(* Ahistory: the lines the human typed, to be recalled.

   Each line sent, a message or a command, is kept, and outlives the
   run in a file, history in arno's directory, as the Pascal arno kept
   it: one entry a line, newest last, a backslash written \\ and a line
   break \n, so that a line of several stays one. It is read when the
   screen starts and added to as each line is sent; once it holds more
   than twice Max entries it is written again with the newest Max, so
   that it stays small without being written whole for every line.

   The input steps through it: back and forward move from the entry
   shown to the one before or after it, past the newest to the line
   that was being typed, kept aside meanwhile; prefixed moves to the
   next that begins as the input does; search finds the newest that
   holds a text, for ^R.

   Depends on Buf, Str, Sys and Files. *)
module Ahistory;
import Buf, Str, Sys, Files, Heap, Out, Strs := Vec([]U8);

const
    Max = 1000;   (* entries kept when the file is written again *)

var
    entries: Strs.Vec;   (* oldest first, each in memory of its own *)
    at: INT;             (* the entry shown; entries.len for the line being typed *)
    draft: Buf.Buf;      (* the line being typed, while an entry is shown *)
    path: Buf.Buf;       (* the file; "" for none *)

(* s kept, as an entry. *)
proc keep(s: []U8);
var copy: []U8; ok: BOOL;
begin
    copy, ok := Str.copy(Heap.heap, s);
    if ok then Strs.push(ADR(entries), copy); end;
end;

(* s added to b, escaped as a line of the file. *)
proc escape(b: ^Buf.Buf; s: []U8);
var i: INT;
begin
    for i := 0 to LEN(s) - 1 do
        if s[i] = '\\' then Buf.str(b, "\\\\");
        elsif s[i] = '\n' then Buf.str(b, "\\n");
        else Buf.add(b, s[i]);
        end;
    end;
    Buf.add(b, '\n');
end;

(* A line of the file, unescaped, into b. *)
proc unescape(b: ^Buf.Buf; s: []U8);
var i: INT;
begin
    Buf.reset(b);
    i := 0;
    while i < LEN(s) do
        if (s[i] = '\\') and (i + 1 < LEN(s)) then
            INC(i);
            if s[i] = 'n' then Buf.add(b, '\n'); else Buf.add(b, s[i]); end;
        else
            Buf.add(b, s[i]);
        end;
        INC(i);
    end;
end;

(* The history read from file, which from now on each line sent is
   added to. *)
proc load*(file: []U8);
var text, line: Buf.Buf; s, l: []U8; all: [][]U8; i, n: INT;
begin
    Buf.reset(ADR(path));
    Buf.str(ADR(path), file);
    Buf.init(ADR(text), Heap.heap);
    defer Buf.done(ADR(text));
    Buf.init(ADR(line), Heap.heap);
    defer Buf.done(ADR(line));
    if Files.load(file, ADR(text)) # 0 then return; end;
    s := Buf.bytes(ADR(text));
    while LEN(s) > 0 do
        l, s, _ := Str.cut(s, "\n");
        if LEN(l) = 0 then continue; end;
        unescape(ADR(line), l);
        keep(Buf.bytes(ADR(line)));
    end;
    at := entries.len;
    if entries.len <= 2 * Max then return; end;
    (* the oldest dropped, and the file written again *)
    all := Strs.all(ADR(entries));
    n := entries.len - Max;
    for i := 0 to n - 1 do Str.free(Heap.heap, all[i]); end;
    for i := 0 to Max - 1 do all[i] := all[i + n]; end;
    Strs.resize(ADR(entries), Max);
    at := Max;
    Buf.reset(ADR(text));
    all := Strs.all(ADR(entries));
    for i := 0 to Max - 1 do escape(ADR(text), all[i]); end;
    _ := Files.write(file, Buf.bytes(ADR(text)));
end;

(* s, a line sent, added: kept, unless it is the newest already, and
   written to the file. The input is back at the line being typed. *)
proc add*(s: []U8);
var b: Buf.Buf; fd: INT;
begin
    at := entries.len;
    if (LEN(s) = 0) or (entries.len > 0) and (Strs.all(ADR(entries))[entries.len - 1] = s) then return; end;
    keep(s);
    at := entries.len;
    if path.len = 0 then return; end;
    Buf.init(ADR(b), Heap.heap);
    defer Buf.done(ADR(b));
    escape(ADR(b), s);
    fd := Sys.open(Buf.bytes(ADR(path)), {Sys.Access.writing, Sys.Access.creating, Sys.Access.appending});
    if fd < 0 then return; end;
    _ := Sys.write(fd, Buf.bytes(ADR(b)));
    Sys.close(fd);
end;

(* The input is the line being typed again, whatever was recalled. *)
proc reset*;
begin
    at := entries.len;
end;

(* Entry i shown, or the line being typed if i is entries.len: its
   text, and false, with nothing moved, if there is no such entry.
   typed is the input as it is, kept aside if it is the line being
   typed that is left. *)
proc recall(i: INT; typed: []U8): ([]U8, BOOL);
begin
    if (i < 0) or (i > entries.len) or (i = at) then return "", false; end;
    if at = entries.len then
        Buf.reset(ADR(draft));
        Buf.str(ADR(draft), typed);
    end;
    at := i;
    if i = entries.len then return Buf.bytes(ADR(draft)), true; end;
    return Strs.all(ADR(entries))[i], true;
end;

(* The entry before the one shown, and true; false at the oldest. *)
proc back*(typed: []U8): ([]U8, BOOL);
begin
    return recall(at - 1, typed);
end;

(* The entry after the one shown, the line being typed after the
   newest, and true; false if that is shown already. *)
proc onward*(typed: []U8): ([]U8, BOOL);
begin
    return recall(at + 1, typed);
end;

(* The nearest entry before the one shown (dir -1) or after it (dir 1)
   that begins with pre and isn't typed, and true; after the newest,
   the line being typed. False if there is none. *)
proc prefixed*(typed, pre: []U8; dir: INT): ([]U8, BOOL);
var i: INT; all: [][]U8;
begin
    all := Strs.all(ADR(entries));
    i := at + dir;
    while (i >= 0) and (i < LEN(all)) do
        if Str.hasPrefix(all[i], pre) and (all[i] # typed) then return recall(i, typed); end;
        i := i + dir;
    end;
    if dir > 0 then return recall(LEN(all), typed); end;
    return "", false;
end;

(* Where s holds q, ASCII letters' case aside, or -1. *)
proc findFold(s, q: []U8): INT;
var i: INT;
begin
    for i := 0 to LEN(s) - LEN(q) do
        if Str.eqFold(s[i..i + LEN(q)], q) then return i; end;
    end;
    return -1;
end;

(* The newest entry at or before from that holds q, case aside, shown:
   its index, its text, and where q is in it; -1 if there is none, and
   nothing shown. from past the newest is the newest. typed is the
   input as it is. *)
proc search*(q: []U8; from: INT; typed: []U8): (INT, []U8, INT);
var i, k: INT; all: [][]U8;
begin
    all := Strs.all(ADR(entries));
    if LEN(q) = 0 then return -1, "", 0; end;
    if from >= LEN(all) then from := LEN(all) - 1; end;
    for i := from to 0 by -1 do
        k := findFold(all[i], q);
        if k >= 0 then
            _, _ := recall(i, typed);
            return i, all[i], k;
        end;
    end;
    return -1, "", 0;
end;

(* How many entries there are; an index past the newest. *)
proc count*: INT;
begin
    return entries.len;
end;

(* The module's test. *)

proc expect(what: []U8; got: []U8; ok: BOOL; want: []U8; failed: ^BOOL);
begin
    if ok and (got = want) then return; end;
    Out.str("Ahistory: ");
    Out.str(what);
    Out.str(": got ");
    Out.str(got);
    Out.str("\n");
    failed^ := true;
end;

proc main*: INT;
var failed, ok: BOOL; s: []U8; i, k: INT; b: Buf.Buf;
begin
    _ := Sys.makeDir("build");
    _ := Sys.remove("build/history.test");
    load("build/history.test");
    add("one");
    add("two\nlines \\ back");
    add("two\nlines \\ back");
    add("/load x");
    Strs.reset(ADR(entries));
    load("build/history.test");
    if count() # 3 then Out.str("Ahistory: read back\n"); failed := true; end;
    s, ok := back("typing");
    expect("back", s, ok, "/load x", ADR(failed));
    s, ok := back("/load x");
    expect("back again", s, ok, "two\nlines \\ back", ADR(failed));
    s, ok := onward("edited");
    s, ok := onward("/load x");
    expect("forward to the draft", s, ok, "typing", ADR(failed));
    s, ok := onward("typing");
    if ok then Out.str("Ahistory: past the draft\n"); failed := true; end;
    s, ok := prefixed("t", "t", -1);
    expect("prefixed", s, ok, "two\nlines \\ back", ADR(failed));
    s, ok := prefixed(s, "t", 1);
    expect("prefixed back to the draft", s, ok, "t", ADR(failed));
    i, s, k := search("ONE", count(), "x");
    if (i # 0) or (k # 0) then Out.str("Ahistory: search\n"); failed := true; end;
    i, s, k := search("lines", count(), "x");
    if (i # 1) or (k # 4) then Out.str("Ahistory: search further\n"); failed := true; end;
    Buf.init(ADR(b), Heap.heap);
    _ := Files.read("build/history.test", ADR(b));
    expect("the file", Buf.bytes(ADR(b)), true, "one\ntwo\\nlines \\\\ back\n/load x\n", ADR(failed));
    if failed then return 1; end;
    return 0;
end;

proc init;
begin
    Strs.init(ADR(entries), Heap.heap);
    Buf.init(ADR(draft), Heap.heap);
    Buf.init(ADR(path), Heap.heap);
end;

begin
    init();
end Ahistory.
