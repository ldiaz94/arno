(* Aboard: the Board, the transcript the screen keeps, and how it looks.

   The board is a list of entries: what the human typed, the model's
   replies, each tool call with its result, and what arno says, as
   information or as an error. Only the loop's thread touches it: what
   a turn's thread is told reaches it through the screen's queue.

   draw lays the transcript out into a part of the screen, the last
   rows of it, or rows further up when it is scrolled back. Nothing is
   kept of a layout: each draw lays out, from the last entry up, only
   the entries that reach the part shown, so a long session costs
   nothing to draw but what is on the screen.

   A reply is read as markdown, lightly: a fence of three backquotes
   starts or ends a block of code, a line of #s and a space is a
   heading, and **bold** and `code` are styled, their marks dropped. A
   line of >s is quoted, a bar for each > before it, and so are the
   lines that follow it lazily, as CommonMark has it: up to a blank
   line or one that opens a block of its own, a list's item say. A
   table, a head, a rule of dashes and rows between bars, is laid out
   in columns between dim bars, aligned as its rule says, its head
   ruled off; one too wide has its widest columns narrowed, their
   cells wrapped. Flatten keeps a table as its markdown, so that
   copying it copies what the model wrote. Left out: a bar escaped or
   in `code` within a cell, a quote's fence or table, more than
   MaxCols columns. A
   tool call is a line, its name, its arguments and what came of it,
   until it is opened: then its arguments in full, the diff its
   question showed, and its result, 400 lines at most, follow, a diff
   and git's result coloured as diffs. The newest call stays open
   while its question is asked.

   The view says whose entries are drawn: every one, the lead's alone,
   or one worker's. Every entry stays on the board; only what is shown
   is laid out, by draw and by flatten alike, so copy mode follows the
   view. Shown all, a worker's run of entries hangs under a label, its
   number and its model, indented behind a bar in a colour of its own,
   and the lead's entries are as they always were:

         > delegate {"task":"..."}  running...
         w2 glm-5.3-flash
         |   > read {"path":"a.raz"}  40 lines
         | | a reply of the worker's

   Shown the lead's, each worker is a line under the delegate that
   started it, kept up to date: its number and model, how many calls it
   has made, and its latest, the call's name and the first string of
   its arguments; toggled, the delegate shows the worker's view:

         > delegate {"task":"..."}  running...
             w2 glm-5.3-flash . 23 calls . read enterprise/cv.ts

   A worker's first entry is linked to the lead's newest delegate
   before it, as a worker's first word follows its own call, so the
   link falls out of the entries, for a viewer too. Left out: what a
   worker has spent, which the entries don't hold.

   flatten lays the whole transcript out as text, for copy mode to move
   over: each row's text, without its styles or what goes before it,
   and the column it starts at; and what joins it to the row above
   when it is copied, so that a paragraph wrapped over several rows is
   copied as the one line it was.

   Depends on rtui's TuiScreen, rterm's Term, Buf, Str and
   Heap. *)
module Aboard;
import TuiScreen, Term, Buf, Str, Heap, Fmt, Out, Entries := Vec(Entry), Rows := Vec(Row), Lines := Vec([]const U8), Models := Vec(Buf.Buf),
    Ints := Vec(INT);
import SYSTEM;

type
    Kind* = (user, reply, tool, info, error);

    Entry* = record
        kind*: Kind;
        speaker*: INT;      (* who said it: 0 the lead, N worker N *)
        text*: Buf.Buf;     (* what was said; a tool's name *)
        args*: Buf.Buf;     (* a tool's arguments, JSON as the model wrote them *)
        res*: Buf.Buf;      (* its result *)
        detail*: Buf.Buf;   (* the diff its question showed *)
        done*: BOOL;        (* its result came *)
        open*: BOOL;        (* shown in full, not as a line *)
    end;

    (* A row of the transcript as text, as flatten lays it out. *)
    Row* = record
        a*, b*: INT;   (* where its text is in flatten's, from a to b *)
        x*: INT;       (* the column the text starts at *)
        join*: U8;     (* what joins it to the row above: a line feed where the text had one, a
                          blank where the row broke at one, 0 where it broke inside a word *)
    end;

    (* How a piece of text looks: an index into Styles. *)
    Look = (plain, strong, mono, heading, block, dim, red, green, typed, hunk, worker);

const
    MaxShown = 400;     (* lines of a result an open call shows *)
    UserBar = "\u{258C} ";
    ReplyBar = "\u{258C} ";
    QuoteBar = "\u{2502} ";   (* one for each level of a quote *)
    Gutter = "    \u{2502} ";
    Plan = "    ";   (* a plan's lines, under its call *)
    WorkerBar = "  \u{2502} ";   (* before each row of a worker's entry, shown all *)
    WorkerLine = "    ";   (* before a worker's line, under its delegate *)
    Dot = " \u{B7} ";      (* between a worker line's facts *)
    All* = -1;       (* the view of every entry *)
    Unseen = -2;     (* in starts: the worker has said nothing yet *)
    MaxCols = 16;    (* a table's columns shown; those past are left out *)

var
    speaker*: INT;      (* who the entries pushed now are said by, as Entry.speaker; set by speak *)
    view*: INT;         (* whose entries are shown: All, 0 the lead's, N worker N's *)
    entries: Entries.Vec;
    models: Models.Vec;   (* worker N's model at N; empty where none was named *)
    starts: Ints.Vec;     (* at N, the index of the lead's delegate that started worker N: -1 if
                             none, Unseen if N has said nothing, as past the end *)
    styles: [11]TuiScreen.Style;   (* each Look's *)
    (* the line being laid out: its text, and the Look of each byte *)
    text, looks: Buf.Buf;
    (* where a draw puts the rows: the screen, the part of it, the row
       of the transcript at its top, and the row being laid out *)
    screen: ^TuiScreen.Screen;
    area: TuiScreen.Rect;
    top, row: INT;
    gutter: []const U8;   (* drawn before each row, in the worker's look: WorkerBar in a worker's entry shown all *)
    (* what flatten keeps: the rows, their text, and the join of the
       next row laid out *)
    keeping: BOOL;
    flatRows: Rows.Vec;
    flatText: Buf.Buf;
    joinNext: U8;
    (* a table: its lines, and a line's cells as tableRow lays them out *)
    tableLines: Lines.Vec;
    cellText, cellLooks: Buf.Buf;

(* The entries, oldest first, until one is added. *)
proc all*: []Entry;
begin
    return Entries.all(entries);
end;

(* The last entry, or nil if there is none. *)
proc last*: ^Entry;
begin
    if entries.len = 0 then return nil; end;
    return SYSTEM.ADR(Entries.all(entries)[entries.len - 1]);
end;

(* The entries pushed from now on are said by n: 0 the lead, N worker N. *)
proc speak*(n: INT);
begin
    speaker := n;
end;

(* Worker n runs on model, which its label says. *)
proc name*(n: INT; model: []const U8);
var m: ^Buf.Buf;
begin
    if n < 1 then return; end;
    while models.len <= n do Buf.init(Models.add(models)^, Heap.heap); end;
    m := SYSTEM.ADR(Models.all(models)[n]);
    Buf.reset(m^);
    Buf.str(m^, model);
end;

(* Worker n's model; "" if none was named. *)
proc model*(n: INT): []const U8;
begin
    if (n < 1) or (n >= models.len) then return ""; end;
    return Buf.bytes(Models.all(models)[n]);
end;

(* Whether e is a delegate of the lead's. *)
proc isDelegate(const e: Entry): BOOL;
begin
    return (e.speaker = 0) and (e.kind = Kind.tool) and (Buf.bytes(e.text) = "delegate");
end;

(* Worker n's first entry, the last, linked to the lead's newest
   delegate before it: a worker's first word follows its own call. *)
proc attach(n: INT);
var e: []Entry; i: INT;
begin
    while starts.len <= n do Ints.push(starts, Unseen); end;
    if Ints.all(starts)[n] # Unseen then return; end;
    e := all();
    i := LEN(e) - 2;
    while (i >= 0) and not isDelegate(e[i]) do DEC(i); end;
    Ints.all(starts)[n] := i;
end;

(* The worker that entry i started, or 0 if none. *)
proc started(i: INT): INT;
var s: []INT; n: INT;
begin
    s := Ints.all(starts);
    for n := 1 to LEN(s) - 1 do
        if s[n] = i then return n; end;
    end;
    return 0;
end;

(* A new entry of kind k saying s, at the end. *)
proc push*(k: Kind; s: []const U8): ^Entry;
var e: ^Entry;
begin
    e := Entries.add(entries);
    e^.kind := k;
    e^.speaker := speaker;
    Buf.init(e^.text, Heap.heap);
    Buf.init(e^.args, Heap.heap);
    Buf.init(e^.res, Heap.heap);
    Buf.init(e^.detail, Heap.heap);
    Buf.str(e^.text, s);
    if speaker > 0 then attach(speaker); end;
    return e;
end;

(* The index of the speaker's last entry, or -1 if it has none: what
   it says next goes on from there, whoever else spoke between. *)
proc latest*: INT;
var e: []Entry; i: INT;
begin
    e := all();
    i := LEN(e) - 1;
    while (i >= 0) and (e[i].speaker # speaker) do DEC(i); end;
    return i;
end;

(* A piece of the model's text, added to the speaker's reply it goes
   on, or the start of a new one if something of theirs came between. *)
proc reply*(s: []const U8);
var e: ^Entry; i: INT;
begin
    i := latest();
    if (i < 0) or (all()[i].kind # Kind.reply) then e := push(Kind.reply, ""); else e := SYSTEM.ADR(all()[i]); end;
    Buf.str(e^.text, s);
end;

(* A tool call, about to run. *)
proc call*(name, args: []const U8);
begin
    Buf.str(push(tool, name)^.args, args);
end;

(* The first call still running of the speaker's, or nil: the one a
   result answers, as a speaker's calls run one after another, and a
   conversation shown again gives an assistant's calls before their
   results. A worker's calls run while the lead's delegate does. *)
proc running: ^Entry;
var e: []Entry; i: INT;
begin
    e := all();
    for i := 0 to LEN(e) - 1 do
        if (e[i].kind = tool) and not e[i].done and (e[i].speaker = speaker) then return SYSTEM.ADR(e[i]); end;
    end;
    return nil;
end;

(* res, the result of the call running. *)
proc result*(res: []const U8);
var e: ^Entry;
begin
    e := running();
    if e = nil then return; end;
    Buf.str(e^.res, res);
    e^.done := true;
end;

(* The diff a question about the newest call still running shows,
   which opens it: the call that asks, whoever spoke since. *)
proc detail*(d: []const U8);
var e: []Entry; i: INT;
begin
    e := all();
    i := LEN(e) - 1;
    while (i >= 0) and ((e[i].kind # tool) or e[i].done) do DEC(i); end;
    if i < 0 then return; end;
    Buf.reset(e[i].detail);
    Buf.str(e[i].detail, d);
    e[i].open := true;
end;

(* Every entry dropped. *)
proc clear*;
var e: []Entry; i: INT;
begin
    e := all();
    for i := 0 to LEN(e) - 1 do
        Buf.done(e[i].text);
        Buf.done(e[i].args);
        Buf.done(e[i].res);
        Buf.done(e[i].detail);
    end;
    Entries.reset(entries);
    Ints.reset(starts);
end;

(* Whether the view shows e. *)
proc shows(const e: Entry): BOOL;
begin
    return (view = All) or (e.speaker = view);
end;

(* The entry shown before entry i, or -1 if there is none. *)
proc prior(i: INT): INT;
begin
    DEC(i);
    while (i >= 0) and not shows(all()[i]) do DEC(i); end;
    return i;
end;

(* The view is v from now on: All, 0 the lead's entries, N worker N's. *)
proc choose*(v: INT);
begin
    view := v;
end;

(* The next view: all, then the lead's, then each worker's that said
   something, in their order, then all again. *)
proc cycle*;
var e: []Entry; i, next: INT;
begin
    if view = All then view := 0; return; end;
    e := all();
    next := All;
    for i := 0 to LEN(e) - 1 do
        if (e[i].speaker > view) and ((next = All) or (e[i].speaker < next)) then next := e[i].speaker; end;
    end;
    view := next;
end;

(* The newest call shown opened, or closed if it is open; but shown the
   lead's, a delegate that started a worker shows the worker's view,
   which holds its whole run, its report last. *)
proc toggle*;
var e: []Entry; i: INT;
begin
    e := all();
    for i := LEN(e) - 1 to 0 by -1 do
        if (e[i].kind = tool) and shows(e[i]) then
            if (view = 0) and (started(i) > 0) then view := started(i); else e[i].open := not e[i].open; end;
            return;
        end;
    end;
end;

(* Every call shown opened, or every one closed if any is open. *)
proc toggleAll*;
var e: []Entry; i: INT; open: BOOL;
begin
    e := all();
    open := false;
    for i := 0 to LEN(e) - 1 do
        if (e[i].kind = tool) and shows(e[i]) and e[i].open then open := true; end;
    end;
    for i := 0 to LEN(e) - 1 do
        if (e[i].kind = tool) and shows(e[i]) then e[i].open := not open; end;
    end;
end;

(* Laying out: the line in text and looks wrapped at w columns, each
   row after pre, which is drawn in bar. A row out of the part shown is
   only counted. *)

(* The row of the transcript row is next: drawn if it is in the part
   shown, the gutter in the worker's look, pre in bar, then text from a
   to b, piece by piece in its looks. *)
proc emit(pre: []const U8; bar: Look; a, b: INT);
var r, col, limit, x: INT; s, l: []const U8;
begin
    if keeping then
        Rows.push(flatRows, {a: flatText.len, b: flatText.len + b - a, x: TuiScreen.columns(gutter) + TuiScreen.columns(pre), join: joinNext});
        Buf.str(flatText, Buf.bytes(text)[a..b]);
    end;
    joinNext := '\n';
    r := row - top;
    INC(row);
    if (screen = nil) or (r < 0) or (r >= area.rows) then return; end;
    limit := area.col + area.cols;
    col := TuiScreen.putTo(screen, area.row + r, area.col, limit, gutter, styles[INT(worker)]);
    col := TuiScreen.putTo(screen, area.row + r, col, limit, pre, styles[INT(bar)]);
    s := Buf.bytes(text);
    l := Buf.bytes(looks);
    while a < b do
        x := a;
        while (x < b) and (l[x] = l[a]) do INC(x); end;
        col := TuiScreen.putTo(screen, area.row + r, col, limit, s[a..x], styles[l[a]]);
        a := x;
    end;
end;

(* Where a row of w columns of s, from a, ends: at a blank where there
   is one in the row, else where the row is full, or at a character at
   least, so that a row is never empty; and where the next row starts,
   past the blanks the row broke at. *)
proc fill(s: []const U8; a, w: INT): (INT, INT);
var i, b, cols, blank, n: INT; c: I32;
begin
    i := a;
    cols := 0;
    blank := -1;
    n := 1;
    while i < LEN(s) do
        c, n := Str.decode(s[i..LEN(s)]);
        if n < 1 then n := 1; end;
        if cols + TuiScreen.width(c) > w then break; end;
        if s[i] = ' ' then blank := i; end;
        cols := cols + TuiScreen.width(c);
        i := i + n;
    end;
    if i >= LEN(s) then return LEN(s), LEN(s); end;
    if s[i] # ' ' then
        if blank > a then i := blank; elsif i = a then i := a + n; end;
    end;
    b := i;
    while (i < LEN(s)) and (s[i] = ' ') do INC(i); end;
    return b, i;
end;

(* The line in text wrapped at w columns, as fill breaks it. *)
proc wrap(pre: []const U8; bar: Look; w: INT);
var s: []const U8; a, b, next: INT;
begin
    s := Buf.bytes(text);
    if w < 8 then w := 8; end;
    if LEN(s) = 0 then emit(pre, bar, 0, 0); return; end;
    a := 0;
    while a < LEN(s) do
        b, next := fill(s, a, w);
        emit(pre, bar, a, b);
        if next < LEN(s) then
            joinNext := 0;
            if next > b then joinNext := ' '; end;
        end;
        a := next;
    end;
end;

(* s added to the line being laid out, in look l; a tab as four
   blanks. *)
proc add(s: []const U8; l: Look);
var i, k: INT;
begin
    for i := 0 to LEN(s) - 1 do
        if s[i] = '\t' then
            for k := 1 to 4 do
                Buf.add(text, ' ');
                Buf.add(looks, U8(l));
            end;
        else
            Buf.add(text, s[i]);
            Buf.add(looks, U8(l));
        end;
    end;
end;

proc start;
begin
    Buf.reset(text);
    Buf.reset(looks);
end;

(* Each line of s wrapped after pre, in look l. *)
proc lines(s, pre: []const U8; bar, l: Look; w: INT);
var line: []const U8; ok: BOOL;
begin
    repeat
        line, s, ok := Str.cut(s, "\n");
        start();
        add(line, l);
        wrap(pre, bar, w);
    until not ok;
end;

(* Each line of s wrapped after pre, coloured as a diff's: added lines
   green, taken lines red, a hunk's head in its own, the rest dim. *)
proc diff(s, pre: []const U8; w: INT);
var line: []const U8; l: Look; ok: BOOL;
begin
    repeat
        line, s, ok := Str.cut(s, "\n");
        l := dim;
        if Str.hasPrefix(line, "+") then l := green;
        elsif Str.hasPrefix(line, "-") then l := red;
        elsif Str.hasPrefix(line, "@") then l := hunk;
        end;
        start();
        add(line, l);
        wrap(pre, dim, w);
    until not ok;
end;

(* s added in look l, but **bold** and `code`, styled, their marks
   dropped. *)
proc inline(s: []const U8; l: Look);
var i: INT; bold, quoted: BOOL; at: Look;
begin
    bold := false;
    quoted := false;
    i := 0;
    while i < LEN(s) do
        if s[i] = '`' then
            quoted := not quoted;
            INC(i);
        elsif not quoted and (s[i] = '*') and (i + 1 < LEN(s)) and (s[i + 1] = '*') then
            bold := not bold;
            INC(i, 2);
        else
            at := l;
            if quoted then at := mono; elsif bold then at := strong; end;
            add(s[i..i + 1], at);
            INC(i);
        end;
    end;
end;

(* Whether t, a line without its leading blanks, opens a block of its
   own: a fence, a heading, a list's item, a table's row or a rule.
   Such a line, or a blank one, ends a quote; any other continues it. *)
proc opens(t: []const U8): BOOL;
var i: INT;
begin
    if (LEN(t) = 0) or (t[0] = '#') or (t[0] = '|') or Str.hasPrefix(t, "```") or Str.hasPrefix(t, "---") then
        return true;
    end;
    if Str.hasPrefix(t, "- ") or Str.hasPrefix(t, "* ") or Str.hasPrefix(t, "+ ") then return true; end;
    i := 0;
    while (i < LEN(t)) and Str.isDigit(t[i]) do INC(i); end;
    return (i > 0) and (i + 1 < LEN(t)) and ((t[i] = '.') or (t[i] = ')')) and (t[i + 1] = ' ');
end;

(* A reply's line, as markdown, into text and looks; fence says whether
   a block of code is open, and quote how many quotes deep the line is,
   before and after. *)
proc markdown(line: []const U8; var fence: BOOL; var quote: INT);
var t: []const U8; h, depth: INT;
begin
    start();
    if not fence then
        (* each > and the blank after it is a level of quote *)
        t := line;
        depth := 0;
        while Str.hasPrefix(Str.trimLeft(t), ">") do
            t := Str.trimLeft(t);
            t := t[1..LEN(t)];
            if Str.hasPrefix(t, " ") then t := t[1..LEN(t)]; end;
            INC(depth);
        end;
        if depth > 0 then
            quote := depth;
            line := t;
        elsif opens(Str.trimLeft(line)) then
            quote := 0;
        end;
    end;
    if Str.hasPrefix(Str.trimLeft(line), "```") then
        fence := not fence;
        add(line, dim);
        return;
    end;
    if fence then add(line, block); return; end;
    h := 0;
    while (h < LEN(line)) and (line[h] = '#') do INC(h); end;
    if (h > 0) and (h < LEN(line)) and (line[h] = ' ') then
        add(line[h + 1..LEN(line)], heading);
        return;
    end;
    inline(line, plain);
end;

(* Tables. A table's lines are its head, its rule (|---|:--:|), which
   says how each column is aligned, and its rows; each line's cells
   are between bars. *)

(* Whether line is a table's. *)
proc isRow(line: []const U8): BOOL;
begin
    return Str.hasPrefix(Str.trimLeft(line), "|");
end;

(* Whether line is a table's rule: bars, dashes, colons and blanks. *)
proc isRule(line: []const U8): BOOL;
var i: INT;
begin
    if not isRow(line) or (Str.find(line, "-") < 0) then return false; end;
    for i := 0 to LEN(line) - 1 do
        if Str.find("|-: ", line[i..i + 1]) < 0 then return false; end;
    end;
    return true;
end;

(* A table's line without its blanks and the bars at its ends. *)
proc inner(line: []const U8): []const U8;
var t: []const U8;
begin
    t := Str.trim(line);
    if Str.hasPrefix(t, "|") then t := t[1..LEN(t)]; end;
    if Str.hasSuffix(t, "|") then t := t[0..LEN(t) - 1]; end;
    return t;
end;

(* How many cells a table's line has. *)
proc cells(line: []const U8): INT;
var t: []const U8; i, n: INT;
begin
    t := inner(line);
    n := 1;
    for i := 0 to LEN(t) - 1 do
        if t[i] = '|' then INC(n); end;
    end;
    return n;
end;

(* Cell c of a table's line, without its blanks; "" past the last. *)
proc cell(line: []const U8; c: INT): []const U8;
var t, part: []const U8; ok: BOOL;
begin
    t := inner(line);
    repeat
        part, t, ok := Str.cut(t, "|");
        if c = 0 then return Str.trim(part); end;
        DEC(c);
    until not ok;
    return "";
end;

(* Of pad blanks that fill column c out, how many go before its text,
   as the rule aligns it: none for the left, all for the right, half
   for the centre. *)
proc before(rule: []const U8; c, pad: INT): INT;
var r: []const U8;
begin
    r := cell(rule, c);
    if not Str.hasSuffix(r, ":") then return 0; end;
    if Str.hasPrefix(r, ":") then return pad div 2; end;
    return pad;
end;

(* n blanks added. *)
proc blanks(n: INT);
var i: INT;
begin
    for i := 1 to n do add(" ", plain); end;
end;

(* A table's line laid out in columns as wide as widths, each cell
   wrapped in its column, in look l: as many rows as its longest cell
   takes. *)
proc tableRow(line, rule: []const U8; widths: []const INT; l: Look; pre: []const U8);
var ends, at: [MaxCols]INT; c, b, next, pad, lead, k: INT; s, ls: []const U8; more: BOOL;
begin
    (* the cells, styled, one after another, in cellText and cellLooks *)
    start();
    for c := 0 to LEN(widths) - 1 do
        at[c] := text.len;
        inline(cell(line, c), l);
        ends[c] := text.len;
    end;
    Buf.reset(cellText);
    Buf.str(cellText, Buf.bytes(text));
    Buf.reset(cellLooks);
    Buf.str(cellLooks, Buf.bytes(looks));
    s := Buf.bytes(cellText);
    ls := Buf.bytes(cellLooks);
    repeat
        start();
        more := false;
        for c := 0 to LEN(widths) - 1 do
            if c > 0 then add(" \u{2502} ", dim); end;
            b, next := fill(s[0..ends[c]], at[c], widths[c]);
            pad := widths[c] - TuiScreen.columns(s[at[c]..b]);
            lead := before(rule, c, pad);
            blanks(lead);
            for k := at[c] to b - 1 do
                Buf.add(text, s[k]);
                Buf.add(looks, ls[k]);
            end;
            blanks(pad - lead);
            at[c] := next;
            if next < ends[c] then more := true; end;
        end;
        emit(pre, dim, 0, text.len);
    until not more;
end;

(* A table, t its lines, laid out at w columns after pre: each column
   as wide as its widest cell, then the widest narrowed, column by
   column, until the table fits; its head strong, and ruled off. In
   flatten, the lines are kept as they were written, so that copying a
   table copies its markdown. *)
proc table(t: []const []const U8; pre: []const U8; w: INT);
var widths: [MaxCols]INT; n, c, i, total, widest: INT;
begin
    if keeping then
        for i := 0 to LEN(t) - 1 do
            start();
            add(t[i], plain);
            wrap(pre, dim, w);
        end;
        return;
    end;
    n := cells(t[0]);
    if n > MaxCols then n := MaxCols; end;
    for c := 0 to n - 1 do
        widths[c] := 0;
        for i := 0 to LEN(t) - 1 do
            if i # 1 then
                start();
                inline(cell(t[i], c), plain);
                if TuiScreen.columns(Buf.bytes(text)) > widths[c] then widths[c] := TuiScreen.columns(Buf.bytes(text)); end;
            end;
        end;
    end;
    total := 3 * (n - 1);
    for c := 0 to n - 1 do total := total + widths[c]; end;
    while total > w do
        widest := 0;
        for c := 1 to n - 1 do
            if widths[c] > widths[widest] then widest := c; end;
        end;
        if widths[widest] <= 1 then break; end;
        DEC(widths[widest]);
        DEC(total);
    end;
    tableRow(t[0], t[1], widths[0..n], strong, pre);
    start();
    for c := 0 to n - 1 do
        if c > 0 then add("\u{2500}\u{253C}\u{2500}", dim); end;
        for i := 1 to widths[c] do add("\u{2500}", dim); end;
    end;
    emit(pre, dim, 0, text.len);
    for i := 2 to LEN(t) - 1 do tableRow(t[i], t[1], widths[0..n], plain, pre); end;
end;

(* The first line of s. *)
proc first(s: []const U8): []const U8;
var line: []const U8;
begin
    line, _, _ := Str.cut(s, "\n");
    return line;
end;

(* s, as markdown, each line wrapped at w columns after pre and a bar
   for each quote it is in, drawn dim; a table laid out as one. *)
proc prose(s, pre: []const U8; w: INT);
var line: []const U8; fence, ok: BOOL; quote, i: INT; bars: Buf.Buf;
begin
    Buf.init(bars, Heap.heap);
    defer Buf.done(bars);
    fence := false;
    quote := 0;
    repeat
        line, s, ok := Str.cut(s, "\n");
        if not fence and isRow(line) and ok and isRule(first(s)) then
            Lines.reset(tableLines);
            Lines.push(tableLines, line);
            while ok and isRow(first(s)) do
                line, s, ok := Str.cut(s, "\n");
                Lines.push(tableLines, line);
            end;
            quote := 0;
            table(Lines.all(tableLines), pre, w);
        else
            markdown(line, fence, quote);
            Buf.reset(bars);
            Buf.str(bars, pre);
            for i := 1 to quote do Buf.str(bars, QuoteBar); end;
            wrap(Buf.bytes(bars), dim, w - quote * TuiScreen.columns(QuoteBar));
        end;
    until not ok;
end;

(* s on one line: its line breaks and tabs as blanks. *)
proc flat(s: []const U8; l: Look);
var i: INT;
begin
    for i := 0 to LEN(s) - 1 do
        if (s[i] = '\n') or (s[i] = '\t') or (s[i] = '\r') then add(" ", l); else add(s[i..i + 1], l); end;
    end;
end;

(* How many lines s has, a last one without its line feed counted. *)
proc count(s: []const U8): INT;
var i, n: INT;
begin
    n := 0;
    for i := 0 to LEN(s) - 1 do
        if s[i] = '\n' then INC(n); end;
    end;
    if (LEN(s) > 0) and (s[LEN(s) - 1] # '\n') then INC(n); end;
    return n;
end;

(* The start of text, as the line being laid out, cut to what fits in
   w columns. *)
proc fit(w: INT);
var s: []const U8; i, cols, n: INT; c: I32;
begin
    s := Buf.bytes(text);
    i := 0;
    cols := 0;
    while i < LEN(s) do
        c, n := Str.decode(s[i..LEN(s)]);
        if n < 1 then n := 1; end;
        if cols + TuiScreen.width(c) > w then break; end;
        cols := cols + TuiScreen.width(c);
        i := i + n;
    end;
    text.len := i;
    looks.len := i;
end;

(* A call's line: open or not, its name and arguments, cut to leave
   room for what came of it: running, its result if it is a line, or
   how many lines came; a failure in red. *)
proc header(const e: Entry; w: INT);
var sum: Buf.Buf; res: []const U8; n: INT; l: Look;
begin
    Buf.init(sum, Heap.heap);
    defer Buf.done(sum);
    res := Str.trim(Buf.bytes(e.res));
    n := count(res);
    if not e.done then
        Buf.str(sum, "running\u{2026}");
    elsif n <= 1 then
        Buf.str(sum, res);
    else
        Fmt.write(sum, "{} lines", [Fmt.int(n)]);
    end;
    l := dim;
    if Str.hasPrefix(res, "error") or Str.hasPrefix(res, "declined") or Str.hasPrefix(res, "not run") then l := red; end;
    start();
    if e.open then add("\u{25BE} ", hunk); else add("\u{25B8} ", hunk); end;
    add(Buf.bytes(e.text), hunk);
    add(" ", hunk);
    flat(Buf.bytes(e.args), hunk);
    n := w - 2 - TuiScreen.columns(Buf.bytes(sum));
    if n < w div 2 then n := w div 2; end;
    fit(n);
    add("  ", plain);
    flat(Buf.bytes(sum), l);
    fit(w);
    emit("  ", plain, 0, text.len);
end;

(* The first max lines of s, and how many were left out. *)
proc head(s: []const U8; max: INT): ([]const U8, INT);
var i, n: INT;
begin
    n := 0;
    for i := 0 to LEN(s) - 1 do
        if s[i] = '\n' then
            INC(n);
            if n = max then return s[0..i + 1], count(s) - max; end;
        end;
    end;
    return s, 0;
end;

(* What a call's arguments are about, for a line: the first string
   after a key in them, its escapes as written, or all of them if there
   is none. *)
proc gist(args: []const U8): []const U8;
var a, b: INT;
begin
    a := Str.find(args, `":"`);
    if a < 0 then return args; end;
    a := a + 3;
    b := a;
    while (b < LEN(args)) and (args[b] # '"') do
        if args[b] = '\\' then INC(b); end;
        INC(b);
    end;
    if b > LEN(args) then b := LEN(args); end;
    return args[a..b];
end;

(* Worker n's line, under its delegate, cut to w columns: its number
   and model, how many calls it has made, and the latest, its name and
   what its arguments are about. *)
proc workerLine(n, w: INT);
var e: []Entry; i, calls, latest: INT; b: Buf.Buf;
begin
    e := all();
    calls := 0;
    latest := -1;
    for i := 0 to LEN(e) - 1 do
        if (e[i].speaker = n) and (e[i].kind = tool) then
            INC(calls);
            latest := i;
        end;
    end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Fmt.write(b, "w{} {}", [Fmt.int(n), Fmt.str(model(n))]);
    start();
    add(Str.trimRight(Buf.bytes(b)), worker);
    Buf.reset(b);
    Fmt.write(b, "{}{} call", [Fmt.str(Dot), Fmt.int(calls)]);
    if calls # 1 then Buf.str(b, "s"); end;
    add(Buf.bytes(b), dim);
    if latest >= 0 then
        add(Dot, dim);
        add(Buf.bytes(e[latest].text), dim);
        add(" ", dim);
        flat(gist(Buf.bytes(e[latest].args)), dim);
    end;
    fit(w);
    emit(WorkerLine, plain, 0, text.len);
end;

(* Worker e's label, its number and its model, as a row: e is entry i,
   and the label comes where the speaker changes, at the head of a run
   of the worker's entries. *)
proc label(i: INT; const e: Entry; w: INT);
var b: Buf.Buf; p: INT;
begin
    p := prior(i);
    if (p >= 0) and (all()[p].speaker = e.speaker) then return; end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Fmt.write(b, "w{} {}", [Fmt.int(e.speaker), Fmt.str(model(e.speaker))]);
    lines(Str.trimRight(Buf.bytes(b)), "  ", worker, worker, w - 2);
end;

(* Entry i laid out at w columns, its rows counted from row on; nothing
   if the view leaves it out. Shown all, a worker's entry is labelled
   and indented behind the gutter. *)
proc layout(i: INT; w: INT);
var e: ^Entry; s: []const U8; more: INT; note: Buf.Buf;
begin
    e := SYSTEM.ADR(all()[i]);
    gutter := "";
    if not shows(e^) then return; end;
    if (view = All) and (e^.speaker > 0) then
        label(i, e^, w);
        gutter := WorkerBar;
        w := w - TuiScreen.columns(WorkerBar);
    end;
    s := Buf.bytes(e^.text);
    match e^.kind of
    | user:
        start();
        emit("", plain, 0, 0);
        lines(s, UserBar, typed, typed, w - 2);
    | Kind.reply:
        s := Str.trimRight(s);
        if LEN(s) = 0 then return; end;
        start();
        emit("", plain, 0, 0);
        prose(s, ReplyBar, w - 2);
    | tool:
        header(e^, w - 2);
        if (view = 0) and (started(i) > 0) then workerLine(started(i), w - TuiScreen.columns(WorkerLine)); end;
        if not e^.open then return; end;
        (* a plan is read, not checked against its arguments, which hold it
           again: it stands apart from the call, as markdown, as a reply does *)
        if (Buf.bytes(e^.text) = "plan") and (e^.detail.len > 0) then
            start();
            emit("", plain, 0, 0);
            prose(Str.trimRight(Buf.bytes(e^.detail)), Plan, w - 4);
            start();
            emit("", plain, 0, 0);
        else
            lines(Buf.bytes(e^.args), Gutter, dim, dim, w - 6);
            if e^.detail.len > 0 then diff(Str.trimRight(Buf.bytes(e^.detail)), Gutter, w - 6); end;
        end;
        s, more := head(Str.trimRight(Buf.bytes(e^.res)), MaxShown);
        if LEN(s) > 0 then
            if Buf.bytes(e^.text) = "git" then diff(s, Gutter, w - 6); else lines(s, Gutter, dim, dim, w - 6); end;
        end;
        if more > 0 then
            Buf.init(note, Heap.heap);
            defer Buf.done(note);
            Fmt.write(note, "[{} more lines]", [Fmt.int(more)]);
            lines(Buf.bytes(note), Gutter, dim, dim, w - 6);
        end;
    | info:
        if (prior(i) >= 0) and (all()[prior(i)].kind # info) then start(); emit("", plain, 0, 0); end;
        lines(s, "  ", dim, dim, w - 2);
    | error:
        lines(s, "  ", red, red, w - 2);
    end;
end;

(* How many rows entry i takes at w columns. *)
proc rows(i, w: INT): INT;
begin
    screen := nil;
    row := 0;
    layout(i, w);
    return row;
end;

(* The transcript drawn into r of s, back rows up from its end: as many
   rows back as there are, if back is more. The rows back it was drawn
   at. Short of filling r, it starts at r's top. *)
proc draw*(s: ^TuiScreen.Screen; r: TuiScreen.Rect; back: INT): INT;
var i, total, first: INT;
begin
    if (r.rows < 1) or (r.cols < 1) or (back < 0) then back := 0; end;
    (* the entries from the last up, until they fill r back rows up *)
    total := 0;
    i := entries.len;
    while (i > 0) and (total < r.rows + back) do
        DEC(i);
        total := total + rows(i, r.cols);
    end;
    first := i;
    if back > total - r.rows then back := total - r.rows; end;
    if back < 0 then back := 0; end;
    screen := s;
    area := r;
    top := total - r.rows - back;
    if top < 0 then top := 0; end;
    row := 0;
    for i := first to entries.len - 1 do layout(i, r.cols); end;
    screen := nil;
    return back;
end;

(* The whole transcript laid out at w columns, as rows of text: how
   many there are. Each row is kept until the next flatten. *)
proc flatten*(w: INT): INT;
var i: INT;
begin
    Rows.reset(flatRows);
    Buf.reset(flatText);
    keeping := true;
    screen := nil;
    row := 0;
    for i := 0 to entries.len - 1 do layout(i, w); end;
    keeping := false;
    return flatRows.len;
end;

(* Row i of the last flatten. *)
proc rowAt*(i: INT): Row;
begin
    return Rows.all(flatRows)[i];
end;

(* Row i's text. *)
proc rowText*(i: INT): []const U8;
var r: Row;
begin
    r := Rows.all(flatRows)[i];
    return Buf.bytes(flatText)[r.a..r.b];
end;

(* The board drawn on a screen of cols by rows, back rows back, as
   text, matched with want; false, and both said, if they differ. *)
proc expect(what: []const U8; cols, rows, back: INT; want: []const U8): BOOL;
var s: TuiScreen.Screen; b: Buf.Buf; got: INT;
begin
    TuiScreen.init(SYSTEM.ADR(s), cols, rows);
    defer TuiScreen.done(SYSTEM.ADR(s));
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    got := draw(SYSTEM.ADR(s), {row: 0, col: 0, rows: rows, cols: cols}, back);
    TuiScreen.plain(SYSTEM.ADR(s), SYSTEM.ADR(b));
    Fmt.write(b, "back {}\n", [Fmt.int(got)]);
    if Buf.bytes(b) = want then return true; end;
    Fmt.print("Aboard: {}: got\n{}want\n{}", [Fmt.str(what), Fmt.str(Buf.bytes(b)), Fmt.str(want)]);
    return false;
end;

proc main*: INT;
var ok: BOOL;
begin
    _ := push(info, "arno");
    _ := push(user, "hello there");
    reply("**Hi**, a reply long enough to wrap\n");
    reply("# Head\n`x := 1`");
    call("read", `{"path":"a.raz"}`);
    ok := expect("short, from the top", 24, 16, 0, "  arno\n\n\u{258C} hello there\n\n\u{258C} Hi, a reply long\n\u{258C} enough to wrap\n\u{258C} Head\n\u{258C} x := 1\n  \u{25B8} read {\"pat  running\u{2026}\n\n\n\n\n\n\n\nback 0\n");
    if (flatten(24) # 9) or (rowText(5) # "enough to wrap") or (rowAt(5).join # ' ') or (rowAt(5).x # 2)
        or (rowText(4) # "Hi, a reply long") or (rowAt(4).join # '\n') then
        Out.str("Aboard: flatten\n");
        ok := false;
    end;
    result("one\ntwo\nthree\n");
    ok := expect("the last rows", 24, 4, 0, "\u{258C} enough to wrap\n\u{258C} Head\n\u{258C} x := 1\n  \u{25B8} read {\"path  3 lines\nback 0\n") and ok;
    ok := expect("scrolled back", 24, 4, 3, "\u{258C} hello there\n\n\u{258C} Hi, a reply long\n\u{258C} enough to wrap\nback 3\n") and ok;
    ok := expect("scrolled past the top", 24, 4, 50, "  arno\n\n\u{258C} hello there\n\nback 5\n") and ok;
    toggle;
    _ := push(error, "it failed");
    ok := expect("opened", 30, 6, 0, "  \u{25BE} read {\"path\":\"a.r  3 lines\n    \u{2502} {\"path\":\"a.raz\"}\n    \u{2502} one\n    \u{2502} two\n    \u{2502} three\n  it failed\nback 0\n") and ok;
    (* a plan apart from its call, as markdown, its arguments not shown *)
    clear;
    call("plan", `{"plan":"# Steps"}`);
    detail("# Steps\n1. **one** thing");
    ok := expect("a plan", 30, 6, 0, "  \u{25BE} plan {\"plan\":\"#   running\u{2026}\n\n    Steps\n    1. one thing\n\n\nback 0\n") and ok;
    (* a quote wrapped, continued lazily, ended by a list's item, and nested *)
    clear;
    reply("> a quote long enough to wrap\nlazily\n- item\n> > deep\n\nafter");
    ok := expect("quotes", 24, 8, 0, "\n\u{258C} \u{2502} a quote long enough\n\u{258C} \u{2502} to wrap\n\u{258C} \u{2502} lazily\n\u{258C} - item\n\u{258C} \u{2502} \u{2502} deep\n\u{258C}\n\u{258C} after\nback 0\n") and ok;
    (* a table: aligned, a cell styled and one with an em dash, then narrowed to fit, its widest column wrapped *)
    clear;
    reply("| Issue | Title | N |\n|---|---|--:|\n| **A-1** | a dash \u{2014} here | 7 |\n| B-22 | short | 10 |\nafter");
    ok := expect("a table", 40, 7, 0, "\n\u{258C} Issue \u{2502} Title         \u{2502}  N\n\u{258C} \u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{253C}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{253C}\u{2500}\u{2500}\u{2500}\n\u{258C} A-1   \u{2502} a dash \u{2014} here \u{2502}  7\n\u{258C} B-22  \u{2502} short         \u{2502} 10\n\u{258C} after\n\nback 0\n") and ok;
    ok := expect("a table, narrowed", 24, 9, 0, "\n\u{258C} Issue \u{2502} Title     \u{2502}  N\n\u{258C} \u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{253C}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{2500}\u{253C}\u{2500}\u{2500}\u{2500}\n\u{258C} A-1   \u{2502} a dash \u{2014}  \u{2502}  7\n\u{258C}       \u{2502} here      \u{2502}\n\u{258C} B-22  \u{2502} short     \u{2502} 10\n\u{258C} after\n\n\nback 0\n") and ok;
    if (flatten(40) # 6) or (rowText(3) # "| **A-1** | a dash \u{2014} here | 7 |") then
        Out.str("Aboard: a table copied\n");
        ok := false;
    end;
    (* views: all labels a worker's run and indents it, its result its
       own call's, not the delegate's; one speaker's leaves the other out *)
    clear;
    call("delegate", "{}");
    speak(1);
    name(1, "glm");
    call("read", "{}");
    result("one line");
    speak(0);
    result("reported");
    ok := expect("all", 30, 4, 0, "  \u{25B8} delegate {}  reported\n  w1 glm\n  \u{2502}   \u{25B8} read {}  one line\n\nback 0\n") and ok;
    choose(0);
    ok := expect("the lead's", 30, 3, 0, "  \u{25B8} delegate {}  reported\n    w1 glm \u{B7} 1 call \u{B7} read {}\n\nback 0\n") and ok;
    choose(1);
    if (flatten(30) # 1) or (rowText(0) # "\u{25B8} read {}  one line") or (rowAt(0).x # 2) then
        Out.str("Aboard: a worker's view\n");
        ok := false;
    end;
    choose(All);
    if (flatten(30) # 3) or (rowText(1) # "w1 glm") or (rowAt(2).x # 6) then
        Out.str("Aboard: all, flattened\n");
        ok := false;
    end;
    (* a worker as one line, with its latest call; toggled, its view *)
    speak(1);
    call("read", `{"path":"enterprise/cv.ts","limit":9}`);
    speak(0);
    choose(0);
    ok := expect("a worker as one line", 50, 2, 0, "  \u{25B8} delegate {}  reported\n    w1 glm \u{B7} 2 calls \u{B7} read enterprise/cv.ts\nback 0\n") and ok;
    toggle;
    if view # 1 then
        Out.str("Aboard: a worker's line opened\n");
        ok := false;
    end;
    (* a delegate refused starts no worker: the next worker is the next delegate's *)
    clear;
    call("delegate", "{}");
    call("delegate", "{}");
    speak(2);
    _ := push(info, "worker glm: look");
    speak(0);
    if (started(0) # 0) or (started(1) # 2) then
        Out.str("Aboard: a worker linked to its delegate\n");
        ok := false;
    end;
    if ok then return 0; end;
    return 1;
end;

proc init;
begin
    Entries.init(entries, Heap.heap);
    Buf.init(text, Heap.heap);
    Buf.init(looks, Heap.heap);
    Rows.init(flatRows, Heap.heap);
    Buf.init(flatText, Heap.heap);
    Lines.init(tableLines, Heap.heap);
    Buf.init(cellText, Heap.heap);
    Buf.init(cellLooks, Heap.heap);
    joinNext := '\n';
    view := All;
    Models.init(models, Heap.heap);
    Ints.init(starts, Heap.heap);
    styles := [TuiScreen.Plain, TuiScreen.style(Term.strong, {}), TuiScreen.style(Term.warn, {}),
        TuiScreen.style(Term.strong, {TuiScreen.Attr.underline}), TuiScreen.style(Term.warn, {}),
        TuiScreen.style(Term.dim, {}), TuiScreen.style(Term.bad, {}), TuiScreen.style(Term.good, {}),
        TuiScreen.style(Term.accent, {TuiScreen.Attr.bold}), TuiScreen.style(Term.info, {}),
        TuiScreen.style(Term.good, {})];
end;

begin
    init();
end Aboard.
