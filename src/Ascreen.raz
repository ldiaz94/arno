(* Ascreen: the full screen, arno's session on rtui's loop.

   The screen is, from the top: the transcript (Aboard), a rule that
   says what is going on, the input, which grows to eight rows as it
   is typed, and the status line, the session's mode, model, context
   in use and cost, and the conversation's title, drawn from the
   session's facts (Asession.Facts) in parts of their own colours. The
   mode is a pill, its name on a colour of its own, with the safety
   beside it; on a narrow terminal the parts that say least go first.
   A change of mode or safety is said on the rule for a moment.

   What the human types runs on a thread of its own, a job: a message
   is a turn, a command is run, and the first job prepares the session,
   which may ask about context files. The loop's thread only shows: a
   job tells it what happens by events put in a queue, under a mutex,
   and TuiLoop.wake; the loop takes them into the board when woken. A
   job that asks the human, a path outside the project or a change to
   a file, puts its question in the queue and waits on a pipe for the
   answer, which the loop writes there when a key gives it. Only one
   job runs at a time.

   A line sent while one runs is queued (Aview's queue, which viewers
   share): shown dim above the input, counted on the status line, and
   run in order, each a job of its own, as the one before ends; a
   command waits its place too, but /view, the screen's own, acts at
   once, and /usage answers at once from the counters as the turn
   began, a viewer's too (Aview.metered). C-p on an empty input takes
   the last back to be edited (not Up, which the wheel sends). C-c stops the turn and keeps the queue;
   a second, or one with no turn, empties it. A job that ends on an
   error or a stop holds the queue until RET.

   The keys are emacs's, over rtui's editor (TuiEdit): RET sends, M-RET
   breaks the line, C-c stops the turn or, with none, empties the
   input, C-d on an empty input ends arno, S-TAB steps to the next
   mode, TAB opens or closes the newest call and C-o every one, Page Up
   and Page Down, and S-<up> and S-<down>, scroll the transcript, C-l
   draws the screen again. A question takes one of its keys; C-c, C-d,
   Esc or RET is no, and C-c stops the turn too. After a no to a change,
   the rule asks why, a line that RET gives and C-g or Esc leaves empty.

   The lines sent are kept (Ahistory). C-p on the input's first line
   recalls the one before, C-n on its last the one after; <up> and
   <down> there scroll the transcript instead, as they are what rat's
   wheel sends on the alternate screen, and a wheel that recalled
   history would be nonsense; M-p and M-n the one before or after that begins as the
   input does up to the point. C-r searches them, newest first, case
   aside: what is typed narrows it, C-r looks further back, DEL takes a
   character off, C-g or Esc puts the input back as it was, and any
   other key keeps what was found and does what it does.

   While a command or an @path is typed, what it may become is shown
   over the foot of the transcript (Acomplete): TAB takes the one
   chosen, RET too, and sends a command that takes it as it is, with
   no blank after it; C-n, C-p and the arrows choose, Esc hides them
   until the input changes. During a job, which has the session, a
   model is completed from the list as it stood when the last job
   ended, which viewers are told (Aview.listed); an attached screen
   completes from that list as told, and the rest, commands, /load's
   conversations and @paths, as here, an @path from the attached
   screen's own working directory.

   M-v starts copy mode (Acopy): a cursor on the transcript, to move
   over it, select and copy, until it copies or is left.

   C-v types in an @path to the clipboard's image, saved to a file of
   its own (Aattach.paste); or says on the rule why there is none.

   C-x C-e hands the input to the editor in $VISUAL or $EDITOR, with
   the last exchange under it, below git's scissors line, to read while
   writing; what is above that line comes back. Not during a job, whose
   exchange isn't over.

   A stop is heard after the next read of the reply: the human's C-c
   can't yet break into a wait for the server, since raz has no way to
   signal one thread (PLAN.md, asked of raz).

   An editor's ask (Apeer) arrives on the loop, as a viewer's line does:
   a question runs as a job once none is running, shown as coming from
   the editor, and lines with no question go to the input as a reference.

   Depends on Asession, Agent, Apeer, Aboard, Ahistory, Aattach, Acomplete, Acopy, Astore, Amsg, Aprompt,
   rtui (TuiLoop, TuiScreen, TuiKeys, TuiMap, TuiEdit, TuiText,
   TuiLine), rterm's Term, Thread and Sys. Leaves out, for
   the mouse, and vim's keys. *)
module Ascreen;
import Asession, Agent, Apeer, Aboard, Aview, Aframe, Afence, Ahistory, Aattach, Acomplete, Acopy, Astore, Amsg, Aprompt, TuiLoop, TuiScreen, TuiKeys, TuiMap, TuiEdit,
    TuiText, TuiLine, Term, Thread, Sys, Buf, Str, Heap, Fmt, Events := Vec(Event), Fields := Vec([]const U8),
    Msgs := Vec(Amsg.Msg), Calls := Vec(Amsg.Call);
import SYSTEM;

type
    (* What a job tells the loop. *)
    Sort = (said, called, answered, told, shown, failed, typed, cleared, asked, why, revise, status, named, ended);

    (* The parts of the status line a narrow row leaves out, in the
       order it leaves them out; the mode, safety, plan, view and queue always show. *)
    Part = (hints, title, usage, provider, context, model);
    Parts = set of Part;

    Event = record
        sort: Sort;
        a, b, c: Buf.Buf;   (* its texts: a question's, its detail and keys *)
        going: BOOL;        (* ended: the session goes on *)
        who: INT;           (* who said it: 0 the lead, N worker N *)
    end;

const
    MaxInput = 8;   (* rows the input grows to *)
    MaxMenu = 8;    (* rows of completions shown *)
    MaxQueued = 4;  (* rows of the queue shown, the first lines to run *)
    Hints = "^O tools \u{B7} M-v copy \u{B7} S-Tab mode \u{B7} /help";
    Gap = 3;          (* columns between the status line's parts *)
    Near = 2;         (* columns between the safety and the plan *)
    MinTitle = 12;    (* columns the title needs, cut, to be shown at all *)
    Bar = 8;          (* cells of the context's bar *)
    NoticeTime = 2000;   (* milliseconds a change of mode or safety is said on the rule *)
    (* each mode's colour, by Aprompt.Mode, for its pill: build the loudest *)
    ModeRoles: [5]Term.Role = [Term.accent, Term.good, Term.info, Term.strong, Term.warn];
    Prompt = "\u{203A} ";
    (* git commit -v's line, byte for byte, which an editor may know *)
    Scissors = "# ------------------------ >8 ------------------------";

var
    session: ^Asession.Session;

    (* shared by the loop's thread and a job's, under mutex *)
    mutex: Thread.Mutex;
    speaking: INT;      (* who speaks for the turn under way: 0 the lead, N worker N *)
    events: Events.Vec;
    stopping: BOOL;     (* the human said to stop the turn *)
    ending: BOOL;       (* the loop has ended: a question is a no, unasked *)
    reason: Buf.Buf;    (* the human's why, written before the answer *)
    revision: Buf.Buf;  (* the text the human's editor left, written before the answer *)
    answerRead, answerWrite: INT;   (* the pipe an answer comes by, a byte *)

    (* a job's own *)
    job: Buf.Buf;       (* the line it runs; "" to prepare the session *)
    usageText: Buf.Buf; (* /usage made as the job begins, for Aview to answer from during it *)
    asking: BOOL;       (* the job is an editor's ask instead, in editorAsk *)
    editorAsk: Apeer.Ask;
    made: Buf.Buf;      (* the status line it makes *)
    posted: Asession.Facts;   (* the facts it made last, under mutex *)
    fresh: BOOL;        (* posted is newer than what the loop shows, under mutex *)
    because: Buf.Buf;   (* the why it was given *)
    revised: Buf.Buf;   (* the text the human's editor left, as it was given *)

    (* the loop's own *)
    thread: ^Thread.Thread;   (* the job running, or nil *)
    troubled: BOOL;           (* the job's last word was an error: the queue is held after it *)
    toRevise: Buf.Buf;        (* the text a job asked to have edited, edited once the queue is let go *)
    revising: BOOL;           (* whether it waits *)
    editor: TuiEdit.Editor;   (* the input *)
    map: TuiMap.Map;
    reader: TuiMap.Reader;
    back: INT;          (* rows the transcript is scrolled back *)
    view: INT;          (* rows of it the last draw showed *)
    facts: Asession.Facts;   (* what the status line shows *)
    flash: Buf.Buf;     (* said on the rule until the next key *)
    notice: Buf.Buf;    (* a change of mode or safety, said on the rule for NoticeTime *)
    noticeStyle: TuiScreen.Style;   (* its style *)
    begun: BOOL;        (* the first job has been started *)
    prepared: BOOL;     (* the first job, which prepares the session, has ended *)
    question: Buf.Buf;  (* the question being asked, "" for none *)
    keys: Buf.Buf;      (* the keys that answer it *)
    no: U8;             (* the one of them that is no *)
    why: TuiLine.Line;  (* the reason for a no, while why.open *)
    viewing: BOOL;      (* this is the screen of a session run elsewhere (attach) *)
    viewFd: INT;        (* its socket *)
    viewIn: Buf.Buf;    (* what it sent that isn't a whole message yet *)
    viewStatus: Buf.Buf;   (* its status line *)
    viewBusy: BOOL;     (* a turn runs there *)
    viewEnded: BOOL;    (* the session ended *)
    mode: INT;          (* the mode S-TAB chose during a job, for after it; -1 for none *)
    searching: BOOL;    (* C-r is searching the history *)
    query: Buf.Buf;     (* what it searches for *)
    found: INT;         (* the entry it found last; Ahistory.count() for none *)
    failing: BOOL;      (* the query is in no entry *)
    saved: Buf.Buf;     (* the input before the search, or before the editor *)
    menu: []Acomplete.Item;   (* what the word being typed may become *)
    chosen: INT;        (* the one of them chosen *)
    wordA, wordB: INT;  (* where that word is in the input *)
    hidden: BOOL;       (* Esc hid the menu until the input changes *)
    looked: Buf.Buf;    (* the input the menu was made for *)
    lookedAt: INT;      (* and its point *)

(* A job's side: what it is told, put in the queue *)

(* An event of sort s, with texts a, b and c, put in the queue, and the
   loop woken to take it. *)
proc post(s: Sort; a, b, c: []const U8; going: BOOL);
var e: ^Event;
begin
    Thread.lock(mutex);
    e := Events.add(events);
    e^.sort := s;
    e^.going := going;
    e^.who := speaking;
    Buf.init(e^.a, Heap.heap);
    Buf.init(e^.b, Heap.heap);
    Buf.init(e^.c, Heap.heap);
    Buf.str(e^.a, a);
    Buf.str(e^.b, b);
    Buf.str(e^.c, c);
    Thread.unlock(mutex);
    TuiLoop.wake;
end;

proc text(s: []const U8; _arg: ^U8);
begin
    post(said, s, "", "", false);
end;

(* Who speaks from now on, the front's speaker: kept for what is posted,
   and a worker's model told, for its label. *)
proc speaker(n: INT; model: []const U8; _arg: ^U8);
begin
    Thread.lock(mutex);
    speaking := n;
    Thread.unlock(mutex);
    if (n > 0) and (LEN(model) > 0) then post(named, model, "", "", false); end;
end;

proc call(name, args: []const U8; _arg: ^U8);
begin
    post(called, name, args, "", false);
end;

proc result(_name, res: []const U8; _arg: ^U8);
begin
    post(answered, res, "", "", false);
end;

proc note(s: []const U8; _arg: ^U8);
begin
    post(told, s, "", "", false);
end;

proc show*(s: []const U8; bad: BOOL; _arg: ^U8);
begin
    if bad then post(failed, s, "", "", false); else post(shown, s, "", "", false); end;
end;

(* The status line made again, from the job's thread: the session is
   the job's while it runs. Its facts are left in posted for the loop,
   its text goes in the event, for the viewers. *)
proc counted(_arg: ^U8);
begin
    Thread.lock(mutex);
    Asession.facts(session^, posted);
    fresh := true;
    Buf.reset(made);
    Asession.text(posted, made);
    Thread.unlock(mutex);
    post(Sort.status, Buf.bytes(made), session^.conv.title, "", false);
end;

proc stopped: BOOL;
var s: BOOL;
begin
    Thread.lock(mutex);
    s := stopping;
    Thread.unlock(mutex);
    return s;
end;

(* Whether the loop has ended, and no one is there to answer. *)
proc gone: BOOL;
var g: BOOL;
begin
    Thread.lock(mutex);
    g := ending;
    Thread.unlock(mutex);
    return g;
end;

(* The answer the loop writes, a byte. *)
proc answer: U8;
var c: [1]U8; n: INT;
begin
    repeat n := Sys.read(answerRead, c); until n # -4;
    if n # 1 then return 'n'; end;
    return c[0];
end;

(* The human asked question, after detail: one of keys. *)
proc ask(q, detail, k: []const U8): U8;
begin
    if gone() then return 0; end;
    post(asked, q, detail, k, false);
    return answer();
end;

(* After a no, why: "" for nothing, and for a no that came of a stop. *)
proc reasoned(): []const U8;
begin
    if gone() or stopped() then return ""; end;
    post(Sort.why, "", "", "", false);
    _ := answer();
    Thread.lock(mutex);
    Buf.reset(because);
    Buf.str(because, Buf.bytes(reason));
    Thread.unlock(mutex);
    return Buf.bytes(because);
end;

(* text as the human left it in their editor, which the loop's thread
   runs (reviseNow), and whether it ran. *)
proc revise(text: []const U8): ([]const U8, BOOL);
var c: U8;
begin
    if gone() or stopped() then return "", false; end;
    post(Sort.revise, text, "", "", false);
    c := answer();
    Thread.lock(mutex);
    Buf.reset(revised);
    Buf.str(revised, Buf.bytes(revision));
    Thread.unlock(mutex);
    return Buf.bytes(revised), c = 'y';
end;

(* The front end a session on the screen tells. *)
proc front*: Agent.Front;
begin
    return {text: text, call: call, result: result, note: note, ask: ask, why: reasoned, stopped: stopped,
        counted: counted, edit: revise, speaker: speaker};
end;

(* c shown again from its start, on the job's thread, which has it: the
   board cleared, then each message as it was told when it came. *)
proc changed*(const c: Astore.Conv; _arg: ^U8);
var m: []Amsg.Msg; calls: []Amsg.Call; i, k: INT;
begin
    post(cleared, "", "", "", false);
    m := Msgs.all(c.msgs);
    for i := 0 to LEN(m) - 1 do
        match m[i].role of
        | user:
            if Apeer.isAsk(m[i].text) then
                post(told, Apeer.shown(m[i].text), "", "", false);
            else
                post(typed, Aattach.shown(m[i].text), "", "", false);
            end;
        | assistant:
            post(said, m[i].text, "", "", false);
            calls := Calls.all(m[i].calls);
            for k := 0 to LEN(calls) - 1 do post(called, calls[k].name, calls[k].args, "", false); end;
        | tool: post(answered, m[i].text, "", "", false);
        end;
    end;
end;

(* A job: the line in job run, or the session prepared if it is "";
   then the status line made again, and the loop told it ended. *)
proc work(_arg: ^U8);
var going: BOOL;
begin
    going := true;
    if asking then
        Asession.ask(session^, editorAsk);
    elsif job.len = 0 then
        Asession.prepare(session^);
    else
        going := Asession.line(session^, Buf.bytes(job));
    end;
    counted(nil);
    post(ended, "", "", "", going);
end;

(* The loop's side *)

(* A job started on line, "" to prepare the session. *)
proc start(line: []const U8);
var err: ERROR;
begin
    Buf.reset(job);
    Buf.str(job, line);
    stopping := false;
    troubled := false;
    Buf.reset(usageText);
    Buf.str(usageText, "as of the start of the turn:\n");
    Asession.usage(session^, usageText);   (* no job runs yet, so the counters are still *)
    Aview.metered(Buf.bytes(usageText));
    Aview.busied(true);
    thread, err := Thread.spawn(work, nil);
    if err # nil then
        thread := nil;
        Aview.busied(false);
        Aview.noted(Aboard.error, MSG(err));
    end;
end;

(* c written to the pipe a job waits on for its answer. *)
proc reply(c: U8);
var b: [1]U8;
begin
    b[0] := c;
    Aview.waiting("", false);
    _ := Sys.write(answerWrite, b);
end;

(* A question asked: its keys, and the one that is no, the first that
   isn't y, which the hint shows in capitals. *)
proc pose(q, detail, k: []const U8);
var i: INT;
begin
    Buf.reset(keys);
    Buf.str(keys, k);
    no := 'n';
    for i := 0 to LEN(k) - 1 do
        if k[i] # 'y' then no := k[i]; break; end;
    end;
    Buf.reset(question);
    Fmt.write(question, "{} [", [Fmt.str(q)]);
    for i := 0 to LEN(k) - 1 do
        if i > 0 then Buf.add(question, '/'); end;
        if k[i] = no then Buf.add(question, k[i] - 'a' + 'A'); else Buf.add(question, k[i]); end;
    end;
    Buf.add(question, ']');
    if LEN(detail) > 0 then Aboard.detail(detail); end;
    Aview.waiting("the terminal", true);
    back := 0;
end;

(* C-c, or a viewer's cancel: the turn stopped, the queue kept; with
   the turn stopping already, or none running, the queue emptied. *)
proc interrupt;
begin
    if (thread # nil) and not stopped() then
        Thread.lock(mutex);
        stopping := true;
        Thread.unlock(mutex);
        Buf.str(flash, "stopping");
    elsif LEN(Aview.queue()) > 0 then
        Aview.clearQueue;
        Buf.str(flash, "queue emptied");
    end;
end;

(* The queue, the human's lines and the viewers', run: a viewer's
   cancel heard, then, with no job and no hold, the next line started;
   then the queue as it is now told. *)
proc runQueue;
var line: Buf.Buf;
begin
    if Aview.cancelled() then interrupt(); end;
    Buf.init(line, Heap.heap);
    defer Buf.done(line);
    while (thread = nil) and not Aview.held() and Aview.heard(line) do
        Aview.typed(Buf.bytes(line));
        back := 0;
        start(Buf.bytes(line));
    end;
    Aview.settle;
end;

(* The ask a is put in the input, as a reference to its lines, after
   what is typed there. *)
proc inputReference(const a: Apeer.Ask);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.str(b, TuiEdit.text(SYSTEM.ADR(editor)));
    if (b.len > 0) and (Buf.bytes(b)[b.len - 1] # ' ') then Buf.add(b, ' '); end;
    Apeer.reference(a, b);
    Buf.add(b, ' ');
    TuiEdit.setText(SYSTEM.ADR(editor), Buf.bytes(b));
end;

(* What editors asked, taken as the session can: a question, or a new
   conversation, only with no job running, its job begun, as an ask and
   not as the human's own message; lines to be asked about put in the
   input. *)
proc takeAsks;
var a: Apeer.Ask;
begin
    while Apeer.take(a, thread = nil) do
        if a.fresh and (LEN(a.question) = 0) then start("/new"); end;
        if LEN(a.question) = 0 then
            inputReference(a);
            Apeer.free(a);
        else
            editorAsk := a;
            asking := true;
            start("ask");
            if thread = nil then Apeer.free(editorAsk); asking := false; end;
        end;
    end;
end;

(* A socket of a viewer, or of an editor, or the session's, is ready. *)
proc viewReady;
begin
    Aview.serviceAll();
    Apeer.serviceAll(thread # nil);
    runQueue();
    takeAsks();
end;

(* The fd of a viewer is to be watched by the loop, or no longer. *)
proc watching(fd: INT; on: BOOL): BOOL;
begin
    if on then return TuiLoop.watch(fd, viewReady); end;
    TuiLoop.unwatch(fd);
    return true;
end;

(* The notice of what changed from old to the facts shown, a mode or
   the safety, on the rule for NoticeTime: what the mode is for, or
   what the safety does. *)
proc noticed(const old: Asession.Facts);
var m: INT;
begin
    m := INT(facts.mode);
    Buf.reset(notice);
    if facts.mode # old.mode then
        Fmt.write(notice, "{}: {}", [Fmt.str(Aprompt.Modes[m].name), Fmt.str(Aprompt.Modes[m].hint)]);
        noticeStyle := TuiScreen.style(ModeRoles[m], {TuiScreen.Attr.bold});
    elsif facts.staged = old.staged then
        return;
    elsif facts.staged then
        Buf.str(notice, "auto: changes made on a copy, one diff a turn to apply");
        noticeStyle := TuiScreen.style(Term.good, {TuiScreen.Attr.bold});
    else
        Buf.str(notice, "safe: each change asked");
        noticeStyle := TuiScreen.style(Term.warn, {TuiScreen.Attr.bold});
    end;
    TuiLoop.after(NoticeTime);
end;

(* The facts f shown from now on, and f given the ones shown before,
   swapped, not copied; what changed is noticed once the session is
   prepared. *)
proc restate(var f: Asession.Facts);
var old: Asession.Facts;
begin
    old := facts;
    facts := f;
    f := old;
    if prepared then noticed(f); end;
end;

(* The status line made again from the session, on the loop's thread,
   with no job running, and told the viewers. *)
proc remade;
var f: Asession.Facts; b: Buf.Buf;
begin
    Asession.initFacts(f);
    defer Asession.doneFacts(f);
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Asession.facts(session^, f);
    Asession.text(f, b);
    Aview.stated(Buf.bytes(b), session^.conv.title);
    restate(f);
end;

proc reviseNow(text: []const U8); forward;

(* What a job told, taken from the queue into the board. *)
proc woken;
var e: []Event; i: INT; finished: BOOL;
begin
    finished := false;
    Thread.lock(mutex);
    e := Events.all(events);
    for i := 0 to LEN(e) - 1 do
        Aboard.speak(e[i].who);
        match e[i].sort of
        | said: Aview.said(Buf.bytes(e[i].a)); troubled := false;
        | called: Aview.called(Buf.bytes(e[i].a), Buf.bytes(e[i].b)); back := 0; troubled := false;
        | answered: Aview.answered(Buf.bytes(e[i].a)); troubled := false;
        | told, shown: Aview.noted(Aboard.info, Buf.bytes(e[i].a)); back := 0;
        | failed: Aview.noted(Aboard.error, Buf.bytes(e[i].a)); back := 0; troubled := true;
        | typed: Aview.typed(Buf.bytes(e[i].a));
        | cleared: Aview.cleared(); back := 0;
        | asked: pose(Buf.bytes(e[i].a), Buf.bytes(e[i].b), Buf.bytes(e[i].c));
        | Sort.why: TuiLine.start(SYSTEM.ADR(why), " why not? ", "", nil);
        | revise:
            Buf.reset(toRevise);
            Buf.str(toRevise, Buf.bytes(e[i].a));
            revising := true;
        | Sort.status:
            if fresh then restate(posted); fresh := false; end;
            Aview.stated(Buf.bytes(e[i].a), Buf.bytes(e[i].b));
        | named: Aboard.name(e[i].who, Buf.bytes(e[i].a));
        | ended:
            finished := true;
            Buf.reset(flash);
            if not e[i].going then TuiLoop.stop; end;
        end;
        Buf.done(e[i].a);
        Buf.done(e[i].b);
        Buf.done(e[i].c);
    end;
    Aboard.speak(0);
    Events.reset(events);
    Thread.unlock(mutex);
    (* the editor runs with the queue let go: reviseNow takes the mutex
       to leave its answer, and the job may tell more meanwhile *)
    if revising then
        revising := false;
        reviseNow(Buf.bytes(toRevise));
    end;
    if finished and (thread # nil) then
        Thread.join(thread);
        thread := nil;
        Aview.busied(false);
        Aview.waiting("", false);
        Aview.listed(Asession.models(session^));
        if asking then
            Apeer.free(editorAsk);
            asking := false;
        end;
        if mode >= 0 then
            session^.agent.mode := Aprompt.Mode(mode);
            mode := -1;
            remade();
        end;
        prepared := true;
        (* a job that ended on a stop or an error holds the queue until RET *)
        Aview.hold(stopping or troubled);
        runQueue();
        takeAsks();
    end;
end;

(* The timer: first, the first job, once the loop runs (before, a wake
   would be lost); after, the end of the notice's time. *)
proc tick;
begin
    if not begun then begun := true; start(""); return; end;
    Buf.reset(notice);
end;

(* the commands *)

(* line sent to the session this screen shows, as a message. *)
proc tellSession(fields: [][]const U8);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Aframe.pack(b, fields);
    if not Aframe.sendSocket(viewFd, Buf.bytes(b)) then viewEnded := true; TuiLoop.stop; end;
end;

(* The view, as a name, into b: all, lead or wN. *)
proc viewName(var b: Buf.Buf);
begin
    if Aboard.view = Aboard.All then Buf.str(b, "all");
    elsif Aboard.view = 0 then Buf.str(b, "lead");
    else Fmt.write(b, "w{}", [Fmt.int(Aboard.view)]);
    end;
end;

(* /view: whose entries the transcript shows, as arg says, lead, all or
   a worker's number, from its end; with none, which it shows. The
   screen's own, so an attached one chooses for itself, while a turn
   runs too. *)
proc chooseView(arg: []const U8);
var n: I64; ok: BOOL;
begin
    if LEN(arg) = 0 then
        Buf.str(flash, "view ");
        viewName(flash);
        return;
    end;
    n, ok := Str.toInt(arg);
    if arg = "all" then Aboard.choose(Aboard.All);
    elsif arg = "lead" then Aboard.choose(0);
    elsif ok and (n > 0) then Aboard.choose(INT(n));
    else Buf.str(flash, "/view lead, all or a worker's number"); return;
    end;
    back := 0;
end;

(* /usage while a job runs: the counters as they stood when it began,
   the job owning the live ones. *)
proc usageDuringJob;
begin
    Aview.usageAsked;
    back := 0;
end;

proc send(_n: INT);
var s: []const U8;
begin
    s := Str.trim(TuiEdit.text(SYSTEM.ADR(editor)));
    if (s = "/usage") and not viewing and (thread # nil) then
        Ahistory.add(s);
        usageDuringJob;
        TuiEdit.setText(SYSTEM.ADR(editor), "");
        return;
    end;
    if (s = "/view") or Str.hasPrefix(s, "/view ") then
        Ahistory.add(s);
        chooseView(Str.trim(s[LEN("/view")..LEN(s)]));
        TuiEdit.setText(SYSTEM.ADR(editor), "");
        return;
    end;
    if LEN(s) = 0 then
        (* RET on an empty input lets a held queue go, here or where the session runs *)
        if viewing and not viewBusy and (LEN(Aview.queue()) > 0) then tellSession(["line", ""]); end;
        if not viewing and Aview.held() then Aview.enqueue(""); runQueue(); end;
        return;
    end;
    Ahistory.add(s);
    back := 0;
    if viewing and ((s = "/quit") or (s = "/exit")) then
        TuiLoop.stop;
    elsif viewing then
        tellSession(["line", s]);
    elsif (thread = nil) and (LEN(Aview.queue()) = 0) then
        Aview.typed(s);
        start(s);
    else
        Aview.enqueue(s);
        runQueue();
    end;
    TuiEdit.setText(SYSTEM.ADR(editor), "");
end;

(* C-c: the turn stopped, or the queue emptied (interrupt); with no turn,
   the input emptied too. Attached, the session is told to. *)
proc stop(_n: INT);
begin
    if viewing then
        if viewBusy or (LEN(Aview.queue()) > 0) then tellSession(["cancel"]); end;
        if viewBusy then Buf.str(flash, "stopping"); return; end;
    else
        interrupt();
        Aview.settle;
        if thread # nil then return; end;
    end;
    TuiEdit.setText(SYSTEM.ADR(editor), "");
    Ahistory.reset;
end;

proc quit(n: INT);
begin
    if (thread = nil) and (LEN(TuiEdit.text(SYSTEM.ADR(editor))) = 0) then TuiLoop.stop; return; end;
    _ := TuiMap.run("edit-delete-char", n);
end;

(* The next mode, now, or after the job running. *)
proc nextMode(_n: INT);
var m: INT;
begin
    if viewing then return; end;
    m := mode;
    if m < 0 then m := INT(session^.agent.mode); end;
    m := (m + 1) mod LEN(Aprompt.Modes);
    if thread = nil then
        session^.agent.mode := Aprompt.Mode(m);
        remade();
    else
        mode := m;
        Fmt.write(flash, "mode {} from the next turn", [Fmt.str(Aprompt.Modes[m].name)]);
    end;
end;

proc toggle(_n: INT);
begin
    Aboard.toggle;
end;

proc toggleAll(_n: INT);
begin
    Aboard.toggleAll;
end;

(* The next view: all, the lead's, each worker's. *)
proc nextView(_n: INT);
begin
    Aboard.cycle;
    back := 0;
end;

(* The transcript scrolled back n rows, or forward if n is negative; a
   page is the screen less the input, the rule and the status line. *)
proc scroll(n: INT);
begin
    back := back + n;
    if back < 0 then back := 0; end;
end;

proc pageUp(n: INT);
begin
    scroll(n * (TuiLoop.theScreen()^.rows - 4));
end;

proc pageDown(n: INT);
begin
    scroll(-n * (TuiLoop.theScreen()^.rows - 4));
end;

proc lineUp(n: INT);
begin
    scroll(n);
end;

proc lineDown(n: INT);
begin
    scroll(-n);
end;

proc copyMode(_n: INT);
begin
    Acopy.start(TuiLoop.theScreen()^.cols, view, back);
end;

proc redraw(_n: INT);
begin
    TuiScreen.redraw(TuiLoop.theScreen());
end;

(* the history *)

(* The input made s, the point at p, or at its end if p is past it. *)
proc fill(s: []const U8; p: INT);
begin
    TuiEdit.setText(SYSTEM.ADR(editor), s);
    if p < LEN(s) then editor.point := p; end;
end;

(* The line of the input the point is on, and how many there are. *)
proc lineOf: (INT, INT);
begin
    return TuiText.lineOf(SYSTEM.ADR(editor.text), editor.point), TuiText.lines(SYSTEM.ADR(editor.text));
end;

(* On an empty input with lines queued, the last of them taken back
   into the input, to be edited, and true; false if not. Attached, the
   session is told to take it out of its queue. *)
proc takeBack: BOOL;
var q: [][]U8; line: Buf.Buf;
begin
    q := Aview.queue();
    if (LEN(TuiEdit.text(SYSTEM.ADR(editor))) > 0) or (LEN(q) = 0) then return false; end;
    Buf.init(line, Heap.heap);
    defer Buf.done(line);
    if viewing then
        Buf.str(line, q[LEN(q) - 1]);
        tellSession(["unqueue", Buf.bytes(line)]);
    else
        _ := Aview.unqueue(line);
        Aview.settle;
    end;
    fill(Buf.bytes(line), line.len);
    return true;
end;

(* The line before, on the input's first line, or the last queued, on
   an empty input; else a line up. *)
proc historyBack(n: INT);
var s: []const U8; l, _lines: INT; ok: BOOL;
begin
    l, _lines := lineOf();
    if l > 0 then _ := TuiMap.run("edit-previous-line", n); return; end;
    if takeBack() then return; end;
    s, ok := Ahistory.back(TuiEdit.text(SYSTEM.ADR(editor)));
    if ok then fill(s, LEN(s)); end;
end;

(* The line after, on the input's last line; else a line down. *)
proc historyOnward(n: INT);
var s: []const U8; l, lines: INT; ok: BOOL;
begin
    l, lines := lineOf();
    if l < lines - 1 then _ := TuiMap.run("edit-next-line", n); return; end;
    s, ok := Ahistory.onward(TuiEdit.text(SYSTEM.ADR(editor)));
    if ok then fill(s, LEN(s)); end;
end;

(* <up>: a line up in the input; else, on its first line, the
   transcript scrolled back a line, as the wheel sends it: never a
   queued line taken back, which the wheel would do unasked. *)
proc arrowUp(n: INT);
var l, _lines: INT;
begin
    l, _lines := lineOf();
    if l > 0 then _ := TuiMap.run("edit-previous-line", n); return; end;
    lineUp(n);
end;

(* <down>: a line down in the input; on its last, the transcript
   scrolled on a line. *)
proc arrowDown(n: INT);
var l, lines: INT;
begin
    l, lines := lineOf();
    if l < lines - 1 then _ := TuiMap.run("edit-next-line", n); return; end;
    lineDown(n);
end;

(* The line before (dir -1) or after (dir 1) that begins as the input
   does up to the point, which stays where it is. *)
proc prefixed(dir: INT);
var s: []const U8; p: INT; ok: BOOL;
begin
    p := editor.point;
    s, ok := Ahistory.prefixed(TuiEdit.text(SYSTEM.ADR(editor)), TuiEdit.text(SYSTEM.ADR(editor))[0..p], dir);
    if ok then fill(s, p); end;
end;

proc prefixedBack(_n: INT);
begin
    prefixed(-1);
end;

proc prefixedOnward(_n: INT);
begin
    prefixed(1);
end;

(* The newest line at or before from that holds the query, in the
   input, the point on what matched; failing if there is none. *)
proc seek(from: INT);
var i, k: INT; s: []const U8;
begin
    failing := false;
    if query.len = 0 then return; end;
    i, s, k := Ahistory.search(Buf.bytes(query), from, TuiEdit.text(SYSTEM.ADR(editor)));
    if i < 0 then failing := true; return; end;
    found := i;
    fill(s, k);
end;

proc searchBack(_n: INT);
begin
    searching := true;
    failing := false;
    Buf.reset(query);
    Buf.reset(saved);
    Buf.str(saved, TuiEdit.text(SYSTEM.ADR(editor)));
    found := Ahistory.count();
end;

(* A key while C-r searches: true if it was the search's; false if it
   ended the search, and is to do what it does. *)
proc searchKey(ev: TuiKeys.Event): BOOL;
var c: [4]U8; n: INT; s: []const U8;
begin
    if ev.key = TuiKeys.ctrl('r') then
        seek(found - 1);
    elsif (ev.key = TuiKeys.ctrl('g')) or (ev.key = TuiKeys.Esc) then
        searching := false;
        fill(Buf.bytes(saved), LEN(Buf.bytes(saved)));
        Ahistory.reset;
    elsif (ev.key = TuiKeys.Backspace) or (ev.key = TuiKeys.ctrl('h')) then
        s := Buf.bytes(query);
        if LEN(s) > 0 then
            _, n := Str.decodeLast(s);
            query.len := query.len - n;
            seek(Ahistory.count());
        end;
    elsif ev.key = TuiKeys.Paste then
        Buf.str(query, ev.paste);
        seek(found);
    elsif TuiKeys.printable(ev.key) then
        c, n := Str.encode(I32(ev.key));
        Buf.str(query, c[0..n]);
        seek(found);
    else
        searching := false;
        return false;
    end;
    return true;
end;

(* C-v: an @path to the clipboard's image typed in, blanks around it
   keeping it a reference of its own; or why there is none, on the
   rule. *)
proc pasteImage(_n: INT);
var path, t: Buf.Buf; s: []const U8; p: INT;
begin
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    if not Aattach.paste(path, flash) then return; end;
    Buf.init(t, Heap.heap);
    defer Buf.done(t);
    s := TuiEdit.text(SYSTEM.ADR(editor));
    p := editor.point;
    if (p > 0) and (s[p - 1] # ' ') and (s[p - 1] # '\n') and (s[p - 1] # '(') then Buf.add(t, ' '); end;
    Fmt.write(t, "@{}", [Fmt.str(Buf.bytes(path))]);
    if (p >= LEN(s)) or (s[p] # ' ') and (s[p] # '\n') then Buf.add(t, ' '); end;
    TuiEdit.paste(SYSTEM.ADR(editor), Buf.bytes(t));
end;

(* completion *)

(* The menu made again for the input, if it changed. *)
proc refresh;
var s: []const U8;
begin
    s := TuiEdit.text(SYSTEM.ADR(editor));
    if (Buf.bytes(looked) = s) and (lookedAt = editor.point) then return; end;
    Buf.reset(looked);
    Buf.str(looked, s);
    lookedAt := editor.point;
    hidden := false;
    menu := [];
    chosen := 0;
    wordA, wordB := Acomplete.token(s, editor.point);
    if wordA < 0 then return; end;
    (* attached, the session's models as it told them; a job has the
       session: its models as they were listed when the last job ended *)
    if viewing or (thread # nil) then
        menu := Acomplete.complete(s[wordA..wordB], Aview.modelsListed());
    else
        menu := Acomplete.complete(s[wordA..wordB], Asession.models(session^));
    end;
end;

(* Whether the menu is shown. *)
proc offered: BOOL;
begin
    return (LEN(menu) > 0) and not hidden and (question.len = 0) and not why.open and not searching;
end;

(* The word being typed made the item chosen. *)
proc take;
var b: Buf.Buf; s: []const U8;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    s := TuiEdit.text(SYSTEM.ADR(editor));
    Buf.str(b, s[0..wordA]);
    Buf.str(b, menu[chosen].text);
    Buf.str(b, s[wordB..LEN(s)]);
    fill(Buf.bytes(b), wordA + LEN(menu[chosen].text));
end;

(* A key while the menu is shown: true if it was the menu's. *)
proc menuKey(ev: TuiKeys.Event): BOOL;
var k: INT; s: []const U8;
begin
    k := ev.key;
    if k = TuiKeys.Tab then
        take();
    elsif k = TuiKeys.Enter then
        take();
        s := TuiEdit.text(SYSTEM.ADR(editor));
        if Str.hasPrefix(s, "/") and not Str.hasSuffix(s, " ") then send(1); end;
    elsif (k = TuiKeys.ctrl('n')) or (k = TuiKeys.Down) then
        chosen := (chosen + 1) mod LEN(menu);
    elsif (k = TuiKeys.ctrl('p')) or (k = TuiKeys.Up) then
        chosen := (chosen + LEN(menu) - 1) mod LEN(menu);
    elsif k = TuiKeys.Esc then
        hidden := true;
    else
        return false;
    end;
    return true;
end;

(* The menu drawn on the rows above row r, the one chosen reversed. *)
proc drawMenu(s: ^TuiScreen.Screen; r: INT);
var n, first, i, w, col, row: INT; st: TuiScreen.Style;
begin
    n := LEN(menu);
    if n > MaxMenu then n := MaxMenu; end;
    if n > r then n := r; end;
    first := 0;
    if chosen >= n then first := chosen - n + 1; end;
    w := 0;
    for i := first to first + n - 1 do
        if TuiScreen.columns(menu[i].text) > w then w := TuiScreen.columns(menu[i].text); end;
    end;
    if w > s^.cols div 2 then w := s^.cols div 2; end;
    for i := first to first + n - 1 do
        row := r - n + i - first;
        st := TuiScreen.style(Term.line, {});
        if i = chosen then st := TuiScreen.style(Term.select, {}); end;
        TuiScreen.fill(s, row, 0, s^.cols, TuiScreen.Plain);
        TuiScreen.fill(s, row, 2, s^.cols - 2, st);
        col := TuiScreen.putTo(s, row, 3, 3 + w, menu[i].text, st);
        _ := TuiScreen.putTo(s, row, 5 + w, s^.cols - 1, menu[i].desc, st);
        _ := col;
    end;
end;

(* the editor *)

(* The last exchange as text, for the editor to show below the input:
   from the human's last message on, the message quoted as mail is, a
   reply as it was written, a call its line; arno's own lines left
   out. Nothing if nothing has been said. *)
proc exchange(var b: Buf.Buf);
var e: []Aboard.Entry; i, first: INT; s, line: []const U8; ok: BOOL;
begin
    e := Aboard.all();
    first := LEN(e) - 1;
    while (first >= 0) and (e[first].kind # Aboard.user) do DEC(first); end;
    if first < 0 then return; end;
    for i := first to LEN(e) - 1 do
        s := Buf.bytes(e[i].text);
        match e[i].kind of
        | user:
            repeat
                line, s, ok := Str.cut(s, "\n");
                Fmt.write(b, "\n> {}", [Fmt.str(line)]);
            until not ok;
            Buf.add(b, '\n');
        | reply: if LEN(Str.trim(s)) > 0 then Fmt.write(b, "\n{}\n", [Fmt.str(Str.trim(s))]); end;
        | tool:
            line := Buf.bytes(e[i].args);
            if LEN(line) > 100 then line := line[0..100]; end;
            Fmt.write(b, "\n\u{25B8} {} ", [Fmt.str(s)]);
            Str.replace(b, line, "\n", " ");
            Buf.add(b, '\n');
        | error: Fmt.write(b, "\n{}\n", [Fmt.str(s)]);
        | info:
        end;
    end;
end;

(* C-x C-e: the input written in the editor, the last exchange below
   the scissors line; what is above it comes back. *)
(* text edited in $VISUAL or $EDITOR, as C-x C-e edits the input, for a
   job's revise: what the editor left, and whether it ran, the answer;
   the input as it was before. *)
proc reviseNow(text: []const U8);
var mine: Buf.Buf; ok: BOOL;
begin
    Buf.init(mine, Heap.heap);
    defer Buf.done(mine);
    Buf.str(mine, TuiEdit.text(SYSTEM.ADR(editor)));
    TuiEdit.setText(SYSTEM.ADR(editor), text);
    ok := TuiEdit.external(SYSTEM.ADR(editor));
    Thread.lock(mutex);
    Buf.reset(revision);
    if ok then Buf.str(revision, TuiEdit.text(SYSTEM.ADR(editor))); end;
    Thread.unlock(mutex);
    fill(Buf.bytes(mine), LEN(Buf.bytes(mine)));
    if not ok then Buf.str(flash, "the editor failed or was quit; the plan is as it was"); end;
    if ok then reply('y'); else reply('n'); end;
end;

proc external(_n: INT);
var b, last: Buf.Buf; s: []const U8; k: INT;
begin
    if thread # nil then Buf.str(flash, "the editor waits until the reply is in"); return; end;
    Buf.reset(saved);
    Buf.str(saved, TuiEdit.text(SYSTEM.ADR(editor)));
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.init(last, Heap.heap);
    defer Buf.done(last);
    Buf.str(b, Buf.bytes(saved));
    exchange(last);
    if last.len > 0 then
        Fmt.write(b, "\n\n{}\n# Not sent: this line and all below it are dropped. The last exchange:\n{}",
            [Fmt.str(Scissors), Fmt.str(Buf.bytes(last))]);
    end;
    TuiEdit.setText(SYSTEM.ADR(editor), Buf.bytes(b));
    if not TuiEdit.external(SYSTEM.ADR(editor)) then
        fill(Buf.bytes(saved), LEN(Buf.bytes(saved)));
        Buf.str(flash, "the editor failed or was quit; the input is as it was");
        return;
    end;
    (* only a whole line is the scissors: a sentence may quote it *)
    Buf.reset(b);
    Fmt.write(b, "\n{}\n", [Fmt.str(TuiEdit.text(SYSTEM.ADR(editor)))]);
    s := Buf.bytes(b);
    k := Str.find(s, "\n" + Scissors + "\n");
    if k >= 0 then s := s[0..k]; end;
    s := Str.trimRight(s[1..LEN(s)]);
    fill(s, LEN(s));
end;

(* A key while a question is asked: one of its keys answers, C-c, C-d,
   Esc and RET are no, C-c stopping the turn too, and the keys that
   move the transcript move it. C-d is no rather than what it is on
   the input, as a turn runs and it would delete a character there.
   <up> and <down> scroll too, not recall history: they are what the
   wheel sends on the alternate screen, and a plan is read by it. *)
proc answering(ev: TuiKeys.Event);
var k: INT;
begin
    k := ev.key;
    if (k >= 'A') and (k <= 'Z') then k := k - 'A' + 'a'; end;
    if (k > 0) and (k < 128) and (Str.find(Buf.bytes(keys), [U8(k)]) >= 0) then
        reply(U8(k));
    elsif (k = TuiKeys.ctrl('c')) or (k = TuiKeys.ctrl('d')) or (k = TuiKeys.Esc) or (k = TuiKeys.Enter) then
        if k = TuiKeys.ctrl('c') then stop(1); end;
        reply(no);
    elsif (k = TuiKeys.Up) or (k = TuiKeys.ctrl('p')) then
        lineUp(1);
        return;
    elsif (k = TuiKeys.Down) or (k = TuiKeys.ctrl('n')) then
        lineDown(1);
        return;
    else
        if not TuiKeys.printable(k) then _ := TuiMap.feed(SYSTEM.ADR(reader), SYSTEM.ADR(map), k); end;
        return;
    end;
    Buf.reset(question);
end;

proc key(ev: TuiKeys.Event);
var out: TuiLine.Outcome;
begin
    (* C-z stops arno as a shell does, whatever is on the screen;
       fg brings it back, drawn whole *)
    if ev.key = TuiKeys.ctrl('z') then
        TuiLoop.suspend;
        return;
    end;
    Buf.reset(flash);
    if why.open then
        (* Esc leaves it as C-g does, as it leaves a question *)
        out := TuiLine.givenUp;
        if ev.key # TuiKeys.Esc then out := TuiLine.key(SYSTEM.ADR(why), ev); end;
        if out # TuiLine.going then
            why.open := false;
            Thread.lock(mutex);
            Buf.reset(reason);
            if out = TuiLine.taken then Buf.str(reason, TuiLine.value(SYSTEM.ADR(why))); end;
            Thread.unlock(mutex);
            reply('.');
            TuiEdit.focus(SYSTEM.ADR(editor));
        end;
        return;
    end;
    (* copy mode first: entered with M-v under a question, to read a
       plan with its keys, it gives the question back when it ends *)
    if Acopy.active() then
        if not Acopy.key(ev) then
            Buf.str(flash, Acopy.saying());
            TuiEdit.focus(SYSTEM.ADR(editor));
        end;
        return;
    end;
    (* drawn after, as after any key: a scroll would wait for the next output *)
    if question.len > 0 then
        answering(ev);
        refresh();
        return;
    end;
    if searching and searchKey(ev) then return; end;
    if offered() and not TuiMap.busy(SYSTEM.ADR(reader)) and menuKey(ev) then refresh(); return; end;
    if ev.key = TuiKeys.Paste then
        TuiEdit.paste(SYSTEM.ADR(editor), ev.paste);
    else
        map.parent := TuiEdit.keymap(SYSTEM.ADR(editor));
        if TuiMap.feed(SYSTEM.ADR(reader), SYSTEM.ADR(map), ev.key) = TuiMap.unbound then
            _ := TuiEdit.typeKey(SYSTEM.ADR(editor), ev.key);
        end;
    end;
    refresh();
end;

(* text said at the start of the rule, row r, in st, a blank each side,
   short of right: the column after. *)
proc said(s: ^TuiScreen.Screen; r, right: INT; text: []const U8; st: TuiScreen.Style): INT;
var col: INT;
begin
    col := TuiScreen.putTo(s, r, 0, right, " ", TuiScreen.Plain);
    col := TuiScreen.putTo(s, r, col, right, text, st);
    return TuiScreen.putTo(s, r, col, right, " ", TuiScreen.Plain);
end;

(* The rule on row r: what is going on, then a line, then how far the
   transcript is scrolled back; or the line a reason is typed on. *)
proc rule(s: ^TuiScreen.Screen; r: INT);
var col, right: INT; d: Buf.Buf;
begin
    if why.open then TuiLine.draw(SYSTEM.ADR(why), s, r, 0); return; end;
    if Acopy.active() and Acopy.rule(s, r) then return; end;
    Buf.init(d, Heap.heap);
    defer Buf.done(d);
    if back > 0 then Fmt.write(d, " \u{2191}{} ", [Fmt.int(back)]); end;
    right := s^.cols - TuiScreen.columns(Buf.bytes(d));
    col := 0;
    if Acopy.active() then
        col := TuiScreen.putTo(s, r, 0, right, " COPY ", TuiScreen.style(Term.warn, {TuiScreen.Attr.bold}));
        if LEN(Acopy.saying()) > 0 then
            col := TuiScreen.putTo(s, r, col, right, Acopy.saying(), TuiScreen.style(Term.bad, {}));
            col := TuiScreen.putTo(s, r, col, right, " ", TuiScreen.Plain);
        end;
    elsif question.len > 0 then
        col := said(s, r, right, Buf.bytes(question), TuiScreen.style(Term.warn, {TuiScreen.Attr.bold}));
    elsif searching then
        col := TuiScreen.putTo(s, r, 0, right, " history", TuiScreen.style(Term.info, {}));
        if failing then col := TuiScreen.putTo(s, r, col, right, ", failing", TuiScreen.style(Term.bad, {})); end;
        col := TuiScreen.putTo(s, r, col, right, ": ", TuiScreen.style(Term.info, {}));
        col := TuiScreen.putTo(s, r, col, right, Buf.bytes(query), TuiScreen.style(Term.strong, {}));
        col := TuiScreen.putTo(s, r, col, right, " ", TuiScreen.Plain);
    elsif flash.len > 0 then
        col := said(s, r, right, Buf.bytes(flash), TuiScreen.style(Term.good, {TuiScreen.Attr.bold}));
    elsif notice.len > 0 then
        col := said(s, r, right, Buf.bytes(notice), noticeStyle);
    elsif Aview.held() and (thread = nil) and not viewBusy then
        col := TuiScreen.putTo(s, r, 0, right, " queue held \u{B7} RET runs it \u{B7} ^C empties it ",
            TuiScreen.style(Term.warn, {}));
    elsif (thread # nil) or viewBusy then
        col := TuiScreen.putTo(s, r, 0, right, " \u{25CF} working \u{B7} ^C stops ", TuiScreen.style(Term.info, {}));
    end;
    while col < right do col := TuiScreen.put(s, r, col, "\u{2500}", TuiScreen.style(Term.line, {})); end;
    _ := TuiScreen.put(s, r, right, Buf.bytes(d), TuiScreen.style(Term.dim, {}));
end;

(* text in st from col on the status line, the last row of s; with s
   nil, only measured. The column after it. *)
proc piece(s: ^TuiScreen.Screen; col: INT; text: []const U8; st: TuiScreen.Style): INT;
begin
    if s = nil then return col + TuiScreen.columns(text); end;
    return TuiScreen.put(s, s^.rows - 1, col, text, st);
end;

(* The mode as a pill from col: its name in capitals, bold, on its
   colour. *)
proc pill(s: ^TuiScreen.Screen; col: INT): INT;
var b: Buf.Buf; m: INT;
begin
    m := INT(facts.mode);
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Fmt.write(b, " {} ", [Fmt.str(Aprompt.Modes[m].name)]);
    Str.upper(Buf.bytes(b));
    return piece(s, col, Buf.bytes(b), TuiScreen.style(ModeRoles[m], {TuiScreen.Attr.bold, TuiScreen.Attr.reverse}));
end;

(* The context in use from col: a bar of Bar cells and the percent of
   the model's window, green, yellow from 60%, when /compact is due,
   red from 85%; where the window is unknown, the count alone. *)
proc meter(s: ^TuiScreen.Screen; col: INT): INT;
var b: Buf.Buf; role: Term.Role; i, n: INT;
begin
    col := piece(s, col, "ctx ", TuiScreen.style(Term.dim, {}));
    if facts.fill < 0 then return piece(s, col, Buf.bytes(facts.context), TuiScreen.Plain); end;
    role := Term.good;
    if facts.fill >= 85 then role := Term.bad; elsif facts.fill >= 60 then role := Term.warn; end;
    n := (facts.fill * Bar + 50) div 100;
    if n > Bar then n := Bar; end;
    for i := 1 to n do col := piece(s, col, "\u{25B0}", TuiScreen.style(role, {})); end;
    for i := n + 1 to Bar do col := piece(s, col, "\u{25B1}", TuiScreen.style(Term.dim, {})); end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Fmt.write(b, " {}%", [Fmt.int(facts.fill)]);
    return piece(s, col, Buf.bytes(b), TuiScreen.style(role, {}));
end;

(* The title from col, cut with an ellipsis to end by limit: the column
   after. Measured, it takes MinTitle columns at most, as it is cut to
   the room the other parts leave it. *)
proc titled(s: ^TuiScreen.Screen; col, limit: INT): INT;
var t: []const U8; w: INT; st: TuiScreen.Style;
begin
    t := Buf.bytes(facts.title);
    w := TuiScreen.columns(t);
    st := TuiScreen.style(Term.text, {TuiScreen.Attr.italic});
    if s = nil then
        if w > MinTitle then w := MinTitle; end;
        return col + w;
    end;
    if col + w <= limit then return piece(s, col, t, st); end;
    col := TuiScreen.putTo(s, s^.rows - 1, col, limit - 1, t, st);
    return piece(s, col, "\u{2026}", st);
end;

(* The view from col, unless it is all, so that a filtered transcript
   is never taken for the whole: the column after. *)
proc viewed(s: ^TuiScreen.Screen; col: INT): INT;
var b: Buf.Buf;
begin
    if Aboard.view = Aboard.All then return col; end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.str(b, "view ");
    viewName(b);
    return piece(s, col + Near, Buf.bytes(b), TuiScreen.style(Term.warn, {TuiScreen.Attr.bold}));
end;

(* The count of lines queued from col, if any are, held or not: the
   column after. *)
proc queued(s: ^TuiScreen.Screen; col: INT): INT;
var b: Buf.Buf; role: Term.Role;
begin
    if LEN(Aview.queue()) = 0 then return col; end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Fmt.write(b, "{} queued", [Fmt.int(LEN(Aview.queue()))]);
    role := Term.info;
    if Aview.held() then Buf.str(b, ", held"); role := Term.warn; end;
    return piece(s, col + Near, Buf.bytes(b), TuiScreen.style(role, {TuiScreen.Attr.bold}));
end;

(* The status line's parts but the hints, those in shown and the mode,
   safety, plan, view and queue always, Gap apart from column 0, the title ending by
   limit: the column after them. With s nil, only measured. *)
proc parts(s: ^TuiScreen.Screen; shown: Parts; limit: INT): INT;
var col: INT; dim: TuiScreen.Style;
begin
    dim := TuiScreen.style(Term.dim, {});
    col := pill(s, 0);
    if facts.staged then
        col := piece(s, col + 1, "\u{25CF} auto", TuiScreen.style(Term.good, {}));
    else
        col := piece(s, col + 1, "\u{25C6} safe", TuiScreen.style(Term.warn, {}));
    end;
    if (facts.mode = Aprompt.build) and facts.approved then
        col := piece(s, col + Near, "plan \u{2713}", TuiScreen.style(Term.good, {}));
    elsif facts.mode = Aprompt.build then
        col := piece(s, col + Near, "plan ?", TuiScreen.style(Term.warn, {}));
    end;
    col := viewed(s, col);
    col := queued(s, col);
    if Part.model in shown then
        col := piece(s, col + Gap, Buf.bytes(facts.model), TuiScreen.style(Term.strong, {}));
        if Part.provider in shown then col := piece(s, col, " @ ", dim); col := piece(s, col, Buf.bytes(facts.provider), dim); end;
    end;
    if Part.context in shown then
        col := meter(s, col + Gap);
        if facts.full then col := piece(s, col + 1, "/compact", TuiScreen.style(Term.bad, {TuiScreen.Attr.bold})); end;
    end;
    if (Part.usage in shown) and (facts.usage.len > 0) then
        col := piece(s, col + Gap, Buf.bytes(facts.usage), dim);
        if facts.cost.len > 0 then col := piece(s, col, " \u{B7} ", dim); col := piece(s, col, Buf.bytes(facts.cost), dim); end;
    end;
    if (Part.title in shown) and (facts.title.len > 0) then
        col := titled(s, col + Gap, limit);
    end;
    return col;
end;

(* The status line on the last row: the parts that fit cols, the
   least needed left out first, and the hints at the right if there is
   room; the title is cut to the room between them. Attached, the session's own status line, as it sent it. *)
proc bottom(s: ^TuiScreen.Screen);
var shown: Parts; p: Part; col, w, limit: INT;
begin
    w := TuiScreen.columns(Hints);
    if viewing then
        col := piece(s, 0, " ATTACHED ", TuiScreen.style(Term.strong, {TuiScreen.Attr.bold, TuiScreen.Attr.reverse}));
        col := viewed(s, col);
        col := queued(s, col);
        col := piece(s, col + 1, Buf.bytes(viewStatus), TuiScreen.Plain);
        if col + Gap + w < s^.cols then _ := piece(s, s^.cols - w - 1, Hints, TuiScreen.style(Term.dim, {})); end;
        return;
    end;
    shown := {Part.hints, Part.title, Part.usage, Part.provider, Part.context, Part.model};
    for p := Part.hints to Part.model do
        col := parts(nil, shown, 0);
        if Part.hints in shown then col := col + Gap + w + 1; end;
        if col <= s^.cols then break; end;
        shown := shown - {p};
    end;
    limit := s^.cols;
    if Part.hints in shown then
        limit := s^.cols - w - 1 - Gap;
        _ := piece(s, limit + Gap, Hints, TuiScreen.style(Term.dim, {}));
    end;
    _ := parts(s, shown, limit);
end;

(* The queue on the rows from r, q of them, dim, a line each, under
   the prompt as the input is: the first of each line, cut to the row. *)
proc drawQueue(s: ^TuiScreen.Screen; r, q: INT);
var lines: [][]U8; i: INT; first: []const U8; dim: TuiScreen.Style;
begin
    lines := Aview.queue();
    dim := TuiScreen.style(Term.dim, {});
    for i := 0 to q - 1 do
        first, _, _ := Str.cut(lines[i], "\n");
        _ := TuiScreen.put(s, r + i, 0, Prompt, dim);
        _ := TuiScreen.putTo(s, r + i, 2, s^.cols, first, dim);
    end;
end;

proc draw(s: ^TuiScreen.Screen);
var n, q, v: INT;
begin
    n := TuiEdit.rows(SYSTEM.ADR(editor), s^.cols - 2);
    if n > MaxInput then n := MaxInput; end;
    q := LEN(Aview.queue());
    if q > MaxQueued then q := MaxQueued; end;
    if q > s^.rows - n - 3 then q := s^.rows - n - 3; end;
    if q < 0 then q := 0; end;
    v := s^.rows - n - q - 2;
    if v < 1 then v := 1; end;
    view := v;
    if Acopy.active() then
        back := Acopy.draw(s, {row: 0, col: 0, rows: v, cols: s^.cols});
    else
        back := Aboard.draw(s, {row: 0, col: 0, rows: v, cols: s^.cols}, back);
    end;
    if offered() then drawMenu(s, v); end;
    rule(s, v);
    drawQueue(s, v + 1, q);
    _ := TuiScreen.put(s, v + q + 1, 0, Prompt, TuiScreen.style(Term.accent, {TuiScreen.Attr.bold}));
    TuiEdit.draw(SYSTEM.ADR(editor), s, {row: v + q + 1, col: 2, rows: n, cols: s^.cols - 2},
        (question.len = 0) and not why.open and not Acopy.active());
    bottom(s);
end;

proc define;
begin
    TuiMap.define("arno-send", "the input sent: a message to the model, or a command", send);
    TuiMap.define("arno-stop", "the turn stopped, or with none the input emptied", stop);
    TuiMap.define("arno-quit", "arno ended, on an empty input; else the character deleted", quit);
    TuiMap.define("arno-mode", "the next mode", nextMode);
    TuiMap.define("arno-toggle", "the newest tool call opened or closed", toggle);
    TuiMap.define("arno-toggle-all", "every tool call opened or closed", toggleAll);
    TuiMap.define("arno-view", "the next view: all, the lead's, each worker's", nextView);
    TuiMap.define("arno-page-up", "the transcript scrolled back a page", pageUp);
    TuiMap.define("arno-page-down", "the transcript scrolled on a page", pageDown);
    TuiMap.define("arno-line-up", "the transcript scrolled back a line", lineUp);
    TuiMap.define("arno-line-down", "the transcript scrolled on a line", lineDown);
    TuiMap.define("arno-redraw", "the screen drawn again", redraw);
    TuiMap.define("arno-up", "a line up in the input; on its first line, the transcript scrolled back", arrowUp);
    TuiMap.define("arno-down", "a line down in the input; on its last line, the transcript scrolled on", arrowDown);
    TuiMap.define("arno-history-back", "the line sent before, on the input's first line; else a line up",
        historyBack);
    TuiMap.define("arno-history-onward", "the line sent after, on the input's last line; else a line down",
        historyOnward);
    TuiMap.define("arno-prefixed-back", "the line sent before that begins as the input does", prefixedBack);
    TuiMap.define("arno-prefixed-onward", "the line sent after that begins as the input does", prefixedOnward);
    TuiMap.define("arno-search-back", "the lines sent searched, newest first", searchBack);
    TuiMap.define("arno-copy", "copy mode, a cursor on the transcript", copyMode);
    TuiMap.define("arno-paste-image", "an @path to the clipboard's image typed in", pasteImage);
    TuiMap.define("arno-external", "the input written in $VISUAL or $EDITOR", external);
    TuiMap.init(SYSTEM.ADR(map), "arno", nil);
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "RET", "arno-send");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "M-RET", "edit-newline");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "C-c", "arno-stop");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "C-d", "arno-quit");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "<backtab>", "arno-mode");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "TAB", "arno-toggle");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "C-o", "arno-toggle-all");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "M-o", "arno-view");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "<prior>", "arno-page-up");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "<next>", "arno-page-down");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "S-<up>", "arno-line-up");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "S-<down>", "arno-line-down");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "C-l", "arno-redraw");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "<up>", "arno-up");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "C-p", "arno-history-back");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "<down>", "arno-down");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "C-n", "arno-history-onward");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "M-p", "arno-prefixed-back");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "M-n", "arno-prefixed-onward");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "C-r", "arno-search-back");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "C-x C-e", "arno-external");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "C-v", "arno-paste-image");
    _ := TuiMap.bind(SYSTEM.ADR(map), TuiKeys.emacs, "M-v", "arno-copy");
end;

(* The session s run on the screen until the human ends it: false, at
   once, if there is no terminal. s was made with front's procedures
   and show, and changed. A job still running at the end is told to
   stop, its questions answered no, and waited for. *)
proc run*(s: ^Asession.Session): BOOL;
var ran: BOOL;
begin
    session := s;
    answerRead, answerWrite := Sys.pipe();
    TuiEdit.init(SYSTEM.ADR(editor), false);
    TuiEdit.focus(SYSTEM.ADR(editor));
    TuiLine.init(SYSTEM.ADR(why));
    define();
    mode := -1;
    Fmt.write(made, "{}history", [Fmt.str(Astore.dir())]);
    Ahistory.load(Buf.bytes(made));
    Buf.reset(made);
    Fmt.write(made, "arno \u{B7} {} via {} \u{B7} /help for commands", [Fmt.str(s^.conf.prov.model),
        Fmt.str(s^.conf.prov.name)]);
    Aview.noted(Aboard.info, Buf.bytes(made));
    remade();
    Aview.listed(Asession.models(session^));
    Aview.owning("terminal", Afence.zone);
    Aview.watching(watching);
    if Aview.listen() then _ := TuiLoop.watch(Aview.listenFd(), viewReady); end;
    Apeer.watching(watching);
    if Apeer.listen() then _ := TuiLoop.watch(Apeer.listenFd(), viewReady); end;
    TuiLoop.after(0);
    ran := TuiLoop.run({key: key, draw: draw, woken: woken, tick: tick});
    if thread # nil then
        Thread.lock(mutex);
        stopping := true;
        ending := true;
        Thread.unlock(mutex);
        if (question.len > 0) or why.open then reply(no); end;
        Thread.join(thread);
    end;
    Aview.unlisten();
    Apeer.unlisten();
    Aattach.drop;
    return ran;
end;

(* The session's socket has something: its messages applied to the
   board, or its end noted. *)
proc viewRead;
var chunk: [16384]U8; n, used: INT; f: Fields.Vec;
begin
    n := Sys.read(viewFd, chunk);
    if n = -4 then return; end;
    if n <= 0 then viewEnded := true; TuiLoop.stop; return; end;
    Buf.str(viewIn, chunk[0..n]);
    Fields.init(f, Heap.heap);
    defer Fields.done(f);
    used := Aframe.take(Buf.bytes(viewIn), f);
    while used > 0 do
        Aview.apply(Fields.all(f), viewStatus, viewBusy);
        Aframe.drop(viewIn, used);
        used := Aframe.take(Buf.bytes(viewIn), f);
    end;
    if used < 0 then viewEnded := true; TuiLoop.stop; return; end;
end;

(* The screen of the session on fd, a connection Aview.attach made: its
   transcript and what is typed in it, the session running elsewhere.
   The first is false if the terminal can't be used; the second whether
   the session ended, not the human leaving. *)
proc attach*(fd: INT): (BOOL, BOOL);
var ran: BOOL;
begin
    viewing := true;
    viewFd := fd;
    TuiEdit.init(SYSTEM.ADR(editor), false);
    TuiEdit.focus(SYSTEM.ADR(editor));
    TuiLine.init(SYSTEM.ADR(why));
    define();
    mode := -1;
    Fmt.write(made, "{}history", [Fmt.str(Astore.dir())]);
    Ahistory.load(Buf.bytes(made));
    Buf.reset(made);
    _ := TuiLoop.watch(fd, viewRead);
    ran := TuiLoop.run({key: key, draw: draw});
    Sys.close(fd);
    Aattach.drop;
    return ran, viewEnded;
end;

proc init;
begin
    Events.init(events, Heap.heap);
    Buf.init(reason, Heap.heap);
    Buf.init(job, Heap.heap);
    Buf.init(usageText, Heap.heap);
    Buf.init(made, Heap.heap);
    Buf.init(because, Heap.heap);
    Buf.init(revision, Heap.heap);
    Buf.init(revised, Heap.heap);
    Buf.init(toRevise, Heap.heap);
    Asession.initFacts(facts);
    Asession.initFacts(posted);
    Buf.init(flash, Heap.heap);
    Buf.init(notice, Heap.heap);
    Buf.init(question, Heap.heap);
    Buf.init(keys, Heap.heap);
    Buf.init(query, Heap.heap);
    Buf.init(saved, Heap.heap);
    Buf.init(looked, Heap.heap);
    Buf.init(viewIn, Heap.heap);
    Buf.init(viewStatus, Heap.heap);
end;

begin
    init();
end Ascreen.
