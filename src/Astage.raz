(* Astage: the stage, a copy of the project the model works on, so that
   a whole turn's changes reach the human as one diff, and one question.

   Edits made one by one, each with its own yes, suit a human watching;
   they do not suit a run left to itself, where every question is
   either answered blind or refused. With the stage up, arno moves into
   a git worktree of the project, in the cache, and makes it the zone:
   there the model's edit, move and remove go ahead without asking, as
   in its scratch directory (Afence.ours), check builds and tests the
   copy, and the human's own tree is not touched. When a turn ends, the
   session asks once, showing everything changed since the last such
   question (changes); a yes applies it to the human's tree (apply), a
   no leaves it in the copy, to be asked about again after the next
   turn, or dropped (drop).

     the human's tree    root          the copy        stage = zone
            |                              |
            |  up: every file not          |
            |  ignored, as it stands ----> |   base, the tree it began as
            |                              |   the model edits here
            |  <---- apply: the diff ----- |   changes: base against now

   The copy is the human's tree as it stands, not their last commit:
   their uncommitted changes and their new files not ignored come
   along (up adds them all to a throwaway index and starts the copy
   from that tree), so the model sees what they see, and the diff
   holds only the model's work. Ignored files, such as build output and
   local settings, stay behind. Every git command here runs with hooks
   turned off: making and comparing a copy is arno's business, not the
   repository's.

   Needs git and a repository with at least one commit, since a
   worktree is checked out from one. Nothing is committed: the copy's
   states are trees (write-tree), compared tree to tree, so no ref,
   commit or reflog is left in the human's repository; only objects
   git's gc collects.

   Each command of git runs detached (Arun), with no terminal and no
   display, so that it fails where it would ask. A diff past MaxOut
   bytes is not offered.

   The copy's own .git file, which points at its git directory, is the
   model's to write only with approval (Afence.ours refuses it): git
   reads settings from there that run programs. As a second wall, every
   git command in the copy names the git directory up recorded, and
   turns core.fsmonitor off, rather than trust that file.

   Depends on Afence (the zone, the stage), Astore (where the copy
   lives), Amsg (keep), Arun, Files, Str and Sys. Leaves out what lies outside a git repository
   (a project under another version control has no stage), and what
   shell needs of the copy, which comes with the jail. *)
module Astage;
import Afence, Amsg, Arun, Astore, Buf, Str, Sys, Files, Heap, Fmt, Out, Strs := Vec([]const U8);

const
    MaxOut = 64 * 1024 * 1024;   (* bytes of a diff kept: the largest offered *)
    MaxShort = 1024 * 1024;      (* bytes kept of what any other git command says *)

var
    base: []U8;   (* the tree the copy's changes are counted from, a hash from Heap; "" with no copy *)
    away: []U8;   (* the working directory up left, to go back to *)
    gitDir: []U8; (* the copy's git directory, absolute, as up made it, from Heap; "" with no copy *)

(* git -C dir args, hooks and fsmonitor off, at most max bytes of its
   output and errors added to out, and whether there was more. idx, if
   not "", is the index to use in place of dir's own. In the copy, the
   git directory is the one up recorded. The status is git's. *)
proc gitMax(idx, dir: []const U8; args: [][]const U8; max: INT; var out: Buf.Buf): (INT, BOOL);
var argv, env: Strs.Vec; index, pin: Buf.Buf; j: Arun.Job; status: INT; cut: BOOL; i: INT;
begin
    Strs.init(argv, Heap.heap);
    defer Strs.done(argv);
    Strs.init(env, Heap.heap);
    defer Strs.done(env);
    Buf.init(index, Heap.heap);
    defer Buf.done(index);
    Buf.init(pin, Heap.heap);
    defer Buf.done(pin);
    Strs.push(argv, "git");
    Strs.push(argv, "-C");
    Strs.push(argv, dir);
    if (LEN(gitDir) > 0) and (dir = Afence.stage) then
        Buf.str(pin, "--git-dir=");
        Buf.str(pin, gitDir);
        Strs.push(argv, Buf.bytes(pin));
        Strs.push(argv, "--work-tree=.");
    end;
    Strs.push(argv, "-c");
    Strs.push(argv, "core.hooksPath=/dev/null");
    Strs.push(argv, "-c");
    Strs.push(argv, "core.fsmonitor=false");
    for i := 0 to LEN(args) - 1 do Strs.push(argv, args[i]); end;
    if LEN(idx) > 0 then
        Buf.str(index, "GIT_INDEX_FILE=");
        Buf.str(index, idx);
        Strs.push(env, Buf.bytes(index));
    end;
    j := {args: Strs.all(argv), env: Strs.all(env), detach: true};
    status, cut, _ := Arun.start(j, max, out);   (* no flood limit set, so never flooded *)
    return status, cut;
end;

(* git -C dir args, as gitMax, with room for a short answer. *)
proc git(idx, dir: []const U8; args: [][]const U8; var out: Buf.Buf): INT;
var status: INT;
begin
    status, _ := gitMax(idx, dir, args, MaxShort, out);
    return status;
end;

(* The tree dir's working tree holds, every file not ignored added to
   the index idx first ("" for dir's own): its hash made what tree
   holds. false if git fails, why saying what it said. *)
proc snap(idx, dir: []const U8; var tree, why: Buf.Buf): BOOL;
begin
    Buf.reset(tree);
    Buf.reset(why);
    if git(idx, dir, ["add", "-A"], why) # 0 then return false; end;
    Buf.reset(why);
    if git(idx, dir, ["write-tree"], why) # 0 then return false; end;
    Buf.str(tree, Str.trim(Buf.bytes(why)));
    Buf.reset(why);
    return true;
end;

(* The tree of hash made the one changes counts from. *)
proc setBase(tree: []const U8);
begin
    if LEN(base) > 0 then Str.free(Heap.heap, base); end;
    base := Amsg.keep(tree);
end;

(* b's contents, a git failure's text, without the newline at its end. *)
proc said(b: Buf.Buf): []const U8;
begin
    return Str.trim(Buf.bytes(b));
end;

(* The working directory put in the copy at dir: where it was in the
   human's tree, if that is there, else the copy's top. *)
proc enter(dir: []const U8);
var here, target: Buf.Buf;
begin
    Buf.init(here, Heap.heap);
    defer Buf.done(here);
    Buf.init(target, Heap.heap);
    defer Buf.done(target);
    Afence.resolve(".", here);
    Buf.str(target, dir);
    if Afence.within(Buf.bytes(here), Afence.root) then
        Buf.str(target, Buf.bytes(here)[LEN(Afence.root)..here.len]);
    end;
    if Sys.setWorkDir(Buf.bytes(target)) # 0 then _ := Sys.setWorkDir(dir); end;
end;

(* Back to the human's tree, the copy removed; the working directory
   goes back to where up found it, or to the project's top should that
   be gone. *)
proc down*;
var dir, out: Buf.Buf;
begin
    if LEN(Afence.stage) = 0 then return; end;
    Buf.init(dir, Heap.heap);
    defer Buf.done(dir);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    Buf.str(dir, Afence.stage);
    if (LEN(away) = 0) or (Sys.setWorkDir(away) # 0) then _ := Sys.setWorkDir(Afence.root); end;
    Afence.leaveStage;
    if LEN(gitDir) > 0 then Str.free(Heap.heap, gitDir); end;
    gitDir := gitDir[0..0];
    _ := git("", Afence.root, ["worktree", "remove", "--force", Buf.bytes(dir)], out);
    Astore.wipe(Buf.bytes(dir));
    _ := git("", Afence.root, ["worktree", "prune"], out);
end;

(* Into a copy of the project, made the zone, and the working directory
   moved into it, at the same place in the tree. false if it can't be
   made, why saying why; true, nothing done, if it is up. *)
proc up*(var why: Buf.Buf): BOOL;
var dir, idx, tree, out: Buf.Buf; cwd: []const U8; e: INT; r: Buf.Buf;
begin
    if LEN(Afence.stage) > 0 then return true; end;
    Buf.init(dir, Heap.heap);
    defer Buf.done(dir);
    Buf.init(idx, Heap.heap);
    defer Buf.done(idx);
    Buf.init(tree, Heap.heap);
    defer Buf.done(tree);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    Buf.init(r, Heap.heap);
    defer Buf.done(r);
    Buf.str(r, Afence.root);
    Buf.str(r, "/.git");
    if not Afence.rooted or (Sys.access(Buf.bytes(r), {}) # 0) then
        Fmt.write(why, "{} is not a git repository", [Fmt.str(Afence.root)]);
        return false;
    end;
    _ := Astore.stageDir(dir);
    Buf.str(idx, Buf.bytes(dir));
    Buf.str(idx, ".index");
    Astore.wipe(Buf.bytes(dir));   (* what a run that died left *)
    _ := git("", Afence.root, ["worktree", "prune"], out);
    _ := Sys.remove(Buf.bytes(idx));
    (* HEAD first, so that tracked files that .gitignore matches, added
       by force, stay in the copy; add -A then brings the human's work *)
    if git(Buf.bytes(idx), Afence.root, ["read-tree", "HEAD"], out) # 0 then
        Fmt.write(why, "cannot read the tree: {}", [Fmt.str(said(out))]);
        return false;
    end;
    if not snap(Buf.bytes(idx), Afence.root, tree, out) then
        _ := Sys.remove(Buf.bytes(idx));
        Fmt.write(why, "cannot read the tree: {}", [Fmt.str(said(out))]);
        return false;
    end;
    _ := Sys.remove(Buf.bytes(idx));
    Buf.reset(out);
    if git("", Afence.root, ["worktree", "add", "--detach", "--no-checkout", Buf.bytes(dir), "HEAD"], out) # 0 then
        Fmt.write(why, "cannot make the copy (does the repository have a commit?): {}", [Fmt.str(said(out))]);
        return false;
    end;
    Buf.reset(out);
    if git("", Buf.bytes(dir), ["read-tree", "-u", "--reset", Buf.bytes(tree)], out) # 0 then
        Fmt.write(why, "cannot fill the copy: {}", [Fmt.str(said(out))]);
        Buf.reset(r);
        _ := git("", Afence.root, ["worktree", "remove", "--force", Buf.bytes(dir)], r);
        return false;
    end;
    setBase(Buf.bytes(tree));
    cwd, e := Sys.workDir();
    if e = 0 then
        if LEN(away) > 0 then Str.free(Heap.heap, away); end;
        away := Amsg.keep(cwd);
    end;
    Afence.useStage(Buf.bytes(dir));
    Buf.reset(out);
    if git("", Afence.stage, ["rev-parse", "--absolute-git-dir"], out) # 0 then
        Fmt.write(why, "cannot find the copy's git directory: {}", [Fmt.str(said(out))]);
        down;
        return false;
    end;
    gitDir := Amsg.keep(said(out));
    enter(Afence.stage);
    return true;
end;

(* How many files diff changes, by its "diff --git" headers. *)
proc files(diff: []const U8): INT;
const Header = "\ndiff --git ";
var n, k: INT; rest: []const U8;
begin
    n := 0;
    if Str.hasPrefix(diff, "diff --git ") then n := 1; end;
    rest := diff;
    k := Str.find(rest, Header);
    while k >= 0 do
        INC(n);
        rest := rest[k + 1..LEN(rest)];
        k := Str.find(rest, Header);
    end;
    return n;
end;

(* What the model changed in the copy since base, as one diff, added
   to diff, and how many files that is: 0 if none; -1 if it can't be
   told, why saying why. *)
proc changes*(var diff, why: Buf.Buf): INT;
var cur, got: Buf.Buf; status: INT; cut: BOOL;
begin
    Buf.init(cur, Heap.heap);
    defer Buf.done(cur);
    Buf.init(got, Heap.heap);
    defer Buf.done(got);
    if not snap("", Afence.stage, cur, why) then return -1; end;
    if Buf.bytes(cur) = base then return 0; end;
    status, cut := gitMax("", Afence.stage, ["diff-tree", "-r", "-p", "--binary", "--no-color", "--no-ext-diff",
            "--no-textconv", base, Buf.bytes(cur)], MaxOut, got);
    if status # 0 then
        Buf.str(why, said(got));
        return -1;
    end;
    if cut then
        Fmt.write(why, "the changes are over {} MB, too many to offer", [Fmt.int(MaxOut div 1048576)]);
        return -1;
    end;
    Buf.str(diff, Buf.bytes(got));
    return files(Buf.bytes(got));
end;

(* git apply of diff, in dir (the human's tree or the copy): all or nothing. why says what git said, if it failed. It goes by a
   file, since a program started has no input but /dev/null. *)
proc patch(dir, diff: []const U8; var why: Buf.Buf): BOOL;
var file, out: Buf.Buf; ok: BOOL;
begin
    Buf.init(file, Heap.heap);
    defer Buf.done(file);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    Buf.str(file, Afence.stage);
    Buf.str(file, ".diff");
    if not Files.write(Buf.bytes(file), diff) then
        Fmt.write(why, "cannot write {}", [Fmt.str(Buf.bytes(file))]);
        return false;
    end;
    defer _ := Sys.remove(Buf.bytes(file));
    ok := git("", dir, ["apply", "--binary", Buf.bytes(file)], out) = 0;
    if not ok then Buf.str(why, said(out)); end;
    return ok;
end;

(* diff, from changes, applied to the human's tree. git apply is all or
   nothing: should the human have changed one of the same files
   meanwhile so that a hunk no longer fits, nothing at all changes, and
   the work stays in the copy. The copy then is what changes counts from.
   false if it can't, why saying why. *)
proc apply*(diff: []const U8; var why: Buf.Buf): BOOL;
var cur, out: Buf.Buf;
begin
    Buf.init(cur, Heap.heap);
    defer Buf.done(cur);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    if not snap("", Afence.stage, cur, out) then
        Fmt.write(why, "cannot read the copy: {}", [Fmt.str(said(out))]);
        return false;
    end;
    if not patch(Afence.root, diff, why) then return false; end;
    setBase(Buf.bytes(cur));
    return true;
end;

(* The copy put back to base, what the model changed in it undone. The
   snap first is not for its tree: its add -A puts the files the model
   made into the index, and read-tree -u --reset removes only what the
   index holds, so without it a new file would survive the drop. *)
proc drop*(var why: Buf.Buf): BOOL;
var cur, out: Buf.Buf;
begin
    Buf.init(cur, Heap.heap);
    defer Buf.done(cur);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    if not snap("", Afence.stage, cur, out) then
        Buf.str(why, said(out));
        return false;
    end;
    if git("", Afence.stage, ["read-tree", "-u", "--reset", base], out) # 0 then
        Buf.str(why, said(out));
        return false;
    end;
    return true;
end;

(* A copy lasts as long as its arno, but a conversation can be taken up
   again by another (arno --resume, /load): the work an earlier copy
   held, unapplied, comes back into this one from the conversation's
   stage.diff, on top of base, so that it is offered again with
   whatever the next turn adds. git apply passes over the "# note:"
   lines before the first diff. *)
proc carry*(diff: []const U8; var why: Buf.Buf): BOOL;
begin
    return patch(Afence.stage, diff, why);
end;

(* The module's test, in build/stage, which it makes: a repository of
   one commit, with the human's changes not yet committed. *)

var failed: BOOL;   (* some check did not hold *)

(* Says, if got is not want, that what was wrong, and fails the test. *)
proc expect(what, got, want: []const U8);
begin
    if got = want then return; end;
    Out.str("Astage: ");
    Out.str(what);
    Out.str(": ");
    Out.str(got);
    Out.str(", not ");
    Out.str(want);
    Out.ln;
    failed := true;
end;

(* What the command cmd, run by sh, writes; a failure fails the test. *)
proc sh(cmd: []const U8): []const U8;
var b: Buf.Buf; status: INT;
begin
    Buf.init(b, Heap.heap);
    status := Arun.run(["sh", "-c", cmd], 1000000, b);
    if status # 0 then expect(cmd, "failed", "worked"); end;
    return Str.trim(Buf.bytes(b));
end;

(* "yes" or "no", for expect. *)
proc yes(b: BOOL): []const U8;
begin
    if b then return "yes"; end;
    return "no";
end;

(* The test: see above. *)
proc main*: INT;
var top, human, theirs: Buf.Buf; diff, why, cache: Buf.Buf; n: INT;
begin
    Arun.child();
    Buf.init(top, Heap.heap);
    Buf.init(human, Heap.heap);
    Buf.init(theirs, Heap.heap);
    Buf.init(diff, Heap.heap);
    Buf.init(why, Heap.heap);
    Buf.init(cache, Heap.heap);
    _ := sh("rm -rf build/stage; mkdir -p build/stage/cache build/stage/proj/src");
    _ := sh("cd build/stage/proj && git init -q && printf 'one\\n' > a.txt && printf 'two\\n' > src/b.txt && printf 'kept\\n' > src/k.txt && printf 'forced\\n' > f.o && " +
        "printf '*.o\\n' > .gitignore && git add . && git add -f f.o && git -c user.name=t -c user.email=t@t commit -q -m first && " +
        "printf 'human\\n' >> a.txt && printf 'new\\n' > new.txt && printf 'obj\\n' > x.o");
    Buf.str(top, sh("cd build/stage && pwd"));
    Buf.str(cache, Buf.bytes(top));
    Buf.str(cache, "/cache");
    _ := Sys.setEnv("XDG_CACHE_HOME", Buf.bytes(cache));
    _ := Sys.setEnv("TOP", Buf.bytes(top));
    Buf.str(human, Buf.bytes(top));
    Buf.str(human, "/proj");
    if Sys.setWorkDir("build/stage/proj/src") # 0 then Out.str("Astage: no build/stage\n"); return 1; end;
    Afence.init;

    (* up: the human's tree as it stands, less what is ignored, and the
       working directory in the same place *)
    if not up(why) then expect("up", Buf.bytes(why), ""); return 1; end;
    expect("the zone is the copy", yes(Afence.zone = Afence.stage), "yes");
    expect("the root is the human's", Afence.root, Buf.bytes(human));
    expect("the copy is ours", yes(Afence.ours("a.txt")), "yes");
    Buf.str(theirs, Buf.bytes(human));
    Buf.str(theirs, "/a.txt");
    expect("the human's tree is not", yes(Afence.ours(Buf.bytes(theirs))), "no");
    expect("in the same place", sh("basename $PWD"), "src");
    expect("the human's uncommitted work", sh("cat ../a.txt"), "one\nhuman");
    expect("a new file", sh("cat ../new.txt"), "new");
    expect("ignored files stay behind", sh("test -e ../x.o || echo gone"), "gone");
    expect("but a tracked one, ignored, comes", sh("cat ../f.o"), "forced");
    expect("their own tree untouched", sh("cd $TOP/proj && git status --short | tr '\\n' ' '"),
        "M a.txt ?? new.txt");
    n := changes(diff, why);
    expect("no changes yet", yes(n = 0), "yes");

    (* the copy's .git file, rewritten, is not trusted *)
    _ := sh("printf 'gitdir: /nonexistent\\n' > ../.git");
    n := changes(diff, why);
    expect("a rewritten .git is not trusted", yes(n = 0), "yes");

    (* the model's work is the diff, and the human's is not in it *)
    _ := sh("printf 'model\\n' >> ../a.txt && printf 'fresh\\n' > ../c.txt && rm b.txt");
    Buf.reset(diff);
    n := changes(diff, why);
    expect("three files", yes(n = 3), "yes");
    expect("the model's line", yes(Str.find(Buf.bytes(diff), "+model") >= 0), "yes");
    expect("not the human's", yes(Str.find(Buf.bytes(diff), "+human") >= 0), "no");

    (* apply: the human's tree has it, and nothing is pending *)
    Buf.reset(why);
    if not apply(Buf.bytes(diff), why) then expect("apply", Buf.bytes(why), ""); end;
    expect("applied", sh("cat $TOP/proj/a.txt"), "one\nhuman\nmodel");
    expect("a new file applied", sh("cat $TOP/proj/c.txt"), "fresh");
    expect("a removal applied", sh("test -e $TOP/proj/src/b.txt || echo gone"), "gone");
    Buf.reset(diff);
    n := changes(diff, why);
    expect("nothing pending", yes(n = 0), "yes");

    (* a hunk that fits no more changes nothing, all or nothing *)
    _ := sh("printf 'later\\n' >> ../a.txt");
    Buf.reset(diff);
    n := changes(diff, why);
    expect("one pending", yes(n = 1), "yes");
    _ := sh("printf 'x\\n' > $TOP/proj/a.txt");
    Buf.reset(why);
    expect("apply refused", yes(apply(Buf.bytes(diff), why)), "no");
    expect("so nothing changed", sh("cat $TOP/proj/a.txt"), "x");
    expect("and it is said why", yes(Buf.bytes(why) # ""), "yes");

    (* drop and carry: the work undone, and put back from its diff *)
    _ := sh("printf 'made\\n' > ../c2.txt");
    Buf.reset(why);
    if not drop(why) then expect("drop", Buf.bytes(why), ""); end;
    expect("dropped", sh("cat ../a.txt"), "one\nhuman\nmodel");
    expect("a file made is gone", sh("test -e ../c2.txt || echo gone"), "gone");
    _ := sh("printf 'again\\n' >> ../a.txt");
    Buf.reset(diff);
    n := changes(diff, why);
    Buf.reset(why);
    if not drop(why) then expect("drop again", Buf.bytes(why), ""); end;
    expect("dropped again", sh("tail -n 1 ../a.txt"), "model");
    Buf.reset(why);
    if not carry(Buf.bytes(diff), why) then expect("carry", Buf.bytes(why), ""); end;
    expect("carried", sh("tail -n 1 ../a.txt"), "again");

    (* down: the human's tree, the copy gone *)
    down;
    expect("no stage", yes(LEN(Afence.stage) = 0), "yes");
    expect("the zone is the root again", yes(Afence.zone = Afence.root), "yes");
    expect("back in the tree", sh("basename $PWD"), "src");
    expect("no copy left", sh("ls $TOP/cache/arno/stage | wc -l"), "0");
    if failed then return 1; end;
    return 0;
end;

end Astage.
