(* Astage: the stage, a copy of the project the model works on, so that
   a whole turn's changes reach the human as one diff, and one question.

   Edits made one by one, each with its own yes, suit a human watching;
   they do not suit a run left to itself, where every question is
   either answered blind or refused. With the stage up, arno moves into
   a git worktree of the project, in the cache, and makes it the zone:
   there the model's edit, move and remove go ahead without asking, as
   in its scratch directory (Afence.ours), check builds and tests the
   copy, and the human's own tree is not touched. When a turn ends, the
   session asks once, showing everything changed since the last such
   question (changes); a yes applies it to the human's tree (apply), a
   no leaves it in the copy, to be asked about again after the next
   turn, or dropped (drop).

     the human's tree    root          the copy        stage = zone
            |                              |
            |  up: every file not          |
            |  ignored, as it stands ----> |   base, the tree it began as
            |                              |   the model edits here
            |  <---- apply: the diff ----- |   changes: base against now

   The copy is the human's tree as it stands, not their last commit:
   their uncommitted changes and their new files not ignored come
   along (up adds them all to a throwaway index and starts the copy
   from that tree), so the model sees what they see, and the diff
   holds only the model's work. Ignored files, such as build output and
   local settings, stay behind, but for the dependencies (Deps), which
   come as links to the human's. Every git command here runs with hooks
   turned off: making and comparing a copy is arno's business, not the
   repository's.

   A worker the lead delegates to works in a copy of its own (Work),
   made the same way from the stage's copy as it stands, the lead's
   own unapplied work and all (fork), beside it in the cache as
   PID.wN. For the worker's turn its copy is the stage and the zone, so
   its edits go unasked and its shell and check are jailed there; when
   it ends, the zone is the lead's copy again, the worker's work is
   one diff against where it began (gather), and its copy is removed.
   The lead then brings that diff into its own copy (carry) or not.

     the stage's copy               a worker's copy
            |  fork: as it stands ---> |   its base
            |                          |   the worker edits here
            |  <--- carry: the diff -- |   gather: base against now

   Needs git and a repository with at least one commit, since a
   worktree is checked out from one. Nothing is committed: the copy's
   states are trees (write-tree), compared tree to tree, so no ref,
   commit or reflog is left in the human's repository; only objects
   git's gc collects.

   Each command of git runs detached (Arun), with no terminal and no
   display, so that it fails where it would ask. A diff past MaxOut
   bytes is not offered.

   The copy's own .git file, which points at its git directory, is the
   model's to write only with approval (Afence.ours refuses it): git
   reads settings from there that run programs. As a second wall, every
   git command in a copy names the git directory recorded as it was
   made, and turns core.fsmonitor off, rather than trust that file.

   Depends on Afence (the zone, the stage), Astore (where the copy
   lives), Amsg (keep), Arun, Files, Str and Sys. Leaves out what lies outside a git repository
   (a project under another version control has no stage), and what
   shell needs of the copy, which comes with the jail. *)
module Astage;
import Afence, Amsg, Arun, Astore, Buf, Str, Sys, Files, Heap, Fmt, Out, Strs := Vec([]const U8);

const
    MaxOut = 64 * 1024 * 1024;   (* bytes of a diff kept: the largest offered *)
    MaxShort = 1024 * 1024;      (* bytes kept of what any other git command says *)
    (* The directories of a project's dependencies, ignored by git, so
       left behind by up, which the copy is given as links to the
       human's own: its tests need them. In the jail they are read-only,
       so an install fails there; installing is the human's. *)
    Deps: []const []const U8 = ["node_modules", ".venv", "venv"];
    Excluded: []const []const U8 = [":(exclude)node_modules", ":(exclude).venv", ":(exclude)venv"];   (* Deps as pathspecs *)

type
    (* A worker's copy, made from the stage's copy by fork, and what
       gather needs to put things back. Each string is from Heap. *)
    Work* = record
        dir*: []U8;   (* the copy, resolved *)
        pin: []U8;    (* its git directory, absolute, as fork made it *)
        base: []U8;   (* the tree it began as: the stage's copy then *)
        lead: []U8;   (* the stage's copy, the zone to go back to *)
        back: []U8;   (* the working directory to go back to *)
    end;

var
    base: []U8;   (* the tree the copy's changes are counted from, a hash from Heap; "" with no copy *)
    away: []U8;   (* the working directory up left, to go back to *)
    gitDir: []U8; (* the copy's git directory, absolute, as up made it, from Heap; "" with no copy *)

(* git -C dir args, hooks and fsmonitor off, at most max bytes of its
   output and errors added to out, and whether there was more. idx, if
   not "", is the index to use in place of dir's own. pin, if not "",
   is dir's git directory, a copy's, used in place of what its .git
   file says. The status is git's. *)
proc gitMax(idx, dir, pin: []const U8; args: [][]const U8; max: INT; var out: Buf.Buf): (INT, BOOL);
var argv, env: Strs.Vec; index, gd: Buf.Buf; j: Arun.Job; status: INT; cut: BOOL; i: INT;
begin
    Strs.init(argv, Heap.heap);
    defer Strs.done(argv);
    Strs.init(env, Heap.heap);
    defer Strs.done(env);
    Buf.init(index, Heap.heap);
    defer Buf.done(index);
    Buf.init(gd, Heap.heap);
    defer Buf.done(gd);
    Strs.push(argv, "git");
    Strs.push(argv, "-C");
    Strs.push(argv, dir);
    if LEN(pin) > 0 then
        Buf.str(gd, "--git-dir=");
        Buf.str(gd, pin);
        Strs.push(argv, Buf.bytes(gd));
        Strs.push(argv, "--work-tree=.");
    end;
    Strs.push(argv, "-c");
    Strs.push(argv, "core.hooksPath=/dev/null");
    Strs.push(argv, "-c");
    Strs.push(argv, "core.fsmonitor=false");
    for i := 0 to LEN(args) - 1 do Strs.push(argv, args[i]); end;
    if LEN(idx) > 0 then
        Buf.str(index, "GIT_INDEX_FILE=");
        Buf.str(index, idx);
        Strs.push(env, Buf.bytes(index));
    end;
    j := {args: Strs.all(argv), env: Strs.all(env), detach: true};
    status, cut, _ := Arun.start(j, max, out);   (* no flood limit set, so never flooded *)
    return status, cut;
end;

(* git -C dir args, as gitMax, with room for a short answer. *)
proc git(idx, dir, pin: []const U8; args: [][]const U8; var out: Buf.Buf): INT;
var status: INT;
begin
    status, _ := gitMax(idx, dir, pin, args, MaxShort, out);
    return status;
end;

(* The tree dir's working tree holds, every file not ignored added to
   the index idx first ("" for dir's own): its hash made what tree
   holds. In a copy, pinned to pin, the links to Deps are left out:
   git ignores a directory's name, not a link's. false if git fails,
   why saying what it said. *)
proc snap(idx, dir, pin: []const U8; var tree, why: Buf.Buf): BOOL;
var args: Strs.Vec; i: INT;
begin
    Buf.reset(tree);
    Buf.reset(why);
    Strs.init(args, Heap.heap);
    defer Strs.done(args);
    Strs.push(args, "add");
    Strs.push(args, "-A");
    if LEN(pin) > 0 then
        Strs.push(args, "--");
        Strs.push(args, ".");
        for i := 0 to LEN(Excluded) - 1 do Strs.push(args, Excluded[i]); end;
    end;
    if git(idx, dir, pin, Strs.all(args), why) # 0 then return false; end;
    Buf.reset(why);
    if git(idx, dir, pin, ["write-tree"], why) # 0 then return false; end;
    Buf.str(tree, Str.trim(Buf.bytes(why)));
    Buf.reset(why);
    return true;
end;

(* The tree of hash made the one changes counts from. *)
proc setBase(tree: []const U8);
begin
    if LEN(base) > 0 then Str.free(Heap.heap, base); end;
    base := Amsg.keep(tree);
end;

(* b's contents, a git failure's text, without the newline at its end. *)
proc said(b: Buf.Buf): []const U8;
begin
    return Str.trim(Buf.bytes(b));
end;

(* The working directory put in the copy at dir: where it was under
   from, if that is there, else the copy's top. *)
proc enter(from, dir: []const U8);
var here, target: Buf.Buf;
begin
    Buf.init(here, Heap.heap);
    defer Buf.done(here);
    Buf.init(target, Heap.heap);
    defer Buf.done(target);
    Afence.resolve(".", here);
    Buf.str(target, dir);
    if Afence.within(Buf.bytes(here), from) then
        Buf.str(target, Buf.bytes(here)[LEN(from)..here.len]);
    end;
    if Sys.setWorkDir(Buf.bytes(target)) # 0 then _ := Sys.setWorkDir(dir); end;
end;

(* The copy at dir removed, from the disk and from the repository's
   list of worktrees. *)
proc uproot(dir: []const U8);
var out: Buf.Buf;
begin
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    _ := git("", Afence.root, "", ["worktree", "remove", "--force", dir], out);
    Astore.wipe(dir);
    _ := git("", Afence.root, "", ["worktree", "prune"], out);
end;

(* Back to the human's tree, the copy removed; the working directory
   goes back to where up found it, or to the project's top should that
   be gone. *)
proc down*;
var dir: Buf.Buf;
begin
    if LEN(Afence.stage) = 0 then return; end;
    Buf.init(dir, Heap.heap);
    defer Buf.done(dir);
    Buf.str(dir, Afence.stage);
    if (LEN(away) = 0) or (Sys.setWorkDir(away) # 0) then _ := Sys.setWorkDir(Afence.root); end;
    Afence.leaveStage;
    if LEN(gitDir) > 0 then Str.free(Heap.heap, gitDir); end;
    gitDir := gitDir[0..0];
    uproot(Buf.bytes(dir));
end;

(* Each of Deps the human's tree holds, and the copy, at dir, doesn't,
   given to the copy as a link to theirs. *)
proc linkDeps(dir: []const U8);
var theirs, ours: Buf.Buf; i: INT; f: Sys.Info; e: INT;
begin
    Buf.init(theirs, Heap.heap);
    defer Buf.done(theirs);
    Buf.init(ours, Heap.heap);
    defer Buf.done(ours);
    for i := 0 to LEN(Deps) - 1 do
        Buf.reset(theirs);
        Fmt.write(theirs, "{}/{}", [Fmt.str(Afence.root), Fmt.str(Deps[i])]);
        Buf.reset(ours);
        Fmt.write(ours, "{}/{}", [Fmt.str(dir), Fmt.str(Deps[i])]);
        f, e := Sys.info(Buf.bytes(theirs));
        if (e = 0) and f.dir then
            _, e := Sys.linkInfo(Buf.bytes(ours));
            if e # 0 then _ := Sys.symlink(Buf.bytes(theirs), Buf.bytes(ours)); end;
        end;
    end;
end;

(* A copy made at dir, a worktree of the human's repository holding
   the tree tree, with the dependencies linked: its git directory,
   absolute, added to pin. false if it can't be made, why saying why,
   and nothing left of it. *)
proc plant(dir, tree: []const U8; var pin, why: Buf.Buf): BOOL;
var out: Buf.Buf;
begin
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    if git("", Afence.root, "", ["worktree", "add", "--detach", "--no-checkout", dir, "HEAD"], out) # 0 then
        Fmt.write(why, "cannot make the copy (does the repository have a commit?): {}", [Fmt.str(said(out))]);
        return false;
    end;
    Buf.reset(out);
    if git("", dir, "", ["read-tree", "-u", "--reset", tree], out) # 0 then
        Fmt.write(why, "cannot fill the copy: {}", [Fmt.str(said(out))]);
        uproot(dir);
        return false;
    end;
    Buf.reset(out);
    if git("", dir, "", ["rev-parse", "--absolute-git-dir"], out) # 0 then
        Fmt.write(why, "cannot find the copy's git directory: {}", [Fmt.str(said(out))]);
        uproot(dir);
        return false;
    end;
    Buf.str(pin, said(out));
    linkDeps(dir);
    return true;
end;

(* Into a copy of the project, made the zone, and the working directory
   moved into it, at the same place in the tree. false if it can't be
   made, why saying why; true, nothing done, if it is up. *)
proc up*(var why: Buf.Buf): BOOL;
var dir, idx, tree, out, pin, r: Buf.Buf; cwd: []const U8; e: INT;
begin
    if LEN(Afence.stage) > 0 then return true; end;
    Buf.init(dir, Heap.heap);
    defer Buf.done(dir);
    Buf.init(idx, Heap.heap);
    defer Buf.done(idx);
    Buf.init(tree, Heap.heap);
    defer Buf.done(tree);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    Buf.init(pin, Heap.heap);
    defer Buf.done(pin);
    Buf.init(r, Heap.heap);
    defer Buf.done(r);
    Buf.str(r, Afence.root);
    Buf.str(r, "/.git");
    if not Afence.rooted or (Sys.access(Buf.bytes(r), {}) # 0) then
        Fmt.write(why, "{} is not a git repository", [Fmt.str(Afence.root)]);
        return false;
    end;
    _ := Astore.stageDir(dir);
    Buf.str(idx, Buf.bytes(dir));
    Buf.str(idx, ".index");
    Astore.wipe(Buf.bytes(dir));   (* what a run that died left *)
    _ := git("", Afence.root, "", ["worktree", "prune"], out);
    _ := Sys.remove(Buf.bytes(idx));
    (* HEAD first, so that tracked files that .gitignore matches, added
       by force, stay in the copy; add -A then brings the human's work *)
    if git(Buf.bytes(idx), Afence.root, "", ["read-tree", "HEAD"], out) # 0 then
        Fmt.write(why, "cannot read the tree: {}", [Fmt.str(said(out))]);
        return false;
    end;
    if not snap(Buf.bytes(idx), Afence.root, "", tree, out) then
        _ := Sys.remove(Buf.bytes(idx));
        Fmt.write(why, "cannot read the tree: {}", [Fmt.str(said(out))]);
        return false;
    end;
    _ := Sys.remove(Buf.bytes(idx));
    if not plant(Buf.bytes(dir), Buf.bytes(tree), pin, why) then return false; end;
    setBase(Buf.bytes(tree));
    cwd, e := Sys.workDir();
    if e = 0 then
        if LEN(away) > 0 then Str.free(Heap.heap, away); end;
        away := Amsg.keep(cwd);
    end;
    Afence.useStage(Buf.bytes(dir));
    gitDir := Amsg.keep(Buf.bytes(pin));
    enter(Afence.root, Afence.stage);
    return true;
end;

(* How many files diff changes, by its "diff --git" headers. *)
proc files(diff: []const U8): INT;
const Header = "\ndiff --git ";
var n, k: INT; rest: []const U8;
begin
    n := 0;
    if Str.hasPrefix(diff, "diff --git ") then n := 1; end;
    rest := diff;
    k := Str.find(rest, Header);
    while k >= 0 do
        INC(n);
        rest := rest[k + 1..LEN(rest)];
        k := Str.find(rest, Header);
    end;
    return n;
end;

(* The copy at dir, pinned to pin, from the tree from to the tree now,
   as one diff added to diff, and how many files that is; -1 if it
   can't be told, why saying why. *)
proc compare(dir, pin, from, now: []const U8; var diff, why: Buf.Buf): INT;
var got: Buf.Buf; status: INT; cut: BOOL;
begin
    Buf.init(got, Heap.heap);
    defer Buf.done(got);
    status, cut := gitMax("", dir, pin, ["diff-tree", "-r", "-p", "--binary", "--no-color", "--no-ext-diff",
            "--no-textconv", from, now], MaxOut, got);
    if status # 0 then
        Buf.str(why, said(got));
        return -1;
    end;
    if cut then
        Fmt.write(why, "the changes are over {} MB, too many to offer", [Fmt.int(MaxOut div 1048576)]);
        return -1;
    end;
    Buf.str(diff, Buf.bytes(got));
    return files(Buf.bytes(got));
end;

(* What the model changed in the copy since base, as one diff, added
   to diff, and how many files that is: 0 if none; -1 if it can't be
   told, why saying why. *)
proc changes*(var diff, why: Buf.Buf): INT;
var cur: Buf.Buf;
begin
    Buf.init(cur, Heap.heap);
    defer Buf.done(cur);
    if not snap("", Afence.stage, gitDir, cur, why) then return -1; end;
    if Buf.bytes(cur) = base then return 0; end;
    return compare(Afence.stage, gitDir, base, Buf.bytes(cur), diff, why);
end;

(* git apply of diff, in dir (the human's tree, or the copy pinned to
   pin): all or nothing. why says what git said, if it failed. It goes
   by a file, since a program started has no input but /dev/null. *)
proc patch(dir, pin, diff: []const U8; var why: Buf.Buf): BOOL;
var file, out: Buf.Buf; ok: BOOL;
begin
    Buf.init(file, Heap.heap);
    defer Buf.done(file);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    Buf.str(file, Afence.stage);
    Buf.str(file, ".diff");
    if not Files.write(Buf.bytes(file), diff) then
        Fmt.write(why, "cannot write {}", [Fmt.str(Buf.bytes(file))]);
        return false;
    end;
    defer _ := Sys.remove(Buf.bytes(file));
    ok := git("", dir, pin, ["apply", "--binary", Buf.bytes(file)], out) = 0;
    if not ok then Buf.str(why, said(out)); end;
    return ok;
end;

(* diff, from changes, applied to the human's tree. git apply is all or
   nothing: should the human have changed one of the same files
   meanwhile so that a hunk no longer fits, nothing at all changes, and
   the work stays in the copy. The copy then is what changes counts from.
   false if it can't, why saying why. *)
proc apply*(diff: []const U8; var why: Buf.Buf): BOOL;
var cur, out: Buf.Buf;
begin
    Buf.init(cur, Heap.heap);
    defer Buf.done(cur);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    if not snap("", Afence.stage, gitDir, cur, out) then
        Fmt.write(why, "cannot read the copy: {}", [Fmt.str(said(out))]);
        return false;
    end;
    if not patch(Afence.root, "", diff, why) then return false; end;
    setBase(Buf.bytes(cur));
    return true;
end;

(* The copy put back to base, what the model changed in it undone. The
   snap first is not for its tree: its add -A puts the files the model
   made into the index, and read-tree -u --reset removes only what the
   index holds, so without it a new file would survive the drop. *)
proc drop*(var why: Buf.Buf): BOOL;
var cur, out: Buf.Buf;
begin
    Buf.init(cur, Heap.heap);
    defer Buf.done(cur);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    if not snap("", Afence.stage, gitDir, cur, out) then
        Buf.str(why, said(out));
        return false;
    end;
    if git("", Afence.stage, gitDir, ["read-tree", "-u", "--reset", base], out) # 0 then
        Buf.str(why, said(out));
        return false;
    end;
    return true;
end;

(* diff brought into the copy, on top of what it holds, all or
   nothing: a worker's work, merged, or the work an earlier copy held,
   unapplied. A copy lasts as long as its arno, but a conversation can
   be taken up again by another (arno --resume, /load), and its
   stage.diff comes back this way, to be offered again with whatever
   the next turn adds. git apply passes over the "# note:" lines before
   the first diff. *)
proc carry*(diff: []const U8; var why: Buf.Buf): BOOL;
begin
    return patch(Afence.stage, gitDir, diff, why);
end;

(* Worker n's copy made in w, from the stage's copy as it stands, and
   made the stage and the zone, the working directory moved into it at
   the same place, until gather. false if there is no stage, or the
   copy can't be made, why saying why. *)
proc fork*(n: INT; var w: Work; var why: Buf.Buf): BOOL;
var dir, tree, pin: Buf.Buf; cwd: []const U8; e: INT;
begin
    if LEN(Afence.stage) = 0 then
        Buf.str(why, "there is no stage to copy");
        return false;
    end;
    Buf.init(dir, Heap.heap);
    defer Buf.done(dir);
    Buf.init(tree, Heap.heap);
    defer Buf.done(tree);
    Buf.init(pin, Heap.heap);
    defer Buf.done(pin);
    if not snap("", Afence.stage, gitDir, tree, why) then return false; end;
    Fmt.write(dir, "{}.w{}", [Fmt.str(Afence.stage), Fmt.int(n)]);
    Astore.wipe(Buf.bytes(dir));   (* what a run that died left *)
    if not plant(Buf.bytes(dir), Buf.bytes(tree), pin, why) then return false; end;
    cwd, e := Sys.workDir();
    if e # 0 then cwd := Afence.stage; end;
    w := {pin: Amsg.keep(Buf.bytes(pin)), base: Amsg.keep(Buf.bytes(tree)), lead: Amsg.keep(Afence.stage),
        back: Amsg.keep(cwd)};
    Afence.useStage(Buf.bytes(dir));
    w.dir := Amsg.keep(Afence.stage);
    enter(w.lead, w.dir);
    return true;
end;

(* What git's numstat line, "added removed path", says, added to out
   as "+added -removed path", or "binary path" for a file git counts
   no lines of. *)
proc tallyLine(line: []const U8; var out: Buf.Buf);
var plus, minus, name: []const U8;
begin
    plus, name, _ := Str.cut(line, "\t");
    minus, name, _ := Str.cut(name, "\t");
    if plus = "-" then
        Fmt.write(out, "binary {}\n", [Fmt.str(name)]);
    else
        Fmt.write(out, "+{} -{} {}\n", [Fmt.str(plus), Fmt.str(minus), Fmt.str(name)]);
    end;
end;

(* The worker's work in w, as gather finds it: its diff added to diff,
   a line a file of lines added and removed to stat, and how many files
   changed; -1 if it can't be told, why saying why. *)
proc taken(const w: Work; var diff, stat, why: Buf.Buf): INT;
var cur, out: Buf.Buf; n: INT; line, rest: []const U8;
begin
    Buf.init(cur, Heap.heap);
    defer Buf.done(cur);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    if not snap("", w.dir, w.pin, cur, why) then return -1; end;
    if Buf.bytes(cur) = w.base then return 0; end;
    n := compare(w.dir, w.pin, w.base, Buf.bytes(cur), diff, why);
    if n <= 0 then return n; end;
    if git("", w.dir, w.pin, ["diff-tree", "-r", "--numstat", w.base, Buf.bytes(cur)], out) = 0 then
        rest := said(out);
        while LEN(rest) > 0 do
            line, rest, _ := Str.cut(rest, "\n");
            tallyLine(line, stat);
        end;
    end;
    return n;
end;

(* The worker's turn over: the lead's copy the stage and the zone
   again, the working directory back where fork found it, what the
   worker changed in its copy since fork as taken gives it, and its
   copy removed, w let go. *)
proc gather*(var w: Work; var diff, stat, why: Buf.Buf): INT;
var n: INT;
begin
    Afence.useStage(w.lead);
    if Sys.setWorkDir(w.back) # 0 then _ := Sys.setWorkDir(w.lead); end;
    n := taken(w, diff, stat, why);
    uproot(w.dir);
    Str.free(Heap.heap, w.dir);
    Str.free(Heap.heap, w.pin);
    Str.free(Heap.heap, w.base);
    Str.free(Heap.heap, w.lead);
    Str.free(Heap.heap, w.back);
    w := {};
    return n;
end;

(* The module's test, in build/stage, which it makes: a repository of
   one commit, with the human's changes not yet committed. *)

var failed: BOOL;   (* some check did not hold *)

(* Says, if got is not want, that what was wrong, and fails the test. *)
proc expect(what, got, want: []const U8);
begin
    if got = want then return; end;
    Out.str("Astage: ");
    Out.str(what);
    Out.str(": ");
    Out.str(got);
    Out.str(", not ");
    Out.str(want);
    Out.ln;
    failed := true;
end;

(* What the command cmd, run by sh, writes; a failure fails the test. *)
proc sh(cmd: []const U8): []const U8;
var b: Buf.Buf; status: INT;
begin
    Buf.init(b, Heap.heap);
    status := Arun.run(["sh", "-c", cmd], 1000000, b);
    if status # 0 then expect(cmd, "failed", "worked"); end;
    return Str.trim(Buf.bytes(b));
end;

(* "yes" or "no", for expect. *)
proc yes(b: BOOL): []const U8;
begin
    if b then return "yes"; end;
    return "no";
end;

(* dir's src, for expect. *)
proc src(dir: []const U8): []const U8;
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    Fmt.write(b, "{}/src", [Fmt.str(dir)]);
    return Buf.bytes(b);
end;

(* Workers, with the stage up and its copy holding work not applied,
   the working directory in its src: a worker's copy is the copy as
   it stands, its work comes back as a diff of its own, which carry
   brings into the copy, all or nothing. *)
proc testWorkers;
var w: Work; lead, diff, stat, why: Buf.Buf; n: INT;
begin
    Buf.init(lead, Heap.heap);
    Buf.init(diff, Heap.heap);
    Buf.init(stat, Heap.heap);
    Buf.init(why, Heap.heap);
    Buf.str(lead, Afence.stage);
    if not fork(1, w, why) then expect("fork", Buf.bytes(why), ""); return; end;
    expect("the worker's copy is the zone", yes((Afence.zone = w.dir) and (Afence.stage = w.dir)), "yes");
    expect("and ours", yes(Afence.ours("../a.txt")), "yes");
    expect("the lead's copy is not", yes(Afence.ours(Buf.bytes(lead))), "no");
    expect("in the same place", sh("pwd -P"), src(w.dir));
    expect("the lead's unapplied work comes", sh("tail -n 1 ../a.txt"), "again");
    expect("the dependencies come", sh("test -L ../node_modules && echo linked"), "linked");
    _ := sh("printf 'worker\\n' >> ../a.txt && printf 'w\\n' > ../w.txt");
    n := gather(w, diff, stat, why);
    expect("two files", yes(n = 2), "yes");
    expect("the stage is the lead's again", yes((Afence.stage = Buf.bytes(lead)) and (Afence.zone = Afence.stage)), "yes");
    expect("back in the lead's copy", sh("pwd -P"), src(Buf.bytes(lead)));
    expect("the stat", Buf.bytes(stat), "+1 -0 a.txt\n+1 -0 w.txt\n");
    expect("the worker's own work only", yes(Str.find(Buf.bytes(diff), "+again") >= 0), "no");
    expect("not yet in the lead's", sh("tail -n 1 ../a.txt"), "again");
    expect("the worker's copy removed", sh("ls $TOP/cache/arno/stage | wc -l"), "1");
    Buf.reset(why);
    if not carry(Buf.bytes(diff), why) then expect("merge", Buf.bytes(why), ""); end;
    expect("merged", sh("tail -n 1 ../a.txt && cat ../w.txt"), "worker\nw");

    (* a worker's diff that fits the lead's copy no more changes nothing *)
    Buf.reset(why);
    if not fork(2, w, why) then expect("fork again", Buf.bytes(why), ""); return; end;
    _ := sh("sed -i 's/^worker$/two/' ../a.txt");
    Buf.reset(diff);
    Buf.reset(stat);
    n := gather(w, diff, stat, why);
    expect("one file", yes(n = 1), "yes");
    _ := sh("sed -i 's/^worker$/lead/' ../a.txt");
    Buf.reset(why);
    expect("a merge refused", yes(carry(Buf.bytes(diff), why)), "no");
    expect("so nothing changed", sh("tail -n 1 ../a.txt"), "lead");
end;

(* The test: see above. *)
proc main*: INT;
var top, human, theirs: Buf.Buf; diff, why, cache: Buf.Buf; n: INT;
begin
    Arun.child();
    Buf.init(top, Heap.heap);
    Buf.init(human, Heap.heap);
    Buf.init(theirs, Heap.heap);
    Buf.init(diff, Heap.heap);
    Buf.init(why, Heap.heap);
    Buf.init(cache, Heap.heap);
    _ := sh("rm -rf build/stage; mkdir -p build/stage/cache build/stage/proj/src");
    _ := sh("cd build/stage/proj && git init -q && printf 'one\\n' > a.txt && printf 'two\\n' > src/b.txt && printf 'kept\\n' > src/k.txt && printf 'forced\\n' > f.o && " +
        "printf '*.o\\nnode_modules/\\n' > .gitignore && git add . && git add -f f.o && git -c user.name=t -c user.email=t@t commit -q -m first && " +
        "mkdir -p node_modules/dep && printf 'lib\\n' > node_modules/dep/i.js && printf 'human\\n' >> a.txt && printf 'new\\n' > new.txt && printf 'obj\\n' > x.o");
    Buf.str(top, sh("cd build/stage && pwd"));
    Buf.str(cache, Buf.bytes(top));
    Buf.str(cache, "/cache");
    _ := Sys.setEnv("XDG_CACHE_HOME", Buf.bytes(cache));
    _ := Sys.setEnv("TOP", Buf.bytes(top));
    Buf.str(human, Buf.bytes(top));
    Buf.str(human, "/proj");
    if Sys.setWorkDir("build/stage/proj/src") # 0 then Out.str("Astage: no build/stage\n"); return 1; end;
    Afence.init;

    (* up: the human's tree as it stands, less what is ignored, and the
       working directory in the same place *)
    if not up(why) then expect("up", Buf.bytes(why), ""); return 1; end;
    expect("the zone is the copy", yes(Afence.zone = Afence.stage), "yes");
    expect("the root is the human's", Afence.root, Buf.bytes(human));
    expect("the copy is ours", yes(Afence.ours("a.txt")), "yes");
    Buf.str(theirs, Buf.bytes(human));
    Buf.str(theirs, "/a.txt");
    expect("the human's tree is not", yes(Afence.ours(Buf.bytes(theirs))), "no");
    expect("in the same place", sh("basename $PWD"), "src");
    expect("the human's uncommitted work", sh("cat ../a.txt"), "one\nhuman");
    expect("a new file", sh("cat ../new.txt"), "new");
    expect("ignored files stay behind", sh("test -e ../x.o || echo gone"), "gone");
    expect("but a tracked one, ignored, comes", sh("cat ../f.o"), "forced");
    expect("the dependencies, a link to the human's", sh("cat ../node_modules/dep/i.js && test -L ../node_modules && echo linked"),
        "lib\nlinked");
    expect("their own tree untouched", sh("cd $TOP/proj && git status --short | tr '\\n' ' '"),
        "M a.txt ?? new.txt");
    n := changes(diff, why);
    expect("no changes yet", yes(n = 0), "yes");

    (* the copy's .git file, rewritten, is not trusted *)
    _ := sh("printf 'gitdir: /nonexistent\\n' > ../.git");
    n := changes(diff, why);
    expect("a rewritten .git is not trusted", yes(n = 0), "yes");

    (* the model's work is the diff, and the human's is not in it *)
    _ := sh("printf 'model\\n' >> ../a.txt && printf 'fresh\\n' > ../c.txt && rm b.txt");
    Buf.reset(diff);
    n := changes(diff, why);
    expect("three files", yes(n = 3), "yes");
    expect("the model's line", yes(Str.find(Buf.bytes(diff), "+model") >= 0), "yes");
    expect("not the human's", yes(Str.find(Buf.bytes(diff), "+human") >= 0), "no");

    (* apply: the human's tree has it, and nothing is pending *)
    Buf.reset(why);
    if not apply(Buf.bytes(diff), why) then expect("apply", Buf.bytes(why), ""); end;
    expect("applied", sh("cat $TOP/proj/a.txt"), "one\nhuman\nmodel");
    expect("a new file applied", sh("cat $TOP/proj/c.txt"), "fresh");
    expect("a removal applied", sh("test -e $TOP/proj/src/b.txt || echo gone"), "gone");
    Buf.reset(diff);
    n := changes(diff, why);
    expect("nothing pending", yes(n = 0), "yes");

    (* a hunk that fits no more changes nothing, all or nothing *)
    _ := sh("printf 'later\\n' >> ../a.txt");
    Buf.reset(diff);
    n := changes(diff, why);
    expect("one pending", yes(n = 1), "yes");
    _ := sh("printf 'x\\n' > $TOP/proj/a.txt");
    Buf.reset(why);
    expect("apply refused", yes(apply(Buf.bytes(diff), why)), "no");
    expect("so nothing changed", sh("cat $TOP/proj/a.txt"), "x");
    expect("and it is said why", yes(Buf.bytes(why) # ""), "yes");

    (* drop and carry: the work undone, and put back from its diff *)
    _ := sh("printf 'made\\n' > ../c2.txt");
    Buf.reset(why);
    if not drop(why) then expect("drop", Buf.bytes(why), ""); end;
    expect("dropped", sh("cat ../a.txt"), "one\nhuman\nmodel");
    expect("a file made is gone", sh("test -e ../c2.txt || echo gone"), "gone");
    _ := sh("printf 'again\\n' >> ../a.txt");
    Buf.reset(diff);
    n := changes(diff, why);
    Buf.reset(why);
    if not drop(why) then expect("drop again", Buf.bytes(why), ""); end;
    expect("dropped again", sh("tail -n 1 ../a.txt"), "model");
    Buf.reset(why);
    if not carry(Buf.bytes(diff), why) then expect("carry", Buf.bytes(why), ""); end;
    expect("carried", sh("tail -n 1 ../a.txt"), "again");

    testWorkers;

    (* down: the human's tree, the copy gone *)
    down;
    expect("no stage", yes(LEN(Afence.stage) = 0), "yes");
    expect("the zone is the root again", yes(Afence.zone = Afence.root), "yes");
    expect("back in the tree", sh("basename $PWD"), "src");
    expect("no copy left", sh("ls $TOP/cache/arno/stage | wc -l"), "0");
    if failed then return 1; end;
    return 0;
end;

end Astage.
