(* Arno: a harness for language models in the terminal. This is the
   program:

       arno                         a session, a line of input at a time
       arno PROMPT ...              a new conversation of one turn
       arno --resume ID PROMPT ...  one more turn of the saved one, ID
       arno --serve                 one session for the program that runs it
       arno --attach [PID | -l]     a session run elsewhere, shown here
       arno -h | --help             the usage

   The prompt is the arguments, joined by blanks. ID may also be a
   number from /list, or a word of a title, as /load takes. The turn
   runs with the tools (Agent). The model's text goes to standard
   output as it comes; ^C stops it, keeping what came. Each tool call, and what came
   of it, goes to standard error, a line each, and so does a question
   for the human, a path outside the project or a change to a file,
   after the change's diff; the answer is a line of standard input: y,
   n, or a for always; anything else, or the end of the input, is no.
   After a no to a change, the next line says why, if it isn't empty.
   The conversation is saved, the turn in it, so that
   --resume goes on from it; what arno says of it, and what goes wrong,
   go to standard error too. The status is 0 for a reply, 1 for a
   request that failed or a conversation not found, 2 for a mistake on
   the command line, 130 for a turn stopped by ^C.

   With no prompt, arno runs a session (Asession): on a terminal, on
   the full screen (Ascreen); else each line of standard input is a
   message to the model, or a command such as /help or /load; what a
   command says goes to standard output, an error to standard error.
   ^C stops a turn, not the session; the end of the input, or /quit,
   ends it. With standard input alone a terminal, a "> " asks for each
   line.

   --serve runs one session for the program that started it, a host
   that speaks the protocol of arno-serve(5) on standard input and output
   (Aserve). --attach shows another arno's session, a terminal's or a
   host's, in this terminal, and types into it (Aview, Ascreen); -l
   lists the sessions: process id, owner, project root and title.
   --version says which arno this is.

   Depends on Asession, Ascreen, Aserve, Aview and Awire. *)
module Arno;
import Asession, Ascreen, Aserve, Aview, Arun, Astore, Awire, Buf, Str, Sys, Files, Out, Heap;
import SYSTEM;

const
    Usage = `
    usage: arno
           arno prompt ...
           arno --resume id prompt ...
           arno --serve
           arno --attach [pid | -l]
           arno -h | --help
           arno --version
    `;
    Version = "arno 0.5.0\n";    (* as the release is tagged, v0.5.0 *)

var stopped: BOOL;

(* ^C, noted by Sys.handle, says to stop the reply; asked by Awire
   after each read, which ^C also breaks into. *)
proc interrupted: BOOL;
begin
    if Sys.came(Sys.sigInt) then stopped := true; end;
    return stopped;
end;

var ended: BOOL;   (* the last piece of the model's text ended its line *)

proc show(text: []const U8; _arg: ^U8);
begin
    Out.str(text);
    Out.flush;
    ended := Str.hasSuffix(text, "\n");
end;

proc say(a, b, c: []const U8);
begin
    _ := Sys.write(Sys.stderr, a);
    _ := Sys.write(Sys.stderr, b);
    _ := Sys.write(Sys.stderr, c);
end;

(* The model's text so far ended with a line feed, so that a line on
   standard error doesn't run on from it on a terminal. *)
proc breakLine;
begin
    if not ended then Out.ln; ended := true; end;
    Out.flush;
end;

(* s's first line, cut to at most max bytes where a character starts. *)
proc line(s: []const U8; max: INT): []const U8;
var n: INT;
begin
    n := Str.find(s, "\n");
    if n >= 0 then s := s[0..n]; end;
    if LEN(s) <= max then return s; end;
    n := max;
    while (n > 0) and (s[n] & 0C0H = 80H) do DEC(n); end;
    return s[0..n];
end;

proc called(name, args: []const U8; _arg: ^U8);
begin
    breakLine;
    say("\u{25B8} ", name, " ");
    say(line(args, 100), "\n", "");
end;

(* A result in a line: a failure's first line, which says why, or how
   many lines came. *)
proc answered(_name, res: []const U8; _arg: ^U8);
var n, i: INT; digits: [20]U8;
begin
    if Str.hasPrefix(res, "error") or Str.hasPrefix(res, "declined") or Str.hasPrefix(res, "not run") then
        say("  ", line(res, 100), "\n");
        return;
    end;
    n := 0;
    for i := 0 to LEN(res) - 1 do
        if res[i] = '\n' then INC(n); end;
    end;
    if (LEN(res) > 0) and (res[LEN(res) - 1] # '\n') then INC(n); end;
    digits, i := Str.fromInt(n);
    if n = 1 then say("  ", digits[0..i], " line\n"); else say("  ", digits[0..i], " lines\n"); end;
end;

proc told(s: []const U8; _arg: ^U8);
begin
    breakLine;
    say("arno: ", s, "\n");
end;

var answer: Buf.Buf;   (* the last line read from standard input *)

(* A line of standard input, without its line feed, into answer; false
   at the end of the input, with nothing read. A ^C while waiting for
   it drops what was typed and waits again. *)
proc readLine: ([]const U8, BOOL);
var c: [1]U8; n: INT;
begin
    Buf.reset(answer);
    while true do
        n := Sys.read(Sys.stdin, c);
        if n = 1 then
            if c[0] = '\n' then break; end;
            Buf.add(answer, c[0]);
        elsif (n < 0) and Sys.came(Sys.sigInt) then
            Buf.reset(answer);
            Out.ln;
            Out.flush;
        else
            return Buf.bytes(answer), answer.len > 0;
        end;
    end;
    return Buf.bytes(answer), true;
end;

(* The human's answer to question, after detail: one of keys, the first
   byte of a line of standard input; 'n' for any other, 0 at its end. *)
proc asked(question, detail, keys: []const U8): U8;
var s: []const U8; more: BOOL;
begin
    breakLine;
    say(detail, question, " [y/N] ");
    s, more := readLine();
    if not more then return 0; end;
    if (LEN(s) > 0) and (Str.find(keys, s[0..1]) >= 0) then return s[0]; end;
    return 'n';
end;

(* After a no, why: the next line of standard input. *)
proc why(): []const U8;
var s: []const U8;
begin
    say("why not? (Enter skips) ", "", "");
    s, _ := readLine();
    return s;
end;

(* What a command says: to standard output; an error to standard
   error. *)
proc shown(s: []const U8; bad: BOOL; _arg: ^U8);
begin
    breakLine;
    if bad then
        say("arno: ", s, "\n");
    else
        Out.str(s);
        Out.ln;
        Out.flush;
    end;
end;

(* The session: a line at a time, until the input ends or /quit. *)
proc session(var s: Asession.Session): INT;
var text: []const U8; tty, more: BOOL;
begin
    tty := Sys.isTerminal(Sys.stdin);
    Asession.prepare(s);
    say("arno · ", s.conf.prov.model, " via ");
    say(s.conf.prov.name, " · /help for commands\n", "");
    while true do
        if tty then say("> ", "", ""); end;
        text, more := readLine();
        if not more then break; end;
        stopped := false;
        ended := true;
        if not Asession.line(s, text) then break; end;
        breakLine;
    end;
    return 0;
end;

(* arno --attach -l: a line for each session, its process id, owner,
   project root and title. *)
proc sessions;
var b: Buf.Buf; rest, one, pid, owner, root, title: []const U8; more: BOOL;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Aview.sessions(b);
    if b.len = 0 then Out.str("no sessions\n"); end;
    rest := Buf.bytes(b);
    more := LEN(rest) > 0;
    while more do
        one, rest, more := Str.cut(rest, "\n");
        if LEN(one) = 0 then continue; end;
        pid, one, _ := Str.cut(one, "\t");
        owner, one, _ := Str.cut(one, "\t");
        root, title, _ := Str.cut(one, "\t");
        Out.str(pid);
        Out.str("\t");
        Out.str(owner);
        Out.str("\t");
        Out.str(root);
        Out.str("\t");
        Out.str(title);
        Out.ln;
    end;
    Out.flush;
end;

(* arno --attach [PID | -l]: the session of PID shown here, or, with
   none, one working in this directory, else the one begun last. *)
proc attach(): INT;
var fd, i: INT; ran, ended: BOOL; pid: []const U8;
begin
    if (ARGC() = 3) and (Files.arg(2) = "-l") then sessions(); return 0; end;
    if ARGC() > 3 then say("arno: --attach takes a pid, or -l\n", "", ""); return 2; end;
    if not (Sys.isTerminal(Sys.stdin) and Sys.isTerminal(Sys.stdout)) then
        say("arno: --attach needs a terminal\n", "", "");
        return 1;
    end;
    pid := "";
    if ARGC() = 3 then pid := Files.arg(2); end;
    for i := 0 to LEN(pid) - 1 do
        if not Str.isDigit(pid[i]) then say("arno: --attach takes a pid, or -l\n", "", ""); return 2; end;
    end;
    fd := Aview.attach(pid);
    if fd < 0 then
        if LEN(pid) = 0 then say("arno: no session to attach to\n", "", "");
        else say("arno: no session ", pid, "\n"); end;
        return 1;
    end;
    ran, ended := Ascreen.attach(fd);
    if not ran then say("arno: the terminal can't be used\n", "", ""); return 1; end;
    if ended then say("arno: the session has ended\n", "", ""); end;
    return 0;
end;

proc main*: INT;
var s: Asession.Session; first, i: INT; prompt, failure: Buf.Buf; err: ERROR;
begin
    Arun.child();
    if (ARGC() >= 2) and ((Files.arg(1) = "-h") or (Files.arg(1) = "--help")) then
        Out.str(Usage);
        return 0;
    end;
    if (ARGC() >= 2) and (Files.arg(1) = "--version") then
        Out.str(Version);
        return 0;
    end;
    first := 1;
    if (ARGC() >= 2) and (Files.arg(1) = "--resume") then first := 3; end;
    if (ARGC() >= 2) and (Files.arg(1) = "--serve") then
        if ARGC() > 2 then say("arno: --serve takes no arguments\n", "", ""); return 2; end;
        Astore.sweep;
        return Aserve.run();
    end;
    if (ARGC() >= 2) and (Files.arg(1) = "--attach") then return attach(); end;
    Buf.init(prompt, Heap.heap);
    for i := first to ARGC() - 1 do
        if i > first then Buf.add(prompt, ' '); end;
        Buf.str(prompt, Files.arg(i));
    end;
    (* an empty prompt is a mistake of the script that made it, a
       prompt file never written, not a question for a model *)
    if (ARGC() >= 2) and (LEN(Str.trim(Buf.bytes(prompt))) = 0) then
        say("arno: no prompt\n", "", "");
        _ := Sys.write(Sys.stderr, Usage);
        return 2;
    end;

    Astore.sweep;
    if (ARGC() < 2) and Sys.isTerminal(Sys.stdin) and Sys.isTerminal(Sys.stdout) then
        Asession.init(SYSTEM.ADR(s), Ascreen.front(), Ascreen.show, nil);
        s.changed := Ascreen.changed;
        defer Asession.leave;
        if Ascreen.run(SYSTEM.ADR(s)) then return 0; end;
        say("arno: the terminal can't be used\n", "", "");
        return 1;
    end;
    Buf.init(answer, Heap.heap);
    Asession.init(SYSTEM.ADR(s), {text: show, call: called, result: answered, note: told, ask: asked, why: why,
        stopped: interrupted}, shown, nil);
    defer Asession.leave;
    _ := Sys.handle(Sys.sigInt);
    ended := true;
    if ARGC() < 2 then return session(s); end;
    if (first = 3) and not Asession.resume(s, Files.arg(2)) then
        say("arno: no conversation ", Files.arg(2), "\n");
        return 1;
    end;
    Asession.prepare(s);
    Buf.init(failure, Heap.heap);
    err := Asession.turn(s, Str.trim(Buf.bytes(prompt)), failure);
    breakLine;
    if err = Awire.Failed then say("arno: ", Buf.bytes(failure), "\n"); end;
    if err = Awire.Stopped then say("arno: stopped\n", "", ""); end;
    say("arno --resume ", s.conv.id, " PROMPT goes on from here\n");
    if err = Awire.Failed then return 1; end;
    if err = Awire.Stopped then return 130; end;
    return 0;
end;

end Arno.
