(* Arno: a harness for language models in the terminal. This is the
   program; for now it asks one question and leaves:

       arno PROMPT ...              a new conversation of one turn
       arno --resume ID PROMPT ...  one more turn of the saved one, ID
       arno -h | --help             the usage

   The prompt is the arguments, joined by blanks. The turn runs with
   the tools (Agent). The model's text goes to standard output as it
   comes; ^C stops it, keeping what came. Each tool call, and what came
   of it, goes to standard error, a line each, and so does a question
   for the human, a path outside the project, whose answer is a line of
   standard input: y, n, or a for always; anything else, or the end of
   the input, is no. The conversation is saved, the turn in it, so that
   --resume goes on from it; what arno says of it, and what goes wrong,
   go to standard error too. The status is 0 for a reply, 1 for a
   request that failed or a conversation not found, 2 for a mistake on
   the command line, 130 for a turn stopped by ^C.

   Depends on Agent, Aconf, Astore, Awire and Amsg. Leaves out, for the
   stages after this one, what the Pascal arno's one-shot run has
   besides: the screen, --serve and --attach. *)
module Arno;
import Agent, Aconf, Astore, Awire, Amsg, Buf, Str, Sys, Files, Out, Heap, Msgs := Vec(Amsg.Msg);

const Usage = `
    usage: arno [prompt ...]
           arno --resume id prompt ...
           arno -h | --help
    `;

var stopped: BOOL;

(* ^C, noted by Sys.handle, says to stop the reply; asked by Awire
   after each read, which ^C also breaks into. *)
proc interrupted: BOOL;
begin
    if Sys.came(Sys.sigInt) then stopped := true; end;
    return stopped;
end;

var ended: BOOL;   (* the last piece of the model's text ended its line *)

proc show(text: []U8; _arg: ^U8);
begin
    Out.str(text);
    Out.flush;
    ended := Str.hasSuffix(text, "\n");
end;

proc say(a, b, c: []U8);
begin
    _ := Sys.write(Sys.stderr, a);
    _ := Sys.write(Sys.stderr, b);
    _ := Sys.write(Sys.stderr, c);
end;

(* The model's text so far ended with a line feed, so that a line on
   standard error doesn't run on from it on a terminal. *)
proc breakLine;
begin
    if not ended then Out.ln; ended := true; end;
    Out.flush;
end;

(* s's first line, cut to at most max bytes where a character starts. *)
proc line(s: []U8; max: INT): []U8;
var n: INT;
begin
    n := Str.find(s, "\n");
    if n >= 0 then s := s[0..n]; end;
    if LEN(s) <= max then return s; end;
    n := max;
    while (n > 0) and (s[n] & 0C0H = 80H) do DEC(n); end;
    return s[0..n];
end;

proc called(name, args: []U8; _arg: ^U8);
begin
    breakLine;
    say("\u{25B8} ", name, " ");
    say(line(args, 100), "\n", "");
end;

(* A result in a line: a failure's first line, which says why, or how
   many lines came. *)
proc answered(_name, res: []U8; _arg: ^U8);
var n, i: INT; digits: [20]U8;
begin
    if Str.hasPrefix(res, "error") or Str.hasPrefix(res, "declined") or Str.hasPrefix(res, "not run") then
        say("  ", line(res, 100), "\n");
        return;
    end;
    n := 0;
    for i := 0 to LEN(res) - 1 do
        if res[i] = '\n' then INC(n); end;
    end;
    if (LEN(res) > 0) and (res[LEN(res) - 1] # '\n') then INC(n); end;
    digits, i := Str.fromInt(n);
    if n = 1 then say("  ", digits[0..i], " line\n"); else say("  ", digits[0..i], " lines\n"); end;
end;

proc told(s: []U8; _arg: ^U8);
begin
    breakLine;
    say("arno: ", s, "\n");
end;

(* The human's answer to question, one of keys: the first byte of a
   line of standard input; 'n' for any other, or for none. *)
proc asked(question, keys: []U8; _arg: ^U8): U8;
var c, first: [1]U8; n: INT;
begin
    breakLine;
    say(question, " [y/N] ", "");
    n := 0;
    while Sys.read(Sys.stdin, c) = 1 do
        if c[0] = '\n' then break; end;
        if n = 0 then first := c; end;
        INC(n);
    end;
    if (n > 0) and (Str.find(keys, first) >= 0) then return first[0]; end;
    return 'n';
end;

proc main*: INT;
var conf: Aconf.Conf; c: Astore.Conv; first, i: INT; prompt, why, id: Buf.Buf; m: ^Amsg.Msg;
    a: Agent.Agent; steps: I64; ok: BOOL; err: ERROR;
begin
    if (ARGC() >= 2) and ((Files.arg(1) = "-h") or (Files.arg(1) = "--help")) then
        Out.str(Usage);
        return 0;
    end;
    first := 1;
    if (ARGC() >= 2) and (Files.arg(1) = "--resume") then first := 3; end;
    if (ARGC() >= 2) and ((Files.arg(1) = "--serve") or (Files.arg(1) = "--attach")) then
        say("arno: ", Files.arg(1), " is not here yet\n");
        return 2;
    end;
    Buf.init(ADR(prompt), Heap.heap);
    for i := first to ARGC() - 1 do
        if i > first then Buf.add(ADR(prompt), ' '); end;
        Buf.str(ADR(prompt), Files.arg(i));
    end;
    (* an empty prompt is a mistake of the script that made it, a
       prompt file never written, not a question for a model *)
    if (ARGC() < 2) or (LEN(Str.trim(Buf.bytes(ADR(prompt)))) = 0) then
        say("arno: no prompt\n", "", "");
        _ := Sys.write(Sys.stderr, Usage);
        return 2;
    end;

    Aconf.load(ADR(conf));
    if conf.warnings.len > 0 then say(Buf.bytes(ADR(conf.warnings)), "", ""); end;
    Buf.init(ADR(id), Heap.heap);
    if first = 3 then
        if Astore.load(ADR(c), Files.arg(2)) # nil then
            say("arno: no conversation ", Files.arg(2), "\n");
            return 1;
        end;
    else
        Astore.newId(ADR(id));
        Astore.init(ADR(c), Buf.bytes(ADR(id)));
    end;
    Astore.setModel(ADR(c), conf.prov.model);
    m := Msgs.add(ADR(c.msgs));
    Amsg.init(m, Amsg.Role.user);
    Amsg.setText(m, Str.trim(Buf.bytes(ADR(prompt))));

    Buf.init(ADR(why), Heap.heap);
    Agent.init(ADR(a), ADR(conf.prov),
        {text: show, call: called, result: answered, note: told, ask: asked, stopped: interrupted});
    steps, ok := Str.toInt(Aconf.get(ADR(conf), "max_steps"));
    if ok and (steps > 0) then a.maxSteps := INT(steps); end;
    _ := Sys.handle(Sys.sigInt);
    ended := true;
    err := Agent.turn(ADR(a), ADR(c), ADR(why));
    breakLine;
    if Astore.save(ADR(c)) # nil then say("arno: the conversation can't be saved in ", Astore.dir(), "\n"); end;
    if err = Awire.Failed then say("arno: ", Buf.bytes(ADR(why)), "\n"); end;
    if err = Awire.Stopped then say("arno: stopped\n", "", ""); end;
    say("arno --resume ", c.id, " PROMPT goes on from here\n");
    if err = Awire.Failed then return 1; end;
    if err = Awire.Stopped then return 130; end;
    return 0;
end;

end Arno.
