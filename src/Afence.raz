(* Afence: where the model's tools may reach without asking.

   The zone is the project the human works in: the nearest directory,
   at most two levels above the working directory, that holds a mark
   of version control (.git, .sauce, .hg, .jj or .svn), or else the
   working directory itself. Two levels, so that a stray .git far up,
   in the home directory say, doesn't make all of it the project.
   Anything under the zone the tools may read; anything else the human
   is asked for, once or for the rest of the run (grant).

   Every path is judged resolved: absolute, with every symbolic link
   followed, so that neither "../../etc" nor a link in the project that
   points out of it passes a test of its prefix. Unlike realpath(3),
   resolve takes a path whose end doesn't exist yet, a file a tool is
   about to make, resolving what exists and taking the rest as it is
   written.

   The module only decides; asking is the caller's, Atools'.

   The conversation's scratch directory, and its artifacts directory,
   where the documents the human asks for are kept, are the model's own:
   inside, and ours, which Atools takes as a change needing no approval. So is the
   stage's copy of the project, while Astage has one up: the zone is then
   the copy, and root still the human's project, which the notes and
   the test command are kept under. Leaves out config's grant.

   Depends on Sys, Buf and Str. *)
module Afence;
import Buf, Str, Sys, Heap, Rt, Out, Strs := Vec([]U8);

const
    Marks: []const []const U8 = [".git", ".sauce", ".hg", ".jj", ".svn"];
    MaxHops = 40;   (* links followed in a path, as the kernel's own ELOOP limit *)

var
    zone*: []const U8;           (* resolved; set by init, and by useStage and leaveStage *)
    root*: []const U8;           (* the human's project, as init found it: the zone, but while the stage is up *)
    stage*: []U8;                (* the stage's copy, resolved, from Heap; "" for none *)
    scratch*: []U8;        (* resolved, from Heap; set by useScratch, "" before *)
    artifacts*: []U8;      (* the conversation's lasting files, resolved, from Heap; set by useArtifacts, "" before *)
    rooted*: BOOL;         (* zone holds a mark, rather than being the bare working directory *)
    grants: Strs.Vec;      (* the directories granted, resolved, each from Heap *)
    ready: BOOL;           (* grants made *)

(* b cut to its last '/': "/a/b" to "/a", and "/a" to "". *)
proc up(var b: Buf.Buf);
var s: []const U8;
begin
    s := Buf.bytes(b);
    b.len := Str.findLast(s, "/");
    if b.len < 0 then b.len := 0; end;
end;

(* path, absolute and with every link followed, made what b holds.
   It goes a part at a time, b the resolved part so far and rest what
   is still to do. ".." goes up from the resolved part, so a/link/..
   is the parent of where link points, as the kernel has it. A part
   that is a link is put back as its target, in front of rest; an
   absolute target starts again from "/". *)
proc resolve*(path: []const U8; var b: Buf.Buf);
var rest, next: Buf.Buf; s, c, t, dir: []const U8; at, i, hops, keep, e: INT;
begin
    Buf.init(rest, Heap.heap);
    defer Buf.done(rest);
    Buf.init(next, Heap.heap);
    defer Buf.done(next);
    if not Str.hasPrefix(path, "/") then
        dir, e := Sys.workDir();
        if e = 0 then Buf.str(rest, dir); end;
        Buf.add(rest, '/');
    end;
    Buf.str(rest, path);
    Buf.reset(b);
    at := 0;
    hops := 0;
    while at < rest.len do
        s := Buf.bytes(rest);
        i := at;
        while (i < LEN(s)) and (s[i] # '/') do INC(i); end;
        c := s[at..i];
        at := i + 1;
        if (LEN(c) = 0) or (c = ".") then continue; end;
        if c = ".." then up(b); continue; end;
        keep := b.len;
        Buf.add(b, '/');
        Buf.str(b, c);
        t, e := Sys.readLink(Buf.bytes(b));
        if (e = 0) and (hops < MaxHops) then
            INC(hops);
            Buf.reset(next);
            Buf.str(next, t);
            Buf.add(next, '/');
            if at < LEN(s) then Buf.str(next, s[at..LEN(s)]); end;
            Buf.reset(rest);
            Buf.str(rest, Buf.bytes(next));
            at := 0;
            b.len := keep;
            if Str.hasPrefix(t, "/") then b.len := 0; end;
        end;
    end;
    if b.len = 0 then Buf.add(b, '/'); end;
end;

(* Whether p is base or below it, both resolved: the '/' after the
   prefix keeps /r/arno2 out of /r/arno. *)
proc within*(p, base: []const U8): BOOL;
begin
    return (base = "/") or (p = base) or Str.hasPrefix(p, base) and (p[LEN(base)] = '/');
end;

proc keep(s: []const U8): []U8;
var c: []U8; ok: BOOL;
begin
    c, ok := Str.copy(Heap.heap, s);
    if not ok then Rt.stop("arno: out of memory"); end;
    return c;
end;

(* Every grant dropped. *)
proc forget*;
var g: [][]U8; i: INT;
begin
    g := Strs.all(grants);
    for i := 0 to LEN(g) - 1 do Str.free(Heap.heap, g[i]); end;
    Strs.reset(grants);
end;

(* The stage's memory let go, and no stage; the zone is not reset. *)
proc dropStage;
begin
    if LEN(stage) > 0 then Str.free(Heap.heap, stage); end;
    stage := stage[0..0];
end;

(* The zone found from the working directory, the stage given up, and the grants dropped. *)
proc init*;
var b, mark: Buf.Buf; levels, m: INT;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.init(mark, Heap.heap);
    defer Buf.done(mark);
    if not ready then Strs.init(grants, Heap.heap); ready := true; end;
    forget;
    dropStage;
    resolve(".", b);
    zone := keep(Buf.bytes(b));
    root := zone;
    rooted := false;
    for levels := 0 to 2 do
        for m := 0 to LEN(Marks) - 1 do
            Buf.reset(mark);
            Buf.str(mark, Buf.bytes(b));
            if b.len > 1 then Buf.add(mark, '/'); end;
            Buf.str(mark, Marks[m]);
            if Sys.access(Buf.bytes(mark), {}) = 0 then
                zone := keep(Buf.bytes(b));
                root := zone;
                rooted := true;
                return;
            end;
        end;
        if b.len = 1 then return; end;
        up(b);
        if b.len = 0 then Buf.add(b, '/'); end;
    end;
end;

(* Whether path is in the zone, in the scratch or artifacts directory, or under a grant. *)
proc inside*(path: []const U8): BOOL;
var b: Buf.Buf; p: []const U8; g: [][]U8; i: INT;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    resolve(path, b);
    p := Buf.bytes(b);
    if within(p, zone) then return true; end;
    if (LEN(scratch) > 0) and within(p, scratch) then return true; end;
    if (LEN(artifacts) > 0) and within(p, artifacts) then return true; end;
    g := Strs.all(grants);
    for i := 0 to LEN(g) - 1 do
        if within(p, g[i]) then return true; end;
    end;
    return false;
end;

(* path, resolved, the conversation's scratch directory from now on;
   the one before it is let go. *)
proc useScratch*(path: []const U8);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    resolve(path, b);
    if LEN(scratch) > 0 then Str.free(Heap.heap, scratch); end;
    scratch := keep(Buf.bytes(b));
end;

(* path, resolved, the conversation's artifacts directory from now on;
   the one before it is let go. *)
proc useArtifacts*(path: []const U8);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    resolve(path, b);
    if LEN(artifacts) > 0 then Str.free(Heap.heap, artifacts); end;
    artifacts := keep(Buf.bytes(b));
end;

(* path, resolved, the stage's copy from now on, and the zone: the
   model works there, and its changes are its own. *)
proc useStage*(path: []const U8);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    resolve(path, b);
    dropStage;
    stage := keep(Buf.bytes(b));
    zone := stage;
end;

(* The stage given up: the zone is the human's project again. *)
proc leaveStage*;
begin
    zone := root;
    dropStage;
end;

(* Whether p, resolved and inside the stage, is its .git or below it. *)
proc gitMark(p: []const U8): BOOL;
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.str(b, stage);
    Buf.str(b, "/.git");
    return within(p, Buf.bytes(b));
end;

(* Whether the file at p, a resolved path, has no name but p: one
   with a second hard link shares its contents with a name elsewhere,
   maybe the human's, and writing it writes theirs. A directory, which
   has a link for each one below it, is alone, as is a name with no
   file yet. *)
proc alone(p: []const U8): BOOL;
var i: Sys.Info; e: INT;
begin
    i, e := Sys.info(p);
    return (e < 0) or i.dir or (i.links <= 1);
end;

(* Whether path is in the scratch or artifacts directory or the
   stage's copy, the model's own, so that a change there needs no approval. It is
   resolved like any path, so a link left there that points out
   doesn't count; nor does a file with a second hard link (alone).
   The stage's own .git, the file that points it at its git
   directory, and all below it are not ours: git reads settings from
   there that run programs (core.fsmonitor), so the model may not
   write it without asking. *)
proc ours*(path: []const U8): BOOL;
var b: Buf.Buf; p: []const U8;
begin
    if (LEN(scratch) = 0) and (LEN(artifacts) = 0) and (LEN(stage) = 0) then return false; end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    resolve(path, b);
    p := Buf.bytes(b);
    if not alone(p) then return false; end;
    if (LEN(scratch) > 0) and within(p, scratch) then return true; end;
    if (LEN(artifacts) > 0) and within(p, artifacts) then return true; end;
    if LEN(stage) = 0 then return false; end;
    return within(p, stage) and not gitMark(p);
end;

(* path, and everything below it, inside for the rest of the run;
   after init. *)
proc grant*(path: []const U8);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    resolve(path, b);
    Strs.push(grants, keep(Buf.bytes(b)));
end;

(* The module's test, in build/fence, which it makes. *)

var failed: BOOL;

proc expect(what, got, want: []const U8);
begin
    if got = want then return; end;
    Out.str("Afence: ");
    Out.str(what);
    Out.str(": ");
    Out.str(got);
    Out.str(", not ");
    Out.str(want);
    Out.ln;
    failed := true;
end;

proc resolved(path: []const U8): []const U8;
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    resolve(path, b);
    return Buf.bytes(b);
end;

(* s and t, joined *)
proc cat(s, t: []const U8): []const U8;
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    Buf.str(b, s);
    Buf.str(b, t);
    return Buf.bytes(b);
end;

proc yes(b: BOOL): []const U8;
begin
    if b then return "yes"; end;
    return "no";
end;

(* A hard link to target made at path, by ln: raz's Sys makes none. *)
proc hardLink(target, path: []const U8): BOOL;
var pid, status: INT; how: Sys.Status;
begin
    pid := Sys.spawn({path: "/usr/bin/ln", args: ["ln", "-f", target, path]});
    if pid < 0 then return false; end;
    _, how, status := Sys.waitExit(pid);
    return (how = Sys.Status.exited) and (status = 0);
end;

(* An empty file made at path. *)
proc touch(path: []const U8);
begin
    Sys.close(Sys.openMode(path, {Sys.writing, Sys.creating}, 1A4H));
end;

proc main*: INT;
var top, dir: []const U8;
begin
    _ := Sys.makeDir("build");
    _ := Sys.makeDir("build/fence");
    _ := Sys.makeDir("build/fence/proj");
    _ := Sys.makeDir("build/fence/proj/.git");
    _ := Sys.makeDir("build/fence/proj/src");
    _ := Sys.makeDir("build/fence/proj2");
    _ := Sys.makeDir("build/fence/out");
    _ := Sys.remove("build/fence/proj/src/out");
    _ := Sys.remove("build/fence/proj/src/up");
    _ := Sys.symlink("../../out", "build/fence/proj/src/out");
    _ := Sys.symlink("/", "build/fence/proj/src/up");
    top := keep(resolved("build/fence"));

    expect("dots", resolved("/a/./b//../c/"), "/a/c");
    expect("above /", resolved("/../.."), "/");
    expect("a link", resolved("build/fence/proj/src/out/x"), cat(top, "/out/x"));
    expect("a link and ..", resolved("build/fence/proj/src/out/.."), top);
    expect("an absolute link", resolved("build/fence/proj/src/up/etc"), "/etc");
    expect("a prefix", yes(within("/r/arno2", "/r/arno")), "no");
    expect("the base", yes(within("/r/arno", "/r/arno")), "yes");

    dir, _ := Sys.workDir();
    dir := keep(dir);
    if Sys.setWorkDir("build/fence/proj/src") # 0 then Out.str("Afence: no build/fence\n"); return 1; end;
    init;
    expect("the zone", zone, cat(top, "/proj"));
    expect("rooted", yes(rooted), "yes");
    expect("inside", yes(inside("../x/y")), "yes");
    expect("out by a link", yes(inside("out/z")), "no");
    expect("a neighbour", yes(inside("../../proj2")), "no");
    grant("../../out");
    expect("granted", yes(inside("out/z")), "yes");
    forget;
    expect("forgotten", yes(inside("out/z")), "no");
    useArtifacts("../../out");
    expect("the artifacts directory, inside", yes(inside("out/z")), "yes");
    expect("and ours", yes(ours("out/z")), "yes");
    Str.free(Heap.heap, artifacts);
    artifacts := artifacts[0..0];
    expect("not ours", yes(ours("../../proj2/x")), "no");
    useStage(cat(top, "/proj2"));
    expect("the stage is ours", yes(ours("../../proj2/x")), "yes");
    expect("a neighbour of the stage", yes(ours("../x")), "no");
    expect("the stage's .git is not ours", yes(ours("../../proj2/.git")), "no");
    expect("nor below it", yes(ours("../../proj2/.git/config")), "no");
    expect("a file like it is", yes(ours("../../proj2/.gitignore")), "yes");
    touch(cat(top, "/proj2/lone"));
    expect("a file alone", yes(ours("../../proj2/lone")), "yes");
    expect("a directory, with links of its own", yes(ours("../../proj2")), "yes");
    touch(cat(top, "/out/theirs"));
    if not hardLink(cat(top, "/out/theirs"), cat(top, "/proj2/twin")) then Out.str("Afence: no ln\n"); return 1; end;
    expect("a file with a second hard link", yes(ours("../../proj2/twin")), "no");
    _ := Sys.setWorkDir(cat(top, "/out"));
    init;
    expect("unrooted", yes(rooted), "no");
    expect("the bare zone", zone, cat(top, "/out"));
    _ := Sys.setWorkDir(dir);
    if failed then return 1; end;
    return 0;
end;

end Afence.
