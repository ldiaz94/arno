(* Atools: the tools a model may call, and a call run.

   A call comes as the tool's name and its arguments, JSON text as the
   model wrote it. call parses them, asks the human about a path
   outside the fence, runs the tool and gives back its result, text for
   the model. A result that is no answer starts with a word the agent
   counts: "error" (the call went wrong), "declined" (the human said
   no) or "not run" (arno wouldn't); that is the only way a tool says
   it failed.

   A change to a file, an edit, a move or a removal, is shown to the
   human, an edit as its diff, and made only if they approve it. After
   a no they are asked why, and the model reads the reason with the
   refusal, and that nothing was changed: told only no, a model guesses
   what to do instead, and one wrote its next edit as if the declined
   one had gone in. The same change proposed again, word for word, is
   not put to the human again in the run: the model is told what they
   said the first time. Models did that after a no whose reason they
   misread, one offering the same edit three times.

   Models get the arguments wrong in a few ways often enough to take
   them as meant rather than refuse them, since a model that made a
   slip once tends to make it again: the whole object encoded twice, as
   a JSON string whose text is the object; an empty text for no
   arguments; and a path written ~/x, meant as the home directory's,
   which taken as a name under the working directory finds nothing and
   says so as if the file weren't there. The fence and the tool read
   the arguments through the same Args, so the fence judges the path
   the tool will open.

   A result is cut at MaxOut bytes, and made valid UTF-8, each byte
   that starts no character made U+FFFD: it goes into the conversation,
   which rjson reads only as UTF-8.

   run starts one of the programs config allows, or one of Readers,
   asked about unless trusted, as Readers are; check runs the project's
   test command, the human's, without asking; shell runs a command line the model writes, asking nothing,
   since the sandbox is the fence: Ajail's namespaces, no network, only
   the stage's copy (Afence.stage) and $ARNO_SCRATCH writable, unless
   config's jail_net and jail_rw open more. Its exit
   status comes first, as check's does, then the end of the output; a
   command that runs past its timeout is killed, and so is one that
   writes past 4 MB.

   Depends on Afence, Afind (find, grep, outline, def and refs), Arun (git,
   run and check), Alsp (an edit's diagnostics; def and refs where a
   language server knows the type), Astore (tests.json),
   Aahead (note), Ahtml (fetch), Awire (for Tool), Amcp (the MCP servers' tools), Apeer (the editor),
   rnet's Http (search and fetch), rjson's Json.
   Delegate and plan are the agent's, which runs the worker and keeps
   the plan; they are described here, with the rest. A call of an MCP
   server's tool is asked about every time, unless trust names the
   tool, its server or a prefix of its name with *, and is not fenced.
   A change in the conversation's scratch directory (Afence.ours) needs no approval, and run, check and shell
   see its path as $ARNO_SCRATCH. shell is offered only while the
   stage is up (Afence.stage): in the project's own tree it could
   rewrite .git or the Makefile, which git and check then run outside
   the sandbox, with no diff shown.

   While an editor is reachable (Apeer), editor says what the human has
   open, open shows them a file, read gives a file as the editor has it,
   unsaved changes included, and an edit, once approved, is made by the
   editor, as one of the human's own undo steps; the disk is used for
   what the editor lacks. A file the editor has open is neither moved nor
   removed.

   skill gives one of the skills, the human's how-to for a kind of work,
   their own or the project's (Asession says where), listed in its
   description and read only when the work calls for it, so a long one
   costs nothing until then. Leaves out the images read shows as
   pictures, which come with the screen. *)
module Atools;
import Aprice, Afence, Afind, Apeer, Arun, Alsp, Aahead, Astore, Ahtml, Awire, Amsg, Amcp, Http, Json, Buf, Str, Sys, Files, Fmt, Heap, Mem, Math, Arena, Rt, Out,
    Strs := Vec([]const U8), Cmds := Vec(Cmd), Refusals := Vec(Refusal), Tools := Vec(Awire.Tool);
import SYSTEM;

type
    (* What the human answers to question, shown detail first (a diff;
       "" for none): one of the bytes of keys, or 0 if there is nobody
       to ask. *)
    Ask* = proc(question, detail, keys: []const U8): U8;
    (* After a no, why: a line, "" for none; good until the next call. *)
    Why* = proc(): []const U8;

    (* How the human is asked; ask nil if nobody is there, why nil if
       they aren't asked why. *)
    Human* = record
        ask*: Ask;
        why*: Why;
        stopped*: proc: BOOL;   (* whether the human said to stop; or nil *)
        arg*: ^U8;
    end;

    (* One command of a call of run: the program and its arguments. *)
    Cmd = record
        args: [][]const U8;
    end;

    (* A change the human declined: the call, as key gives it, and what
       its result said. *)
    Refusal = record
        key, said: []U8;
    end;

    (* A call's arguments, parsed: v an object of d. *)
    Args* = record
        d*: ^Json.Doc;
        v*: Json.Value;
        mem: ^Mem.Allocator;   (* for what the arguments are made into *)
    end;

const
    Failed: ERROR = "the server answered with an error";

    MaxAsked = 300;   (* bytes of an MCP call's arguments shown when the human is asked *)
    MaxOut* = 32000;   (* bytes of a result, past which it is cut *)
    MaxFile = 64 * 1024 * 1024;   (* bytes of a file read reads, and edit changes *)
    MaxShown = 40;     (* lines of a file to be removed the human is shown *)
    ShellTimeout = 120;      (* seconds a shell command may run unless it asks for more *)
    ShellMost = 600;         (* and the most it may ask for *)
    ShellFlood = 4 * 1024 * 1024;   (* bytes of output past which it is killed *)
    MaxResults = 8;    (* search's results *)
    MaxPage = 1 shl 20;   (* bytes of a page fetch reads; it shows far fewer *)
    MaxText = 20000;   (* bytes of a page fetch shows at once: about 5K tokens, so a long page can't flood the context *)
    WebWait = 30;      (* seconds search and fetch wait for a page *)
    Hex = "0123456789ABCDEF";

    (* What a request offers. A tool's rules go in its description,
       not in the system prompt, and the descriptions use placeholders,
       not examples a model copies. *)
    Offered*: []Awire.Tool = [
        {name: "read",
         description: "Read a text file. Returns each line prefixed by its number and a tab " +
            "(e.g. \"   12<tab>begin\"); the prefix is not part of the file. Read a file before " +
            "editing it, so the old text given to edit matches exactly. Read a file of up to " +
            "about 400 lines whole, in one call. For a longer one, use offset and limit to take " +
            "a whole function or section at a time - a grep with context usually tells you " +
            "where - never a few dozen lines at a time.",
         params: `{"type":"object","properties":` +
            `{"path":{"type":"string","description":"file path, relative to the working directory"},` +
            `"offset":{"type":"integer","description":"first line to read, from 1; default 1"},` +
            `"limit":{"type":"integer","description":"most lines to return; default 2000"}},` +
            `"required":["path"]}`},
        {name: "find",
         description: "Find files by name. Lists the files under a directory whose name matches " +
            "a glob: * is any run of characters but /, ? one character, ** any depth of " +
            "directories. Use this to locate a file before reading it. A glob without / is " +
            "matched against the file name and every directory name on its path, so *NAME* also " +
            "lists the files in a directory called NAME. Hidden files, and files git ignores, " +
            "are left out.",
         params: `{"type":"object","properties":` +
            `{"path":{"type":"string","description":"directory to search; default ."},` +
            `"name":{"type":"string","description":"glob for the file name, such as *.EXT; default *"}}}`},
        {name: "grep",
         description: "Search file contents for a text, in one file or a whole directory tree. " +
            "Returns matching lines as \"path:line: text\"; with context, the lines around " +
            "each match too, as \"path-line- text\", groups separated by \"--\". Use this to " +
            "find where something is defined or used; with context 5 or so, the answer is " +
            "often right there without a read.",
         params: `{"type":"object","properties":` +
            `{"pattern":{"type":"string","description":` +
            `"the text to look for, matched as it is: no regular expressions, so one word or phrase a call"},` +
            `"path":{"type":"string","description":"file or directory to search; default ."},` +
            `"glob":{"type":"string","description":"only search files whose name matches, such as *.EXT"},` +
            `"ignore_case":{"type":"boolean","description":"match regardless of case; default false"},` +
            `"context":{"type":"integer","description":"lines to show before and after each match, up to 10; default 0"}},` +
            `"required":["pattern"]}`},
        {name: "def",
         description: "Go to where something is defined: give a function, class, type or method " +
            "name and get its whole definition, the comment above it included, numbered like " +
            "read. Use it instead of grep then read whenever you know the name; for a method, the " +
            "bare name finds it (NAME finds CLASS.NAME). It knows the common shapes of " +
            "declarations, not every one: if it finds nothing, grep for the name.",
         params: `{"type":"object","properties":` +
            `{"name":{"type":"string","description":"the name defined"},` +
            `"path":{"type":"string","description":"file or directory to look in; default ."}},` +
            `"required":["name"]}`},
        {name: "refs",
         description: "Find where something is used: give a function, class, type, method or " +
            "variable name and get each line that refers to it, as \"path:line: text\", like " +
            "grep. Where the project has a language server for the files, it answers, and " +
            "knows the name's real uses; else each line where the name stands as a whole word.",
         params: `{"type":"object","properties":` +
            `{"name":{"type":"string","description":"the name used"},` +
            `"path":{"type":"string","description":"file or directory to look in; default ."}},` +
            `"required":["name"]}`},
        {name: "outline",
         description: "See what a file or directory holds: every function, class, type and " +
            "method declaration (in Markdown, every heading), one line each with its line " +
            "number. Outline a file before reading it, to read only the part you need, or a " +
            "directory to get the lay of it.",
         params: `{"type":"object","properties":` +
            `{"path":{"type":"string","description":"file or directory; default ."}}}`},
        {name: "git",
         description: "Run a read-only git command: status, diff, log, show, blame, and to look " +
            "at other branches branch (lists them), merge-base, ls-tree and rev-list. Compare " +
            "branches with diff BASE..OTHER, read a file on another branch with show " +
            "OTHER:PATH. Nothing that changes the repository is allowed.",
         params: `{"type":"object","properties":` +
            `{"args":{"type":"array","items":{"type":"string"},"description":` +
            `"the arguments after git, subcommand first, one per item"}},` +
            `"required":["args"]}`},
        {name: "run",
         description: "Run a program the human allows, with arguments, and see its exit status and " +
            "output. There is no shell: no pipes, redirection, globs or variables, and the program gets " +
            "no input and no terminal, so use its non-interactive options. The human approves each " +
            "call of a program not marked as running without asking, so make each one count: to try " +
            "a program many ways, give all the commands in one call, parted by \";\".",
         params: `{"type":"object","properties":` +
            `{"args":{"type":"array","items":{"type":"string"},"description":` +
            `"the program, then its arguments, one per item; several commands in one call, parted by a lone \";\" item, run one after another"},` +
            `"env":{"type":"object","additionalProperties":{"type":"string"},"description":` +
            `"environment variables for the programs, NAME to value, of the names the human allows"}},` +
            `"required":["args"]}`},
        {name: "check",
         description: "Build and test the project, with a command the human set, and see whether it " +
            "passed and what it printed. Run the narrowest check that covers your change first, and " +
            "the whole one before you finish; run it again after each fix, until it passes. Without a " +
            "name it runs the project's own test command.",
         params: `{"type":"object","properties":` +
            `{"name":{"type":"string","description":"the check to run"},` +
            `"files":{"type":"array","items":{"type":"string"},"description":` +
            `"files inside the project for a check whose command takes them"}}}`},
        {name: "shell",
         description: "Run a shell command line in the project, sandboxed: no network, no input, no " +
            "display. Only the project's copy, $ARNO_SCRATCH and /tmp are writable. Use it for what " +
            "the other tools can't do in one call: pipelines, trying a snippet, building and running " +
            "what you built. To look at code, read, grep and def are cheaper. Gives the exit status, then the " +
            "end of the output.",
         params: `{"type":"object","properties":` +
            `{"command":{"type":"string","description":"the command line, run by /bin/sh -c in the working directory"},` +
            `"timeout":{"type":"integer","description":"seconds it may run; default 120, at most 600"}},` +
            `"required":["command"]}`},
        {name: "edit",
         description: "Change a file by replacing exact text, or create a new file. old must be " +
            "copied verbatim from a read of the same file, whitespace included and without the " +
            "line-number prefix read adds, and must occur exactly once unless all is true. To " +
            "create a file, give an empty old and the whole content as new. The human sees each " +
            "edit as a diff and approves or declines it, so make one focused change per call.",
         params: `{"type":"object","properties":` +
            `{"path":{"type":"string","description":"file path, relative to the working directory"},` +
            `"old":{"type":"string","description":` +
            `"exact current text to replace, with enough surrounding lines to be unique; empty to create a file"},` +
            `"new":{"type":"string","description":"the text to put in its place"},` +
            `"all":{"type":"boolean","description":"replace every occurrence of old; default false"}},` +
            `"required":["path","old","new"]}`},
        {name: "move",
         description: "Move or rename one file. The human approves each move. The destination " +
            "must not exist yet; its directory is made if need be. Not for directories.",
         params: `{"type":"object","properties":` +
            `{"path":{"type":"string","description":"the file to move, relative to the working directory"},` +
            `"to":{"type":"string","description":"its new path, file name included"}},` +
            `"required":["path","to"]}`},
        {name: "remove",
         description: "Delete one file. The human approves each removal. Not for directories.",
         params: `{"type":"object","properties":` +
            `{"path":{"type":"string","description":"the file to delete, relative to the working directory"}},` +
            `"required":["path"]}`},
        {name: "skill",
         description: "Read a skill: the human's own instructions for a kind of work. " +
            "Before you do work a skill below is for, read it, and follow it over your own habits.",
         params: `{"type":"object","properties":{"name":{"type":"string","description":"the skill to read"}},` +
            `"required":["name"]}`},
        {name: "note",
         description: "Keep a note about this project for your later sessions, which see every note in " +
            "their instructions. Note what you had to search for and the next session would too: where a " +
            "feature lives, a layout that surprised you, how to build or test, how an outside tool behaves. " +
            "One fact per note, one short line, project paths written from its root. Not for what this " +
            "conversation alone needs, nor what the project map already says, and never for what the code you " +
            "are changing does now: the next edit changes that, and a note that outlives it misleads every " +
            "later session.",
         params: `{"type":"object","properties":` +
            `{"text":{"type":"string","description":"the note, one line of at most 200 characters"}},` +
            `"required":["text"]}`},
        {name: "search",
         description: "Search the web. Use it for things outside this project: a library's API, an error " +
            "message, current events. Not for finding code, which find, grep and read do better. Returns " +
            "titles, urls and snippets only, and a snippet is not evidence: read the pages with fetch before " +
            "you answer from them.",
         params: `{"type":"object","properties":` +
            `{"query":{"type":"string","description":"what to search for, as you would type it into a search engine"}},` +
            `"required":["query"]}`},
        {name: "fetch",
         description: "Read a web page by its URL: its title, then its text as a text browser shows it, " +
            "without markup, scripts or styles; a plain-text, JSON or Markdown body comes back as it is. Use it " +
            "after search to read the pages found, not just the first hit: snippets are not evidence. When the " +
            "answer matters, read two or three sources, and prefer primary ones - official documentation, the " +
            "project's own repository, a man page - to pages that retell them. Say in your answer which URLs " +
            "you relied on. http and https only. A long page comes back in parts, " +
            "each ending with the offset to read on from.",
         params: `{"type":"object","properties":` +
            `{"url":{"type":"string","description":"the page's URL, http:// or https://, as search gave it"},` +
            `"offset":{"type":"integer","description":"first byte of the text to show, from 0; default 0"}},` +
            `"required":["url"]}`},
        {name: "editor",
         description: "See what the human has open in their editor: the current file and line, and the other " +
            "buffers, marked when they have unsaved changes. Takes no arguments.",
         params: `{"type":"object","properties":{}}`},
        {name: "open",
         description: "Show the human a file in their editor, at a line, to point them at what you are talking about.",
         params: `{"type":"object","properties":` +
            `{"path":{"type":"string","description":"file path, relative to the working directory"},` +
            `"line":{"type":"integer","description":"line to show, from 1; default 1"}},` +
            `"required":["path"]}`},
        {name: "delegate",
         description: "Give a self-contained step of a larger job to a worker: a cheaper model with the " +
            "ordinary tools and nothing but your brief, which does the step and reports what it did, what it " +
            "found, the files it changed and check's verdict. It pays for a step whose details you will not " +
            "need again, such as building one piece or surveying an area; it does not for a small task, or for " +
            "anything you would have to read again yourself. Brief it fully: the goal, the files, the " +
            "project's rules that matter, what to test. A step that needs an earlier one's report waits for it; " +
            "steps that don't may go together, several delegate calls in one reply, and while staged their " +
            "workers run side by side. While staged, a worker works in a copy of its own, made from yours as it " +
            "stands, and its changes come back as a diff for you to merge.",
         params: `{"type":"object","properties":` +
            `{"task":{"type":"string","description":"what to do, in full: the worker knows nothing else"},` +
            `"files":{"type":"array","items":{"type":"string"},"description":"the files it will read or change"},` +
            `"done_when":{"type":"string","description":"how the worker knows the step is done"},` +
            `"model":{"type":"string","description":"the worker's model, one of those listed; the default if left out"},` +
            `"budget":{"type":"number","description":"dollars the worker may spend, out of what your turn has left; ` +
            `all of that if left out, or an even share of it for each of several delegated together"}},` +
            `"required":["task","done_when"]}`},
        {name: "plan",
         description: "Put your plan to the human for approval. It is written to plan.md in the scratch " +
            "directory and shown to them; nothing is edited or delegated until they approve one. After a no, " +
            "their reason comes back: revise the plan as they say and call plan again.",
         params: `{"type":"object","properties":` +
            `{"plan":{"type":"string","description":"the plan in Markdown: the goal, the steps in order, each with ` +
            `the files it touches and how it is checked, and what is left out"}},` +
            `"required":["plan"]}`},
        {name: "merge",
         description: "Bring a worker's changes into your copy, or drop them. A worker's diff is kept in the " +
            "scratch directory as worker-N.diff: read it first. It is applied whole or not at all: one that no " +
            "longer fits your copy changes nothing, and the error says where.",
         params: `{"type":"object","properties":` +
            `{"worker":{"type":"integer","description":"the worker's number, which delegate's result gives"},` +
            `"apply":{"type":"boolean","description":"true to apply the diff to your copy, false to drop it"}},` +
            `"required":["worker","apply"]}`}];

    (* What git may run, and what may follow git branch --list. *)
    GitVerbs = " status diff log show blame branch merge-base ls-tree rev-list ";
    BranchOptions = " -a -r -v -vv -i --all --remotes --verbose --ignore-case --contains --no-contains " +
        "--merged --no-merged --points-at --sort --format --abbrev --no-abbrev --column --no-column ";

var
    shellOff: BOOL;         (* config's shell is no, which takes the tool away *)
    jailNet: BOOL;          (* config's jail_net is yes: the jail keeps the network *)
    jailRw: []const U8;     (* config's jail_rw: more directories the jail leaves writable, split by blanks *)

(* config's shell: whether the shell tool may be offered. *)
proc shellEnabled*(on: BOOL);
begin
    shellOff := not on;
end;

(* config's jail_net and jail_rw: whether the jail of check, run and
   shell keeps the network, and the directories, split by blanks, it
   leaves writable beyond the copy and the scratch, which a test may
   want for a cache in the home. *)
proc jail*(net: BOOL; rw: []const U8);
begin
    jailNet := net;
    jailRw := rw;
end;

(* Whether shell can be offered now: config allows it, the session is
   staged (safety auto), and the kernel allows the jail. Safe, it is
   withdrawn: every read outside the project then goes through the
   fence's question, which the jail, reading all the human can, would
   pass by. *)
proc shellOn*(): BOOL;
begin
    return not shellOff and (LEN(Afence.stage) > 0) and Arun.jails();
end;

(* Whether the tool called name only reads: a call to one made twice
   in a turn is refused the second time, as nothing it saw has
   changed. *)
proc readOnly*(name: []const U8): BOOL;
begin
    match name of
    | "read", "find", "grep", "def", "refs", "outline", "git", "skill": return true;
    | else: return false;
    end;
end;

(* Arguments *)

(* s, copied into mem, for what is parsed in it, as parsing rewrites its
   text. *)
proc scratch(mem: ^Mem.Allocator; s: []const U8): []U8;
var c: []U8; ok: BOOL;
begin
    c, ok := Str.copy(mem, s);
    if not ok then Rt.stop("arno: out of memory"); end;
    return c;
end;

(* The argument key as a string; "" if it isn't one. *)
proc str*(const a: Args; key: []const U8): []const U8;
begin
    return Json.text(a.d, Json.member(a.d, a.v, key));
end;

(* s with a leading ~, alone or before a '/', made $HOME, in a's
   memory if it changes. Never ~user. *)
proc home(const a: Args; s: []const U8): []const U8;
var b: Buf.Buf;
begin
    if (s # "~") and not Str.hasPrefix(s, "~/") then return s; end;
    Buf.init(b, a.mem);
    Buf.str(b, Sys.env("HOME"));
    Buf.str(b, s[1..LEN(s)]);
    return Buf.bytes(b);
end;

(* The argument key as a path: a string, ~ made $HOME. *)
proc path*(const a: Args; key: []const U8): []const U8;
begin
    return home(a, str(a, key));
end;

(* The argument key as the path of a directory to look in: ".", if it
   isn't given, and without the /s at its end, so that "src/" and "src"
   are one. *)
proc dir(const a: Args; key: []const U8): []const U8;
var s: []const U8;
begin
    s := path(a, key);
    if LEN(s) = 0 then return "."; end;
    while (LEN(s) > 1) and (s[LEN(s) - 1] = '/') do s := s[0..LEN(s) - 1]; end;
    return s;
end;

(* The argument key as a flag: true, or the string "true". *)
proc flag*(const a: Args; key: []const U8): BOOL;
var v: Json.Value;
begin
    v := Json.member(a.d, a.v, key);
    return (v = Json.True) or (str(a, key) = "true");
end;

(* The argument key as a list of strings, each ~ made $HOME. A model
   sends git's list in three shapes: an array; the array's own JSON
   text, as a string, which split at its blanks would make a subcommand
   of '["diff",'; and the words as one string, "diff --stat". *)
proc list*(const a: Args; key: []const U8): [][]const U8;
var l: Strs.Vec; v, w: Json.Value; s, word: []const U8; i: INT;
begin
    Strs.init(l, a.mem);
    v := Json.member(a.d, a.v, key);
    s := Json.text(a.d, v);
    if (Json.kind(a.d, v) = Json.Kind.string) and Str.hasPrefix(Str.trimLeft(s), "[") then
        w := Json.parse(a.d, scratch(a.mem, s));
        if Json.kind(a.d, w) = Json.Kind.array then v := w; end;
    end;
    if Json.kind(a.d, v) = Json.Kind.array then
        for i := 0 to Json.len(a.d, v) - 1 do
            Strs.push(l, home(a, Json.text(a.d, Json.item(a.d, v, i))));
        end;
    else
        word, s := Str.field(s);
        while LEN(word) > 0 do
            Strs.push(l, home(a, word));
            word, s := Str.field(s);
        end;
    end;
    return Strs.all(l);
end;

(* The argument key as a number, from a number or a string that holds
   one, as models send both; def if it is neither. *)
proc int*(const a: Args; key: []const U8; def: INT): INT;
var n: I64; ok: BOOL;
begin
    n, ok := Str.toInt(str(a, key));
    if not ok then return def; end;
    return INT(n);
end;

(* The argument key as a real number, from a number or a string that
   holds one; def if it is neither. *)
proc real*(const a: Args; key: []const U8; def: F64): F64;
var x: F64; ok: BOOL;
begin
    x, ok := Math.toReal(str(a, key));
    if not ok then return def; end;
    return x;
end;

(* text parsed into a, in d, with what a keeps from mem: false if it is no object, nor a string
   whose text is one. *)
proc parse*(d: ^Json.Doc; mem: ^Mem.Allocator; text: []const U8; var a: Args): BOOL;
var v: Json.Value;
begin
    a.d := d;
    a.mem := mem;
    if LEN(Str.trim(text)) = 0 then text := "{}"; end;
    v := Json.parse(d, scratch(mem, text));
    if Json.kind(d, v) = Json.Kind.string then v := Json.parse(d, scratch(mem, Json.text(d, v))); end;
    a.v := v;
    return Json.kind(d, v) = Json.Kind.object;
end;

(* The fence *)

(* "" if path may be reached, the human asked if it is outside the
   fence; else why not, the call's result. "Always", for a file, grants
   the directory that holds it: a model that reads one file of a
   library reads its neighbours next. Never / or the home directory,
   though: a yes to ~/.bashrc is not one to all of ~. *)
proc fence(name, path: []const U8; const h: Human; var out: Buf.Buf): BOOL;
var p, room, home, q: Buf.Buf; i: Sys.Info; e: INT;
begin
    if (LEN(path) = 0) or Afence.inside(path) then return true; end;
    Buf.init(p, Heap.heap);
    defer Buf.done(p);
    Buf.init(room, Heap.heap);
    defer Buf.done(room);
    Buf.init(home, Heap.heap);
    defer Buf.done(home);
    Buf.init(q, Heap.heap);
    defer Buf.done(q);
    Afence.resolve(path, p);
    Afence.resolve(Sys.env("HOME"), home);
    Buf.str(room, Buf.bytes(p));
    i, e := Sys.info(Buf.bytes(p));
    if (e # 0) or not i.dir then
        room.len := Str.findLast(Buf.bytes(room), "/");
        if room.len = 0 then Buf.add(room, '/'); end;
    end;
    if (Buf.bytes(room) = "/") or (Buf.bytes(room) = Buf.bytes(home)) then
        Buf.reset(room);
        Buf.str(room, Buf.bytes(p));
    end;
    Buf.str(q, name);
    Buf.add(q, ' ');
    Buf.str(q, Buf.bytes(p));
    Buf.str(q, ", outside ");
    Buf.str(q, Afence.zone);
    Buf.str(q, "? (a: always, all of ");
    Buf.str(q, Buf.bytes(room));
    Buf.add(q, ')');
    if h.ask = nil then
        Buf.str(out, "declined: ");
        Buf.str(out, Buf.bytes(p));
        Buf.str(out, " is outside ");
        Buf.str(out, Afence.zone);
        Buf.str(out, ", and there is nobody to ask");
        return false;
    end;
    match h.ask(Buf.bytes(q), "", "yna") of
    | 'y': return true;
    | 'a': Afence.grant(Buf.bytes(room)); return true;
    | else:
    end;
    Buf.str(out, "declined by user: ");
    Buf.str(out, Buf.bytes(p));
    Buf.str(out, " is outside the project");
    return false;
end;

(* The tools *)

(* The text of the file p into text: as the editor has it, unsaved
   changes and all, if it has the file open, else from the disk; Files.load's
   result, 0 if it was read. *)
proc load(p: []const U8; stopped: proc: BOOL; var text: Buf.Buf): INT;
var full: Buf.Buf;
begin
    if Apeer.reachable() then
        Buf.init(full, Heap.heap);
        defer Buf.done(full);
        if Apeer.contents(Apeer.absolute(p, full), stopped, text) then return 0; end;
    end;
    return Files.load(p, text);
end;

(* An editor's answer, its status st and text in out, made a result: the
   text after lead if it is ok, else an error saying why. *)
proc answered(st: Apeer.Status; lead: []const U8; var out: Buf.Buf);
var t: Buf.Buf;
begin
    Buf.init(t, Heap.heap);
    defer Buf.done(t);
    Buf.str(t, Buf.bytes(out));
    Buf.reset(out);
    match st of
    | Apeer.Status.ok: Fmt.write(out, "{}{}", [Fmt.str(lead), Fmt.str(Buf.bytes(t))]);
    | Apeer.Status.absent: Buf.str(out, "error: no editor is running");
    | else: Fmt.write(out, "error: {}", [Fmt.str(Buf.bytes(t))]);
    end;
end;

(* editor: what the human has open in their editor, into out. *)
proc editor(const h: Human; var out: Buf.Buf);
begin
    answered(Apeer.call(["state"], h.stopped, out), "", out);
end;

(* open: the file at the argument path shown in the editor, at the argument line. *)
proc open(const a: Args; const h: Human; var out: Buf.Buf);
var full: Buf.Buf; digits: [20]U8; k: INT;
begin
    Buf.init(full, Heap.heap);
    defer Buf.done(full);
    digits, k := Str.fromInt(int(a, "line", 1));
    answered(Apeer.call(["open", Apeer.absolute(path(a, "path"), full), digits[0..k]], h.stopped, out), "", out);
end;

(* The edit of the file p, old for new, made by the editor, so that it is
   the human's own undo step; false if there is no editor, and the file
   is to be written here. The result, ok or an error, goes into out. *)
proc throughEditor(p, old, new: []const U8; all: BOOL; const h: Human; var out: Buf.Buf): BOOL;
var full: Buf.Buf; st: Apeer.Status; flag: []const U8;
begin
    Buf.init(full, Heap.heap);
    defer Buf.done(full);
    flag := "";
    if all then flag := "all"; end;
    st := Apeer.call(["edit", Apeer.absolute(p, full), old, new, flag], h.stopped, out);
    if st = Apeer.Status.absent then return false; end;
    answered(st, "ok: ", out);
    return true;
end;

(* The file's lines, numbered: the number right-aligned in five
   columns, then a tab, as cat -n has them. With two blanks there,
   models took them for indentation and put them in an edit's old text;
   a tab can't be taken for the file's own blanks once the number is
   dropped. *)
proc read(const a: Args; const h: Human; mem: ^Mem.Allocator; var out: Buf.Buf);
var text: Buf.Buf; s, p: []const U8; i: Sys.Info; e, at, j, k, n, first, count: INT; digits: [20]U8;
begin
    p := path(a, "path");
    i, e := Sys.info(p);
    if (e = 0) and i.dir then
        Buf.str(out, "error: ");
        Buf.str(out, p);
        Buf.str(out, " is a directory; outline it, or find the files in it");
        return;
    end;
    (* never open a pipe: the read would wait for whoever writes it *)
    if (e # 0) or not i.file then
        Buf.str(out, "error: cannot read ");
        Buf.str(out, p);
        Buf.str(out, " (no such file? use find to locate it)");
        return;
    end;
    if i.size > MaxFile then
        Buf.str(out, "error: ");
        Buf.str(out, p);
        Buf.str(out, " is too big to read");
        return;
    end;
    Buf.init(text, mem);
    if load(p, h.stopped, text) # 0 then
        Buf.str(out, "error: cannot read ");
        Buf.str(out, p);
        return;
    end;
    s := Buf.bytes(text);
    j := LEN(s);
    if j > 8192 then j := 8192; end;
    if Str.find(s[0..j], "\x00") >= 0 then
        Buf.str(out, "error: ");
        Buf.str(out, p);
        Buf.str(out, " is binary, not text");
        return;
    end;
    first := int(a, "offset", 1);
    count := int(a, "limit", 2000);
    n := 1;
    at := 0;
    while (at < LEN(s)) and (n < first + count) do
        j := at;
        while (j < LEN(s)) and (s[j] # '\n') do INC(j); end;
        if n >= first then
            digits, k := Str.fromInt(n);
            (* the note fits, so call's own cut doesn't take it off *)
            if out.len + 7 + j - at > MaxOut - 64 then
                Buf.str(out, "[cut before line ");
                Buf.str(out, digits[0..k]);
                Buf.str(out, "; read on with offset ");
                Buf.str(out, digits[0..k]);
                Buf.add(out, ']');
                return;
            end;
            Afind.numbered(out, n, s[at..j]);
        end;
        INC(n);
        at := j + 1;
    end;
    if out.len = 0 then Buf.str(out, "(empty)"); end;
end;

(* find, grep, def, refs or outline, the tool name, run with a: def
   and refs through a language server where there is one (Alsp), else
   by the rule of thumb (Afind). *)
proc look(name: []const U8; const a: Args; mem: ^Mem.Allocator; var out: Buf.Buf);
var d, s, n: []const U8;
begin
    d := dir(a, "path");
    n := Str.trim(str(a, "name"));
    if name = "find" then
        s := str(a, "name");
        if LEN(s) = 0 then s := "*"; end;
        Afind.find(d, s, out);
    elsif name = "grep" then
        Afind.grep(d, str(a, "pattern"), str(a, "glob"), flag(a, "ignore_case"), int(a, "context", 0), mem, out);
    elsif name = "outline" then
        Afind.outline(d, MaxOut, mem, out);
    elsif LEN(n) = 0 then
        Buf.str(out, "error: give the name to look up");
    elsif name = "refs" then
        if not Alsp.refer(d, n, mem, out) then Afind.refs(d, n, mem, out); end;
        if out.len = 0 then Fmt.write(out, "no uses of {} found in {}", [Fmt.str(n), Fmt.str(d)]); end;
    elsif Alsp.define(d, n, mem, out) then
        (* the server's answer *)
    elsif Afind.defs(d, str(a, "name"), mem, out) >= Afind.MaxDefs then
        Buf.str(out, "[stopped at 10 definitions; give a path]");
    elsif out.len = 0 then
        Buf.str(out, "no definition of ");
        Buf.str(out, Str.trim(str(a, "name")));
        Buf.str(out, " found in ");
        Buf.str(out, d);
        Buf.str(out, "; def knows common declaration shapes, not every one: grep for the name with some context instead.");
    end;
end;

(* git, with the arguments args: a read-only subcommand, subcommand
   first. diff, log and show run no program a repository's config
   names (--no-ext-diff, --no-textconv), and no option that writes a
   file or runs one is passed on. branch alone of them also makes,
   renames and deletes, by what follows it; it goes out as branch
   --list, which makes every other word a pattern to list, and only the
   options that choose or shape the list get past it. A log not
   limited is limited to 50 commits. *)
proc git(const a: Args; var out: Buf.Buf);
var args: [][]const U8; argv: Strs.Vec; sub, x, o: []const U8; i: INT; limited: BOOL;
begin
    args := list(a, "args");
    if LEN(args) = 0 then
        Buf.str(out, "error: args must be an array of strings, the subcommand first");
        return;
    end;
    sub := args[0];
    if not Afind.listed(sub, GitVerbs) then
        Buf.str(out, "error: ");
        Buf.str(out, sub);
        Buf.str(out, " is not allowed; only status, diff, log, show, blame, branch, merge-base, " +
            "ls-tree and rev-list, subcommand first, without \"git\"");
        return;
    end;
    Strs.init(argv, a.mem);
    Strs.push(argv, "git");
    Strs.push(argv, "--no-pager");
    Strs.push(argv, sub);
    if (sub = "diff") or (sub = "log") or (sub = "show") then
        Strs.push(argv, "--no-ext-diff");
        Strs.push(argv, "--no-textconv");
    end;
    if sub = "branch" then Strs.push(argv, "--list"); end;
    limited := false;
    for i := 1 to LEN(args) - 1 do
        x := args[i];
        o, _, _ := Str.cut(x, "=");
        if Str.hasPrefix(x, "--output") or Str.hasPrefix(x, "--ext") or Str.hasPrefix(x, "--textconv") or
            Str.hasPrefix(x, "--no-in") or (sub = "branch") and Str.hasPrefix(x, "-") and not Afind.listed(o, BranchOptions) then
            Buf.str(out, "error: option not allowed: ");
            Buf.str(out, x);
            return;
        end;
        if Str.hasPrefix(x, "-n") or Str.hasPrefix(x, "--max-count") or
            (LEN(x) > 1) and (x[0] = '-') and (x[1] >= '0') and (x[1] <= '9') then
            limited := true;
        end;
        Strs.push(argv, x);
    end;
    if (sub = "log") and not limited then
        Strs.push(argv, "-n");
        Strs.push(argv, "50");
    end;
    i := Arun.run(Strs.all(argv), MaxOut + 1, out);
    if (i = 127) and (out.len = 0) or (i < 0) then
        Buf.str(out, "error: git can't be run");
    elsif out.len = 0 then
        Buf.str(out, "(no output)");
    end;
end;

(* run and check *)

var
    runs: Buf.Buf;     (* the programs run may start, config's run, a blank at either end and between *)
    runsRO: Buf.Buf;   (* those of them that only read, config's run_ro *)
    runsEnv: Buf.Buf;  (* the variables run may set, config's run_env *)
    trust: Buf.Buf;    (* config's trust: the programs run starts without asking, and the MCP tools and servers called without *)
    trustTools: Buf.Buf;   (* each MCP tool the human answered always, a blank at either end of each *)
    trustRun: INT;     (* trust's length from config, before the answers *)
    testCmd: []const U8;     (* config's test_cmd, for a project with none of its own *)
    runDesc: Buf.Buf;  (* the run tool's description with the programs it names *)
    runDescFor: INT;   (* trust's length runDesc was made for, -1 until it is made *)
    checkNames: Strs.Vec;  (* the named checks' names, config's check.NAME *)
    checkCmds: Strs.Vec;   (* their commands, each as many as its name *)
    checkDesc: Buf.Buf;    (* the check tool's description with the checks it names *)
    checkParams: Buf.Buf;  (* its schema, name an enum of them *)
    checkMade: BOOL;       (* whether checkDesc and checkParams are made for the checks now set *)

const
    (* The programs always allowed, only reading and trusted, whatever
       config says: models reach for ls first, a refusal costs a turn,
       and these only read. A config entry for one changes nothing. *)
    Readers = "ls wc head file stat";

(* list, words parted by blanks, into b with a blank at either end. *)
proc words(var b: Buf.Buf; list: []const U8);
begin
    Buf.init(b, Heap.heap);
    Buf.add(b, ' ');
    Buf.str(b, list);
    Buf.add(b, ' ');
end;

(* list as words() makes it, and then Readers, those not already in it. *)
proc programs(var b: Buf.Buf; list: []const U8);
var rest, w: []const U8; more: BOOL;
begin
    words(b, list);
    rest := Readers;
    more := true;
    while more do
        w, rest, more := Str.cut(rest, " ");
        if not Afind.listed(w, Buf.bytes(b)) then
            Buf.str(b, w);
            Buf.add(b, ' ');
        end;
    end;
end;

(* run and check as config says: run's programs, those that only read,
   the variables it may set and the programs trusted, the first three
   with Readers added; check's test command for a project without one
   of its own. test is kept, the others copied. *)
proc commands*(run, ro, env, trusted, test: []const U8);
begin
    programs(runs, run);
    programs(runsRO, ro);
    words(runsEnv, env);
    programs(trust, trusted);
    trustRun := trust.len;
    runDescFor := -1;
    testCmd := test;
end;

(* The project's test command, added to b: the one /test last set for
   it, in tests.json, or else config's test_cmd; "" for none. It is
   always one the human typed, never one a project brings, as check
   runs it without asking. *)
proc testFor*(var b: Buf.Buf): []const U8;
var s: []const U8;
begin
    s := Astore.keyed("tests.json", Afence.root, b);
    if LEN(s) = 0 then
        Buf.str(b, testCmd);
        s := testCmd;
    end;
    return s;
end;

(* The named checks made none; then each one set with addCheck. The
   strings are kept, not copied: config's. *)
proc clearChecks*;
begin
    Strs.done(checkNames);
    Strs.done(checkCmds);
    Strs.init(checkNames, Heap.heap);
    Strs.init(checkCmds, Heap.heap);
    checkMade := false;
end;

(* The check name, which runs command, added. *)
proc addCheck*(name, command: []const U8);
begin
    Strs.push(checkNames, name);
    Strs.push(checkCmds, command);
    checkMade := false;
end;

(* The command of the check name, "" if there is none. *)
proc checkCommand(name: []const U8): []const U8;
var i: INT;
begin
    for i := 0 to checkNames.len - 1 do
        if Strs.all(checkNames)[i] = name then return Strs.all(checkCmds)[i]; end;
    end;
    return "";
end;

(* t, the check tool, with the named checks and their commands ended on
   its description, and name an enum of them, so that a model need not
   guess. Made again only when the checks change, in new buffers, so
   that what was handed out before stays whole. *)
proc checkOffer(t: Awire.Tool): Awire.Tool;
var i: INT;
begin
    if not checkMade then
        Buf.init(checkDesc, Heap.heap);
        Buf.init(checkParams, Heap.heap);
        Buf.str(checkDesc, t.description);
        Buf.str(checkParams, `{"type":"object","properties":{`);
        if checkNames.len > 0 then
            Buf.str(checkDesc, " Checks, and the command each runs ({} stands for the files you give; " +
                "without files it is removed, and the whole suite runs):");
            Buf.str(checkParams, `"name":{"type":"string","description":"the check to run","enum":[`);
            for i := 0 to checkNames.len - 1 do
                Fmt.write(checkDesc, "\n- {}: {}", [Fmt.str(Strs.all(checkNames)[i]), Fmt.str(Strs.all(checkCmds)[i])]);
                if i > 0 then Buf.add(checkParams, ','); end;
                Fmt.write(checkParams, "\"{}\"", [Fmt.str(Strs.all(checkNames)[i])]);
            end;
            Buf.str(checkParams, "]},");
        end;
        Buf.str(checkParams, `"files":{"type":"array","items":{"type":"string"},"description":` +
            `"files inside the project, for a check whose command has {}"}}}`);
        checkMade := true;
    end;
    t.description := Buf.bytes(checkDesc);
    t.params := Buf.bytes(checkParams);
    return t;
end;

(* Whether x, a word for fd, asks it to run a program: --exec or
   --exec-batch, or -x or -X alone or in a cluster of short flags (-Hx).
   In a cluster, a flag that takes a value takes the rest of the word
   as it (-tx is the type executable), so the scan stops there. *)
proc fdRuns(x: []const U8): BOOL;
var i: INT;
begin
    if Str.hasPrefix(x, "--") then return Str.hasPrefix(x, "--exec"); end;
    for i := 1 to LEN(x) - 1 do
        match x[i] of
        | 'x', 'X': return true;
        | 't', 'e', 'E', 'd', 'S', 'c', 'j', 'o': return false;
        | else:
        end;
    end;
    return false;
end;

(* Why run mayn't give prog the argument x, added to out; false if it
   may. The program is the human's choice, made in config, but its
   options are the model's, and three kinds would make that choice
   meaningless. man runs a pager or browser of the caller's naming, so
   it takes no options at all: a section and a page are all a manual
   needs. fd runs any program for -x and -X. And a path glued to an
   option (-o../x) hides it from the fence, which judges words; after
   an = it is seen, and so is a path as a word of its own. *)
proc refusedArg(prog, x: []const U8; var out: Buf.Buf): BOOL;
begin
    if not Str.hasPrefix(x, "-") then return false; end;
    if prog = "man" then
        Buf.str(out, "error: man takes no options here; give a section and a page");
    elsif (prog = "fd") and fdRuns(x) then
        Buf.str(out, "error: fd may not run commands here (-x, -X, --exec, --exec-batch)");
    elsif (Str.find(x, "/") >= 0) and (Str.find(x, "=") < 0) then
        Fmt.write(out, "error: give the path in {} as an argument of its own", [Fmt.str(x)]);
    else
        return false;
    end;
    return true;
end;

(* ARNO_SCRATCH=, the scratch directory, from mem: the variable run and
   check give each program, so a script can name the scratch without
   knowing the conversation. *)
proc scratchVar(mem: ^Mem.Allocator): []const U8;
var b: Buf.Buf;
begin
    Buf.init(b, mem);
    Buf.str(b, "ARNO_SCRATCH=");
    Buf.str(b, Afence.scratch);
    return Buf.bytes(b);
end;

(* j made a jailed job, in mem: the copy and the scratch directory
   writable, and jail_rw's directories, each ~ made $HOME; one that
   isn't an absolute path to a directory now is passed over, as it
   would keep the sandbox from being made. The network is cut off
   unless jail_net keeps it. *)
proc jailed(var j: Arun.Job; mem: ^Mem.Allocator);
var rw: Strs.Vec; word, rest: []const U8; b: Buf.Buf; info: Sys.Info; e: INT;
begin
    Strs.init(rw, mem);
    Strs.push(rw, Afence.stage);
    if LEN(Afence.scratch) > 0 then Strs.push(rw, Afence.scratch); end;
    word, rest := Str.field(jailRw);
    while LEN(word) > 0 do
        Buf.init(b, mem);
        if (word = "~") or Str.hasPrefix(word, "~/") then
            Buf.str(b, Sys.env("HOME"));
            word := word[1..LEN(word)];
        end;
        Buf.str(b, word);
        info, e := Sys.info(Buf.bytes(b));
        if Str.hasPrefix(Buf.bytes(b), "/") and (e = 0) and info.dir then Strs.push(rw, Buf.bytes(b)); end;
        word, rest := Str.field(rest);
    end;
    j.jail := true;
    j.rw := Strs.all(rw);
    j.net := jailNet;
end;

(* j put in the jail while the session is staged (safety auto) and the
   kernel allows it, the copy and the scratch directory its only
   writable places, with no network, but as jail_rw and jail_net say:
   there the model edits unasked, so what check and run start may be
   its work, a Makefile it rewrote. Safe, j runs as it is: nothing it
   runs was changed unasked. *)
proc confine(var j: Arun.Job; mem: ^Mem.Allocator);
begin
    if (LEN(Afence.stage) = 0) or not Arun.jails() then return; end;
    jailed(j, mem);
end;

(* Whether a jailed job's status and output, got, say the sandbox could
   not be made; then the error is added to out. *)
proc unjailed(status: INT; const got: Buf.Buf; var out: Buf.Buf): BOOL;
begin
    if (status # 126) or not Str.hasPrefix(Buf.bytes(got), "sandbox:") then return false; end;
    Buf.str(out, "error: ");
    Buf.str(out, Str.trim(Buf.bytes(got)));
    return true;
end;

(* "declined by user" added to out, then the human's reason if they give
   one, then ending, which says what was left undone. *)
proc declined*(const h: Human; ending: []const U8; var out: Buf.Buf);
var why: []const U8;
begin
    Buf.str(out, "declined by user");
    why := "";
    if h.why # nil then why := Str.trim(h.why()); end;
    if LEN(why) > 0 then
        Buf.str(out, ": ");
        Buf.str(out, why);
    end;
    Buf.str(out, ". ");
    Buf.str(out, ending);
end;

(* The 'run' tool: one of the programs config's run names, with the
   model's arguments, its exit status and output, so that a model can
   use the human's own tools (render a drawing, read a manual) without
   a shell. There is none: the arguments go to exec as they are, so
   there is nothing to quote, and no pipe or $(...) to guard against.
   The program starts detached (Arun), without input, a terminal or a
   display. Several commands may come in one call, parted by a lone
   ";", and are asked about once: a model trying a program out ran one
   a step, each step sending the whole conversation again. The human
   is asked about the programs not yet trusted: yes, no, or always,
   which trusts the program until the conversation changes (forgive).
   The variables of env must be among run_env's: a model once ran a
   test suite 22 times only to see a program's colours under one. *)
proc runTool(const a: Args; const h: Human; var out: Buf.Buf);
var args: [][]const U8; cmds: Cmds.Vec; c: []Cmd; env: Strs.Vec; ask, lines, line, q: Buf.Buf; e, v: Json.Value;
    x: []const U8; i, k, start, status: INT; j: Arun.Job; answer: U8;
begin
    Strs.init(env, a.mem);
    e := Json.member(a.d, a.v, "env");
    for i := 0 to Json.len(a.d, e) - 1 do
        x := Json.key(a.d, e, i);
        v := Json.item(a.d, e, i);
        if LEN(Str.trim(Buf.bytes(runsEnv))) = 0 then
            Buf.str(out, "error: no environment variables may be set here");
            return;
        end;
        if not Afind.listed(x, Buf.bytes(runsEnv)) then
            Fmt.write(out, "error: {} may not be set; these may:{}", [Fmt.str(x), Fmt.str(Buf.bytes(runsEnv))]);
            return;
        end;
        if (Json.kind(a.d, v) # Json.Kind.string) or (Str.find(x, "=") >= 0) then
            Fmt.write(out, "error: {} must be set to a string", [Fmt.str(x)]);
            return;
        end;
        Buf.init(line, a.mem);
        Fmt.write(line, "{}={}", [Fmt.str(x), Fmt.str(Json.text(a.d, v))]);
        Strs.push(env, Buf.bytes(line));
    end;

    (* the commands, each a slice of args *)
    args := list(a, "args");
    Cmds.init(cmds, a.mem);
    start := 0;
    for i := 0 to LEN(args) do
        if (i < LEN(args)) and (args[i] # ";") then continue; end;
        if i = start then
            if i < LEN(args) then Buf.str(out, "error: an empty command before \";\""); return; end;
            break;
        end;
        if not Afind.listed(args[start], Buf.bytes(runs)) then
            Fmt.write(out, "error: {} is not allowed; the programs are:{}", [Fmt.str(args[start]), Fmt.str(Buf.bytes(runs))]);
            return;
        end;
        for k := start + 1 to i - 1 do
            if refusedArg(args[start], args[k], out) then return; end;
        end;
        Cmds.push(cmds, {args: args[start..i]});
        start := i + 1;
    end;
    c := Cmds.all(cmds);
    if LEN(c) = 0 then
        Buf.str(out, "error: args must be an array of strings, the program first");
        return;
    end;

    (* one question for them all, naming the programs not yet trusted *)
    Buf.init(ask, a.mem);
    Buf.init(lines, a.mem);
    Buf.add(ask, ' ');
    for k := 0 to LEN(c) - 1 do
        x := c[k].args[0];
        if not Afind.listed(x, Buf.bytes(trust)) and not Afind.listed(x, Buf.bytes(ask)) then
            Buf.str(ask, x);
            Buf.add(ask, ' ');
        end;
        Str.join(lines, Strs.all(env), " ");
        if LEN(Strs.all(env)) > 0 then Buf.add(lines, ' '); end;
        Str.join(lines, c[k].args, " ");
        Buf.add(lines, '\n');
    end;
    if ask.len > 1 then
        if h.ask = nil then Buf.str(out, "declined: there is nobody to ask. Nothing was run."); return; end;
        Buf.init(q, a.mem);
        x := Str.trim(Buf.bytes(ask));
        if LEN(c) = 1 then
            Buf.str(q, "run ");
            Str.join(q, c[0].args, " ");
            Fmt.write(q, "? (a: always {})", [Fmt.str(x)]);
        else
            Fmt.write(q, "run these {} commands? (a: always {})", [Fmt.int(LEN(c)), Fmt.str(x)]);
        end;
        answer := h.ask(Buf.bytes(q), Buf.bytes(lines), "yna");
        if answer = 'a' then
            Buf.str(trust, x);
            Buf.add(trust, ' ');
        elsif answer # 'y' then
            declined(h, "Nothing was run.", out);
            return;
        end;
    end;

    Strs.push(env, scratchVar(a.mem));
    for k := 0 to LEN(c) - 1 do
        if k > 0 then Buf.str(out, "\n\n"); end;
        j := {args: c[k].args, env: Strs.all(env), detach: true};
        confine(j, a.mem);
        Buf.init(line, a.mem);
        status, _, _ := Arun.start(j, MaxOut + 1, line);
        if unjailed(status, line, out) then continue; end;
        if (status = 127) and (line.len = 0) or (status < 0) then
            Fmt.write(out, "error: {} is not installed", [Fmt.str(c[k].args[0])]);
            continue;
        end;
        Fmt.write(out, "exit {}: ", [Fmt.int(status)]);
        Str.join(out, c[k].args, " ");
        if line.len > 0 then
            Buf.add(out, '\n');
            Buf.str(out, Str.trimRight(Buf.bytes(line)));
        end;
    end;
end;

(* The 'shell' tool: a command line run by /bin/sh in the jail (Ajail),
   in the stage's copy, which is writable, as the scratch directory is.
   It asks nothing and its words are not fenced: the sandbox is the fence. Its output is
   kept from the end, as check's is, and it is killed if it floods. The
   exit status comes first, as in check and run; a sandbox that can't
   be made is an error, never a command run outside it. *)
proc shell(const a: Args; mem: ^Mem.Allocator; var out: Buf.Buf);
var cmd: []const U8; got: Buf.Buf; j: Arun.Job; limit, status: INT; cut, flooded, clipped: BOOL;
begin
    (* a call is not always of a tool offered: a one-shot call, or a name the model made up *)
    if not shellOn() then
        Buf.str(out, "error: shell is not on offer: it runs only staged (safety auto), in the jail");
        return;
    end;
    cmd := Str.trim(str(a, "command"));
    if LEN(cmd) = 0 then Buf.str(out, "error: give the command line as command"); return; end;
    limit := int(a, "timeout", ShellTimeout);
    if limit < 1 then limit := ShellTimeout; end;
    clipped := limit > ShellMost;
    if clipped then limit := ShellMost; end;
    Buf.init(got, mem);
    j := {args: ["/bin/sh", "-c", cmd], env: [scratchVar(mem)], dir: Afence.zone, detach: true, tail: true,
        timeout: limit, flood: ShellFlood};
    jailed(j, mem);
    status, cut, flooded := Arun.start(j, MaxOut - 1000, got);
    if status < 0 then Buf.str(out, "error: cannot start /bin/sh"); return; end;
    if unjailed(status, got, out) then return; end;
    if clipped then Fmt.write(out, "(timeout cut to {} s, the most allowed)\n", [Fmt.int(limit)]); end;
    if Arun.stopped() then
        Fmt.write(out, "stopped by the human: {}", [Fmt.str(cmd)]);
    elsif flooded then
        Fmt.write(out, "killed: more than {} MB of output; the last of it:", [Fmt.int(ShellFlood div 1048576)]);
    elsif status = 124 then
        Fmt.write(out, "timed out after {} s: {}", [Fmt.int(limit), Fmt.str(cmd)]);
    else
        Fmt.write(out, "exit {}: {}", [Fmt.int(status), Fmt.str(cmd)]);
    end;
    if LEN(Str.trimRight(Buf.bytes(got))) > 0 then
        Buf.add(out, '\n');
        if cut then Buf.str(out, "[...]\n"); end;
        Buf.str(out, Str.trimRight(Buf.bytes(got)));
    end;
end;

(* s added to b as one word for sh: in single quotes, each one in it
   closed, escaped and opened again. *)
proc shellWord(var b: Buf.Buf; s: []const U8);
begin
    Buf.add(b, '\'');
    Str.replace(b, s, "'", "'\\''");
    Buf.add(b, '\'');
end;

(* Whether the files check was given are fit to go into a command: each
   inside the fence, existing, and no option's look. If not, why is
   added to out. *)
proc filesFit(files: [][]const U8; var out: Buf.Buf): BOOL;
var i: INT;
begin
    for i := 0 to LEN(files) - 1 do
        if Str.hasPrefix(files[i], "-") then
            Fmt.write(out, "error: {} may not start with -", [Fmt.str(files[i])]);
        elsif not Afence.inside(files[i]) then
            Fmt.write(out, "error: {} is outside the project", [Fmt.str(files[i])]);
        elsif Sys.access(files[i], {}) # 0 then
            Fmt.write(out, "error: {} does not exist", [Fmt.str(files[i])]);
        else
            continue;
        end;
        return false;
    end;
    return true;
end;

(* The command of check's call, added to cmd: the project's own test
   command if the call names no check, which takes no files; else the
   named check's, its {} made the files, quoted, parted by blanks, or
   nothing if there are none. False, and why added to out, if the check
   or the files are unfit. quoted is scratch for the quoted files. *)
proc checkCmd(const a: Args; var quoted, cmd, out: Buf.Buf): BOOL;
var name, command: []const U8; files: [][]const U8; i: INT;
begin
    name := str(a, "name");
    files := list(a, "files");
    if LEN(name) = 0 then
        command := testFor(quoted);
        if LEN(command) = 0 then
            Buf.str(out, "error: no test command for this project; ask the human to run /test COMMAND once");
            return false;
        end;
        if LEN(files) > 0 then
            Buf.str(out, "error: the project's own check takes no files; name a check that has {}");
            return false;
        end;
        Buf.str(cmd, command);
        return true;
    end;
    command := checkCommand(name);
    if LEN(command) = 0 then
        Fmt.write(out, "error: there is no check named {}; the checks are:", [Fmt.str(name)]);
        for i := 0 to checkNames.len - 1 do
            Buf.add(out, ' ');
            Buf.str(out, Strs.all(checkNames)[i]);
        end;
        return false;
    end;
    if (LEN(files) > 0) and (Str.find(command, "{}") < 0) then
        Fmt.write(out, "error: check {} takes no files: its command has no {}", [Fmt.str(name), Fmt.str("{}")]);
        return false;
    end;
    if not filesFit(files, out) then return false; end;
    Buf.reset(quoted);
    for i := 0 to LEN(files) - 1 do
        if i > 0 then Buf.add(quoted, ' '); end;
        shellWord(quoted, files[i]);
    end;
    Str.replace(cmd, command, "{}", Buf.bytes(quoted));
    return true;
end;

(* The 'check' tool: a test command run, and how it went, so that the
   model sees its own edit break the build and fixes it without the
   human passing the errors on. The command is always the human's, the
   project's (testFor) or a named check's (config's check.NAME); the
   model chooses which, and the files that fill its {}, never what, so
   it runs without asking. The verdict comes first, as a runner's
   output doesn't always say; the output is kept from the end, where a
   build's or a test's summary and the error that matters are. While
   the stage is up it runs in the copy, whose files the model may edit
   unasked, and so in the jail (confine). *)
proc check(const a: Args; mem: ^Mem.Allocator; var out: Buf.Buf);
var quoted, cmdBuf, got: Buf.Buf; cmd: []const U8; j: Arun.Job; status: INT; cut: BOOL;
begin
    Buf.init(quoted, mem);
    Buf.init(cmdBuf, mem);
    Buf.init(got, mem);
    if not checkCmd(a, quoted, cmdBuf, out) then return; end;
    cmd := Buf.bytes(cmdBuf);
    j := {args: ["sh", "-c", cmd], env: [scratchVar(mem)], detach: true, tail: true};
    confine(j, mem);
    status, cut, _ := Arun.start(j, MaxOut - 1000, got);
    if unjailed(status, got, out) then return; end;
    if status = 0 then
        Fmt.write(out, "passed: {}", [Fmt.str(cmd)]);
    else
        Fmt.write(out, "FAILED, exit {}: {}", [Fmt.int(status), Fmt.str(cmd)]);
    end;
    if got.len > 0 then
        Buf.str(out, "\n\n");
        if cut then Buf.str(out, "[...]\n"); end;
        Buf.str(out, Buf.bytes(got));
    end;
end;

(* Changes *)

(* Whether the human approves question, shown detail first. If not,
   what is added to out says so: the reason, if they give one, after
   "declined by user", and that nothing was changed. *)
proc approve(const h: Human; question, detail: []const U8; var out: Buf.Buf): BOOL;
begin
    if h.ask = nil then
        Buf.str(out, "declined: there is nobody to approve the change. Nothing was changed.");
        return false;
    end;
    if h.ask(question, detail, "yn") = 'y' then return true; end;
    declined(h, "Nothing was changed: the file is as it was before.", out);
    return false;
end;

(* The lines of s, the last counted if it has no line feed. *)
proc lines(s: []const U8): INT;
var n, i: INT;
begin
    n := 0;
    for i := 0 to LEN(s) - 1 do
        if s[i] = '\n' then INC(n); end;
    end;
    if (LEN(s) > 0) and (s[LEN(s) - 1] # '\n') then INC(n); end;
    return n;
end;

(* Each line of s, at most max of them, added to b after mark, as a
   diff marks what goes and what comes. *)
proc marked(var b: Buf.Buf; mark: U8; s: []const U8; max: INT);
var line, rest: []const U8; n: INT;
begin
    rest := s;
    n := 0;
    while LEN(rest) > 0 do
        if n = max then
            Fmt.write(b, "{}[{} more lines]\n", [Fmt.char(mark), Fmt.int(lines(rest))]);
            return;
        end;
        line, rest, _ := Str.cut(rest, "\n");
        Buf.add(b, mark);
        Buf.str(b, line);
        Buf.add(b, '\n');
        INC(n);
    end;
end;

(* The times sub occurs in s, none overlapping. *)
proc count(s, sub: []const U8): INT;
var n, i, at: INT;
begin
    n := 0;
    at := 0;
    i := Str.find(s, sub);
    while i >= 0 do
        INC(n);
        INC(at, i + LEN(sub));
        i := Str.find(s[at..LEN(s)], sub);
    end;
    return n;
end;

(* The directories path is in made, as mkdir -p makes them: false if
   one can't be. *)
proc makeDirs(path: []const U8): BOOL;
var i, e: INT;
begin
    for i := 1 to LEN(path) - 1 do
        if path[i] = '/' then
            e := Sys.makeDir(path[0..i]);
            if (e # 0) and (e # -17) then return false; end;   (* -17: there already *)
        end;
    end;
    return true;
end;

(* s's lines pushed on l, without their line feeds. *)
proc split(s: []const U8; var l: Strs.Vec);
var line: []const U8;
begin
    while LEN(s) > 0 do
        line, s, _ := Str.cut(s, "\n");
        Strs.push(l, line);
    end;
end;

(* The blanks and tabs a line starts with. *)
proc blanks(s: []const U8): INT;
var n: INT;
begin
    n := 0;
    while (n < LEN(s)) and ((s[n] = ' ') or (s[n] = '\t')) do INC(n); end;
    return n;
end;

(* When old isn't in the file s, at path, but is if the blanks at the
   start and end of each line are let go, the error says where, how the
   blanks differ first, and what to do; nothing is added to out otherwise.
   Lines are compared whole, so old that starts or ends inside a line
   never matches here. A model told only "not found" tends to send the
   same edit again. *)
proc nearMiss(old, path, s: []const U8; mem: ^Mem.Allocator; var out: Buf.Buf);
var o, f: Strs.Vec; ol, fl: [][]const U8; n, i, k, at, hits, first: INT;
begin
    Strs.init(o, mem);
    Strs.init(f, mem);
    split(old, o);
    split(s, f);
    ol := Strs.all(o);
    fl := Strs.all(f);
    n := LEN(ol);
    first := 0;
    while (first < n) and (LEN(Str.trim(ol[first])) = 0) do INC(first); end;
    if first = n then return; end;
    hits := 0;
    at := -1;
    for i := 0 to LEN(fl) - n do
        k := 0;
        while (k < n) and (Str.trim(ol[k]) = Str.trim(fl[i + k])) do INC(k); end;
        if k = n then
            INC(hits);
            if at < 0 then at := i; end;
        end;
    end;
    if hits = 0 then return; end;
    if n = 1 then
        Fmt.write(out, "error: old text not found in {}, but line {} holds it", [Fmt.str(path), Fmt.int(at + 1)]);
    else
        Fmt.write(out, "error: old text not found in {}, but lines {}-{} hold it",
            [Fmt.str(path), Fmt.int(at + 1), Fmt.int(at + n)]);
    end;
    Buf.str(out, " with other blanks at the starts or ends of lines");
    k := first;
    while (k < n) and (blanks(fl[at + k]) = blanks(ol[k])) do INC(k); end;
    if k < n then
        Fmt.write(out, ": line {} starts with {} blanks, and old's line {} with {}",
            [Fmt.int(at + k + 1), Fmt.int(blanks(fl[at + k])), Fmt.int(k + 1), Fmt.int(blanks(ol[k]))]);
    end;
    Buf.str(out, ". read shows each line after its number and a tab, which are not part of the line: " +
        "copy old again from those lines");
    if hits > 1 then
        Fmt.write(out, " (they occur {} times; give more lines to choose one)", [Fmt.int(hits)]);
    end;
end;

(* edit: old replaced by new in the file path, once, or everywhere if
   all; or, with old empty, the file made, holding new. Written in
   place, so that the file's mode and its links survive. *)
proc edit(const a: Args; const h: Human; mem: ^Mem.Allocator; var out: Buf.Buf);
var p, old, new, s: []const U8; text, diff, q, b: Buf.Buf; i: Sys.Info; e, n, at: INT; all: BOOL;
begin
    p := path(a, "path");
    old := str(a, "old");
    new := str(a, "new");
    all := flag(a, "all");
    Buf.init(text, mem);
    Buf.init(diff, mem);
    Buf.init(q, mem);
    Buf.init(b, mem);
    if LEN(p) = 0 then
        Buf.str(out, "error: give the path of the file");
        return;
    end;
    i, e := Sys.info(p);
    if LEN(old) = 0 then
        if e = 0 then
            Fmt.write(out, "error: {} exists; to change it, read it and give old text to replace", [Fmt.str(p)]);
            return;
        end;
        n := 1;
        Fmt.write(q, "create {}?", [Fmt.str(p)]);
    else
        if (e = 0) and i.dir then
            Fmt.write(out, "error: {} is a directory", [Fmt.str(p)]);
            return;
        end;
        if (e # 0) or not i.file or (i.size > MaxFile) or (load(p, h.stopped, text) # 0) then
            Fmt.write(out, "error: cannot read {} (no such file? use find to locate it)", [Fmt.str(p)]);
            return;
        end;
        s := Buf.bytes(text);
        n := count(s, old);
        if n = 0 then
            nearMiss(old, p, s, mem, out);
            if out.len = 0 then
                Fmt.write(out, "error: old text not found in {}. It must match the file exactly, whitespace " +
                    "included: read the file again and copy old from it", [Fmt.str(p)]);
            end;
            return;
        end;
        if (n > 1) and not all then
            Fmt.write(out, "error: old text occurs {} times in {}; add surrounding lines to old to make it " +
                "unique, or set all to replace every one", [Fmt.int(n), Fmt.str(p)]);
            return;
        end;
        at := Str.find(s, old);
        if n = 1 then
            Fmt.write(q, "apply edit to {} at line {}?", [Fmt.str(p), Fmt.int(count(s[0..at], "\n") + 1)]);
        else
            Fmt.write(q, "apply edit to {}, in {} places?", [Fmt.str(p), Fmt.int(n)]);
        end;
        marked(diff, '-', old, MaxFile);
    end;
    marked(diff, '+', new, MaxFile);
    if not Afence.ours(p) and not approve(h, Buf.bytes(q), Buf.bytes(diff), out) then return; end;
    if Apeer.reachable() and not Afence.ours(p) and throughEditor(p, old, new, all, h, out) then return; end;
    if LEN(old) = 0 then
        Buf.str(b, new);
        if not makeDirs(p) then
            Fmt.write(out, "error: cannot make the directory of {}", [Fmt.str(p)]);
            return;
        end;
    elsif all then
        Str.replace(b, s, old, new);
    else
        Buf.str(b, s[0..at]);
        Buf.str(b, new);
        Buf.str(b, s[at + LEN(old)..LEN(s)]);
    end;
    if not Files.write(p, Buf.bytes(b)) then
        Fmt.write(out, "error: cannot write {}", [Fmt.str(p)]);
        return;
    elsif LEN(old) = 0 then
        Fmt.write(out, "ok: created {}", [Fmt.str(p)]);
    else
        Fmt.write(out, "ok: {} replaced", [Fmt.int(n)]);
    end;
    Alsp.diagnose(p, Buf.bytes(b), out);
end;

(* Whether path is a file that move and remove may take; if not, why
   is added to out. A directory is refused: removing one is the one
   mistake here that could take a whole tree with it. *)
proc movable(p: []const U8; const h: Human; var out: Buf.Buf): BOOL;
var i: Sys.Info; e: INT; full, text: Buf.Buf;
begin
    i, e := Sys.info(p);
    if (e = 0) and i.dir then
        Fmt.write(out, "error: {} is a directory; only single files can be moved or removed", [Fmt.str(p)]);
        return false;
    end;
    if e # 0 then
        Fmt.write(out, "error: no file {} (use find to locate it)", [Fmt.str(p)]);
        return false;
    end;
    if Apeer.reachable() then
        Buf.init(full, Heap.heap);
        defer Buf.done(full);
        Buf.init(text, Heap.heap);
        defer Buf.done(text);
        if Apeer.contents(Apeer.absolute(p, full), h.stopped, text) then
            Fmt.write(out, "error: {} is open in the editor; ask the human to close it there first", [Fmt.str(p)]);
            return false;
        end;
    end;
    return true;
end;

(* move: the file path renamed to dest, the argument to, into a new directory if need be.
   Never onto a file that is there: an overwrite is a removal the human
   wasn't shown. A rename, so that a move across file systems fails and
   says so. *)
proc move(const a: Args; const h: Human; mem: ^Mem.Allocator; var out: Buf.Buf);
var p, dest: []const U8; q: Buf.Buf; e: INT;
begin
    p := path(a, "path");
    dest := path(a, "to");
    if not movable(p, h, out) then return; end;
    if LEN(dest) = 0 then
        Buf.str(out, "error: to, the new path, is required");
        return;
    end;
    _, e := Sys.linkInfo(dest);
    if e = 0 then
        Fmt.write(out, "error: {} exists; give a path that does not, the whole path including the name", [Fmt.str(dest)]);
        return;
    end;
    Buf.init(q, mem);
    Fmt.write(q, "move {} to {}?", [Fmt.str(p), Fmt.str(dest)]);
    if not (Afence.ours(p) and Afence.ours(dest)) and not approve(h, Buf.bytes(q), "", out) then return; end;
    if not makeDirs(dest) then
        Fmt.write(out, "error: cannot make the directory of {}", [Fmt.str(dest)]);
        return;
    end;
    e := Sys.rename(p, dest);
    if e # 0 then
        Fmt.write(out, "error: cannot move {} to {} (errno {})", [Fmt.str(p), Fmt.str(dest), Fmt.int(-e)]);
        return;
    end;
    Fmt.write(out, "ok: moved {} to {}", [Fmt.str(p), Fmt.str(dest)]);
end;

(* remove: the file path deleted, once the human has seen what it
   holds, as an edit that empties it would show it, so that a slip of
   the path is seen for what it is. *)
proc remove(const a: Args; const h: Human; mem: ^Mem.Allocator; var out: Buf.Buf);
var p, s: []const U8; text, diff, q: Buf.Buf; e: INT;
begin
    p := path(a, "path");
    if not movable(p, h, out) then return; end;
    Buf.init(text, mem);
    Buf.init(diff, mem);
    Buf.init(q, mem);
    if Files.load(p, text) = 0 then
        s := Buf.bytes(text);
        if LEN(s) > 8192 then s := s[0..8192]; end;
        if Str.find(s, "\x00") >= 0 then
            Buf.str(diff, "(binary)\n");
        else
            marked(diff, '-', Buf.bytes(text), MaxShown);
        end;
    end;
    Fmt.write(q, "remove {}?", [Fmt.str(p)]);
    if not Afence.ours(p) and not approve(h, Buf.bytes(q), Buf.bytes(diff), out) then return; end;
    e := Sys.remove(p);
    if e # 0 then
        Fmt.write(out, "error: cannot remove {} (errno {})", [Fmt.str(p), Fmt.int(-e)]);
        return;
    end;
    Fmt.write(out, "ok: removed {}", [Fmt.str(p)]);
end;

proc keep(s: []const U8): []U8;
var c: []U8; ok: BOOL;
begin
    c, ok := Str.copy(Heap.heap, s);
    if not ok then Rt.stop("arno: out of memory"); end;
    return c;
end;

(* The host's tools *)

type
    (* Runs the host's tool name on args, as the model wrote them: the
       result for the model, good until the next call. *)
    HostCall* = proc(name, args: []const U8; arg: ^U8): []const U8;

var
    hosted: Tools.Vec;   (* the host's tools, kept from Heap *)
    hostCall: HostCall;  (* runs one; nil with no host *)
    hostArg: ^U8;
    allowed: []U8;       (* the builtins the host allows, a blank at each end of each; "" for all *)
    limited: BOOL;       (* the host named the builtins it allows *)

var   (* the skills, two shelves (skills, below) *)
    skillDir: []U8;    (* where the human's own are, each NAME.md; "" for none *)
    skillMine: []U8;   (* their names, blank-separated *)
    skillProject: []U8;   (* where the project's are, arno-claude's; "" for none *)
    skillList: []U8;   (* the skills skill may read, both shelves', blank-separated; "" for none, when it isn't offered *)
    skillTool: Awire.Tool;  (* skill as offered, its description listing the skills and its schema limiting name to them *)
    skillBufs: [2]Buf.Buf;  (* what skillTool's description and params are slices of *)

(* Whether the host has a tool called name. *)
proc isHost(name: []const U8): BOOL;
var t: []Awire.Tool; i: INT;
begin
    t := Tools.all(hosted);
    for i := 0 to LEN(t) - 1 do
        if t[i].name = name then return true; end;
    end;
    return false;
end;

(* Whether a builtin tool called name may be offered and called: all
   may, unless the host named those it allows. A builtin left out is
   gone, not only unoffered, so that a model that calls it anyway
   learns there is no such tool. *)
proc usable(name: []const U8): BOOL;
var b: Buf.Buf; yes: BOOL;
begin
    if not limited then return true; end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.add(b, ' ');
    Buf.str(b, name);
    Buf.add(b, ' ');
    yes := Str.find(allowed, Buf.bytes(b)) >= 0;
    return yes;
end;

(* Whether name is one of arno's own tools, offered or not. *)
proc builtin(name: []const U8): BOOL;
var i: INT;
begin
    for i := 0 to LEN(Offered) - 1 do
        if Offered[i].name = name then return true; end;
    end;
    return false;
end;

(* res told there is no tool called name, and which there are: an
   invented name gets the real ones back, the one thing it lacked. *)
proc unknown(name: []const U8; var res: Buf.Buf);
var i: INT;
begin
    Buf.str(res, "error: there is no tool named \"");
    Buf.str(res, name);
    Buf.str(res, "\". The tools are:");
    for i := 0 to LEN(Offered) - 1 do
        if usable(Offered[i].name) and (Apeer.reachable() or (Offered[i].name # "editor") and (Offered[i].name # "open")) and
            ((LEN(skillList) > 0) or (Offered[i].name # "skill")) then
            Buf.add(res, ' ');
            Buf.str(res, Offered[i].name);
        end;
    end;
    for i := 0 to LEN(Amcp.tools()) - 1 do
        Buf.add(res, ' ');
        Buf.str(res, Amcp.tools()[i].name);
    end;
    for i := 0 to hosted.len - 1 do
        Buf.add(res, ' ');
        Buf.str(res, Tools.all(hosted)[i].name);
    end;
end;

var refusal: Buf.Buf;   (* addHost's reason, good until the next *)

(* "tool NAME why", in refusal. *)
proc refuse(name, why: []const U8): []const U8;
begin
    Buf.reset(refusal);
    Fmt.write(refusal, "tool {} {}", [Fmt.str(name), Fmt.str(why)]);
    return Buf.bytes(refusal);
end;

(* The host's tools run by run, with arg: its tools offered from now
   on, and called through it. *)
proc hosting*(run: HostCall; arg: ^U8);
begin
    hostCall := run;
    hostArg := arg;
end;

(* The host's tool name, which description and params (a JSON schema,
   "" for none) tell the model of: "" if it is taken, else why it
   isn't, "tool NAME ..." in the words a host is told. A name already
   arno's own, or an MCP server's, is refused rather than shadowed, since the model couldn't
   tell which of the two it was calling. *)
proc addHost*(name, description, params: []const U8): []const U8;
begin
    if LEN(name) = 0 then return "a tool needs a name"; end;
    if builtin(name) then return refuse(name, "is already arno's own"); end;
    if isHost(name) then return refuse(name, "is already the host's"); end;
    if Amcp.owns(name) then return refuse(name, "is already an MCP server's"); end;
    if LEN(params) = 0 then params := `{"type":"object","properties":{}}`; end;
    Tools.push(hosted, {name: keep(name), description: keep(description), params: keep(params)});
    return "";
end;

(* The builtin tools the host allows, names parted by blanks; only
   those are offered or run. Not called, all are. *)
proc allow*(names: []const U8);
var b: Buf.Buf; n, rest: []const U8;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.add(b, ' ');
    rest := names;
    while LEN(Str.trim(rest)) > 0 do
        n, rest := Str.field(Str.trim(rest));
        Buf.str(b, n);
        Buf.add(b, ' ');
    end;
    Str.free(Heap.heap, allowed);
    allowed := keep(Buf.bytes(b));
    limited := true;
end;

(* The web *)

var
    searx: []U8;       (* the SearXNG search goes through, as config's searxng says; "" for none *)
    web: Http.Client;  (* search's and fetch's, made at the first *)
    webbed: BOOL;      (* web is made *)
    offer: Tools.Vec;  (* what offered gives *)
    workerList: []U8;  (* the models delegate may name, blank-separated; "" for none *)
    workerTool: Awire.Tool;  (* delegate as offered, its description listing workerList and its schema limiting model to it *)
    workerBufs: [2]Buf.Buf;  (* what workerTool's description and params are slices of *)
    roleDir: []U8;     (* where the roles are, each NAME.md; "" for none *)
    roleList: []U8;    (* the roles delegate may name, blank-separated; "" for none *)

(* search through the SearXNG at url, as config's searxng says; "" for
   none, when search isn't offered. *)
proc search*(url: []const U8);
begin
    Str.free(Heap.heap, searx);
    searx := keep(url);
    while Str.hasSuffix(searx, "/") do searx := searx[0..LEN(searx) - 1]; end;
end;

(* The models delegate may name, blank-separated in list, def the one
   it runs on when none is named, and p the session's provider, whose
   price config may give: delegate's description then ends in each model
   and its list price in and out per million tokens, if known, for the
   lead to weigh a step against, and its schema limits model to them.
   list "" for none. *)
proc workers*(list, def: []const U8; const p: Awire.Prov);
var m: Awire.Prov; pr: Aprice.Price; known: BOOL; enum, with: Buf.Buf; w, rest: []const U8; t: Awire.Tool; i: INT;
begin
    Str.free(Heap.heap, workerList);
    workerList := keep(list);
    for i := 0 to LEN(Offered) - 1 do
        if Offered[i].name = "delegate" then t := Offered[i]; end;
    end;
    Buf.done(workerBufs[0]);
    Buf.done(workerBufs[1]);
    Buf.init(workerBufs[0], Heap.heap);
    Buf.init(workerBufs[1], Heap.heap);
    Buf.init(enum, Heap.heap);
    defer Buf.done(enum);
    Buf.init(with, Heap.heap);
    defer Buf.done(with);
    Fmt.write(workerBufs[0], "{} Name the model in model, a stronger one for a hard or delicate step, a cheaper " +
        "one for mechanical work; {} runs it if you name none. Models:", [Fmt.str(t.description), Fmt.str(def)]);
    m := p;
    w, rest := Str.field(list);
    while LEN(w) > 0 do
        if enum.len > 0 then Buf.add(enum, ','); end;
        Fmt.write(enum, `"{}"`, [Fmt.str(w)]);
        m.model := w;
        pr, known := Aprice.price(m);
        Fmt.write(workerBufs[0], "\n- {}", [Fmt.str(w)]);
        if known then
            Fmt.write(workerBufs[0], " (${} in, ${} out per million tokens)", [Fmt.real(pr.inp, 2), Fmt.real(pr.out, 2)]);
        end;
        w, rest := Str.field(rest);
    end;
    Buf.str(with, `"model":{"type":"string","enum":[`);   (* not Fmt: it reads a brace as its own *)
    Buf.str(with, Buf.bytes(enum));
    Buf.str(with, "]");
    Str.replace(workerBufs[1], t.params, `"model":{"type":"string"`, Buf.bytes(with));
    workerTool := {name: t.name, description: Buf.bytes(workerBufs[0]), params: Buf.bytes(workerBufs[1])};
end;

(* Shelves: a directory of NAME.md files, each one's first line what it
   is for and the rest its text. The roles a worker may be given and the
   skills a model may read are each a shelf. *)

(* Whether name may stand on a shelf: not empty, and only letters,
   digits and -_. so it can be listed among blanks and written in a
   schema as it is. *)
proc plainName(name: []const U8): BOOL;
var i: INT;
begin
    if LEN(name) = 0 then return false; end;
    for i := 0 to LEN(name) - 1 do
        match name[i] of
        | 'a'..'z', 'A'..'Z', '0'..'9', '-', '_', '.':
        | else: return false;
        end;
    end;
    return true;
end;

(* Whether name is one of names, blank-separated. *)
proc among(names, name: []const U8): BOOL;
var w, rest: []const U8;
begin
    w, rest := Str.field(names);
    while LEN(w) > 0 do
        if w = name then return true; end;
        w, rest := Str.field(rest);
    end;
    return false;
end;

(* The NAME.md files of dir, added to names (blank-separated), enum (the
   names as a JSON enum's strings, comma-separated) and listed (a line
   "- NAME: what it is for" each); a name already in names, from a shelf
   read before, is passed over. A directory that can't be opened has
   none. *)
proc shelf(dir: []const U8; var names, enum, listed: Buf.Buf);
var d: Sys.Dir; name, first: []const U8; more: BOOL; path, text: Buf.Buf;
begin
    if Sys.openDir(d, dir) < 0 then return; end;
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    Buf.init(text, Heap.heap);
    defer Buf.done(text);
    name, more := Sys.nextEntry(d);
    while more do
        Buf.reset(path);
        Fmt.write(path, "{}/{}", [Fmt.str(dir), Fmt.str(name)]);
        Buf.reset(text);
        if Str.hasSuffix(name, ".md") and plainName(name[0..LEN(name) - 3]) and
            not among(Buf.bytes(names), name[0..LEN(name) - 3]) and (Files.load(Buf.bytes(path), text) = 0) then
            name := name[0..LEN(name) - 3];
            first, _, _ := Str.cut(Buf.bytes(text), "\n");
            if enum.len > 0 then Buf.add(enum, ','); Buf.add(names, ' '); end;
            Fmt.write(enum, `"{}"`, [Fmt.str(name)]);
            Buf.str(names, name);
            Fmt.write(listed, "\n- {}: {}", [Fmt.str(name), Fmt.str(Str.trim(first))]);
        end;
        name, more := Sys.nextEntry(d);
    end;
    Sys.closeDir(d);
end;

(* The text of name on the shelf dir, whose names are names: its file
   but the first line, added to b; false if it is none of names or can't
   be read. *)
proc shelved(dir, names, name: []const U8; var b: Buf.Buf): BOOL;
var rest: []const U8; path, text: Buf.Buf;
begin
    if not among(names, name) then return false; end;
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    Buf.init(text, Heap.heap);
    defer Buf.done(text);
    Fmt.write(path, "{}/{}.md", [Fmt.str(dir), Fmt.str(name)]);
    if Files.load(Buf.bytes(path), text) # 0 then return false; end;
    _, rest, _ := Str.cut(Buf.bytes(text), "\n");
    Buf.str(b, Str.trim(rest));
    return true;
end;

(* The roles in dir, a shelf: delegate, as workers made it, then lists
   them and takes role, one of them, whose instructions the worker gets
   with its brief (roleText). Called after workers; with no workers, or
   no roles in dir, it changes nothing. *)
proc roles*(dir: []const U8);
var enum, names, listed, with, params: Buf.Buf;
begin
    Str.free(Heap.heap, roleDir);
    Str.free(Heap.heap, roleList);
    roleDir := keep(dir);
    roleList := keep("");
    if LEN(workerList) = 0 then return; end;
    Buf.init(enum, Heap.heap);
    defer Buf.done(enum);
    Buf.init(listed, Heap.heap);
    defer Buf.done(listed);
    Buf.init(names, Heap.heap);
    defer Buf.done(names);
    shelf(dir, names, enum, listed);
    if enum.len = 0 then return; end;
    Str.free(Heap.heap, roleList);
    roleList := keep(Buf.bytes(names));
    Buf.str(workerBufs[0], "\n\nA role is standing instructions for a kind of work, written for this project: " +
        "name one in role when the step is that kind of work, and the worker gets them with your brief. Roles:");
    Buf.str(workerBufs[0], Buf.bytes(listed));
    Buf.init(with, Heap.heap);
    defer Buf.done(with);
    Buf.str(with, `"properties":{"role":{"type":"string","enum":[`);
    Buf.str(with, Buf.bytes(enum));
    Buf.str(with, `],"description":"the role whose instructions the worker gets; none if left out"},`);
    Buf.init(params, Heap.heap);
    defer Buf.done(params);
    Str.replace(params, Buf.bytes(workerBufs[1]), `"properties":{`, Buf.bytes(with));
    Buf.reset(workerBufs[1]);
    Buf.str(workerBufs[1], Buf.bytes(params));
    workerTool := {name: workerTool.name, description: Buf.bytes(workerBufs[0]), params: Buf.bytes(workerBufs[1])};
end;

(* role's instructions, its file but its first line, added to b: false
   if it is no role delegate offers. *)
proc roleText*(role: []const U8; var b: Buf.Buf): BOOL;
begin
    return shelved(roleDir, roleList, role, b);
end;

(* The skills, how-tos for a kind of work, on two shelves: mine, the
   human's own, kept for every project, and project, the project's (its
   Claude Code skills, which arno-claude writes); the human's wins a
   name. skill is offered with them listed, each with when to read it,
   and gives one's text when the model asks: a long how-to then costs
   nothing until the work needs it. With none, skill isn't offered. *)
proc skills*(mine, project: []const U8);
var enum, names, listed: Buf.Buf; t: Awire.Tool; i: INT;
begin
    Str.free(Heap.heap, skillDir);
    Str.free(Heap.heap, skillMine);
    Str.free(Heap.heap, skillProject);
    Str.free(Heap.heap, skillList);
    skillDir := keep(mine);
    skillProject := keep(project);
    Buf.init(enum, Heap.heap);
    defer Buf.done(enum);
    Buf.init(listed, Heap.heap);
    defer Buf.done(listed);
    Buf.init(names, Heap.heap);
    defer Buf.done(names);
    shelf(mine, names, enum, listed);
    skillMine := keep(Buf.bytes(names));
    shelf(project, names, enum, listed);
    skillList := keep(Buf.bytes(names));
    for i := 0 to LEN(Offered) - 1 do
        if Offered[i].name = "skill" then t := Offered[i]; end;
    end;
    Buf.done(skillBufs[0]);
    Buf.done(skillBufs[1]);
    Buf.init(skillBufs[0], Heap.heap);
    Buf.init(skillBufs[1], Heap.heap);
    Buf.str(skillBufs[0], t.description);
    Buf.str(skillBufs[0], " Skills:");
    Buf.str(skillBufs[0], Buf.bytes(listed));
    Buf.str(skillBufs[1], `{"type":"object","properties":{"name":{"type":"string","enum":[`);
    Buf.str(skillBufs[1], Buf.bytes(enum));
    Buf.str(skillBufs[1], `],"description":"the skill to read"}},"required":["name"]}`);
    skillTool := {name: t.name, description: Buf.bytes(skillBufs[0]), params: Buf.bytes(skillBufs[1])};
end;

(* skill's call: the text of the skill a names, from the human's shelf
   if it is there, else the project's; or what the skills are. *)
proc skill(const a: Args; var out: Buf.Buf);
var found: BOOL;
begin
    if among(skillMine, str(a, "name")) then
        found := shelved(skillDir, skillMine, str(a, "name"), out);
    else
        found := shelved(skillProject, skillList, str(a, "name"), out);
    end;
    if not found then
        Fmt.write(out, "error: {} is not a skill; the skills are: {}", [Fmt.str(str(a, "name")), Fmt.str(skillList)]);
    end;
end;

(* The roles delegate may name, blank-separated. *)
proc roleNames*(): []const U8;
begin
    return roleList;
end;

(* Whether delegate may name model. *)
proc isWorker*(model: []const U8): BOOL;
var w, rest: []const U8;
begin
    w, rest := Str.field(workerList);
    while LEN(w) > 0 do
        if w = model then return true; end;
        w, rest := Str.field(rest);
    end;
    return false;
end;

(* The models delegate may name, blank-separated. *)
proc workerModels*(): []const U8;
begin
    return workerList;
end;

(* t, the delegate tool, as offered: with the models listed, once workers
   was given them. *)
proc delegateOffer(t: Awire.Tool): Awire.Tool;
begin
    if LEN(workerList) = 0 then return t; end;
    return workerTool;
end;

(* s added to b with every byte but a letter, a digit and -._~
   written %XX, as a URL's query wants it. *)
proc escape(var b: Buf.Buf; s: []const U8);
var i: INT;
begin
    for i := 0 to LEN(s) - 1 do
        match s[i] of
        | 'a' .. 'z', 'A' .. 'Z', '0' .. '9', '-', '.', '_', '~': Buf.add(b, s[i]);
        | else: Fmt.write(b, "%{}{}", [Fmt.char(Hex[s[i] shr 4]), Fmt.char(Hex[s[i] & 15])]);
        end;
    end;
end;

(* The page at url read, its body into body, at most MaxPage bytes of
   it: its Content-Type, or why it can't be. A page that never comes
   mustn't hold the turn: WebWait seconds is all it gets. *)
proc page(url: []const U8; mem: ^Mem.Allocator; var body: Buf.Buf): ([]const U8, ERROR);
var req, res: Http.Message; r: ^Http.Reader; n: INT; err: ERROR;
begin
    if not webbed then
        Awire.initClient(web);
        webbed := true;
    end;
    web.deadline := Sys.clock() + I64(WebWait) * 1000000000;
    Http.init(res, mem);
    req := {method: "GET", minor: 1};
    _ := Http.add(req, "User-Agent", "arno");
    _ := Http.add(req, "Accept", "text/html, text/plain;q=0.9, */*;q=0.8");
    r := try Http.open(web, req, url, res);
    while body.len < MaxPage do
        n, err := Http.read(r^, Buf.spare(body, MaxPage - body.len));
        if err # nil then
            Http.doneClient(web);
            return "", err;
        end;
        if n = 0 then break; end;
        INC(body.len, n);
    end;
    if body.len >= MaxPage then Http.doneClient(web); end;   (* the rest isn't read *)
    if res.status >= 400 then
        Buf.reset(body);
        Fmt.write(body, "the server answered {} {}", [Fmt.int(res.status), Fmt.str(res.reason)]);
        return "", Failed;
    end;
    return Http.header(res, "Content-Type"), nil;
end;

(* search: the first MaxResults of what SearXNG finds for the query,
   each its title, its URL and a snippet. *)
proc searchWeb(const a: Args; mem: ^Mem.Allocator; var out: Buf.Buf);
var url, body: Buf.Buf; d: Json.Doc; v, r, x: Json.Value; i: INT; err: ERROR;
begin
    Buf.init(url, mem);
    Buf.init(body, mem);
    Buf.str(url, searx);
    Buf.str(url, "/search?format=json&q=");
    escape(url, str(a, "query"));
    _, err := page(Buf.bytes(url), mem, body);
    if err = Failed then
        Fmt.write(out, "error: search failed: {}", [Fmt.str(Buf.bytes(body))]);
        return;
    elsif err # nil then
        Fmt.write(out, "error: search failed: {}", [Fmt.str(MSG(err))]);
        return;
    end;
    if not Json.init(SYSTEM.ADR(d), mem) then return; end;
    v := Json.parse(SYSTEM.ADR(d), Buf.bytes(body));
    r := Json.member(SYSTEM.ADR(d), v, "results");
    if Json.kind(SYSTEM.ADR(d), r) # Json.Kind.array then
        i := body.len;
        if i > 200 then i := 200; end;
        Fmt.write(out, "error: a bad reply from SearXNG: {}", [Fmt.str(Buf.bytes(body)[0..i])]);
        return;
    end;
    for i := 0 to Json.len(SYSTEM.ADR(d), r) - 1 do
        if i = MaxResults then break; end;
        x := Json.item(SYSTEM.ADR(d), r, i);
        Fmt.write(out, "{}\n{}\n{}\n\n", [Fmt.str(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), x, "title"))),
            Fmt.str(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), x, "url"))),
            Fmt.str(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), x, "content")))]);
    end;
    if out.len = 0 then Buf.str(out, "no results"); end;
end;

(* s cut to at most max bytes, at where a character starts. *)
proc cutAt(s: []const U8; max: INT): []const U8;
begin
    if LEN(s) <= max then return s; end;
    while (max > 0) and (s[max] & 0C0H = 80H) do DEC(max); end;   (* where a character starts *)
    return s[0..max];
end;

(* text from byte offset on, at most MaxText bytes of it; when cut, a
   last line says how much is left and the offset to read on from. *)
proc window(text: []const U8; offset: INT; var out: Buf.Buf);
var start, stop: INT;
begin
    start := offset;
    if start < 0 then start := 0; end;
    if start > LEN(text) then start := LEN(text); end;
    while (start < LEN(text)) and (text[start] & 0C0H = 80H) do INC(start); end;   (* where a character starts *)
    stop := start + LEN(cutAt(text[start..LEN(text)], MaxText));
    Buf.str(out, text[start..stop]);
    if stop < LEN(text) then
        Fmt.write(out, "\n[cut at byte {} of {}; {} bytes left; fetch again with offset {} to read on]",
            [Fmt.int(stop), Fmt.int(LEN(text)), Fmt.int(LEN(text) - stop), Fmt.int(stop)]);
    elsif out.len = 0 then
        Buf.str(out, "(empty)");
    end;
end;

(* fetch: the page at the URL, as text: an HTML page's laid out by
   Ahtml, any other text's as it is. A body with a NUL in its first 8 KB
   is refused, as read refuses a binary file: its Content-Type can't be
   trusted to say so. The text is shown from the byte offset, MaxText at
   a time. *)
proc fetch(const a: Args; mem: ^Mem.Allocator; var out: Buf.Buf);
var body, text: Buf.Buf; url, kind, s: []const U8; err: ERROR;
begin
    url := str(a, "url");
    if not Str.hasPrefix(url, "http://") and not Str.hasPrefix(url, "https://") then
        Buf.str(out, "error: the url must begin with http:// or https://");
        return;
    end;
    Buf.init(body, mem);
    kind, err := page(url, mem, body);
    if err = Failed then
        Fmt.write(out, "error: {}", [Fmt.str(Buf.bytes(body))]);
        return;
    elsif err # nil then
        Fmt.write(out, "error: {}", [Fmt.str(MSG(err))]);
        return;
    end;
    s := Buf.bytes(body);
    Buf.init(text, mem);
    if (Str.find(kind, "text/html") >= 0) or (Str.find(kind, "application/xhtml") >= 0) then
        Ahtml.text(s, kind, text);
        window(Buf.bytes(text), int(a, "offset", 0), out);
        return;
    end;
    if LEN(s) > 8192 then s := s[0..8192]; end;
    if Str.find(s, "\x00") >= 0 then
        Fmt.write(out, "error: not text ({})", [Fmt.str(kind)]);
        return;
    end;
    window(Buf.bytes(body), int(a, "offset", 0), out);
end;

(* Whether a word of list, parted by blanks, is a prefix of name and a
   "*": linear-server_list_* trusts every tool whose name begins so. A
   bare "*" is no word of that kind and trusts nothing. *)
proc starred(name, list: []const U8): BOOL;
var rest, w: []const U8; more: BOOL;
begin
    rest := list;
    more := true;
    while more do
        w, rest, more := Str.cut(Str.trim(rest), " ");
        if (LEN(w) > 1) and (w[LEN(w) - 1] = '*') and Str.hasPrefix(name, w[0..LEN(w) - 1]) then return true; end;
    end;
    return false;
end;

(* Whether the MCP tool name runs without asking: config's trust names
   it, or the server it is from (as Amcp records, not by the name's
   prefix), or begins as a word of trust ending in * does, or the
   human answered always for it. *)
proc trustedTool(name: []const U8): BOOL;
var server: []const U8;
begin
    server := Amcp.serverOf(name);
    return Afind.listed(name, Buf.bytes(trust)) or Afind.listed(server, Buf.bytes(trust)) or
        starred(name, Buf.bytes(trust)) or Afind.listed(name, Buf.bytes(trustTools));
end;

(* The tool name, one an MCP server offers, run with a's arguments: an
   MCP server is a program of someone else's, which may do anything,
   so every call is asked about, with its arguments (cut at MaxAsked
   bytes) shown, unless the tool or its server is trusted: by config's
   trust or the human's answer always, which lasts as run's does. *)
proc mcp(name: []const U8; const a: Args; const h: Human; var out: Buf.Buf);
var q, shown: Buf.Buf; answer: U8;
begin
    if not trustedTool(name) then
        if h.ask = nil then Buf.str(out, "declined: there is nobody to ask. Nothing was run."); return; end;
        Buf.init(q, a.mem);
        Buf.init(shown, a.mem);
        Fmt.write(q, "run {}? (a: always {})", [Fmt.str(name), Fmt.str(name)]);
        Amsg.compact(a.d, a.v, shown);
        answer := h.ask(Buf.bytes(q), cutAt(Buf.bytes(shown), MaxAsked), "yna");
        if answer = 'a' then
            Buf.add(trustTools, ' ');
            Buf.str(trustTools, name);
            Buf.add(trustTools, ' ');
        elsif answer # 'y' then
            declined(h, "Nothing was run.", out);
            return;
        end;
    end;
    Amcp.call(name, a.d, a.v, h.stopped, out);
end;

(* The words of trust that are programs run may start, parted by
   blanks, into b: trust also holds MCP tools and servers. *)
proc trustedPrograms(var b: Buf.Buf);
var rest, w: []const U8; more: BOOL;
begin
    rest := Buf.bytes(trust);
    more := true;
    while more do
        w, rest, more := Str.cut(Str.trim(rest), " ");
        if Afind.listed(w, Buf.bytes(runs)) then
            if b.len > 0 then Buf.add(b, ' '); end;
            Buf.str(b, w);
        end;
    end;
end;

(* t, the run tool, with its description ending in the programs it may
   start and those that start without asking, so that a model need not
   guess: it tried ls, bash and sh. The description is kept in runDesc,
   made again only when a program has been trusted since, and then in a
   new buffer, not the old one reset, so that a description handed out
   before stays whole. *)
proc runOffer(t: Awire.Tool): Awire.Tool;
var programs: Buf.Buf;
begin
    if runDescFor # trust.len then
        Buf.init(programs, Heap.heap);
        defer Buf.done(programs);
        trustedPrograms(programs);
        Buf.init(runDesc, Heap.heap);
        Fmt.write(runDesc, "{} Programs: {} (these run without asking: {}).",
            [Fmt.str(t.description), Fmt.str(Str.trim(Buf.bytes(runs))), Fmt.str(Buf.bytes(programs))]);
        runDescFor := trust.len;
    end;
    t.description := Buf.bytes(runDesc);
    return t;
end;

(* The tools a request offers: Offered, less those that change files
   unless edits, a mode's say, and those that could only fail: search
   without a SearXNG, note outside a project, delegate unless lead, a
   session with a worker model, which a worker isn't, merge unless
   lead, edits and staged, as only a staged worker hands back a diff,
   and plan unless plan, build mode's lead; and then the MCP servers' tools, in every
   mode. *)
proc offered*(lead, edits, plan: BOOL): []Awire.Tool;
var b: Buf.Buf; i: INT;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Tools.reset(offer);
    for i := 0 to LEN(Offered) - 1 do
        if not usable(Offered[i].name) then continue; end;
        match Offered[i].name of
        | "search": if LEN(searx) = 0 then continue; end;
        | "note": if not Afence.rooted then continue; end;
        | "skill": if LEN(skillList) = 0 then continue; end; Tools.push(offer, skillTool); continue;
        | "delegate": if not lead then continue; end; Tools.push(offer, delegateOffer(Offered[i])); continue;
        | "plan": if not plan then continue; end;
        | "merge": if not lead or not edits or (LEN(Afence.stage) = 0) then continue; end;
        | "editor", "open": if not Apeer.reachable() then continue; end;
        | "edit", "move", "remove": if not edits then continue; end;
        | "run": Tools.push(offer, runOffer(Offered[i])); continue;
        | "check":
            if (LEN(testFor(b)) = 0) and (checkNames.len = 0) then continue; end;
            Tools.push(offer, checkOffer(Offered[i]));
            continue;
        | "shell": if not edits or not shellOn() then continue; end;
        | else:
        end;
        Tools.push(offer, Offered[i]);
    end;
    for i := 0 to LEN(Amcp.tools()) - 1 do Tools.push(offer, Amcp.tools()[i]); end;
    for i := 0 to hosted.len - 1 do Tools.push(offer, Tools.all(hosted)[i]); end;
    return Tools.all(offer);
end;

(* A call *)

var refused: Refusals.Vec;   (* the changes the human declined this run, from Heap *)

(* The key a change is known by among the refused: the tool's name, and
   its arguments as rjson writes them again, so that a blank more or
   less in the model's JSON is still the same change. edit's old must
   match the file, so a change declined, then made another way, can't
   come back unchanged unless the file is as it was. *)
proc key(name: []const U8; const a: Args; var b: Buf.Buf);
begin
    Buf.str(b, name);
    Buf.add(b, 1);
    Json.write(a.d, SYSTEM.ADR(b), a.v, {});
end;

(* What the human said when they declined the change key, "" if they
   haven't. *)
proc said(key: []const U8): []const U8;
var r: []Refusal; i: INT;
begin
    r := Refusals.all(refused);
    for i := 0 to LEN(r) - 1 do
        if r[i].key = key then return r[i].said; end;
    end;
    return "";
end;

(* Every declined change forgotten, so that the human is asked again,
   and the programs run was told always for no longer trusted: the
   conversation they were given for is left. *)
proc forgive*;
var r: []Refusal; i: INT;
begin
    trust.len := trustRun;
    trustTools.len := 0;
    r := Refusals.all(refused);
    for i := 0 to LEN(r) - 1 do
        Str.free(Heap.heap, r[i].key);
        Str.free(Heap.heap, r[i].said);
    end;
    Refusals.reset(refused);
end;

(* Whether every path the call of name would reach may be reached, the
   human asked of those outside the fence; if not, why is added to out.
   git's are the words of its arguments that are on disk: its
   subcommands keep it in the repository otherwise. run's are every
   word, as any may be a path the program reads or writes, and one it
   writes needn't be there yet: an option's value after its =, any
   other word whole; a word that is no path ("5") is in the working
   directory, inside. A program that only reads, of run_ro, has only
   the words on disk judged, as git does: fd's patterns were asked
   about every time and caught nothing. A program run won't start is
   judged not at all, as asking for it would be asking for nothing. *)
proc fenced(name: []const U8; const a: Args; const h: Human; var out: Buf.Buf): BOOL;
var args: [][]const U8; prog, x: []const U8; i: INT; first: BOOL;
begin
    match name of
    | "read", "edit", "remove": return fence(name, path(a, "path"), h, out);
    | "move": return fence(name, path(a, "path"), h, out) and fence(name, path(a, "to"), h, out);
    | "find", "grep", "def", "refs", "outline": return fence(name, dir(a, "path"), h, out);
    | "git":
        args := list(a, "args");
        for i := 1 to LEN(args) - 1 do
            if not Str.hasPrefix(args[i], "-") and (Sys.access(args[i], {}) = 0) and
                not fence(name, args[i], h, out) then
                return false;
            end;
        end;
    | "run":
        args := list(a, "args");
        first := true;
        for i := 0 to LEN(args) - 1 do
            x := args[i];
            if x = ";" then first := true; continue; end;
            if first then prog := x; first := false; continue; end;
            if not Afind.listed(prog, Buf.bytes(runs)) then continue; end;
            if Str.hasPrefix(x, "-") then _, x, _ := Str.cut(x, "="); end;
            if (LEN(x) = 0) or Afind.listed(prog, Buf.bytes(runsRO)) and (Sys.access(x, {}) # 0) then continue; end;
            if not fence(name, x, h, out) then return false; end;
        end;
    | else:
    end;
    return true;
end;

(* s added to b made valid UTF-8, each byte that starts no character
   made U+FFFD. *)
proc clean*(var b: Buf.Buf; s: []const U8);
var i, n: INT; c: I32;
begin
    if Str.valid(s) then Buf.str(b, s); return; end;
    i := 0;
    while i < LEN(s) do
        c, n := Str.decode(s[i..LEN(s)]);
        if (c = 0FFFDH) and (n = 1) then Buf.str(b, "\xEF\xBF\xBD"); else Buf.str(b, s[i..i + n]); end;
        INC(i, n);
    end;
end;

(* The call of the tool name with the arguments args run, its result
   added to out: what the tool gave, cut at MaxOut and made valid
   UTF-8. h is how the human is asked; mem is for the call's own work,
   which out mustn't point into. *)
proc call*(name, args: []const U8; const h: Human; mem: ^Mem.Allocator; var out: Buf.Buf);
var d: Json.Doc; a: Args; res, k: Buf.Buf; s: []const U8; i, cut: INT; change, ok: BOOL;
begin
    if not Json.init(SYSTEM.ADR(d), mem) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    Buf.init(res, mem);
    Buf.init(k, mem);
    change := (name = "edit") or (name = "move") or (name = "remove");
    ok := parse(SYSTEM.ADR(d), mem, args, a);
    if ok and change then key(name, a, k); end;
    if isHost(name) then
        Buf.str(res, hostCall(name, args, hostArg));
    elsif builtin(name) and not usable(name) then
        unknown(name, res);
    elsif not ok then
        Buf.str(res, "error: the arguments must be one JSON object, as the tool's schema says; got: ");
        cut := LEN(args);
        if cut > 200 then cut := 200; end;
        Buf.str(res, args[0..cut]);
    elsif change and (LEN(said(Buf.bytes(k))) > 0) then
        Buf.str(res, "not run: the human already declined this very change (");
        Buf.str(res, said(Buf.bytes(k)));
        Buf.str(res, "). Change it as they said, or ask them.");
    elsif not fenced(name, a, h, res) then
        (* res says why *)
    elsif name = "read" then
        read(a, h, mem, res);
    elsif name = "editor" then
        editor(h, res);
    elsif name = "open" then
        open(a, h, res);
    elsif (name = "find") or (name = "grep") or (name = "def") or (name = "refs") or (name = "outline") then
        look(name, a, mem, res);
    elsif name = "git" then
        git(a, res);
    elsif name = "run" then
        runTool(a, h, res);
    elsif name = "check" then
        check(a, mem, res);
    elsif name = "shell" then
        shell(a, mem, res);
    elsif name = "edit" then
        edit(a, h, mem, res);
    elsif name = "move" then
        move(a, h, mem, res);
    elsif name = "remove" then
        remove(a, h, mem, res);
    elsif name = "skill" then
        skill(a, res);
    elsif name = "note" then
        Aahead.note(str(a, "text"), mem, res);
    elsif (name = "search") and (LEN(searx) > 0) then
        searchWeb(a, mem, res);
    elsif name = "fetch" then
        fetch(a, mem, res);
    elsif name = "delegate" then
        Buf.str(res, "error: there are no workers here");
    elsif name = "plan" then
        Buf.str(res, "error: plan is for build mode's lead");
    elsif name = "merge" then
        Buf.str(res, "error: there are no workers here");
    elsif Amcp.owns(name) then
        mcp(name, a, h, res);
    else
        unknown(name, res);
    end;
    s := Buf.bytes(res);
    if change and Str.hasPrefix(s, "declined by user") and (LEN(said(Buf.bytes(k))) = 0) then
        i := Str.find(s, ". Nothing was changed");
        if i < 0 then i := LEN(s); end;
        Refusals.push(refused, {key: keep(Buf.bytes(k)), said: keep(s[0..i])});
    end;
    if LEN(s) > MaxOut then
        cut := MaxOut;
        while (cut > 0) and (s[cut] & 0C0H = 80H) do DEC(cut); end;   (* where a character starts *)
        clean(out, s[0..cut]);
        Buf.str(out, "\n[truncated]");
    else
        clean(out, s);
    end;
end;

(* The module's test, in build/tools, which it makes. *)

var failed: BOOL; answer: U8; asked: INT; because, shown: []const U8;

proc expect(what, got, want: []const U8);
begin
    if got = want then return; end;
    Out.str("Atools: ");
    Out.str(what);
    Out.str(":\n");
    Out.str(got);
    Out.str("\nnot\n");
    Out.str(want);
    Out.ln;
    failed := true;
end;

proc human(_question, detail, _keys: []const U8): U8;
begin
    INC(asked);
    shown := keep(detail);
    return answer;
end;

proc reason(): []const U8;
begin
    return because;
end;

var mem: Arena.Arena;
var hostSaid: Buf.Buf;   (* what hostRan answers, kept so that the slice it returns lives on *)

(* The host's, for the test: says what it was asked. *)
proc hostRan(name, args: []const U8; _arg: ^U8): []const U8;
begin
    Buf.reset(hostSaid);
    Buf.str(hostSaid, "the host ran ");
    Buf.str(hostSaid, name);
    Buf.add(hostSaid, ' ');
    Buf.str(hostSaid, args);
    return Buf.bytes(hostSaid);
end;

proc run(name, args: []const U8; ask: Ask): []const U8;
var b: Buf.Buf; h: Human;
begin
    Buf.init(b, Heap.heap);
    h := {ask: ask, why: reason};
    call(name, args, h, SYSTEM.ADR(mem.base), b);
    Arena.reset(mem);
    return Buf.bytes(b);
end;

proc holds(path, want: []const U8);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    _ := Files.load(path, b);
    expect(path, Buf.bytes(b), want);
end;

(* config's jail_rw and jail_net, with the stage up: ../out made
   writable, a missing directory passed over, and the network kept,
   the jail's net namespace then arno's own. top is the directory the
   test began in. *)
proc jailOpened(top: []const U8);
var rw, want: Buf.Buf; ns: []const U8;
begin
    Buf.init(rw, Heap.heap);
    defer Buf.done(rw);
    Buf.init(want, Heap.heap);
    defer Buf.done(want);
    Fmt.write(rw, "~/no-such-dir {}/build/tools/out", [Fmt.str(top)]);
    jail(false, Buf.bytes(rw));
    expect("shell writes in jail_rw", run("shell", `{"command":"touch ../out/x"}`, nil), "exit 0: touch ../out/x");
    ns, _ := Sys.readLink("/proc/self/ns/net");
    Fmt.write(want, "exit 0: readlink /proc/self/ns/net\n{}", [Fmt.str(ns)]);
    if run("shell", `{"command":"readlink /proc/self/ns/net"}`, nil) = Buf.bytes(want) then
        Out.str("Atools: the jail kept the network without jail_net\n");
        failed := true;
    end;
    jail(true, "");
    expect("shell, jail_net", run("shell", `{"command":"readlink /proc/self/ns/net"}`, nil), Buf.bytes(want));
    jail(false, "");
end;

(* delegate's offer names the workers with their prices, and limits model to them. *)
proc testWorkers();
var t: []Awire.Tool; i: INT; p: Awire.Prov; d: []const U8; schema: []const U8;
begin
    p := {};
    workers("deepseek-v4-pro mine", "mine", p);
    t := offered(true, true, false);
    d := "";
    schema := "";
    for i := 0 to LEN(t) - 1 do
        if t[i].name = "delegate" then d := t[i].description; schema := t[i].params; end;
    end;
    if Str.find(d, "- deepseek-v4-pro ($") < 0 then expect("a priced worker listed", d, "- deepseek-v4-pro ($..."); end;
    if Str.find(d, "\n- mine\n") >= 0 then expect("an unpriced worker, no price", d, "- mine"); end;
    if Str.find(d, "mine runs it if you name none") < 0 then expect("the default named", d, "mine runs it ..."); end;
    if Str.find(schema, `"model":{"type":"string","enum":["deepseek-v4-pro","mine"]`) < 0 then
        expect("model limited to the workers", schema, "an enum");
    end;
    if not isWorker("mine") or isWorker("other") then expect("isWorker", "wrong", "right"); end;
    workers("", "", p);
end;

(* Roles, after the workers: listed in delegate's offer, role limited
   to them, and a role's instructions without its first line; a name
   that isn't one of them reads nothing. *)
proc testRoles();
var t: []Awire.Tool; i: INT; p: Awire.Prov; d, schema: []const U8; b: Buf.Buf;
begin
    p := {};
    _ := Sys.makeDir("roles");
    _ := Files.write("roles/security.md", "Security review of a change.\n\nFollow the data.\n");
    _ := Files.write("roles/notes.txt", "not a role\n");
    workers("mine", "mine", p);
    roles("roles");
    t := offered(true, true, false);
    d := "";
    schema := "";
    for i := 0 to LEN(t) - 1 do
        if t[i].name = "delegate" then d := t[i].description; schema := t[i].params; end;
    end;
    if Str.find(d, "- security: Security review of a change.") < 0 then expect("a role listed", d, "- security: ..."); end;
    if Str.find(schema, `"role":{"type":"string","enum":["security"]`) < 0 then expect("role limited to the roles", schema, "an enum"); end;
    if Str.find(schema, `"model":{"type":"string","enum":["mine"]`) < 0 then expect("the workers kept", schema, "an enum"); end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    if not roleText("security", b) then expect("roleText", "false", "true"); end;
    expect("a role's instructions", Buf.bytes(b), "Follow the data.");
    if roleText("../roles/security", b) or roleText("notes", b) then expect("roleText of no role", "true", "false"); end;
    workers("", "", p);
    roles("");
end;

(* Skills: listed in skill's offer, name limited to them, one's text
   without its first line, a file whose name won't fit a schema left
   out, the project's shelf read after the human's, which wins a name,
   and skill not offered with none. *)
proc testSkills();
var t: []Awire.Tool; i: INT; d, schema: []const U8;
begin
    _ := Sys.makeDir("skills");
    _ := Files.write("skills/linear.md", "When writing a Linear comment.\n\nTerse, findings first.\n");
    _ := Files.write("skills/a \"b\".md", "not one: a quote in its name\n");
    _ := Sys.makeDir("theirs");
    _ := Files.write("theirs/linear.md", "The project's.\n\nNot this one.\n");
    _ := Files.write("theirs/release.md", "Before a release.\n\nCompare with the last tag.\n");
    skills("skills", "theirs");
    t := offered(false, true, false);
    d := "";
    schema := "";
    for i := 0 to LEN(t) - 1 do
        if t[i].name = "skill" then d := t[i].description; schema := t[i].params; end;
    end;
    if Str.find(d, "- linear: When writing a Linear comment.") < 0 then expect("a skill listed", d, "- linear: ..."); end;
    if Str.find(d, "quote") >= 0 then expect("a name that won't fit left out", d, "no quote"); end;
    expect("skill's schema", schema, `{"type":"object","properties":{"name":{"type":"string","enum":["linear","release"],` +
        `"description":"the skill to read"}},"required":["name"]}`);
    expect("a skill", run("skill", `{"name":"linear"}`, nil), "Terse, findings first.");
    expect("the project's skill", run("skill", `{"name":"release"}`, nil), "Compare with the last tag.");
    expect("no skill", run("skill", `{"name":"../skills/linear"}`, nil),
        "error: ../skills/linear is not a skill; the skills are: linear release");
    skills("none", "");
    t := offered(false, true, false);
    for i := 0 to LEN(t) - 1 do
        if t[i].name = "skill" then expect("skill offered with none", "offered", "not"); end;
    end;
end;

proc main*: INT;
var dir, s, t, w: []const U8; long, store: Buf.Buf; i: INT; tools: []Awire.Tool;
begin
    Arun.child();
    Buf.init(hostSaid, Heap.heap);
    if not Arena.init(mem, 1 shl 26) then return 1; end;
    _ := Sys.makeDir("build");
    _ := Sys.makeDir("build/tools");
    _ := Sys.makeDir("build/tools/proj");
    _ := Sys.makeDir("build/tools/proj/.git");
    _ := Sys.makeDir("build/tools/out");
    _ := Files.write("build/tools/proj/f", "one\ntwo\nthree\n");
    _ := Files.write("build/tools/proj/bin", "a\x00b");
    _ := Files.write("build/tools/proj/bad", "caf\xE9\n");
    _ := Files.write("build/tools/out/g", "far\n");
    Buf.init(long, Heap.heap);
    for i := 1 to 5000 do Buf.str(long, "a line of the long file\n"); end;
    _ := Files.write("build/tools/proj/long", Buf.bytes(long));
    dir, _ := Sys.workDir();
    dir, _ := Str.copy(Heap.heap, dir);
    if Sys.setWorkDir("build/tools/proj") # 0 then Out.str("Atools: no build/tools\n"); return 1; end;
    Afence.init;
    testWorkers();
    testRoles();
    testSkills();

    expect("read", run("read", `{"path":"f"}`, nil), "    1\tone\n    2\ttwo\n    3\tthree\n");
    expect("offset and limit", run("read", `{"path":"f","offset":"2","limit":1}`, nil), "    2\ttwo\n");
    expect("encoded twice", run("read", `"{\"path\":\"f\",\"offset\":3}"`, nil), "    3\tthree\n");
    expect("a directory", run("read", `{"path":"."}`, nil),
        "error: . is a directory; outline it, or find the files in it");
    expect("missing", run("read", `{"path":"nope"}`, nil),
        "error: cannot read nope (no such file? use find to locate it)");
    expect("binary", run("read", `{"path":"bin"}`, nil), "error: bin is binary, not text");
    expect("not UTF-8", run("read", `{"path":"bad"}`, nil), "    1\tcaf\xEF\xBF\xBD\n");
    expect("no object", run("read", `[1]`, nil),
        "error: the arguments must be one JSON object, as the tool's schema says; got: [1]");
    expect("no such tool", run("write", "", nil),
        "error: there is no tool named \"write\". The tools are: read find grep def refs outline git run check shell edit move remove note " +
        "search fetch delegate plan merge");
    expect("find", run("find", `{"name":"f*","path":"./"}`, nil), "f\n");
    expect("grep", run("grep", `{"pattern":"TWO","ignore_case":"true"}`, nil), "f:2: two\n");
    expect("def, no name", run("def", `{"name":" "}`, nil), "error: give the name to look up");
    expect("refs", run("refs", `{"name":"two","path":"f"}`, nil), "f:2: two\n");
    expect("refs, none", run("refs", `{"name":"tw","path":"f"}`, nil), "no uses of tw found in f");
    expect("outline, none", run("outline", `{"path":"f"}`, nil),
        "no declarations found in f; find lists its files, grep searches them");
    expect("git, a verb refused", run("git", `{"args":"[\"push\",\"origin\"]"}`, nil),
        "error: push is not allowed; only status, diff, log, show, blame, branch, merge-base, " +
        "ls-tree and rev-list, subcommand first, without \"git\"");
    expect("git, part of a verb", run("git", `{"args":"rev HEAD"}`, nil)[0..19], "error: rev is not a");
    expect("git, a branch option", run("git", `{"args":["branch","-D","x"]}`, nil), "error: option not allowed: -D");
    expect("git, an output", run("git", `{"args":["diff","--output=x"]}`, nil), "error: option not allowed: --output=x");
    expect("git, no args", run("git", `{}`, nil), "error: args must be an array of strings, the subcommand first");
    expect("grep outside, nobody", run("grep", `{"pattern":"far","path":"../out"}`, nil)[0..9], "declined:");
    expect("git outside, nobody", run("git", `{"args":["log","--","../out/g"]}`, nil)[0..9], "declined:");
    Buf.init(long, Heap.heap);
    for i := 1 to 3000 do Buf.str(long, "0123456789\n"); end;
    Buf.init(store, Heap.heap);
    window(Buf.bytes(long), 0, store);
    w := Buf.bytes(store);
    expect("fetch, cut", w[MaxText..LEN(w)],
        "\n[cut at byte 20000 of 33000; 13000 bytes left; fetch again with offset 20000 to read on]");
    Buf.init(store, Heap.heap);
    window(Buf.bytes(long), 20000, store);
    w := Buf.bytes(store);
    expect("fetch, the rest", w[LEN(w) - 11..LEN(w)], "0123456789\n");
    if LEN(w) # 13000 then Out.str("Atools: fetch's offset wrong\n"); return 1; end;
    Buf.init(store, Heap.heap);
    window("", 0, store);
    expect("fetch, empty", Buf.bytes(store), "(empty)");
    s := run("read", `{"path":"long"}`, nil);
    expect("cut", s[LEN(s) - 49..LEN(s)], "\n[cut before line 1065; read on with offset 1065]");

    expect("outside, nobody", run("read", `{"path":"../out/g"}`, nil)[0..9], "declined:");
    answer := 'n';
    expect("outside, no", run("read", `{"path":"../out/g"}`, human)[0..16], "declined by user");
    answer := 'y';
    expect("outside, yes", run("read", `{"path":"../out/g"}`, human), "    1\tfar\n");
    answer := 'a';
    expect("outside, always", run("read", `{"path":"../out/g"}`, human), "    1\tfar\n");
    asked := 0;
    expect("granted", run("read", `{"path":"../out/g"}`, human), "    1\tfar\n");
    if asked # 0 then Out.str("Atools: a granted directory asked again\n"); failed := true; end;

    (* shell, in the jail; safe, with no stage, it isn't offered *)
    for i := 0 to LEN(offered(true, true, false)) - 1 do
        if offered(true, true, false)[i].name = "shell" then Out.str("Atools: shell offered while safe\n"); failed := true; end;
    end;
    expect("shell, safe", run("shell", `{"command":"true"}`, nil),
        "error: shell is not on offer: it runs only staged (safety auto), in the jail");
    Afence.useStage(Afence.zone);   (* the project as the stage's copy, so shell is offered *)
    expect("shell", run("shell", `{"command":"echo hi; echo oops >&2; exit 3"}`, nil), "exit 3: echo hi; echo oops >&2; exit 3\nhi\noops");
    expect("shell writes in the project", run("shell", `{"command":"echo x > made && cat made"}`, nil), "exit 0: echo x > made && cat made\nx");
    holds("made", "x\n");
    expect("shell can't write outside", run("shell", `{"command":"touch ../out/x"}`, nil)[0..7], "exit 1:");
    jailOpened(dir);
    expect("shell, no command", run("shell", `{"command":" "}`, nil), "error: give the command line as command");
    expect("shell, a timeout", run("shell", `{"command":"sleep 5","timeout":1}`, nil), "timed out after 1 s: sleep 5");
    _ := Sys.makeDir("../scratch");
    Afence.useScratch("../scratch");
    expect("shell, the scratch", run("shell", `{"command":"echo y > $ARNO_SCRATCH/s && cat $ARNO_SCRATCH/s"}`, nil),
        "exit 0: echo y > $ARNO_SCRATCH/s && cat $ARNO_SCRATCH/s\ny");
    holds("../scratch/s", "y\n");
    expect("shell, a flood", run("shell", `{"command":"yes"}`, nil)[0..29], "killed: more than 4 MB of out");
    Afence.useScratch("../no-such-scratch");   (* a writable place that isn't there: no sandbox *)
    expect("shell, no sandbox", run("shell", `{"command":"true"}`, nil)[0..15], "error: sandbox:");
    Afence.useScratch("../scratch");
    (* staged, check and run are jailed too: the copy writable, nothing outside it *)
    commands("touch", "", "", "touch", "touch made2 && touch ../out/y");
    expect("check, jailed", run("check", `{}`, nil)[0..6], "FAILED");
    holds("made2", "");
    expect("run, jailed", run("run", `{"args":["touch","made3"]}`, nil), "exit 0: touch made3");
    holds("made3", "");
    commands("", "", "", "", "");
    Afence.leaveStage;

    (* changes *)
    answer := 'y';
    expect("create", run("edit", `{"path":"sub/dir/e","old":"","new":"a\nb\n"}`, human), "ok: created sub/dir/e");
    expect("create, shown", shown, "+a\n+b\n");
    holds("sub/dir/e", "a\nb\n");
    expect("create over", run("edit", `{"path":"sub/dir/e","old":"","new":"x"}`, human)[0..24],
        "error: sub/dir/e exists;");
    expect("edit", run("edit", `{"path":"sub/dir/e","old":"b\n","new":"c\nd\n"}`, human), "ok: 1 replaced");
    expect("edit, shown", shown, "-b\n+c\n+d\n");
    holds("sub/dir/e", "a\nc\nd\n");
    _ := Files.write("twice", "x\n  y\nx\n");
    expect("twice", run("edit", `{"path":"twice","old":"x","new":"z"}`, human),
        "error: old text occurs 2 times in twice; add surrounding lines to old to make it unique, or set all to " +
        "replace every one");
    expect("all", run("edit", `{"path":"twice","old":"x","new":"z","all":true}`, human), "ok: 2 replaced");
    holds("twice", "z\n  y\nz\n");
    expect("a near miss", run("edit", `{"path":"twice","old":"z\ny","new":""}`, human),
        "error: old text not found in twice, but lines 1-2 hold it with other blanks at the starts or ends of " +
        "lines: line 2 starts with 2 blanks, and old's line 2 with 0. read shows each line after its number " +
        "and a tab, which are not part of the line: copy old again from those lines");
    expect("not found", run("edit", `{"path":"twice","old":"q","new":""}`, human)[0..32],
        "error: old text not found in twi");
    asked := 0;
    answer := 'n';
    because := "keep it";
    expect("declined", run("edit", `{"path":"twice","old":"y","new":"w"}`, human),
        "declined by user: keep it. Nothing was changed: the file is as it was before.");
    expect("declined again", run("edit", `{ "path":"twice", "old":"y", "new":"w" }`, human),
        "not run: the human already declined this very change (declined by user: keep it). Change it as they " +
        "said, or ask them.");
    if asked # 1 then Out.str("Atools: a declined change asked again\n"); failed := true; end;
    forgive;
    because := "";
    expect("forgiven", run("edit", `{"path":"twice","old":"y","new":"w"}`, human),
        "declined by user. Nothing was changed: the file is as it was before.");
    expect("nobody to approve", run("edit", `{"path":"twice","old":"y","new":"v"}`, nil),
        "declined: there is nobody to approve the change. Nothing was changed.");
    holds("twice", "z\n  y\nz\n");
    answer := 'y';
    expect("move", run("move", `{"path":"twice","to":"sub/new/thrice"}`, human), "ok: moved twice to sub/new/thrice");
    expect("move onto", run("move", `{"path":"f","to":"sub/new/thrice"}`, human)[0..30],
        "error: sub/new/thrice exists; ");
    expect("move a directory", run("move", `{"path":"sub","to":"bus"}`, human)[0..22], "error: sub is a direct");
    expect("remove", run("remove", `{"path":"sub/new/thrice"}`, human), "ok: removed sub/new/thrice");
    expect("remove, shown", shown, "-z\n-  y\n-z\n");
    expect("remove, none", run("remove", `{"path":"sub/new/thrice"}`, human),
        "error: no file sub/new/thrice (use find to locate it)");
    _ := Sys.remove("sub/dir/e");
    _ := Sys.removeDir("sub/dir");
    _ := Sys.removeDir("sub/new");
    _ := Sys.removeDir("sub");

    (* run: the programs allowed, asked about, trusted, and fenced *)
    commands("echo sh no-such-program-of-arno", "", "ARNO_T", "", "");
    expect("run, not allowed", run("run", `{"args":["bash"]}`, nil),
        "error: bash is not allowed; the programs are: echo sh no-such-program-of-arno ls wc head file stat ");
    expect("run, a reader asks nothing", run("run", `{"args":["wc","-c","f"]}`, nil)[0..10], "exit 0: wc");
    expect("run, a reader is fenced", run("run", `{"args":["ls","../.."]}`, nil)[0..9], "declined:");
    tools := offered(false, true, false);
    for i := 0 to LEN(tools) - 1 do
        if tools[i].name = "run" then s := tools[i].description; end;
    end;
    expect("run, offered with its programs", s[LEN(s) - 112..LEN(s)],
        "Programs: echo sh no-such-program-of-arno ls wc head file stat (these run without asking: ls wc head file stat).");
    answer := 'n';
    because := "";
    expect("run, declined", run("run", `{"args":["echo","hi"]}`, human), "declined by user. Nothing was run.");
    answer := 'y';
    expect("run", run("run", `{"args":["echo","hi"]}`, human), "exit 0: echo hi\nhi");
    answer := 'a';
    expect("run, a batch", run("run", `{"args":["echo","a",";","sh","-c","exit 3"]}`, human),
        "exit 0: echo a\na\n\nexit 3: sh -c exit 3");
    expect("run, the batch shown", shown, "echo a\nsh -c exit 3\n");
    expect("run, trusted", run("run", `{"args":["echo","b"]}`, nil), "exit 0: echo b\nb");
    expect("run, env", run("run", `{"args":["sh","-c","echo $ARNO_T"],"env":{"ARNO_T":"x"}}`, nil),
        "exit 0: sh -c echo $ARNO_T\nx");
    expect("run, env refused", run("run", `{"args":["echo"],"env":{"PATH":"x"}}`, nil),
        "error: PATH may not be set; these may: ARNO_T ");
    expect("run, a glued path", run("run", `{"args":["echo","-o../x"]}`, nil),
        "error: give the path in -o../x as an argument of its own");
    expect("run, an empty command", run("run", `{"args":["echo",";",";","echo"]}`, nil),
        "error: an empty command before \";\"");
    expect("run, outside", run("run", `{"args":["echo","--in=../../nowhere"]}`, nil)[0..9], "declined:");
    expect("run, not installed", run("run", `{"args":["no-such-program-of-arno"]}`, human),
        "error: no-such-program-of-arno is not installed");
    forgive;
    asked := 0;
    answer := 'y';
    _ := run("run", `{"args":["echo"]}`, human);
    if asked # 1 then Out.str("Atools: run's trust outlived the conversation\n"); failed := true; end;

    (* MCP tools: asked unless trust names the tool or its server, or the human said always *)
    expect("mcp, attach the stub", Amcp.attach("stub", ["../../mcpstub"]), "");
    commands("", "", "", "stub_echo", "");
    expect("mcp, nobody to ask", run("stub_fail", `{}`, nil), "declined: there is nobody to ask. Nothing was run.");
    expect("mcp, a trusted tool", run("stub_echo", `{"text":"hi"}`, nil), "hi\n");
    answer := 'n';
    asked := 0;
    expect("mcp, declined", run("stub_fail", `{}`, human), "declined by user. Nothing was run.");
    answer := 'a';
    expect("mcp, always", run("stub_fail", `{}`, human), "error: boom\n");
    expect("mcp, trusted by always", run("stub_fail", `{}`, nil), "error: boom\n");
    if asked # 2 then Out.str("Atools: an MCP tool was asked about too often\n"); failed := true; end;
    forgive;
    expect("mcp, always forgiven", run("stub_fail", `{}`, nil), "declined: there is nobody to ask. Nothing was run.");
    commands("", "", "", "stub", "");
    expect("mcp, a trusted server", run("stub_fail", `{}`, nil), "error: boom\n");
    commands("", "", "", "stu stub_ech", "");
    expect("mcp, no prefix match", run("stub_echo", `{"text":"hi"}`, nil),
        "declined: there is nobody to ask. Nothing was run.");
    commands("", "", "", "stub_ec* *", "");
    expect("mcp, a starred prefix", run("stub_echo", `{"text":"hi"}`, nil), "hi\n");
    expect("mcp, a prefix not matching", run("stub_fail", `{}`, nil),
        "declined: there is nobody to ask. Nothing was run.");
    commands("", "", "", "stub stub_echo", "");
    tools := offered(false, true, false);
    for i := 0 to LEN(tools) - 1 do
        if tools[i].name = "run" then s := tools[i].description; end;
    end;
    if Str.find(s, "stub") >= 0 then Out.str("Atools: run's description names an MCP tool\n"); failed := true; end;
    Amcp.stop();

    (* check: config's command, or the project's own in tests.json *)
    Buf.init(store, Heap.heap);
    Buf.str(store, dir);
    Buf.str(store, "/build/tools/store/");
    _ := Sys.makeDir(Buf.bytes(store));
    _ := Sys.remove("../store/tests.json");
    Astore.use(Buf.bytes(store));
    expect("check, none", run("check", `{}`, nil),
        "error: no test command for this project; ask the human to run /test COMMAND once");
    commands("", "", "", "", "echo testing; exit 1");
    expect("check", run("check", `{}`, nil), "FAILED, exit 1: echo testing; exit 1\n\ntesting\n");
    _ := Astore.setKeyed("tests.json", Afence.root, "echo ok");
    expect("check, the project's", run("check", `{}`, nil), "passed: echo ok\n\nok\n");

    (* named checks: listed, run, with files in {}, and the unfit refused *)
    clearChecks;
    addCheck("unit", "echo unit {}");
    addCheck("fmt", "echo fmt");
    tools := offered(false, true, false);
    for i := 0 to LEN(tools) - 1 do
        if tools[i].name = "check" then s := tools[i].description; t := tools[i].params; end;
    end;
    if not Str.hasSuffix(s, "\n- unit: echo unit {}\n- fmt: echo fmt") then
        Out.str("Atools: check's description doesn't end in its names\n");
        failed := true;
    end;
    if Str.find(t, `"enum":["unit","fmt"]`) < 0 then Out.str("Atools: check's names are no enum\n"); failed := true; end;
    expect("check, a name", run("check", `{"name":"fmt"}`, nil), "passed: echo fmt\n\nfmt\n");
    expect("check, {} with a file", run("check", `{"name":"unit","files":["f"]}`, nil), "passed: echo unit 'f'\n\nunit f\n");
    expect("check, {} with no file", run("check", `{"name":"unit"}`, nil), "passed: echo unit \n\nunit\n");
    expect("check, a file outside", run("check", `{"name":"unit","files":["/etc/passwd"]}`, nil),
        "error: /etc/passwd is outside the project");
    expect("check, a file like an option", run("check", `{"name":"unit","files":["-f"]}`, nil),
        "error: -f may not start with -");
    expect("check, a file not there", run("check", `{"name":"unit","files":["nonesuch"]}`, nil),
        "error: nonesuch does not exist");
    expect("check, an unknown name", run("check", `{"name":"e2e"}`, nil),
        "error: there is no check named e2e; the checks are: unit fmt");
    expect("check, files for a command with no {}", run("check", `{"name":"fmt","files":["f"]}`, nil),
        "error: check fmt takes no files: its command has no {}");
    expect("check, files for the project's own", run("check", `{"files":["f"]}`, nil),
        "error: the project's own check takes no files; name a check that has {}");
    clearChecks;

    (* the host's tools: its own, run by it; a name of arno's refused; the builtins it left out gone *)
    hosting(hostRan, nil);
    expect("a host tool", addHost("doc_read", "the document", ""), "");
    expect("a name of arno's own", addHost("read", "", ""), "tool read is already arno's own");
    expect("a host tool, twice", addHost("doc_read", "", ""), "tool doc_read is already the host's");
    expect("no name", addHost("", "", ""), "a tool needs a name");
    expect("a host tool, called", run("doc_read", `{"n":1}`, nil), "the host ran doc_read {\"n\":1}");
    allow("read grep");
    expect("a builtin left out is gone", run("find", `{"name":"f"}`, nil),
        "error: there is no tool named \"find\". The tools are: read grep doc_read");
    expect("a builtin allowed", run("read", `{"path":"f"}`, nil), "    1\tone\n    2\ttwo\n    3\tthree\n");
    if LEN(offered(false, true, false)) # 3 then Out.str("Atools: only the allowed and the host's are offered\n"); failed := true; end;
    _ := Sys.setWorkDir(dir);
    if failed then return 1; end;
    return 0;
end;

begin
    Refusals.init(refused, Heap.heap);
    Tools.init(offer, Heap.heap);
    Tools.init(hosted, Heap.heap);
    Buf.init(refusal, Heap.heap);
    Buf.init(trustTools, Heap.heap);
end Atools.
