(* Asession: a session, the conversations one run of arno goes through,
   one at a time, and the commands the human types between turns.

   A line the human types is a command if it starts with a /, and
   otherwise a message to the model, which starts a turn of the
   conversation (line). A turn is saved when it ends, however it ends.
   What a command has to say goes to the front end, as a text or as an
   error, through a Show; what a turn does goes through the agent's
   Front. Plain mode is one front end; the screen will be another.

   Commands that switch conversations, /new, /load and /clear, drop the
   paths granted outside the project and the changes declined: they
   were given for the work of the conversation left. /compact keeps
   them, as the work goes on.

   A message goes with what its @paths bring (Aattach).

   /test runs the project's test command, as check does, and puts a
   failure to the model as a turn.

   Depends on Agent, Aprompt (the commands and modes), Amemory, Aahead
   (the notes), Aattach, Astore, Aconf, Aprice, Atools, Afence and Arun
   (/test). Leaves out /stage, which comes with the stage.

   /models asks the provider's server for its models, or else says
   arno's own list of them (Awire.known); what the server said is kept
   for the screen to complete /model with (models).

   status makes the screen's status line; /usage shows its context in
   use too, from the last request, or guessed from the text before
   one. A conversation changed other than by a turn, by /new, /load,
   /clear or /compact, is handed to changed, for a screen to show it
   again. *)
module Asession;
import Agent, Aprompt, Amemory, Aahead, Aattach, Astore, Aconf, Awire, Aprice, Atools, Afence, Arun, Amsg, Buf, Str, Sys, Files, Fmt,
    Heap, Arena, Math, Rt, Msgs := Vec(Amsg.Msg), Items := Vec(Astore.Item);

type
    (* What arno says of a command to the human: s, an error if bad. *)
    Show* = proc(s: []U8; bad: BOOL; arg: ^U8);
    (* The conversation is c from now on, to be shown from its start. *)
    Changed* = proc(c: ^Astore.Conv; arg: ^U8);

    Session* = record
        conf*: Aconf.Conf;
        agent*: Agent.Agent;   (* asks the model as conf.prov says *)
        conv*: Astore.Conv;    (* the conversation of the next turn *)
        show: Show;
        changed*: Changed;     (* nil if nothing is shown again *)
        arg: ^U8;
        named: []U8;           (* the model or provider a command named, kept from Heap; "" for none *)
        mem: Arena.Arena;      (* a command's work *)
        out: Buf.Buf;          (* what a command says *)
        listed: Buf.Buf;       (* the models /models was told, a line each *)
        listedOf: Buf.Buf;     (* by which provider *)
    end;

const
    Listed = 20;   (* conversations /list shows, and /load N counts in *)
    MaxTest = 50000;   (* bytes of a failed /test's output put to the model, the last *)

(* s made the session the config sets up, telling front of turns and
   show of commands, with a new conversation. What is wrong with the
   config is shown. *)
proc init*(s: ^Session; front: Agent.Front; show: Show; arg: ^U8);
var id: Buf.Buf; n: I64; i: INT; ok: BOOL;
begin
    s^ := {show: show, arg: arg};
    Aconf.load(ADR(s^.conf));
    if not Arena.init(ADR(s^.mem), 1 shl 28) then Rt.stop("arno: out of memory"); end;
    Buf.init(ADR(s^.out), Heap.heap);
    Buf.init(ADR(s^.listed), Heap.heap);
    Buf.init(ADR(s^.listedOf), Heap.heap);
    if s^.conf.warnings.len > 0 then show(Str.trimRight(Buf.bytes(ADR(s^.conf.warnings))), true, arg); end;
    Buf.init(ADR(id), Heap.heap);
    defer Buf.done(ADR(id));
    Astore.newId(ADR(id));
    Astore.init(ADR(s^.conv), Buf.bytes(ADR(id)));
    Agent.init(ADR(s^.agent), ADR(s^.conf.prov), front);
    n, ok := Str.toInt(Aconf.get(ADR(s^.conf), "max_steps"));
    if ok and (n > 0) then s^.agent.maxSteps := INT(n); end;
    n, ok := Str.toInt(Aconf.get(ADR(s^.conf), "prune"));
    if ok and (n >= 0) then s^.agent.prune := INT(n); end;
    s^.agent.budget, _ := Math.toReal(Aconf.get(ADR(s^.conf), "turn_budget"));
    s^.agent.prefetch := Aconf.get(ADR(s^.conf), "prefetch") # "no";
    s^.agent.worker := Aconf.get(ADR(s^.conf), "worker");
    for i := 0 to LEN(Aprompt.Modes) - 1 do
        if Aprompt.Modes[i].name = Aconf.get(ADR(s^.conf), "mode") then s^.agent.mode := Aprompt.Mode(i); end;
    end;
    Atools.search(Aconf.get(ADR(s^.conf), "searxng"));
    Atools.commands(Aconf.get(ADR(s^.conf), "run"), Aconf.get(ADR(s^.conf), "run_ro"),
        Aconf.get(ADR(s^.conf), "run_env"), Aconf.get(ADR(s^.conf), "trust"), Aconf.get(ADR(s^.conf), "test_cmd"));
end;

(* What lasts the session found: the context files, as config's
   context_files says, the human asked if it says ask, and the
   project's map, unless project_map says no. Not before a turn is
   sure to run: asking about context files is for a human who will be
   answered. *)
proc prepare*(s: ^Session);
var mode: []U8;
begin
    mode := Aconf.get(ADR(s^.conf), "context_files");
    if LEN(mode) = 0 then mode := "ask"; end;
    Agent.prepare(ADR(s^.agent), mode, Aconf.get(ADR(s^.conf), "project_map") # "no");
end;

proc say(s: ^Session; text: []U8);
begin
    s^.show(text, false, s^.arg);
end;

proc fail(s: ^Session; text: []U8);
begin
    s^.show(text, true, s^.arg);
end;

(* s's conversation saved; said if it can't be. *)
proc save(s: ^Session);
begin
    Astore.setModel(ADR(s^.conv), s^.conf.prov.model);
    if Astore.save(ADR(s^.conv)) # nil then
        Buf.reset(ADR(s^.out));
        Fmt.write(ADR(s^.out), "the conversation can't be saved in {}", [Fmt.str(Astore.dir())]);
        fail(s, Buf.bytes(ADR(s^.out)));
    end;
end;

(* s's conversation changed other than by a turn: what its last request
   held is no longer known, and the front end shows it again. *)
proc changed(s: ^Session);
begin
    s^.agent.held := 0;
    if s^.changed # nil then s^.changed(ADR(s^.conv), s^.arg); end;
end;

(* c made s's conversation, the one it had given back, and what was
   granted and declined for that one forgotten. *)
proc switch(s: ^Session; c: ^Astore.Conv);
begin
    Astore.done(ADR(s^.conv));
    s^.conv := c^;
    Afence.forget;
    Atools.forgive;
    changed(s);
end;

(* A turn of s's conversation on its last message, the human's:
   Agent.turn's error, why saying why it failed. The conversation is
   saved after. *)
proc answer(s: ^Session; why: ^Buf.Buf): ERROR;
var err: ERROR;
begin
    err := Agent.turn(ADR(s^.agent), ADR(s^.conv), why);
    save(s);
    return err;
end;

(* A turn of s's conversation, on the human's message text and what its
   @paths bring: Agent.turn's error, why saying why it failed. The
   conversation is saved after. *)
proc turn*(s: ^Session; text: []U8; why: ^Buf.Buf): ERROR;
var m: ^Amsg.Msg;
begin
    m := Msgs.add(ADR(s^.conv.msgs));
    Amsg.init(m, Amsg.Role.user);
    Aattach.expand(m, text);
    return answer(s, why);
end;

(* A turn's failure, err, shown: why says why it failed. *)
proc failed(s: ^Session; err: ERROR; why: []U8);
begin
    if err = Awire.Failed then fail(s, why); end;
    if err = Awire.Stopped then fail(s, "stopped"); end;
end;

(* The id of the conversation arg names, into id: a number from /list,
   or an id; else the last changed whose title or id holds arg. *)
proc find(arg: []U8; id: ^Buf.Buf): BOOL;
var list: Items.Vec; n: I64; ok: BOOL;
begin
    n, ok := Str.toInt(arg);
    Astore.recent(Listed, "", ADR(list));
    if ok and (n >= 1) and (n <= list.len) then Buf.str(id, Items.all(ADR(list))[n - 1].id); end;
    Astore.drop(ADR(list));
    if id^.len > 0 then return true; end;
    if LEN(arg) = 0 then return false; end;
    if Sys.access(Astore.file(arg, id), {}) = 0 then
        Buf.reset(id);
        Buf.str(id, arg);
        return true;
    end;
    Buf.reset(id);
    Astore.recent(1, arg, ADR(list));
    if list.len > 0 then Buf.str(id, Items.all(ADR(list))[0].id); end;
    Astore.drop(ADR(list));
    return id^.len > 0;
end;

(* The conversation arg names, as find finds it, made s's: /load, and
   arno --resume. false if there is none. *)
proc resume*(s: ^Session; arg: []U8): BOOL;
var id: Buf.Buf; c: Astore.Conv;
begin
    Buf.init(ADR(id), Heap.heap);
    defer Buf.done(ADR(id));
    if not find(arg, ADR(id)) then return false; end;
    if Astore.load(ADR(c), Buf.bytes(ADR(id))) # nil then
        Astore.done(ADR(c));
        return false;
    end;
    switch(s, ADR(c));
    return true;
end;

(* b's line padded with blanks to col bytes, from start, where it began. *)
proc pad(b: ^Buf.Buf; start, col: INT);
begin
    repeat Buf.add(b, ' '); until b^.len - start >= col;
end;

(* dollars as /usage shows them: a third decimal while there are only
   cents to show. *)
proc money(b: ^Buf.Buf; d: F64);
begin
    if d < 1.0 then Fmt.write(b, "${}", [Fmt.real(d, 3)]); else Fmt.write(b, "${}", [Fmt.real(d, 2)]); end;
end;

(* A price per million tokens, with as many decimals as it needs. *)
proc price(b: ^Buf.Buf; d: F64);
begin
    Fmt.write(b, "${}", [Fmt.real(d, 4)]);
    while Buf.bytes(b)[b^.len - 1] = '0' do DEC(b^.len); end;
    if Buf.bytes(b)[b^.len - 1] = '.' then DEC(b^.len); end;
end;

(* the commands, each its text into out *)

proc help(out: ^Buf.Buf);
var i, at: INT;
begin
    for i := 0 to LEN(Aprompt.Commands) - 1 do
        at := out^.len;
        Aprompt.usage(Aprompt.Commands[i], out);
        pad(out, at, 19);
        Buf.str(out, Aprompt.Commands[i].desc);
        Buf.add(out, '\n');
    end;
    Buf.str(out, "\nmodes:");
    for i := 0 to LEN(Aprompt.Modes) - 1 do
        Buf.str(out, "\n  ");
        at := out^.len;
        Buf.str(out, Aprompt.Modes[i].name);
        pad(out, at, 17);
        Buf.str(out, Aprompt.Modes[i].hint);
    end;
end;

proc renew(s: ^Session);
var id: Buf.Buf; c: Astore.Conv;
begin
    Buf.init(ADR(id), Heap.heap);
    defer Buf.done(ADR(id));
    Astore.newId(ADR(id));
    Astore.init(ADR(c), Buf.bytes(ADR(id)));
    switch(s, ADR(c));
    say(s, "a new conversation");
end;

(* The history cut to the first exchange: the human's first message
   and what came of it, up to the next. *)
proc clear(s: ^Session);
var m: []Amsg.Msg; i, keep: INT;
begin
    m := Msgs.all(ADR(s^.conv.msgs));
    keep := 1;
    while (keep < LEN(m)) and (m[keep].role # Amsg.Role.user) do INC(keep); end;
    for i := keep to LEN(m) - 1 do Amsg.free(ADR(m[i])); end;
    Msgs.resize(ADR(s^.conv.msgs), keep);
    save(s);
    changed(s);
    Afence.forget;
    Atools.forgive;
    say(s, "history cleared to the first exchange, path grants dropped");
end;

(* The history replaced by the model's summary of it, focus, if not "",
   what it is to mind most. The summary starts a conversation of its
   own, titled as the old one and "(compacted)": the old one is saved
   first and left as it is, so that a bad summary costs nothing, and
   /load takes it back. The summary is the human's first message, and
   CompactAck the reply, as every provider wants turns to alternate. *)
proc compact(s: ^Session; focus: []U8);
var ask, sum, why, id, title: Buf.Buf; c: Astore.Conv; m: ^Amsg.Msg; msgs: []Amsg.Msg; before, i, n: INT;
    err: ERROR;
begin
    msgs := Msgs.all(ADR(s^.conv.msgs));
    n := LEN(msgs);
    if n < 4 then say(s, "nothing to compact yet"); return; end;
    before := 0;
    for i := 0 to n - 1 do INC(before, LEN(msgs[i].text)); end;
    save(s);
    Buf.init(ADR(ask), ADR(s^.mem.base));
    Buf.init(ADR(sum), ADR(s^.mem.base));
    Buf.init(ADR(why), ADR(s^.mem.base));
    Buf.init(ADR(id), ADR(s^.mem.base));
    Buf.init(ADR(title), ADR(s^.mem.base));
    Buf.str(ADR(ask), Agent.CompactAsk);
    if LEN(focus) > 0 then Fmt.write(ADR(ask), " Pay particular attention to: {}.", [Fmt.str(focus)]); end;
    err := Agent.once(ADR(s^.agent), ADR(s^.conv), Buf.bytes(ADR(ask)), ADR(sum), ADR(why));
    Astore.newId(ADR(id));
    if err = Awire.Stopped then
        fail(s, "stopped; history unchanged");
    elsif err # nil then
        Fmt.write(ADR(s^.out), "{}; history unchanged", [Fmt.str(Buf.bytes(ADR(why)))]);
        fail(s, Buf.bytes(ADR(s^.out)));
    elsif LEN(Str.trim(Buf.bytes(ADR(sum)))) = 0 then
        fail(s, "the summary came back empty; history unchanged");
    else
        Buf.str(ADR(title), s^.conv.title);
        if title.len = 0 then Astore.autoTitle(ADR(s^.conv), ADR(title)); end;
        if not Str.hasSuffix(Buf.bytes(ADR(title)), " (compacted)") then Buf.str(ADR(title), " (compacted)"); end;
        Astore.init(ADR(c), Buf.bytes(ADR(id)));
        Astore.setTitle(ADR(c), Buf.bytes(ADR(title)));
        Astore.setSystem(ADR(c), s^.conv.system);
        m := Msgs.add(ADR(c.msgs));
        Amsg.init(m, Amsg.Role.user);
        Buf.reset(ADR(ask));
        Fmt.write(ADR(ask), "Summary of our conversation so far:\n\n{}", [Fmt.str(Str.trim(Buf.bytes(ADR(sum))))]);
        Amsg.setText(m, Buf.bytes(ADR(ask)));
        m := Msgs.add(ADR(c.msgs));
        Amsg.init(m, Amsg.Role.assistant);
        Amsg.setText(m, Agent.CompactAck);
        Fmt.write(ADR(s^.out), "compacted {} messages ({} KB) into a summary ({} KB); the full history is kept as {}",
            [Fmt.int(n), Fmt.int(before div 1024), Fmt.int(sum.len div 1024), Fmt.str(s^.conv.id)]);
        Astore.done(ADR(s^.conv));
        s^.conv := c;
        save(s);
        changed(s);
        say(s, Buf.bytes(ADR(s^.out)));
    end;
end;

proc list(word: []U8; out: ^Buf.Buf);
var l: Items.Vec; items: []Astore.Item; i: INT;
begin
    Astore.recent(Listed, word, ADR(l));
    defer Astore.drop(ADR(l));
    items := Items.all(ADR(l));
    for i := 0 to LEN(items) - 1 do
        if i > 0 then Buf.add(out, '\n'); end;
        if i < 9 then Buf.add(out, ' '); end;
        Fmt.write(out, "{}  {}  {}", [Fmt.int(i + 1), Fmt.str(items[i].id), Fmt.str(items[i].title)]);
    end;
    if LEN(items) = 0 then Buf.str(out, "nothing saved"); end;
end;

proc load(s: ^Session; arg: []U8);
var title: Buf.Buf;
begin
    if not resume(s, arg) then
        Fmt.write(ADR(s^.out), "no conversation {}", [Fmt.str(arg)]);
        fail(s, Buf.bytes(ADR(s^.out)));
        return;
    end;
    Buf.init(ADR(title), ADR(s^.mem.base));
    Buf.str(ADR(title), s^.conv.title);
    if title.len = 0 then Astore.autoTitle(ADR(s^.conv), ADR(title)); end;
    Fmt.write(ADR(s^.out), "loaded {}: {}, {} messages",
        [Fmt.str(s^.conv.id), Fmt.str(Buf.bytes(ADR(title))), Fmt.int(s^.conv.msgs.len)]);
    say(s, Buf.bytes(ADR(s^.out)));
end;

(* The conversation arg names as JSON, its file as it is; the current
   one, saved first, if arg is "". *)
proc export(s: ^Session; arg: []U8);
var id, path: Buf.Buf;
begin
    Buf.init(ADR(id), ADR(s^.mem.base));
    Buf.init(ADR(path), ADR(s^.mem.base));
    if LEN(arg) = 0 then
        save(s);
        Buf.str(ADR(id), s^.conv.id);
    elsif not find(arg, ADR(id)) then
        Fmt.write(ADR(s^.out), "no conversation {}", [Fmt.str(arg)]);
        fail(s, Buf.bytes(ADR(s^.out)));
        return;
    end;
    if Files.load(Astore.file(Buf.bytes(ADR(id)), ADR(path)), ADR(s^.out)) # 0 then
        Fmt.write(ADR(s^.out), "no conversation {}", [Fmt.str(Buf.bytes(ADR(id)))]);
        fail(s, Buf.bytes(ADR(s^.out)));
        return;
    end;
    say(s, Buf.bytes(ADR(s^.out)));
end;

proc rename(s: ^Session; title: []U8);
begin
    Astore.setTitle(ADR(s^.conv), title);
    save(s);
    if LEN(title) = 0 then say(s, "title cleared"); return; end;
    Fmt.write(ADR(s^.out), "renamed: {}", [Fmt.str(title)]);
    say(s, Buf.bytes(ADR(s^.out)));
end;

(* /system: text is the rest of the line as typed. *)
proc system(s: ^Session; text: []U8);
begin
    if (LEN(text) = 0) and (LEN(s^.conv.system) = 0) then
        Fmt.write(ADR(s^.out), "arno's own system prompt:\n\n{}", [Fmt.str(Aprompt.Own)]);
    elsif LEN(text) = 0 then
        Fmt.write(ADR(s^.out), "this conversation's own system prompt (/system - for arno's):\n\n{}",
            [Fmt.str(s^.conv.system)]);
    elsif text = "-" then
        Astore.setSystem(ADR(s^.conv), "");
        save(s);
        Buf.str(ADR(s^.out), "system prompt: arno's own, from the next turn");
    else
        Astore.setSystem(ADR(s^.conv), text);
        save(s);
        Buf.str(ADR(s^.out), "system prompt: this conversation's own, from the next turn");
    end;
    say(s, Buf.bytes(ADR(s^.out)));
end;

proc mode(s: ^Session; name: []U8);
var i: INT;
begin
    for i := 0 to LEN(Aprompt.Modes) - 1 do
        if Aprompt.Modes[i].name = name then s^.agent.mode := Aprompt.Mode(i); end;
    end;
    if (LEN(name) > 0) and (Aprompt.Modes[INT(s^.agent.mode)].name # name) then
        fail(s, "modes: chat review improve pair");
        return;
    end;
    Fmt.write(ADR(s^.out), "mode: {}", [Fmt.str(Aprompt.Modes[INT(s^.agent.mode)].name)]);
    say(s, Buf.bytes(ADR(s^.out)));
end;

(* name kept as s's named, the provider's model or name: what it named
   before is given back. *)
proc keep(s: ^Session; name: []U8): []U8;
begin
    Str.free(Heap.heap, s^.named);
    s^.named := Amsg.keep(name);
    return s^.named;
end;

proc model(s: ^Session; name: []U8);
begin
    if LEN(name) > 0 then s^.conf.prov.model := keep(s, name); end;
    Fmt.write(ADR(s^.out), "model: {}", [Fmt.str(s^.conf.prov.model)]);
    say(s, Buf.bytes(ADR(s^.out)));
end;

(* The models of s's provider, a line each: those its server told
   /models, or arno's own list of them. *)
proc models*(s: ^Session): []U8;
begin
    if Buf.bytes(ADR(s^.listedOf)) = s^.conf.prov.name then return Buf.bytes(ADR(s^.listed)); end;
    return Awire.known(s^.conf.prov.name);
end;

(* /models: those the provider's server lists, kept for models; or else
   arno's own list, said to be. *)
proc listModels(s: ^Session);
var why: Buf.Buf; p: ^Awire.Prov;
begin
    p := ADR(s^.conf.prov);
    Buf.init(ADR(why), Heap.heap);
    defer Buf.done(ADR(why));
    if Awire.models(p, ADR(s^.out), ADR(why)) = nil then
        Buf.reset(ADR(s^.listed));
        Buf.str(ADR(s^.listed), Buf.bytes(ADR(s^.out)));
        Buf.reset(ADR(s^.listedOf));
        Buf.str(ADR(s^.listedOf), p^.name);
        say(s, Str.trimRight(Buf.bytes(ADR(s^.out))));
        return;
    end;
    if LEN(Awire.known(p^.name)) = 0 then
        Fmt.write(ADR(s^.out), "{} lists no models: {}", [Fmt.str(p^.name), Fmt.str(Buf.bytes(ADR(why)))]);
        fail(s, Buf.bytes(ADR(s^.out)));
        return;
    end;
    Fmt.write(ADR(s^.out), "{}\n(arno's own list: {} didn't say, {})", [Fmt.str(Awire.known(p^.name)),
        Fmt.str(p^.name), Fmt.str(Buf.bytes(ADR(why)))]);
    say(s, Buf.bytes(ADR(s^.out)));
end;

(* /provider: one of Awire's presets, with none of the config's params,
   which were the other provider's. *)
proc provider(s: ^Session; name: []U8);
var p: ^Awire.Prov;
begin
    p := ADR(s^.conf.prov);
    if (LEN(name) > 0) and not Awire.preset(keep(s, name), p) then
        Fmt.write(ADR(s^.out), "unknown; try {}", [Fmt.str(Awire.Presets)]);
        fail(s, Buf.bytes(ADR(s^.out)));
        return;
    end;
    if LEN(name) > 0 then p^.params := p^.params[0..0]; end;
    Fmt.write(ADR(s^.out), "{} {} {}", [Fmt.str(p^.name), Fmt.str(p^.model), Fmt.str(p^.url)]);
    say(s, Buf.bytes(ADR(s^.out)));
end;

(* The tools the model is offered now, in this mode. *)
proc tools(s: ^Session; out: ^Buf.Buf);
var t: []Awire.Tool; i: INT;
begin
    t := Atools.offered(LEN(s^.agent.worker) > 0, s^.agent.mode in {Aprompt.chat, Aprompt.pair});
    for i := 0 to LEN(t) - 1 do
        if i > 0 then Buf.add(out, '\n'); end;
        Fmt.write(out, "{}  {}", [Fmt.str(t[i].name), Fmt.str(t[i].description)]);
    end;
end;

(* n tokens, short: 950, 23.4k, 1.2M. *)
proc tokens(b: ^Buf.Buf; n: I64);
begin
    if n < 1000 then
        Fmt.write(b, "{}", [Fmt.int(n)]);
    elsif n < 1000000 then
        Fmt.write(b, "{}k", [Fmt.real(F64(n) / 1000.0, 1)]);
    else
        Fmt.write(b, "{}M", [Fmt.real(F64(n) / 1.0E6, 1)]);
    end;
end;

(* The tokens s's conversation holds: what its last request held, in
   and out, and true; before one, a guess of a token for every four
   bytes of its messages, and false. *)
proc context(s: ^Session): (I64, BOOL);
var m: []Amsg.Msg; i: INT; n: I64;
begin
    if s^.agent.held > 0 then return s^.agent.held, true; end;
    m := Msgs.all(ADR(s^.conv.msgs));
    n := 0;
    for i := 0 to LEN(m) - 1 do n := n + LEN(m[i].text); end;
    return n div 4, false;
end;

(* The context in use, a ~ before a guess, and, where the model's
   window is known, of how much: ~1.2k, 23.4k/1.0M 2%. *)
proc meter(s: ^Session; b: ^Buf.Buf);
var n: I64; exact: BOOL; pr: Aprice.Price;
begin
    n, exact := context(s);
    if not exact then Buf.add(b, '~'); end;
    tokens(b, n);
    pr, _ := Aprice.price(ADR(s^.conf.prov));
    if pr.window > 0 then
        Buf.add(b, '/');
        tokens(b, pr.window);
        Fmt.write(b, " {}%", [Fmt.int(n * 100 div pr.window)]);
    end;
end;

(* The status line, into b: the mode, the model and its provider, the
   context in use, what the session cost, a pointer to /compact once
   the conversation is large, and its title, 40 bytes of it at most.
   The numbers come before the title, which the screen cuts first on a
   narrow terminal. Large is 60% of the model's window where that is
   known, else 20 messages or 50 KB of text. *)
proc status*(s: ^Session; b: ^Buf.Buf);
var a: ^Agent.Agent; pr: Aprice.Price; n: I64; title: Buf.Buf; t: []U8; i: INT; full: BOOL;
begin
    a := ADR(s^.agent);
    Fmt.write(b, "arno \u{B7} {} \u{B7} {} @ {} \u{B7} ctx ", [Fmt.str(Aprompt.Modes[INT(a^.mode)].name),
        Fmt.str(s^.conf.prov.model), Fmt.str(s^.conf.prov.name)]);
    meter(s, b);
    if a^.requests > 0 then
        Buf.str(b, " \u{B7} in ");
        tokens(b, a^.used.inp);
        Buf.str(b, " out ");
        tokens(b, a^.used.out);
        if a^.unpriced < a^.requests then
            Buf.str(b, " \u{B7} ");
            money(b, a^.spent);
            if a^.unpriced > 0 then Buf.add(b, '+'); end;
        end;
    end;
    n, _ := context(s);
    pr, _ := Aprice.price(ADR(s^.conf.prov));
    if pr.window > 0 then
        full := n * 10 >= pr.window * 6;
    else
        full := (s^.conv.msgs.len >= 20) or (n * 4 >= 50 * 1024);
    end;
    if full then Buf.str(b, " \u{B7} /compact"); end;
    Buf.init(ADR(title), Heap.heap);
    defer Buf.done(ADR(title));
    Buf.str(ADR(title), s^.conv.title);
    if title.len = 0 then Astore.autoTitle(ADR(s^.conv), ADR(title)); end;
    t := Buf.bytes(ADR(title));
    if LEN(t) = 0 then return; end;
    Buf.str(b, " \u{B7} ");
    if LEN(t) <= 40 then Str.replace(b, t, "\n", " "); return; end;
    i := 40;
    while (i > 0) and (t[i] & 0C0H = 80H) do DEC(i); end;   (* inside a character *)
    Str.replace(b, t[0..i], "\n", " ");
    Buf.str(b, "\u{2026}");
end;

(* /usage: what the session's requests cost, in tokens and in dollars
   at list price, and the price of the model in use. A session is this
   run of arno, across every conversation it went through. *)
proc usage(s: ^Session; out: ^Buf.Buf);
var a: ^Agent.Agent; pr: Aprice.Price; priced: BOOL;
begin
    a := ADR(s^.agent);
    Buf.str(out, "context   ");
    meter(s, out);
    Buf.str(out, " tokens\n");
    Fmt.write(out, "requests  {}\nin        {} tokens", [Fmt.int(a^.requests), Fmt.int(a^.used.inp)]);
    if a^.used.cached > 0 then Fmt.write(out, ", {} of them read from the cache", [Fmt.int(a^.used.cached)]); end;
    if a^.used.written > 0 then Fmt.write(out, ", {} written to it", [Fmt.int(a^.used.written)]); end;
    Fmt.write(out, "\nout       {} tokens", [Fmt.int(a^.used.out)]);
    if a^.unpriced < a^.requests then
        Buf.str(out, "\ncost      ");
        money(out, a^.spent);
        if a^.unpriced > 0 then Fmt.write(out, ", and {} requests with no known price", [Fmt.int(a^.unpriced)]); end;
    end;
    pr, priced := Aprice.price(ADR(s^.conf.prov));
    if priced then
        Fmt.write(out, "\nprice     {}: ", [Fmt.str(s^.conf.prov.model)]);
        price(out, pr.inp);
        Buf.str(out, " in, ");
        price(out, pr.cached);
        Buf.str(out, " cached, ");
        price(out, pr.out);
        Buf.str(out, " out, per million tokens");
    else
        Fmt.write(out, "\nprice     none known for {}; set price = IN OUT, dollars per million tokens, in the config",
            [Fmt.str(s^.conf.prov.model)]);
    end;
end;

(* /remember: arg is the fact, after "#" and its tags, which commas
   part, if it starts with a #. *)
proc remember(s: ^Session; arg: []U8);
var tags, fact: []U8;
begin
    tags := "";
    fact := arg;
    if Str.hasPrefix(arg, "#") then tags, fact := Str.field(arg[1..LEN(arg)]); end;
    fact := Str.trim(fact);
    if LEN(fact) = 0 then fail(s, "usage: /remember [#tag,tag,...] fact text"); return; end;
    Amemory.remember(fact, tags, ADR(s^.mem.base));
    Aprompt.remembered(ADR(s^.agent.prompt));
    Fmt.write(ADR(s^.out), "remembered: {}", [Fmt.str(fact)]);
    say(s, Buf.bytes(ADR(s^.out)));
end;

proc forget(s: ^Session; word: []U8);
var n: INT;
begin
    if LEN(word) = 0 then fail(s, "usage: /forget TAG|WORD"); return; end;
    n := Amemory.forget(word, ADR(s^.mem.base));
    Aprompt.remembered(ADR(s^.agent.prompt));
    Fmt.write(ADR(s^.out), "forgot {}", [Fmt.int(n)]);
    say(s, Buf.bytes(ADR(s^.out)));
end;

proc notes(s: ^Session; arg: []U8);
var verb, what: []U8;
begin
    if LEN(arg) = 0 then
        Aahead.listNotes(ADR(s^.mem.base), ADR(s^.out));
        if s^.out.len = 0 then Fmt.write(ADR(s^.out), "no notes for {}", [Fmt.str(Afence.zone)]); end;
        say(s, Buf.bytes(ADR(s^.out)));
        return;
    end;
    verb, what := Str.field(arg);
    what := Str.trim(what);
    if (verb # "forget") or (LEN(what) = 0) then fail(s, "usage: /notes [forget N|WORD]"); return; end;
    if Aahead.forgetNotes(what, ADR(s^.mem.base), ADR(s^.out)) = 0 then
        Fmt.write(ADR(s^.out), "no note {}", [Fmt.str(what)]);
        fail(s, Buf.bytes(ADR(s^.out)));
        return;
    end;
    say(s, Buf.bytes(ADR(s^.out)));
end;

(* /test: the project's test command run, as check runs it, or first
   set to arg, for this project, in tests.json. A failure is put to the
   model as a turn, with the end of the output: the human runs the
   tests to have what failed fixed. *)
proc test(s: ^Session; arg: []U8);
var b, got, output, why: Buf.Buf; cmd: []U8; j: Arun.Job; m: ^Amsg.Msg; status: INT; cut: BOOL;
begin
    Buf.init(ADR(b), ADR(s^.mem.base));
    Buf.init(ADR(got), ADR(s^.mem.base));
    Buf.init(ADR(output), ADR(s^.mem.base));
    Buf.init(ADR(why), ADR(s^.mem.base));
    cmd := arg;
    if LEN(cmd) = 0 then
        cmd := Atools.testFor(ADR(b));
    elsif cmd # Astore.keyed("tests.json", Afence.zone, ADR(b)) then
        if Astore.setKeyed("tests.json", Afence.zone, cmd) # nil then
            fail(s, "tests.json can't be written");
            return;
        end;
        Fmt.write(ADR(s^.out), "test command for {}: {}", [Fmt.str(Afence.zone), Fmt.str(cmd)]);
        say(s, Buf.bytes(ADR(s^.out)));
        Buf.reset(ADR(s^.out));
    end;
    if LEN(cmd) = 0 then fail(s, "usage: /test COMMAND, or set test_cmd in config"); return; end;
    j := {args: ["sh", "-c", cmd], detach: true, tail: true};
    status, cut := Arun.start(ADR(j), MaxTest, ADR(got));
    if status = 0 then
        Fmt.write(ADR(s^.out), "tests passed: {}", [Fmt.str(cmd)]);
        say(s, Buf.bytes(ADR(s^.out)));
        return;
    end;
    Buf.reset(ADR(b));
    Fmt.write(ADR(b), "Tests failed (`{}`, exit {}). What should I fix?\n\n", [Fmt.str(cmd), Fmt.int(status)]);
    if cut then Buf.str(ADR(output), "[...]\n"); end;
    Buf.str(ADR(output), Buf.bytes(ADR(got)));
    Aahead.block(ADR(b), cmd, "", Buf.bytes(ADR(output)));
    m := Msgs.add(ADR(s^.conv.msgs));
    Amsg.init(m, Amsg.Role.user);
    Amsg.setText(m, Buf.bytes(ADR(b)));
    failed(s, answer(s, ADR(why)), Buf.bytes(ADR(why)));
end;

(* A command, line, which starts with a /. *)
proc command(s: ^Session; line: []U8);
var name, arg: []U8;
begin
    name, arg := Str.field(line);
    arg := Str.trim(arg);
    Buf.reset(ADR(s^.out));
    match name of
    | "/help": help(ADR(s^.out)); say(s, Buf.bytes(ADR(s^.out)));
    | "/new": renew(s);
    | "/clear": clear(s);
    | "/compact": compact(s, arg);
    | "/list": list(arg, ADR(s^.out)); say(s, Buf.bytes(ADR(s^.out)));
    | "/load": load(s, arg);
    | "/export": export(s, arg);
    | "/rename": rename(s, arg);
    | "/system": system(s, arg);
    | "/mode": mode(s, arg);
    | "/model": model(s, arg);
    | "/models": listModels(s);
    | "/provider": provider(s, arg);
    | "/tools": tools(s, ADR(s^.out)); say(s, Buf.bytes(ADR(s^.out)));
    | "/usage": usage(s, ADR(s^.out)); say(s, Buf.bytes(ADR(s^.out)));
    | "/remember": remember(s, arg);
    | "/forget": forget(s, arg);
    | "/my-memory":
        Amemory.facts(arg, ADR(s^.mem.base), ADR(s^.out));
        if s^.out.len = 0 then Buf.str(ADR(s^.out), "nothing remembered"); end;
        say(s, Buf.bytes(ADR(s^.out)));
    | "/notes": notes(s, arg);
    | "/test": test(s, arg);
    | else: fail(s, "unknown command; /help lists them");
    end;
    Arena.reset(ADR(s^.mem));
end;

(* A line the human typed: a command, or a message to the model, whose
   turn's failure is shown. false for /quit or /exit, which end the
   session. *)
proc line*(s: ^Session; text: []U8): BOOL;
var why: Buf.Buf; err: ERROR;
begin
    text := Str.trim(text);
    if LEN(text) = 0 then return true; end;
    if (text = "/quit") or (text = "/exit") then return false; end;
    if text[0] = '/' then command(s, text); return true; end;
    Buf.init(ADR(why), Heap.heap);
    defer Buf.done(ADR(why));
    err := turn(s, text, ADR(why));
    failed(s, err, Buf.bytes(ADR(why)));
    return true;
end;

end Asession.
