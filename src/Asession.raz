(* Asession: a session, the conversations one run of arno goes through,
   one at a time, and the commands the human types between turns.

   A line the human types is a command if it starts with a /, and
   otherwise a message to the model, which starts a turn of the
   conversation (line). A turn is saved when it ends, however it ends.
   What a command has to say goes to the front end, as a text or as an
   error, through a Show; what a turn does goes through the agent's
   Front. Plain mode is one front end; the screen will be another.

   Commands that switch conversations, /new, /load and /clear, drop the
   paths granted outside the project and the changes declined: they
   were given for the work of the conversation left. /compact keeps
   them, as the work goes on.

   A message goes with what its @paths bring (Aattach).

   /test runs the project's test command, as check does, and puts a
   failure to the model as a turn.

   An ask from an editor (ask) is a turn too, put to the model as the
   editor's message and told to the human as that; see Apeer.

   Depends on Agent, Apeer, Aprompt (the commands and modes), Amemory, Aahead
   (the notes), Aattach, Astore, Aconf, Aprice, Atools, Alsp (the
   language servers config names), Amcp, Afence and
   Arun (/test).
   The stage (Astage) is up from start-up unless config's safety or
   stage.json says safe, and on /safety auto; at the end of each turn, and on /stage, the
   human is asked once about the copy's changes (propose). A conversation
   taken up, by /load or --resume, brings back the work it left unapplied
   (carry). leave ends the session's stage. The MCP servers config
   names are attached as the session starts (attachServers).

   /models asks the provider's server for its models, or else says
   arno's own list of them (Awire.known); what the server said is kept
   for the screen to complete /model with (models).

   status makes the screen's status line; /usage shows its context in
   use too, from the last request, or guessed from the text before
   one. A conversation changed other than by a turn, by /new, /load,
   /clear or /compact, is handed to changed, for a screen to show it
   again. *)
module Asession;
import Agent, Apeer, Astage, Aprompt, Amemory, Aahead, Aattach, Astore, Aconf, Awire, Aprice, Atools, Alsp, Amcp, Afence, Arun, Amsg, Buf, Str,
    Sys, Files, Fmt, Heap, Arena, Math, Rt, Strs := Vec([]const U8), Msgs := Vec(Amsg.Msg), Items := Vec(Astore.Item);
import SYSTEM;

type
    (* What arno says of a command to the human: s, an error if bad. *)
    Show* = proc(s: []const U8; bad: BOOL; arg: ^U8);
    (* The conversation is c from now on, to be shown from its start. *)
    Changed* = proc(const c: Astore.Conv; arg: ^U8);

    Session* = record
        conf*: Aconf.Conf;
        agent*: Agent.Agent;   (* asks the model as conf.prov says *)
        conv*: Astore.Conv;    (* the conversation of the next turn *)
        show: Show;
        changed*: Changed;     (* nil if nothing is shown again *)
        arg: ^U8;
        named: []U8;           (* the model or provider a command named, kept from Heap; "" for none *)
        mem: Arena.Arena;      (* a command's work *)
        out: Buf.Buf;          (* what a command says *)
        listed: Buf.Buf;       (* the models /models was told, a line each *)
        listedOf: Buf.Buf;     (* by which provider *)
        notesBefore: INT;      (* the project's notes as the turn began, which the stage shows the new ones after *)
    end;

    (* What the status line says: the screen draws it in colour, text
       writes it out. Its texts are its own, from Heap. *)
    Facts* = record
        mode*: Aprompt.Mode;
        staged*: BOOL;       (* safety auto, working on the stage's copy; else safe *)
        approved*: BOOL;     (* the conversation's plan is approved, which build waits for *)
        model*: Buf.Buf;
        provider*: Buf.Buf;
        context*: Buf.Buf;   (* the context in use, as meter says it *)
        fill*: INT;          (* the percent of the model's window in use; -1 where the window is unknown *)
        usage*: Buf.Buf;     (* the tokens in and out, "in 12k out 3k"; "" before a request *)
        cost*: Buf.Buf;      (* what the session cost; "" before a request, or with no price known *)
        full*: BOOL;         (* the conversation is large: time for /compact *)
        title*: Buf.Buf;     (* the conversation's title, 40 bytes of it at most *)
    end;

const
    Listed = 20;   (* conversations /list shows, and /load N counts in *)
    MaxTest = 50000;   (* bytes of a failed /test's output put to the model, the last *)

(* Staged as stage.json says of the project, else as config says; after init. *)
proc stageStart(var s: Session); forward;

(* The tools' scratch directory made the one of s's conversation. *)
proc useScratch(const s: Session);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Afence.useScratch(Astore.scratch(s.conv.id, b));
end;

(* The MCP servers config's mcp lines name, each a name and then the
   command that runs it, attached; what goes wrong with one is shown, and
   the rest are attached. *)
proc attachServers(const s: Session);
var value, name, word, rest, err: []const U8; argv: Strs.Vec; said: Buf.Buf; n: INT; ok: BOOL;
begin
    Strs.init(argv, Heap.heap);
    defer Strs.done(argv);
    Buf.init(said, Heap.heap);
    defer Buf.done(said);
    n := 0;
    value, ok := Aconf.nth(s.conf, "mcp", n);
    while ok do
        name, rest := Str.field(value);
        Strs.reset(argv);
        word, rest := Str.field(rest);
        while LEN(word) > 0 do
            Strs.push(argv, word);
            word, rest := Str.field(rest);
        end;
        if (LEN(name) > 0) and (LEN(Strs.all(argv)) > 0) then
            err := Amcp.attach(name, Strs.all(argv));
            if LEN(err) > 0 then
                Buf.reset(said);
                Buf.str(said, "mcp ");
                Buf.str(said, err);
                s.show(Buf.bytes(said), true, s.arg);
            end;
        end;
        INC(n);
        value, ok := Aconf.nth(s.conf, "mcp", n);
    end;
end;

(* The models the lead may hand a step to: config's workers, on the
   provider, and config's worker, the one used when a step names none;
   the first of workers if worker isn't set, and worker is one of them
   if it is. *)
proc useWorkers(var s: Session);
var list: Buf.Buf; w, rest: []const U8; listed: BOOL;
begin
    s.agent.worker := Aconf.get(s.conf, "worker");
    w, rest := Str.field(Aconf.get(s.conf, "workers"));
    if LEN(s.agent.worker) = 0 then s.agent.worker := w; end;
    Buf.init(list, Heap.heap);
    defer Buf.done(list);
    Buf.str(list, Aconf.get(s.conf, "workers"));
    listed := false;
    while LEN(w) > 0 do
        if w = s.agent.worker then listed := true; end;
        w, rest := Str.field(rest);
    end;
    if not listed and (LEN(s.agent.worker) > 0) then Fmt.write(list, " {}", [Fmt.str(s.agent.worker)]); end;
    Atools.workers(Str.trim(Buf.bytes(list)), s.agent.worker, s.conf.prov);
end;

(* s made the session the config sets up, telling front of turns and
   show of commands, with a new conversation. What is wrong with the
   config is shown. *)
proc init*(s: ^Session; front: Agent.Front; show: Show; arg: ^U8);
var id: Buf.Buf; n: I64; x: F64; i: INT; ok: BOOL; name, cmd: []const U8;
begin
    s^ := {show: show, arg: arg};
    Arun.stopWhen(front.stopped);
    Aconf.load(s^.conf);
    if not Arena.init(s^.mem, 1 shl 28) then Rt.stop("arno: out of memory"); end;
    Buf.init(s^.out, Heap.heap);
    Buf.init(s^.listed, Heap.heap);
    Buf.init(s^.listedOf, Heap.heap);
    if s^.conf.warnings.len > 0 then show(Str.trimRight(Buf.bytes(s^.conf.warnings)), true, arg); end;
    Buf.init(id, Heap.heap);
    defer Buf.done(id);
    Astore.newId(id);
    Astore.init(s^.conv, Buf.bytes(id));
    Agent.init(s^.agent, SYSTEM.ADR(s^.conf.prov), front);
    (* the project's root is known now that Agent.init has set the fence: its sections from here on *)
    Aconf.apply(s^.conf, Afence.root);
    Alsp.use(SYSTEM.ADR(s^.conf));
    useScratch(s^);
    n, ok := Str.toInt(Aconf.get(s^.conf, "max_steps"));
    if ok and (n > 0) then s^.agent.maxSteps := INT(n); end;
    n, ok := Str.toInt(Aconf.get(s^.conf, "prune"));
    if ok and (n >= 0) then s^.agent.prune := INT(n); end;
    s^.agent.budget, _ := Math.toReal(Aconf.get(s^.conf, "turn_budget"));
    n, ok := Str.toInt(Aconf.get(s^.conf, "build_steps"));
    if ok and (n > 0) then s^.agent.buildSteps := INT(n); end;
    x, ok := Math.toReal(Aconf.get(s^.conf, "build_budget"));
    if ok and (x >= 0.0) then s^.agent.buildBudget := x; end;
    s^.agent.prefetch := Aconf.get(s^.conf, "prefetch") # "no";
    useWorkers(s^);
    for i := 0 to LEN(Aprompt.Modes) - 1 do
        if Aprompt.Modes[i].name = Aconf.get(s^.conf, "mode") then s^.agent.mode := Aprompt.Mode(i); end;
    end;
    Atools.search(Aconf.get(s^.conf, "searxng"));
    Atools.shellEnabled(Aconf.get(s^.conf, "shell") # "no");
    Atools.commands(Aconf.get(s^.conf, "run"), Aconf.get(s^.conf, "run_ro"),
        Aconf.get(s^.conf, "run_env"), Aconf.get(s^.conf, "trust"), Aconf.get(s^.conf, "test_cmd"));
    Atools.clearChecks;
    i := 0;
    name, cmd, ok := Aconf.named(s^.conf, "check", i);
    while ok do
        Atools.addCheck(name, cmd);
        INC(i);
        name, cmd, ok := Aconf.named(s^.conf, "check", i);
    end;
    Atools.jail(Aconf.get(s^.conf, "jail_net") = "yes", Aconf.get(s^.conf, "jail_rw"));
    attachServers(s^);
    stageStart(s^);
    Arena.reset(s^.mem);
end;

(* What lasts the session found: the context files, as config's
   context_files says, the human asked if it says ask, and the
   project's map, unless project_map says no. Not before a turn is
   sure to run: asking about context files is for a human who will be
   answered. *)
proc prepare*(var s: Session);
var mode: []const U8;
begin
    mode := Aconf.get(s.conf, "context_files");
    if LEN(mode) = 0 then mode := "ask"; end;
    Agent.prepare(s.agent, mode, Aconf.get(s.conf, "project_map") # "no");
end;

proc say(const s: Session; text: []const U8);
begin
    s.show(text, false, s.arg);
end;

proc fail(const s: Session; text: []const U8);
begin
    s.show(text, true, s.arg);
end;

(* s's conversation saved; said if it can't be. *)
proc save(var s: Session);
begin
    Astore.setModel(s.conv, s.conf.prov.model);
    if Astore.save(s.conv) # nil then
        Buf.reset(s.out);
        Fmt.write(s.out, "the conversation can't be saved in {}", [Fmt.str(Astore.dir())]);
        fail(s, Buf.bytes(s.out));
    end;
end;

(* s's conversation given the title title, "" to clear it, and saved,
   without a word to the human: a host asks. *)
proc retitle*(var s: Session; title: []const U8);
begin
    Astore.setTitle(s.conv, title);
    save(s);
end;

(* s's conversation given the system prompt text, "" for arno's own,
   and saved, without a word to the human: a host asks. *)
proc resystem*(var s: Session; text: []const U8);
begin
    Astore.setSystem(s.conv, text);
    save(s);
end;

(* s's conversation changed other than by a turn: what its last request
   held is no longer known, and the front end shows it again. *)
proc changed(var s: Session);
begin
    s.agent.held := 0;
    if s.changed # nil then s.changed(s.conv, s.arg); end;
end;

(* c made s's conversation, the one it had given back, and what was
   granted and declined for that one forgotten. *)
proc switch(var s: Session; const c: Astore.Conv);
begin
    Astore.done(s.conv);
    s.conv := c;
    useScratch(s);
    Afence.forget;
    Atools.forgive;
    changed(s);
end;

(* The stage *)

(* The notes the project had when the turn began, how many. *)
proc noteCount(var s: Session): INT;
var l: Strs.Vec;
begin
    Strs.init(l, SYSTEM.ADR(s.mem.base));
    Aahead.projectNotes(SYSTEM.ADR(s.mem.base), l);
    return l.len;
end;

(* The notes kept since the turn began, as lines starting "# note: ",
   "" for none. A note outlives the conversation and steers every later
   one, and it can be wrong, so the turn's notes are shown with its
   diff, where the human looks anyway. *)
proc newNotes(var s: Session; var out: Buf.Buf);
var l: Strs.Vec; all: [][]const U8; i: INT;
begin
    Strs.init(l, SYSTEM.ADR(s.mem.base));
    Aahead.projectNotes(SYSTEM.ADR(s.mem.base), l);
    all := Strs.all(l);
    for i := s.notesBefore to LEN(all) - 1 do Fmt.write(out, "# note: {}\n", [Fmt.str(all[i])]); end;
end;

(* The path of stage.diff, in the conversation's scratch directory, into b. *)
proc stageDiff(var b: Buf.Buf): []const U8;
begin
    Buf.str(b, Afence.scratch);
    Buf.str(b, "/stage.diff");
    return Buf.bytes(b);
end;

(* Into the copy, saying where, or, safe, why not: a project that git
   doesn't keep has no stage. *)
proc stageUp(var s: Session);
var why: Buf.Buf;
begin
    Buf.init(why, SYSTEM.ADR(s.mem.base));
    Buf.reset(s.out);
    if not Astage.up(why) then
        Fmt.write(s.out, "safety: safe, each change asked, since there is no stage: {}", [Fmt.str(Buf.bytes(why))]);
        say(s, Buf.bytes(s.out));
        Buf.reset(s.out);
        return;
    end;
    Fmt.write(s.out, "safety: auto, working on a copy at {}; each turn's changes come as one diff to apply to {}",
        [Fmt.str(Afence.stage), Fmt.str(Afence.root)]);
    say(s, Buf.bytes(s.out));
    Buf.reset(s.out);
end;

(* The copy's changes since last asked, as one diff and one question,
   at the end of a turn and on /stage: a yes applies them to the
   human's tree, a no keeps them in the copy, to be asked about with the
   next turn's. The diff is also left in the scratch directory as
   stage.diff, for a run with no one to answer, the turn's notes before
   it (git apply passes over what comes before the first diff). *)
proc propose(var s: Session);
var diff, why, shown, file: Buf.Buf; n: INT; answer: U8;
begin
    if LEN(Afence.stage) = 0 then return; end;
    Buf.init(diff, SYSTEM.ADR(s.mem.base));
    Buf.init(why, SYSTEM.ADR(s.mem.base));
    Buf.init(shown, SYSTEM.ADR(s.mem.base));
    Buf.init(file, SYSTEM.ADR(s.mem.base));
    Buf.reset(s.out);
    n := Astage.changes(diff, why);
    if n < 0 then
        Fmt.write(s.out, "stage: {}", [Fmt.str(Buf.bytes(why))]);
        fail(s, Buf.bytes(s.out));
        return;
    end;
    newNotes(s, shown);
    if n = 0 then
        if shown.len > 0 then
            Fmt.write(s.out, "notes kept this turn (/notes forgets one):\n{}", [Fmt.str(Str.trimRight(Buf.bytes(shown)))]);
            say(s, Buf.bytes(s.out));
        end;
        return;
    end;
    Buf.str(shown, Buf.bytes(diff));
    _ := Files.write(stageDiff(file), Buf.bytes(shown));
    Buf.reset(s.out);
    Fmt.write(s.out, "apply these changes to {} file(s) in {}?", [Fmt.int(n), Fmt.str(Afence.root)]);
    answer := 0;
    if s.agent.front.ask # nil then
        answer := s.agent.front.ask(Buf.bytes(s.out), Buf.bytes(shown), "yn");
    end;
    Buf.reset(s.out);
    if answer # 'y' then
        Fmt.write(s.out, "kept in the copy, and offered again after the next turn; /stage drop discards them. " +
            "The diff is in {}", [Fmt.str(Buf.bytes(file))]);
        say(s, Buf.bytes(s.out));
        return;
    end;
    if not Astage.apply(Buf.bytes(diff), why) then
        Fmt.write(s.out, "not applied, so kept in the copy: {}", [Fmt.str(Buf.bytes(why))]);
        fail(s, Buf.bytes(s.out));
        return;
    end;
    _ := Sys.remove(Buf.bytes(file));   (* nothing pending now for resume to carry *)
    Fmt.write(s.out, "applied to {} file(s) in {}", [Fmt.int(n), Fmt.str(Afence.root)]);
    say(s, Buf.bytes(s.out));
end;

(* A conversation taken up while staged: the work it left unapplied
   comes back into the copy, unless the copy holds work of its own. *)
proc carry(var s: Session);
var diff, text, why, file: Buf.Buf; n: INT;
begin
    if LEN(Afence.stage) = 0 then return; end;
    Buf.init(diff, SYSTEM.ADR(s.mem.base));
    Buf.init(text, SYSTEM.ADR(s.mem.base));
    Buf.init(why, SYSTEM.ADR(s.mem.base));
    Buf.init(file, SYSTEM.ADR(s.mem.base));
    Buf.reset(s.out);
    if Files.load(stageDiff(file), text) # 0 then return; end;
    n := Astage.changes(diff, why);
    if n < 0 then
        Fmt.write(s.out, "stage: could not tell whether the copy holds changes, so the pending ones were not " +
            "brought in; they are in {}: {}", [Fmt.str(Buf.bytes(file)), Fmt.str(Buf.bytes(why))]);
        fail(s, Buf.bytes(s.out));
    elsif n > 0 then
        Fmt.write(s.out, "stage: the copy holds changes, so this conversation's pending ones were not brought in; " +
            "they are in {}", [Fmt.str(Buf.bytes(file))]);
        fail(s, Buf.bytes(s.out));
    elsif Astage.carry(Buf.bytes(text), why) then
        say(s, "stage: the work this conversation left unapplied is back in the copy");
    else
        Fmt.write(s.out, "stage: could not bring back the unapplied work: {}", [Fmt.str(Buf.bytes(why))]);
        fail(s, Buf.bytes(s.out));
    end;
    Buf.reset(s.out);
end;

(* /stage: where things stand and what the copy holds, offered; /stage
   drop: what it holds discarded. *)
proc stage(var s: Session; arg: []const U8);
var why, file: Buf.Buf;
begin
    Buf.init(why, SYSTEM.ADR(s.mem.base));
    Buf.init(file, SYSTEM.ADR(s.mem.base));
    if (arg # "") and (arg # "drop") then
        fail(s, "usage: /stage [drop]");
    elsif LEN(Afence.stage) = 0 then
        say(s, "not staged: safety is safe; /safety auto works on a copy");
    elsif arg = "" then
        Fmt.write(s.out, "staged: working on a copy at {}", [Fmt.str(Afence.stage)]);
        say(s, Buf.bytes(s.out));
        Buf.reset(s.out);
        propose(s);
    elsif Astage.drop(why) then
        _ := Sys.remove(stageDiff(file));
        say(s, "the copy is back as it was when last applied");
    else
        Fmt.write(s.out, "stage: {}", [Fmt.str(Buf.bytes(why))]);
        fail(s, Buf.bytes(s.out));
    end;
end;

(* /safety auto or safe, remembered for the project; with no argument,
   which it is. Auto works on the stage's copy; safe leaves it, once
   nothing is pending there, and asks each change. *)
proc safety(var s: Session; arg: []const U8);
var why, diff: Buf.Buf;
begin
    Buf.init(why, SYSTEM.ADR(s.mem.base));
    Buf.init(diff, SYSTEM.ADR(s.mem.base));
    if LEN(arg) = 0 then
        if LEN(Afence.stage) = 0 then
            say(s, "safety: safe, each change asked; /safety auto works on a copy");
        else
            Fmt.write(s.out, "safety: auto, working on a copy at {}", [Fmt.str(Afence.stage)]);
            say(s, Buf.bytes(s.out));
        end;
    elsif arg = "auto" then
        if LEN(Afence.stage) > 0 then
            Fmt.write(s.out, "already auto, at {}", [Fmt.str(Afence.stage)]);
            say(s, Buf.bytes(s.out));
        else
            stageUp(s);
        end;
        if LEN(Afence.stage) > 0 then _ := Astore.setKeyed("stage.json", Afence.root, "on"); end;
    elsif arg # "safe" then
        fail(s, "usage: /safety [auto|safe]");
    elsif LEN(Afence.stage) = 0 then
        _ := Astore.setKeyed("stage.json", Afence.root, "off");
        say(s, "already safe");
    elsif Astage.changes(diff, why) < 0 then
        Fmt.write(s.out, "stage: {}", [Fmt.str(Buf.bytes(why))]);
        fail(s, Buf.bytes(s.out));
    elsif diff.len > 0 then
        fail(s, "the copy holds changes: /stage to apply them, /stage drop to discard them");
    else
        Astage.down;
        _ := Astore.setKeyed("stage.json", Afence.root, "off");
        Fmt.write(s.out, "safety: safe, back in {}; each change is asked", [Fmt.str(Afence.root)]);
        say(s, Buf.bytes(s.out));
    end;
end;

(* Staged as /safety last left this project, else unless config's
   safety is safe. *)
proc stageStart(var s: Session);
var b: Buf.Buf; kept: []const U8;
begin
    Buf.init(b, SYSTEM.ADR(s.mem.base));
    kept := Astore.keyed("stage.json", Afence.root, b);
    if (kept = "on") or (LEN(kept) = 0) and (Aconf.get(s.conf, "safety") # "safe") then stageUp(s); end;
    s.notesBefore := noteCount(s);
end;

(* The session over: the copy removed, its pending work kept in the
   conversation's stage.diff. *)
proc leave*;
begin
    Astage.down;
end;

(* A turn of s's conversation on its last message, the human's:
   Agent.turn's error, why saying why it failed. The conversation is
   saved after. *)
proc answer(var s: Session; var why: Buf.Buf): ERROR;
var err: ERROR;
begin
    s.notesBefore := noteCount(s);
    err := Agent.turn(s.agent, s.conv, why);
    save(s);
    propose(s);
    return err;
end;

(* A turn of s's conversation, on the human's message text and what its
   @paths bring: Agent.turn's error, why saying why it failed. The
   conversation is saved after. *)
proc turn*(var s: Session; text: []const U8; var why: Buf.Buf): ERROR;
var m: ^Amsg.Msg; err: ERROR;
begin
    m := Msgs.add(s.conv.msgs);
    Amsg.init(m^, Amsg.Role.user);
    Aattach.expand(m^, text);
    err := answer(s, why);
    Arena.reset(s.mem);
    return err;
end;

(* A turn's failure, err, shown: why says why it failed. *)
proc failed(const s: Session; err: ERROR; why: []const U8);
begin
    if err = Awire.Failed then fail(s, why); end;
    if err = Awire.Stopped then fail(s, "interrupted"); end;
end;

(* The id of the conversation arg names, into id: a number from /list,
   or an id; else the last changed whose title or id holds arg. *)
proc find(arg: []const U8; var id: Buf.Buf): BOOL;
var list: Items.Vec; n: I64; ok: BOOL;
begin
    n, ok := Str.toInt(arg);
    Astore.recent(Listed, "", list);
    if ok and (n >= 1) and (n <= list.len) then Buf.str(id, Items.all(list)[n - 1].id); end;
    Astore.drop(list);
    if id.len > 0 then return true; end;
    if LEN(arg) = 0 then return false; end;
    if Sys.access(Astore.file(arg, id), {}) = 0 then
        Buf.reset(id);
        Buf.str(id, arg);
        return true;
    end;
    Buf.reset(id);
    Astore.recent(1, arg, list);
    if list.len > 0 then Buf.str(id, Items.all(list)[0].id); end;
    Astore.drop(list);
    return id.len > 0;
end;

(* The conversation arg names, as find finds it, made s's: /load, and
   arno --resume. false if there is none. *)
proc resume*(var s: Session; arg: []const U8): BOOL;
var id: Buf.Buf; c: Astore.Conv;
begin
    Buf.init(id, Heap.heap);
    defer Buf.done(id);
    if not find(arg, id) then return false; end;
    if Astore.load(c, Buf.bytes(id)) # nil then
        Astore.done(c);
        return false;
    end;
    switch(s, c);
    carry(s);
    return true;
end;

(* b's line padded with blanks to col bytes, from start, where it began. *)
proc pad(var b: Buf.Buf; start, col: INT);
begin
    repeat Buf.add(b, ' '); until b.len - start >= col;
end;

(* dollars as /usage shows them: a third decimal while there are only
   cents to show. *)
proc money(var b: Buf.Buf; d: F64);
begin
    if d < 1.0 then Fmt.write(b, "${}", [Fmt.real(d, 3)]); else Fmt.write(b, "${}", [Fmt.real(d, 2)]); end;
end;

(* A price per million tokens, with as many decimals as it needs. *)
proc price(var b: Buf.Buf; d: F64);
begin
    Fmt.write(b, "${}", [Fmt.real(d, 4)]);
    while Buf.bytes(b)[b.len - 1] = '0' do DEC(b.len); end;
    if Buf.bytes(b)[b.len - 1] = '.' then DEC(b.len); end;
end;

(* the commands, each its text into out *)

proc help(var out: Buf.Buf);
var i, at: INT;
begin
    for i := 0 to LEN(Aprompt.Commands) - 1 do
        at := out.len;
        Aprompt.usage(Aprompt.Commands[i], out);
        pad(out, at, 19);
        Buf.str(out, Aprompt.Commands[i].desc);
        Buf.add(out, '\n');
    end;
    Buf.str(out, "\nmodes:");
    for i := 0 to LEN(Aprompt.Modes) - 1 do
        Buf.str(out, "\n  ");
        at := out.len;
        Buf.str(out, Aprompt.Modes[i].name);
        pad(out, at, 17);
        Buf.str(out, Aprompt.Modes[i].hint);
    end;
end;

proc renew(var s: Session);
var id: Buf.Buf; c: Astore.Conv;
begin
    Buf.init(id, Heap.heap);
    defer Buf.done(id);
    Astore.newId(id);
    Astore.init(c, Buf.bytes(id));
    switch(s, c);
    say(s, "a new conversation");
end;

(* The history cut to the first exchange: the human's first message
   and what came of it, up to the next. *)
proc clear(var s: Session);
var m: []Amsg.Msg; i, keep: INT;
begin
    m := Msgs.all(s.conv.msgs);
    keep := 1;
    while (keep < LEN(m)) and (m[keep].role # Amsg.Role.user) do INC(keep); end;
    for i := keep to LEN(m) - 1 do Amsg.free(m[i]); end;
    Msgs.resize(s.conv.msgs, keep);
    save(s);
    changed(s);
    Astore.clearScratch(s.conv.id);
    Afence.forget;
    Atools.forgive;
    say(s, "history cleared to the first exchange, scratch directory emptied, path grants dropped");
end;

(* The history replaced by the model's summary of it, focus, if not "",
   what it is to mind most. The summary starts a conversation of its
   own, titled as the old one and "(compacted)": the old one is saved
   first and left as it is, so that a bad summary costs nothing, and
   /load takes it back. The summary is the human's first message, and
   CompactAck the reply, as every provider wants turns to alternate. *)
proc compact(var s: Session; focus: []const U8);
var ask, sum, why, id, title: Buf.Buf; c: Astore.Conv; m: ^Amsg.Msg; msgs: []Amsg.Msg; before, i, n: INT;
    err: ERROR;
begin
    msgs := Msgs.all(s.conv.msgs);
    n := LEN(msgs);
    if n < 4 then say(s, "nothing to compact yet"); return; end;
    before := 0;
    for i := 0 to n - 1 do INC(before, LEN(msgs[i].text)); end;
    save(s);
    Buf.init(ask, SYSTEM.ADR(s.mem.base));
    Buf.init(sum, SYSTEM.ADR(s.mem.base));
    Buf.init(why, SYSTEM.ADR(s.mem.base));
    Buf.init(id, SYSTEM.ADR(s.mem.base));
    Buf.init(title, SYSTEM.ADR(s.mem.base));
    Buf.str(ask, Agent.CompactAsk);
    if LEN(focus) > 0 then Fmt.write(ask, " Pay particular attention to: {}.", [Fmt.str(focus)]); end;
    err := Agent.once(s.agent, s.conv, Buf.bytes(ask), sum, why);
    Astore.newId(id);
    if err = Awire.Stopped then
        fail(s, "stopped; history unchanged");
    elsif err # nil then
        Fmt.write(s.out, "{}; history unchanged", [Fmt.str(Buf.bytes(why))]);
        fail(s, Buf.bytes(s.out));
    elsif LEN(Str.trim(Buf.bytes(sum))) = 0 then
        fail(s, "the summary came back empty; history unchanged");
    else
        Buf.str(title, s.conv.title);
        if title.len = 0 then Astore.autoTitle(s.conv, title); end;
        if not Str.hasSuffix(Buf.bytes(title), " (compacted)") then Buf.str(title, " (compacted)"); end;
        Astore.init(c, Buf.bytes(id));
        Astore.setTitle(c, Buf.bytes(title));
        Astore.setSystem(c, s.conv.system);
        m := Msgs.add(c.msgs);
        Amsg.init(m^, Amsg.Role.user);
        Buf.reset(ask);
        Fmt.write(ask, "Summary of our conversation so far:\n\n{}", [Fmt.str(Str.trim(Buf.bytes(sum)))]);
        Amsg.setText(m^, Buf.bytes(ask));
        m := Msgs.add(c.msgs);
        Amsg.init(m^, Amsg.Role.assistant);
        Amsg.setText(m^, Agent.CompactAck);
        Fmt.write(s.out, "compacted {} messages ({} KB) into a summary ({} KB); the full history is kept as {}",
            [Fmt.int(n), Fmt.int(before div 1024), Fmt.int(sum.len div 1024), Fmt.str(s.conv.id)]);
        Astore.moveScratch(s.conv.id, c.id);
        Astore.done(s.conv);
        s.conv := c;
        useScratch(s);
        save(s);
        changed(s);
        say(s, Buf.bytes(s.out));
    end;
end;

proc list(word: []const U8; var out: Buf.Buf);
var l: Items.Vec; items: []Astore.Item; i: INT;
begin
    Astore.recent(Listed, word, l);
    defer Astore.drop(l);
    items := Items.all(l);
    for i := 0 to LEN(items) - 1 do
        if i > 0 then Buf.add(out, '\n'); end;
        if i < 9 then Buf.add(out, ' '); end;
        Fmt.write(out, "{}  {}  {}", [Fmt.int(i + 1), Fmt.str(items[i].id), Fmt.str(items[i].title)]);
    end;
    if LEN(items) = 0 then Buf.str(out, "nothing saved"); end;
end;

proc load(var s: Session; arg: []const U8);
var title: Buf.Buf;
begin
    if not resume(s, arg) then
        Fmt.write(s.out, "no conversation {}", [Fmt.str(arg)]);
        fail(s, Buf.bytes(s.out));
        return;
    end;
    Buf.init(title, SYSTEM.ADR(s.mem.base));
    Buf.str(title, s.conv.title);
    if title.len = 0 then Astore.autoTitle(s.conv, title); end;
    Fmt.write(s.out, "loaded {}: {}, {} messages",
        [Fmt.str(s.conv.id), Fmt.str(Buf.bytes(title)), Fmt.int(s.conv.msgs.len)]);
    say(s, Buf.bytes(s.out));
end;

(* The conversation arg names as JSON, its file as it is; the current
   one, saved first, if arg is "". *)
proc export(var s: Session; arg: []const U8);
var id, path: Buf.Buf;
begin
    Buf.init(id, SYSTEM.ADR(s.mem.base));
    Buf.init(path, SYSTEM.ADR(s.mem.base));
    if LEN(arg) = 0 then
        save(s);
        Buf.str(id, s.conv.id);
    elsif not find(arg, id) then
        Fmt.write(s.out, "no conversation {}", [Fmt.str(arg)]);
        fail(s, Buf.bytes(s.out));
        return;
    end;
    if Files.load(Astore.file(Buf.bytes(id), path), s.out) # 0 then
        Fmt.write(s.out, "no conversation {}", [Fmt.str(Buf.bytes(id))]);
        fail(s, Buf.bytes(s.out));
        return;
    end;
    say(s, Buf.bytes(s.out));
end;

proc rename(var s: Session; title: []const U8);
begin
    Astore.setTitle(s.conv, title);
    save(s);
    if LEN(title) = 0 then say(s, "title cleared"); return; end;
    Fmt.write(s.out, "renamed: {}", [Fmt.str(title)]);
    say(s, Buf.bytes(s.out));
end;

(* /system: text is the rest of the line as typed. *)
proc system(var s: Session; text: []const U8);
begin
    if (LEN(text) = 0) and (LEN(s.conv.system) = 0) then
        Fmt.write(s.out, "arno's own system prompt:\n\n{}", [Fmt.str(Aprompt.Own)]);
    elsif LEN(text) = 0 then
        Fmt.write(s.out, "this conversation's own system prompt (/system - for arno's):\n\n{}",
            [Fmt.str(s.conv.system)]);
    elsif text = "-" then
        Astore.setSystem(s.conv, "");
        save(s);
        Buf.str(s.out, "system prompt: arno's own, from the next turn");
    else
        Astore.setSystem(s.conv, text);
        save(s);
        Buf.str(s.out, "system prompt: this conversation's own, from the next turn");
    end;
    say(s, Buf.bytes(s.out));
end;

(* /mode: the mode shown, or set to name. Build, set while safe, says
   it works best staged: safe, every change of every worker is asked
   about, one at a time. *)
proc mode(var s: Session; name: []const U8);
var i: INT;
begin
    for i := 0 to LEN(Aprompt.Modes) - 1 do
        if Aprompt.Modes[i].name = name then s.agent.mode := Aprompt.Mode(i); end;
    end;
    if (LEN(name) > 0) and (Aprompt.Modes[INT(s.agent.mode)].name # name) then
        fail(s, "modes: chat review improve pair build");
        return;
    end;
    Fmt.write(s.out, "mode: {}", [Fmt.str(Aprompt.Modes[INT(s.agent.mode)].name)]);
    if (name = "build") and (LEN(Afence.stage) = 0) then
        Buf.str(s.out, "; build works best staged (/safety auto), each change asked about while safe");
    end;
    say(s, Buf.bytes(s.out));
end;

(* /budget: the dollars a turn may spend, workers included, in the mode
   at hand, build mode having its own; with an amount, set for the
   session, 0 for no limit. *)
proc budget(var s: Session; arg: []const U8);
var x: F64; ok, build: BOOL;
begin
    build := s.agent.mode = Aprompt.build;
    if LEN(arg) > 0 then
        x, ok := Math.toReal(arg);
        if not ok or (x < 0.0) then
            fail(s, "usage: /budget [DOLLARS], 0 for no limit");
            return;
        end;
        if build then s.agent.buildBudget := x; else s.agent.budget := x; end;
    end;
    if build then x := s.agent.buildBudget; else x := s.agent.budget; end;
    if x = 0.0 then
        Fmt.write(s.out, "budget: no limit a turn in {} mode", [Fmt.str(Aprompt.Modes[INT(s.agent.mode)].name)]);
    else
        Fmt.write(s.out, "budget: ${} a turn in {} mode, workers included", [Fmt.real(x, 2),
            Fmt.str(Aprompt.Modes[INT(s.agent.mode)].name)]);
    end;
    say(s, Buf.bytes(s.out));
end;

(* name kept as s's named, the provider's model or name: what it named
   before is given back. *)
proc keep(var s: Session; name: []const U8): []U8;
begin
    Str.free(Heap.heap, s.named);
    s.named := Amsg.keep(name);
    return s.named;
end;

proc model(var s: Session; name: []const U8);
begin
    if LEN(name) > 0 then s.conf.prov.model := keep(s, name); end;
    Fmt.write(s.out, "model: {}", [Fmt.str(s.conf.prov.model)]);
    say(s, Buf.bytes(s.out));
end;

(* The models of s's provider, a line each: those its server told
   /models, or arno's own list of them. *)
proc models*(const s: Session): []const U8;
begin
    if Buf.bytes(s.listedOf) = s.conf.prov.name then return Buf.bytes(s.listed); end;
    return Awire.known(s.conf.prov.name);
end;

(* /models: those the provider's server lists, kept for models; or else
   arno's own list, said to be. *)
proc listModels(var s: Session);
var why: Buf.Buf; p: ^Awire.Prov;
begin
    p := SYSTEM.ADR(s.conf.prov);
    Buf.init(why, Heap.heap);
    defer Buf.done(why);
    if Awire.models(p^, s.out, why) = nil then
        Buf.reset(s.listed);
        Buf.str(s.listed, Buf.bytes(s.out));
        Buf.reset(s.listedOf);
        Buf.str(s.listedOf, p^.name);
        say(s, Str.trimRight(Buf.bytes(s.out)));
        return;
    end;
    if LEN(Awire.known(p^.name)) = 0 then
        Fmt.write(s.out, "{} lists no models: {}", [Fmt.str(p^.name), Fmt.str(Buf.bytes(why))]);
        fail(s, Buf.bytes(s.out));
        return;
    end;
    Fmt.write(s.out, "{}\n(arno's own list: {} didn't say, {})", [Fmt.str(Awire.known(p^.name)),
        Fmt.str(p^.name), Fmt.str(Buf.bytes(why))]);
    say(s, Buf.bytes(s.out));
end;

(* /provider: one of Awire's presets, with none of the config's params,
   which were the other provider's. *)
proc provider(var s: Session; name: []const U8);
var p: ^Awire.Prov;
begin
    p := SYSTEM.ADR(s.conf.prov);
    if (LEN(name) > 0) and not Awire.preset(keep(s, name), p^) then
        Fmt.write(s.out, "unknown; try {}", [Fmt.str(Awire.Presets)]);
        fail(s, Buf.bytes(s.out));
        return;
    end;
    if LEN(name) > 0 then p^.params := p^.params[0..0]; end;
    Fmt.write(s.out, "{} {} {}", [Fmt.str(p^.name), Fmt.str(p^.model), Fmt.str(p^.url)]);
    say(s, Buf.bytes(s.out));
end;

(* The tools the model is offered now, in this mode. *)
proc tools(const s: Session; var out: Buf.Buf);
var t: []Awire.Tool; i: INT;
begin
    t := Atools.offered(LEN(s.agent.worker) > 0, s.agent.mode in {Aprompt.chat, Aprompt.pair, Aprompt.build},
        s.agent.mode = Aprompt.build);
    for i := 0 to LEN(t) - 1 do
        if i > 0 then Buf.add(out, '\n'); end;
        Fmt.write(out, "{}  {}", [Fmt.str(t[i].name), Fmt.str(t[i].description)]);
    end;
end;

(* n tokens, short: 950, 23.4k, 1.2M. *)
proc tokens(var b: Buf.Buf; n: I64);
begin
    if n < 1000 then
        Fmt.write(b, "{}", [Fmt.int(n)]);
    elsif n < 1000000 then
        Fmt.write(b, "{}k", [Fmt.real(F64(n) / 1000.0, 1)]);
    else
        Fmt.write(b, "{}M", [Fmt.real(F64(n) / 1.0E6, 1)]);
    end;
end;

(* The tokens s's conversation holds: what its last request held, in
   and out, and true; before one, a guess of a token for every four
   bytes of its messages, and false. *)
proc context(const s: Session): (I64, BOOL);
var m: []Amsg.Msg; i: INT; n: I64;
begin
    if s.agent.held > 0 then return s.agent.held, true; end;
    m := Msgs.all(s.conv.msgs);
    n := 0;
    for i := 0 to LEN(m) - 1 do n := n + LEN(m[i].text); end;
    return n div 4, false;
end;

(* The context in use, a ~ before a guess, and, where the model's
   window is known, of how much: ~1.2k, 23.4k/1.0M 2%. *)
proc meter(const s: Session; var b: Buf.Buf);
var n: I64; exact: BOOL; pr: Aprice.Price;
begin
    n, exact := context(s);
    if not exact then Buf.add(b, '~'); end;
    tokens(b, n);
    pr, _ := Aprice.price(s.conf.prov);
    if pr.window > 0 then
        Buf.add(b, '/');
        tokens(b, pr.window);
        Fmt.write(b, " {}%", [Fmt.int(n * 100 div pr.window)]);
    end;
end;

(* The texts of f made, empty, from Heap. *)
proc initFacts*(var f: Facts);
begin
    Buf.init(f.model, Heap.heap);
    Buf.init(f.provider, Heap.heap);
    Buf.init(f.context, Heap.heap);
    Buf.init(f.usage, Heap.heap);
    Buf.init(f.cost, Heap.heap);
    Buf.init(f.title, Heap.heap);
end;

(* The texts of f let go. *)
proc doneFacts*(var f: Facts);
begin
    Buf.done(f.model);
    Buf.done(f.provider);
    Buf.done(f.context);
    Buf.done(f.usage);
    Buf.done(f.cost);
    Buf.done(f.title);
end;

(* What s's status line says, into f, made with initFacts. The
   conversation is large, time for /compact, at 60% of the model's
   window where that is known, else at 20 messages or 50 KB of text.
   The title is cut to 40 bytes. *)
proc facts*(const s: Session; var f: Facts);
var pr: Aprice.Price; n: I64; title: Buf.Buf; t: []const U8; i: INT;
begin
    f.mode := s.agent.mode;
    f.staged := LEN(Afence.stage) > 0;
    f.approved := Agent.approved(s.conv);
    Buf.reset(f.model);
    Buf.str(f.model, s.conf.prov.model);
    Buf.reset(f.provider);
    Buf.str(f.provider, s.conf.prov.name);
    Buf.reset(f.context);
    meter(s, f.context);
    n, _ := context(s);
    pr, _ := Aprice.price(s.conf.prov);
    f.fill := -1;
    if pr.window > 0 then
        f.fill := INT(n * 100 div pr.window);
        f.full := n * 10 >= pr.window * 6;
    else
        f.full := (s.conv.msgs.len >= 20) or (n * 4 >= 50 * 1024);
    end;
    Buf.reset(f.usage);
    Buf.reset(f.cost);
    if s.agent.requests > 0 then
        Buf.str(f.usage, "in ");
        tokens(f.usage, s.agent.used.inp);
        Buf.str(f.usage, " out ");
        tokens(f.usage, s.agent.used.out);
        if s.agent.unpriced < s.agent.requests then
            money(f.cost, s.agent.spent);
            if s.agent.unpriced > 0 then Buf.add(f.cost, '+'); end;
        end;
    end;
    Buf.reset(f.title);
    Buf.init(title, Heap.heap);
    defer Buf.done(title);
    Buf.str(title, s.conv.title);
    if title.len = 0 then Astore.autoTitle(s.conv, title); end;
    t := Buf.bytes(title);
    if LEN(t) <= 40 then Str.replace(f.title, t, "\n", " "); return; end;
    i := 40;
    while (i > 0) and (t[i] & 0C0H = 80H) do DEC(i); end;   (* inside a character *)
    Str.replace(f.title, t[0..i], "\n", " ");
    Buf.str(f.title, "\u{2026}");
end;

(* The status line f says, as text, into b: the mode, with the safety
   and, in build, whether the plan is approved, then the model and its
   provider, the context in use, what the session cost, a pointer to
   /compact once the conversation is large, and its title. The numbers
   come before the title, which a narrow terminal cuts first; the
   safety and the plan share the mode's field, which arnold reads as
   the second of the fields that " \u{B7} " parts. *)
proc text*(const f: Facts; var b: Buf.Buf);
begin
    Fmt.write(b, "arno \u{B7} {} (", [Fmt.str(Aprompt.Modes[INT(f.mode)].name)]);
    if f.staged then Buf.str(b, "auto"); else Buf.str(b, "safe"); end;
    if f.mode = Aprompt.build then
        if f.approved then Buf.str(b, ", plan \u{2713}"); else Buf.str(b, ", plan ?"); end;
    end;
    Fmt.write(b, ") \u{B7} {} @ {} \u{B7} ctx {}", [Fmt.str(Buf.bytes(f.model)), Fmt.str(Buf.bytes(f.provider)),
        Fmt.str(Buf.bytes(f.context))]);
    if f.usage.len > 0 then Fmt.write(b, " \u{B7} {}", [Fmt.str(Buf.bytes(f.usage))]); end;
    if f.cost.len > 0 then Fmt.write(b, " \u{B7} {}", [Fmt.str(Buf.bytes(f.cost))]); end;
    if f.full then Buf.str(b, " \u{B7} /compact"); end;
    if f.title.len > 0 then Fmt.write(b, " \u{B7} {}", [Fmt.str(Buf.bytes(f.title))]); end;
end;

(* The status line of s, as text, into b. *)
proc status*(const s: Session; var b: Buf.Buf);
var f: Facts;
begin
    initFacts(f);
    defer doneFacts(f);
    facts(s, f);
    text(f, b);
end;

(* /usage: what the session's requests cost, in tokens and in dollars
   at list price, and the price of the model in use. A session is this
   run of arno, across every conversation it went through. *)
proc usage(const s: Session; var out: Buf.Buf);
var pr: Aprice.Price; priced: BOOL;
begin
    Buf.str(out, "context   ");
    meter(s, out);
    Buf.str(out, " tokens\n");
    Fmt.write(out, "requests  {}\nin        {} tokens", [Fmt.int(s.agent.requests), Fmt.int(s.agent.used.inp)]);
    if s.agent.used.cached > 0 then Fmt.write(out, ", {} of them read from the cache", [Fmt.int(s.agent.used.cached)]); end;
    if s.agent.used.written > 0 then Fmt.write(out, ", {} written to it", [Fmt.int(s.agent.used.written)]); end;
    Fmt.write(out, "\nout       {} tokens", [Fmt.int(s.agent.used.out)]);
    if s.agent.unpriced < s.agent.requests then
        Buf.str(out, "\ncost      ");
        money(out, s.agent.spent);
        if s.agent.unpriced > 0 then Fmt.write(out, ", and {} requests with no known price", [Fmt.int(s.agent.unpriced)]); end;
    end;
    pr, priced := Aprice.price(s.conf.prov);
    if priced then
        Fmt.write(out, "\nprice     {}: ", [Fmt.str(s.conf.prov.model)]);
        price(out, pr.inp);
        Buf.str(out, " in, ");
        price(out, pr.cached);
        Buf.str(out, " cached, ");
        price(out, pr.out);
        Buf.str(out, " out, per million tokens");
    else
        Fmt.write(out, "\nprice     none known for {}; set price = IN OUT, dollars per million tokens, in the config",
            [Fmt.str(s.conf.prov.model)]);
    end;
end;

(* /remember: arg is the fact, after "#" and its tags, which commas
   part, if it starts with a #. *)
proc remember(var s: Session; arg: []const U8);
var tags, fact: []const U8;
begin
    tags := "";
    fact := arg;
    if Str.hasPrefix(arg, "#") then tags, fact := Str.field(arg[1..LEN(arg)]); end;
    fact := Str.trim(fact);
    if LEN(fact) = 0 then fail(s, "usage: /remember [#tag,tag,...] fact text"); return; end;
    Amemory.remember(fact, tags, SYSTEM.ADR(s.mem.base));
    Aprompt.remembered(s.agent.prompt);
    Fmt.write(s.out, "remembered: {}", [Fmt.str(fact)]);
    say(s, Buf.bytes(s.out));
end;

proc forget(var s: Session; word: []const U8);
var n: INT;
begin
    if LEN(word) = 0 then fail(s, "usage: /forget TAG|WORD"); return; end;
    n := Amemory.forget(word, SYSTEM.ADR(s.mem.base));
    Aprompt.remembered(s.agent.prompt);
    Fmt.write(s.out, "forgot {}", [Fmt.int(n)]);
    say(s, Buf.bytes(s.out));
end;

proc notes(var s: Session; arg: []const U8);
var verb, what: []const U8;
begin
    if LEN(arg) = 0 then
        Aahead.listNotes(SYSTEM.ADR(s.mem.base), s.out);
        if s.out.len = 0 then Fmt.write(s.out, "no notes for {}", [Fmt.str(Afence.root)]); end;
        say(s, Buf.bytes(s.out));
        return;
    end;
    verb, what := Str.field(arg);
    what := Str.trim(what);
    if (verb # "forget") or (LEN(what) = 0) then fail(s, "usage: /notes [forget N|WORD]"); return; end;
    if Aahead.forgetNotes(what, SYSTEM.ADR(s.mem.base), s.out) = 0 then
        Fmt.write(s.out, "no note {}", [Fmt.str(what)]);
        fail(s, Buf.bytes(s.out));
        return;
    end;
    say(s, Buf.bytes(s.out));
end;

(* /test: the project's test command run, as check runs it, or first
   set to arg, for this project, in tests.json. A failure is put to the
   model as a turn, with the end of the output: the human runs the
   tests to have what failed fixed. *)
proc test(var s: Session; arg: []const U8);
var b, got, output, why: Buf.Buf; cmd: []const U8; j: Arun.Job; m: ^Amsg.Msg; status: INT; cut: BOOL;
begin
    Buf.init(b, SYSTEM.ADR(s.mem.base));
    Buf.init(got, SYSTEM.ADR(s.mem.base));
    Buf.init(output, SYSTEM.ADR(s.mem.base));
    Buf.init(why, SYSTEM.ADR(s.mem.base));
    cmd := arg;
    if LEN(cmd) = 0 then
        cmd := Atools.testFor(b);
    elsif cmd # Astore.keyed("tests.json", Afence.root, b) then
        if Astore.setKeyed("tests.json", Afence.root, cmd) # nil then
            fail(s, "tests.json can't be written");
            return;
        end;
        Fmt.write(s.out, "test command for {}: {}", [Fmt.str(Afence.root), Fmt.str(cmd)]);
        say(s, Buf.bytes(s.out));
        Buf.reset(s.out);
    end;
    if LEN(cmd) = 0 then fail(s, "usage: /test COMMAND, or set test_cmd in config"); return; end;
    j := {args: ["sh", "-c", cmd], detach: true, tail: true};
    status, cut, _ := Arun.start(j, MaxTest, got);
    if status = 0 then
        Fmt.write(s.out, "tests passed: {}", [Fmt.str(cmd)]);
        say(s, Buf.bytes(s.out));
        return;
    end;
    Buf.reset(b);
    Fmt.write(b, "Tests failed (`{}`, exit {}). What should I fix?\n\n", [Fmt.str(cmd), Fmt.int(status)]);
    if cut then Buf.str(output, "[...]\n"); end;
    Buf.str(output, Buf.bytes(got));
    Aahead.block(b, cmd, "", Buf.bytes(output));
    m := Msgs.add(s.conv.msgs);
    Amsg.init(m^, Amsg.Role.user);
    Amsg.setText(m^, Buf.bytes(b));
    failed(s, answer(s, why), Buf.bytes(why));
end;

(* A command, line, which starts with a /. *)
proc command(var s: Session; line: []const U8);
var name, arg: []const U8;
begin
    name, arg := Str.field(line);
    arg := Str.trim(arg);
    Buf.reset(s.out);
    match name of
    | "/help": help(s.out); say(s, Buf.bytes(s.out));
    | "/new": renew(s);
    | "/clear": clear(s);
    | "/compact": compact(s, arg);
    | "/list": list(arg, s.out); say(s, Buf.bytes(s.out));
    | "/load": load(s, arg);
    | "/export": export(s, arg);
    | "/rename": rename(s, arg);
    | "/system": system(s, arg);
    | "/mode": mode(s, arg);
    | "/budget": budget(s, arg);
    | "/model": model(s, arg);
    | "/models": listModels(s);
    | "/provider": provider(s, arg);
    | "/tools": tools(s, s.out); say(s, Buf.bytes(s.out));
    | "/usage": usage(s, s.out); say(s, Buf.bytes(s.out));
    | "/remember": remember(s, arg);
    | "/forget": forget(s, arg);
    | "/my-memory":
        Amemory.facts(arg, SYSTEM.ADR(s.mem.base), s.out);
        if s.out.len = 0 then Buf.str(s.out, "nothing remembered"); end;
        say(s, Buf.bytes(s.out));
    | "/notes": notes(s, arg);
    | "/test": test(s, arg);
    | "/stage": stage(s, arg);
    | "/safety": safety(s, arg);
    | else: fail(s, "unknown command; /help lists them");
    end;
    Arena.reset(s.mem);
end;

(* A line the human typed: a command, or a message to the model, whose
   turn's failure is shown. false for /quit or /exit, which end the
   session. *)
proc line*(var s: Session; text: []const U8): BOOL;
var why: Buf.Buf; err: ERROR;
begin
    text := Str.trim(text);
    if LEN(text) = 0 then return true; end;
    if (text = "/quit") or (text = "/exit") then return false; end;
    if text[0] = '/' then command(s, text); return true; end;
    Buf.init(why, Heap.heap);
    defer Buf.done(why);
    err := turn(s, text, why);
    failed(s, err, Buf.bytes(why));
    return true;
end;

(* The text of the last answer of c's, the model's last message; "" if none. *)
proc lastAnswer(const c: Astore.Conv): []const U8;
var m: []Amsg.Msg; i: INT;
begin
    m := Msgs.all(c.msgs);
    for i := LEN(m) - 1 to 0 by -1 do
        if m[i].role = Amsg.Role.assistant then return m[i].text; end;
    end;
    return "";
end;

(* An ask from an editor, a: said to be from the editor, as that, and put
   to the model as the editor's message, never as the human's, with no @path
   in it brought, in a new conversation first if the editor wants one. The
   answer goes to the editor that asked, unless the turn failed or was
   stopped. *)
proc ask*(var s: Session; const a: Apeer.Ask);
var m: ^Amsg.Msg; text, why: Buf.Buf; err: ERROR;
begin
    Buf.init(text, Heap.heap);
    defer Buf.done(text);
    Buf.init(why, Heap.heap);
    defer Buf.done(why);
    if a.fresh then renew(s); end;
    Apeer.message(a, text);
    say(s, Apeer.shown(Buf.bytes(text)));
    m := Msgs.add(s.conv.msgs);
    Amsg.init(m^, Amsg.Role.user);
    Amsg.setText(m^, Buf.bytes(text));
    err := answer(s, why);
    Arena.reset(s.mem);
    failed(s, err, Buf.bytes(why));
    if err = nil then Apeer.reply(a.sock, a.question, lastAnswer(s.conv)); end;
end;

end Asession.
