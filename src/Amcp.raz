(* Amcp: tools from MCP servers, over standard input and output or
   over HTTP.

   MCP, the Model Context Protocol, is a way for a program like arno
   to offer a model tools it need not carry itself. A server is any
   program that speaks it: arno starts it as a child, and the two talk
   in JSON-RPC, a request or an answer to a line, each way:

       arno  -- {"jsonrpc":"2.0","id":1,"method":"initialize",...} -->  server
       arno  <-- {"jsonrpc":"2.0","id":1,"result":{...}} -------------  server

   Or a server is a URL, and each message is an HTTP POST to it (MCP's
   "streamable HTTP"), each over a connection of its own:

       POST URL   Mcp-Session-Id, MCP-Protocol-Version, Authorization
                  {"jsonrpc":"2.0","id":2,"method":"tools/list",...}
       200        application/json: the answer
                  or text/event-stream: events, data: {json} each, of
                  which the answer is the one with the request's id

   The session's id comes in initialize's answer, and goes with each
   message after, with the version initialize agreed; a 404 to one
   means the server forgot the session, and arno shakes hands again,
   once, and asks again. A token goes as Authorization: Bearer; a 401
   refuses the server, whose WWW-Authenticate, how it wants a login, is
   kept (challenge). A token from a login runs out: the program's renew
   gives a new one a minute before, and once on a 401. stop sends
   DELETE, to end the session. A server not attached is kept, with why,
   for status to say.

   attach starts a server, or attachUrl names one; then each shakes
   hands (initialize, then the notification initialized) and asks
   tools/list; each tool it names is
   then offered to the model as SERVER_TOOL, the server's name from the
   config first, so that two servers, or a server and a built-in, never
   offer one name; a byte a provider would not take in a name becomes _,
   and a name is at most MaxName bytes long, as providers limit
   it. call runs one of them with tools/call; the model's arguments go
   to the server as they are.

   A server's answers are told from the traffic between by the id of
   the request: notifications, and requests the server makes of arno,
   are passed by. Each server runs in a process group of its own, so
   that ^C at the terminal stops the turn and not the server; its
   standard error is thrown away. stop, at the end of the program,
   closes every server's input, gives them Grace looks of Step ms to end,
   and kills the group of any left. A server that does not answer when
   it starts is given up on after startWait ms; a started server's call
   can be stopped by the human, and a late answer to it is passed by on
   the next call, as its id is not the one asked for. Over HTTP the
   stop is heard when it breaks into the wait, as ^C does, and after
   each piece of an event stream. Writing to a server
   that has ended relies on SIGPIPE being ignored, as Awire's HTTP has it.

   A result's content blocks are joined: a text block as it is, any
   other as its type in brackets, so that the model knows something
   was there; a server's own isError makes the result start with
   "error".

   Depends on Awire (for Tool, and its HTTPS client), Amsg (quote and
   compact), rjson's Json, rnet's Http. Leaves out the rest of the
   protocol: pagination of tools/list, other content than text,
   resources and prompts, a server's requests of arno, and over HTTP
   the stream a GET opens and resuming a broken one; and the login
   itself, which is the program's (Alogin). Asking the human before a call is the
   caller's. *)
module Amcp;
import Awire, Amsg, Json, Http, Buf, Str, Sys, Fmt, Heap, Out, Rt, Servers := Vec(Server),
    Belt := Vec(Awire.Tool), Origins := Vec(Origin);
import SYSTEM;

type
    (* A server arno started, or one at a URL. *)
    Server = record
        name: []const U8;   (* the config's name for it, which prefixes its tools *)
        url: []const U8;        (* where it is, for one over HTTP; "" for a child *)
        token: []const U8;      (* sent as Authorization: Bearer, or "" *)
        session: []const U8;    (* the Mcp-Session-Id its initialize gave, or "" *)
        protocol: []const U8;   (* the protocol's version its initialize agreed, or "" before *)
        challenge: []const U8;  (* the WWW-Authenticate of its 401: how it wants a login *)
        expires: I64;       (* when token runs out, on Sys.clock, for one renew gives again; 0, never *)
        why: []const U8;    (* why it was not attached, after its name *)
        due: I64;           (* the time, on Sys.clock, an HTTP answer must come by; 0, none *)
        pid: INT;           (* its process, and its group's; 0 once it has been waited for, and for a URL *)
        rd, wr: INT;        (* its output, and its input; -1 for a URL *)
        seq: INT;           (* the id of the last request made of it *)
        pending: Buf.Buf;   (* what it wrote, of which the first used bytes are read *)
        used: INT;          (* how many of the bytes of pending have been read *)
    end;

    (* What went wrong with a message to a server at a URL, that a
       second try may mend. *)
    Trouble = (fine, forgot, unauthorized);   (* the server forgot the session; it refused the token *)

    (* Where a tool on the belt is from. *)
    Origin = record
        server: INT;            (* an index of servers *)
        name: []const U8;       (* its name there, which has no prefix *)
    end;

const
    MaxName = 64;      (* bytes of a tool's name, as providers allow *)
    Version = "2025-06-18";   (* the protocol's, as arno speaks it *)
    Slice = 100;       (* milliseconds between looks at whether the human said to stop *)
    Grace = 20;        (* looks, Step ms apart, a server is given to end once its input is closed, before it is killed *)
    Step = 50;         (* milliseconds between those looks *)
    Chunk = 4096;      (* bytes asked of a server's output at a time *)
    IdLen = 20;        (* bytes enough for a request id, an INT in decimal *)
    Gone = "server gone";   (* what a request says when the server ended first *)
    Interrupted = "interrupted";   (* what it says when the human said to stop *)
    Early = 60000000000;   (* nanoseconds before a token runs out that it is renewed *)

var
    servers: Servers.Vec;   (* every server attached, from Heap *)
    dropped: Servers.Vec;   (* every server that was not attached, with why *)
    belt: Belt.Vec;         (* every tool they offer *)
    origins: Origins.Vec;   (* where each tool of belt is from, in the same order *)

(* Requests *)

(* s written whole to fd; false if it can't be. *)
proc send(fd: INT; s: []const U8): BOOL;
var n: INT;
begin
    while LEN(s) > 0 do
        n := Sys.write(fd, s);
        if n = Sys.errIntr then continue; end;
        if n <= 0 then return false; end;
        s := s[n..LEN(s)];
    end;
    return true;
end;

(* The next whole line of s.pending into line, without its line feed;
   false if there is none yet. *)
proc cut(var s: Server; var line: Buf.Buf): BOOL;
var i: INT; all: []U8;
begin
    all := Buf.bytes(s.pending);
    i := Str.find(all[s.used..LEN(all)], "\n");
    if i < 0 then return false; end;
    Buf.reset(line);
    Buf.str(line, all[s.used..s.used + i]);
    INC(s.used, i + 1);
    if s.used = LEN(all) then Buf.reset(s.pending); s.used := 0; end;
    return true;
end;

(* The next line s wrote, into line, without its line feed. Gone if s
   ends first; Interrupted if stopped, asked every Slice ms, says so (it
   may be nil); "" if a line came. *)
proc readLine(var s: Server; stopped: proc: BOOL; var line: Buf.Buf): []const U8;
var n: INT;
begin
    while true do
        if cut(s, line) then return ""; end;
        if (stopped # nil) and stopped() then return Interrupted; end;
        if not Sys.ready(s.rd, Slice) then continue; end;
        n := Sys.read(s.rd, Buf.spare(s.pending, Chunk));
        if n = Sys.errIntr then continue; end;
        if n <= 0 then return Gone; end;
        INC(s.pending.len, n);
    end;
end;

(* Whether line is the answer to request id: no method, which makes
   it a request or a notification, and that id. On an answer, res is
   its result as compact JSON, or, if it is an error, the error's
   message; and failed says which. *)
proc answer(line: []U8; id: []const U8; var res: Buf.Buf; var failed: BOOL): BOOL;
var d: Json.Doc; v, e: Json.Value;
begin
    if not Json.init(SYSTEM.ADR(d), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    v := Json.parse(SYSTEM.ADR(d), line);
    if (Json.kind(SYSTEM.ADR(d), v) # Json.Kind.object) or (Json.member(SYSTEM.ADR(d), v, "method") # Json.None) or
            (Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), v, "id")) # id) then
        return false;
    end;
    Buf.reset(res);
    e := Json.member(SYSTEM.ADR(d), v, "error");
    failed := e # Json.None;
    if failed then
        Buf.str(res, Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), e, "message")));
        if res.len = 0 then Buf.str(res, "the server answered with an error"); end;
    else
        Amsg.compact(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), v, "result"), res);
    end;
    return true;
end;

(* The JSON-RPC message of method with params, a JSON object, into q:
   a request with id, or a notification if id is "" (and then params
   may be "" too). *)
proc message(var q: Buf.Buf; id, method, params: []const U8);
begin
    Buf.str(q, "{\"jsonrpc\":\"2.0\"");
    if LEN(id) > 0 then
        Buf.str(q, ",\"id\":");
        Buf.str(q, id);
    end;
    Buf.str(q, ",\"method\":");
    Amsg.quote(q, method);
    if LEN(params) > 0 then
        Buf.str(q, ",\"params\":");
        Buf.str(q, params);
    end;
    Buf.add(q, '}');
end;

(* The request q, with id, sent to s, a child, and its answer waited
   for, as request does. *)
proc ask(var s: Server; var q: Buf.Buf; id: []const U8; stopped: proc: BOOL; var res: Buf.Buf): BOOL;
var line: Buf.Buf; why: []const U8; failed: BOOL;
begin
    Buf.init(line, Heap.heap);
    defer Buf.done(line);
    Buf.add(q, '\n');
    Buf.reset(res);
    if not send(s.wr, Buf.bytes(q)) then Buf.str(res, Gone); return false; end;
    while true do
        why := readLine(s, stopped, line);
        if LEN(why) > 0 then Buf.str(res, why); return false; end;
        if answer(Buf.bytes(line), id, res, failed) then return not failed; end;
    end;
end;

(* HTTP *)

(* The headers each message to s carries but its body's: the token,
   the session and the protocol's version, those that s has; auth
   holds the first. *)
proc heads(const s: Server; var req: Http.Message; var auth: Buf.Buf);
begin
    if LEN(s.token) > 0 then
        Buf.str(auth, "Bearer ");
        Buf.str(auth, s.token);
        _ := Http.add(req, "Authorization", Buf.bytes(auth));
    end;
    if LEN(s.session) > 0 then _ := Http.add(req, "Mcp-Session-Id", s.session); end;
    if LEN(s.protocol) > 0 then _ := Http.add(req, "MCP-Protocol-Version", s.protocol); end;
end;

(* Why an exchange that failed with err failed, into res: Interrupted if
   stopped says the human said to stop, as a stop that broke into its
   wait makes it fail; false. *)
proc failure(err: ERROR; stopped: proc: BOOL; var res: Buf.Buf): BOOL;
begin
    Buf.reset(res);
    if (stopped # nil) and stopped() then Buf.str(res, Interrupted); else Buf.str(res, MSG(err)); end;
    return false;
end;

(* One line of an event stream, in line, taken: a data: line's text
   added to data, the event's so far; a blank line ends the event,
   which is then whether it is the answer to request id, as answer
   finds it. Other lines (event:, id:, a comment) are passed by. *)
proc take(var line, data: Buf.Buf; id: []const U8; var res: Buf.Buf; var failed: BOOL): BOOL;
var text: []const U8; found: BOOL;
begin
    text := Buf.bytes(line);
    if (LEN(text) > 0) and (text[LEN(text) - 1] = '\r') then text := text[0..LEN(text) - 1]; end;
    if LEN(text) = 0 then
        if data.len = 0 then return false; end;
        found := answer(Buf.bytes(data), id, res, failed);
        Buf.reset(data);
        return found;
    end;
    if Str.hasPrefix(text, "data:") then
        text := text[5..LEN(text)];
        if (LEN(text) > 0) and (text[0] = ' ') then text := text[1..LEN(text)]; end;
        if data.len > 0 then Buf.add(data, '\n'); end;
        Buf.str(data, text);
    end;
    return false;
end;

(* The events of the stream rd read, a line at a time through
   s.pending, until one is the answer to request id; "" then, or why
   there is none. The stream's end ends its last line and event. *)
proc events(var s: Server; var rd: Http.Reader; id: []const U8; stopped: proc: BOOL; var res: Buf.Buf; var failed: BOOL): []const U8;
var line, data: Buf.Buf; n: INT; err: ERROR; more: BOOL;
begin
    Buf.init(line, Heap.heap);
    defer Buf.done(line);
    Buf.init(data, Heap.heap);
    defer Buf.done(data);
    Buf.reset(s.pending);
    s.used := 0;
    more := true;
    while more do
        n, err := Http.read(rd, Buf.spare(s.pending, Chunk));
        INC(s.pending.len, n);
        (* asked after each read, so that a stop that broke into the
           wait, as ^C does, is heard at once *)
        if (stopped # nil) and stopped() then return Interrupted; end;
        if err # nil then return MSG(err); end;
        more := n > 0;
        if not more then Buf.str(s.pending, "\n\n"); end;
        while cut(s, line) do
            if take(line, data, id, res, failed) then return ""; end;
        end;
    end;
    return Gone;
end;

(* Whether rsp, the head of the response to a message to s, is a
   success; if not, why, into res, and trouble what a second try may
   mend: a 401, whose challenge s keeps; a 404 to a message with a
   session, which the server has forgotten; any other status. A session it names, as initialize's
   does, s keeps. *)
proc judge(var s: Server; const rsp: Http.Message; var res: Buf.Buf; var trouble: Trouble): BOOL;
var session: []const U8;
begin
    Buf.reset(res);
    if rsp.status = 401 then
        trouble := Trouble.unauthorized;
        s.challenge := Amsg.keep(Http.header(rsp, "WWW-Authenticate"));
        Fmt.write(res, "the server needs a login (401); /mcp login {}, or set mcp_token.{}", [Fmt.str(s.name),
            Fmt.str(s.name)]);
        return false;
    end;
    if (rsp.status = 404) and (LEN(s.session) > 0) then
        trouble := Trouble.forgot;
        Buf.str(res, "the server forgot the session");
        return false;
    end;
    if (rsp.status < 200) or (rsp.status > 299) then
        Fmt.write(res, "HTTP {}", [Fmt.int(rsp.status)]);
        return false;
    end;
    session := Http.header(rsp, "Mcp-Session-Id");
    if (LEN(session) > 0) and (session # s.session) then s.session := Amsg.keep(session); end;
    return true;
end;

(* body, a JSON-RPC message, posted to s, a server at a URL, and if
   id is not "", the answer to request id waited for, as request does;
   the answer is the body, or an event of the stream the body is.
   trouble is what a second try may mend. *)
proc post(var s: Server; body, id: []const U8; stopped: proc: BOOL; var res: Buf.Buf; var trouble: Trouble): BOOL;
var cl: Http.Client; req, rsp: Http.Message; auth: Buf.Buf; rd: ^Http.Reader; err: ERROR; why: []const U8;
    failed: BOOL;
begin
    trouble := Trouble.fine;
    failed := false;
    Awire.initClient(cl);
    defer Http.doneClient(cl);
    cl.timeout := -1;   (* a call takes what it takes, until the human stops it *)
    cl.deadline := s.due;
    Http.init(req, Heap.heap);
    defer Http.done(req);
    Http.init(rsp, Heap.heap);
    defer Http.done(rsp);
    Buf.init(auth, Heap.heap);
    defer Buf.done(auth);
    req.method := "POST";
    req.body := body;
    _ := Http.add(req, "Content-Type", "application/json");
    _ := Http.add(req, "Accept", "application/json, text/event-stream");
    heads(s, req, auth);
    rd, err := Http.open(cl, req, s.url, rsp);
    if err # nil then return failure(err, stopped, res); end;
    if not judge(s, rsp, res, trouble) then return false; end;
    if LEN(id) = 0 then return true; end;
    if Str.hasPrefix(Http.header(rsp, "Content-Type"), "text/event-stream") then
        why := events(s, rd^, id, stopped, res, failed);
    else
        err := Http.readWhole(rd^, rsp);
        if err # nil then return failure(err, stopped, res); end;
        why := "";
        if not answer(Http.bodyOf(rsp), id, res, failed) then why := "the server gave no answer"; end;
    end;
    if LEN(why) > 0 then Buf.reset(res); Buf.str(res, why); return false; end;
    return not failed;
end;

(* The DELETE that ends s's session, if it has one, with a short wait
   for its answer, which is passed by. *)
proc hangUp(const s: Server);
var cl: Http.Client; req, rsp: Http.Message; auth: Buf.Buf;
begin
    if LEN(s.session) = 0 then return; end;
    Awire.initClient(cl);
    defer Http.doneClient(cl);
    cl.deadline := Sys.clock() + I64(Grace * Step) * 1000000;
    Http.init(req, Heap.heap);
    defer Http.done(req);
    Http.init(rsp, Heap.heap);
    defer Http.done(rsp);
    Buf.init(auth, Heap.heap);
    defer Buf.done(auth);
    req.method := "DELETE";
    heads(s, req, auth);
    _ := Http.fetch(cl, req, s.url, rsp);
end;

(* Both transports *)

var
    (* A new token for the server called name at url, and when it runs
       out; "" if there is none. The program's, which knows where
       logins are kept; nil, none. *)
    renew: proc(name, url: []const U8; var expires: I64): []const U8;

(* renew made f: the program's, which knows where logins are kept. *)
proc renewWith*(f: proc(name, url: []const U8; var expires: I64): []const U8);
begin
    renew := f;
end;

(* Whether s, whose token is from a login, has a new one from renew. *)
proc renewed(var s: Server): BOOL;
var token: []const U8; expires: I64;
begin
    if (renew = nil) or (s.expires = 0) then return false; end;
    token := renew(s.name, s.url, expires);
    if LEN(token) = 0 then return false; end;
    s.token := token;
    s.expires := expires;
    return true;
end;

(* The method of s asked with params, a JSON object, and the answer
   waited for, by s's transport: true, and res the result as compact
   JSON; or false, and res says what went wrong, and trouble what a
   second try may mend. A token from a login is renewed a minute
   before it runs out, and once if the server refuses it. *)
proc exchange(var s: Server; method, params: []const U8; stopped: proc: BOOL; var res: Buf.Buf; var trouble: Trouble): BOOL;
var q: Buf.Buf; id: [IdLen]U8; n: INT; ok: BOOL;
begin
    Buf.init(q, Heap.heap);
    defer Buf.done(q);
    INC(s.seq);
    id, n := Str.fromInt(s.seq);
    message(q, id[0..n], method, params);
    trouble := Trouble.fine;
    if LEN(s.url) = 0 then return ask(s, q, id[0..n], stopped, res); end;
    if (s.expires # 0) and (Sys.clock() > s.expires - Early) then _ := renewed(s); end;
    ok := post(s, Buf.bytes(q), id[0..n], stopped, res, trouble);
    if (trouble = Trouble.unauthorized) and renewed(s) then ok := post(s, Buf.bytes(q), id[0..n], stopped, res, trouble); end;
    return ok;
end;

(* The notification method sent to s, whatever becomes of it. *)
proc notify(var s: Server; method: []const U8);
var q, res: Buf.Buf; trouble: Trouble;
begin
    Buf.init(q, Heap.heap);
    defer Buf.done(q);
    Buf.init(res, Heap.heap);
    defer Buf.done(res);
    message(q, "", method, "");
    if LEN(s.url) = 0 then
        Buf.add(q, '\n');
        _ := send(s.wr, Buf.bytes(q));
    else
        _ := post(s, Buf.bytes(q), "", nil, res, trouble);
    end;
end;

(* The protocol's version in res, initialize's result, which the
   parse spoils; Version if it names none. *)
proc versionOf(var res: Buf.Buf): []const U8;
var d: Json.Doc; v: []const U8;
begin
    if not Json.init(SYSTEM.ADR(d), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    v := Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), Json.parse(SYSTEM.ADR(d), Buf.bytes(res)), "protocolVersion"));
    if LEN(v) = 0 then return Version; end;
    return Amsg.keep(v);
end;

(* Hands shaken with s: initialize asked, and the protocol's version
   it agrees kept, then the notification initialized sent. false, and
   res says why, if initialize fails. *)
proc handshake(var s: Server; stopped: proc: BOOL; var res: Buf.Buf): BOOL;
var trouble: Trouble;
begin
    if not exchange(s, "initialize", "{\"protocolVersion\":\"" + Version +
            "\",\"capabilities\":{},\"clientInfo\":{\"name\":\"arno\",\"version\":\"0.1\"}}", stopped, res, trouble) then
        return false;
    end;
    s.protocol := versionOf(res);
    notify(s, "notifications/initialized");
    return true;
end;

(* The method of s asked with params, as exchange asks it; a server
   at a URL that has forgotten its session is given a new one, by
   shaking hands again, and asked once more. *)
proc request(var s: Server; method, params: []const U8; stopped: proc: BOOL; var res: Buf.Buf): BOOL;
var ok: BOOL; trouble: Trouble;
begin
    ok := exchange(s, method, params, stopped, res, trouble);
    if trouble = Trouble.forgot then
        s.session := "";
        s.protocol := "";
        if handshake(s, stopped, res) then ok := exchange(s, method, params, stopped, res, trouble); end;
    end;
    return ok;
end;

(* Starting and stopping *)

(* argv started as a server in a process group of its own, its input
   and output pipes to s; false if it can't be started. *)
proc start(argv: [][]const U8; var s: Server): BOOL;
var p: Sys.Program; inRd, outWr, nul: INT;
begin
    s.rd := -1;
    s.wr := -1;
    nul := Sys.open("/dev/null", {Sys.Access.writing});
    if nul < 0 then return false; end;
    defer Sys.close(nul);
    inRd, s.wr := Sys.pipe();
    if inRd < 0 then return false; end;
    s.rd, outWr := Sys.pipe();
    if s.rd < 0 then Sys.close(inRd); Sys.close(s.wr); return false; end;
    p := {path: argv[0], args: argv, fds: [inRd, outWr, nul], group: -1};
    s.pid := Sys.spawn(p);
    Sys.close(inRd);
    Sys.close(outWr);
    if s.pid > 0 then return true; end;
    Sys.close(s.rd);
    Sys.close(s.wr);
    return false;
end;

(* Whether s has ended, and if it has, its pid made 0. *)
proc ended(var s: Server): BOOL;
var got: INT;
begin
    if s.pid = 0 then return true; end;
    got, _, _ := Sys.wait(s.pid, false);
    if got > 0 then s.pid := 0; end;
    return got > 0;
end;

(* s's input closed, which says to end; once only. *)
proc closeInput(var s: Server);
begin
    if s.wr >= 0 then Sys.close(s.wr); s.wr := -1; end;
end;

(* s ended: its input closed, then, if it is still there after polls
   looks Step ms apart, its whole group killed (a launcher such as npx
   may have started the real server under it); its output closed. One
   at a URL is asked to end its session. *)
proc finish(var s: Server; polls: INT);
var got, i: INT;
begin
    if LEN(s.url) > 0 then
        hangUp(s);
        Buf.done(s.pending);
        return;
    end;
    closeInput(s);
    for i := 1 to polls do
        if ended(s) then break; end;
        Sys.sleep(Step);
    end;
    if not ended(s) then
        _ := Sys.kill(-s.pid, Sys.sigKill);
        repeat got, _, _ := Sys.wait(s.pid, true); until got # Sys.errIntr;
    end;
    Sys.close(s.rd);
    Buf.done(s.pending);
end;

(* Every server ended, as the program ends: all inputs closed first and
   Grace looks taken for them all together, so that servers slow to end
   do not add up. *)
proc stop*;
var i, k: INT; all: []Server; waiting: BOOL;
begin
    all := Servers.all(servers);
    for i := 0 to LEN(all) - 1 do closeInput(all[i]); end;
    for k := 1 to Grace do
        waiting := false;
        for i := 0 to LEN(all) - 1 do
            if not ended(all[i]) then waiting := true; end;
        end;
        if not waiting then break; end;
        Sys.sleep(Step);
    end;
    for i := 0 to LEN(all) - 1 do finish(all[i], 0); end;
    Servers.reset(servers);
    Servers.reset(dropped);
    Belt.reset(belt);
    Origins.reset(origins);
end;

(* Tools *)

(* Whether the belt has a tool called name. *)
proc owns*(name: []const U8): BOOL;
var i: INT;
begin
    for i := 0 to belt.len - 1 do
        if Belt.all(belt)[i].name = name then return true; end;
    end;
    return false;
end;

(* The config name of the server the tool name is from, "" if it is no
   MCP tool's. Not read off the name: a server's name may hold _. *)
proc serverOf*(name: []const U8): []const U8;
var i: INT;
begin
    for i := 0 to belt.len - 1 do
        if Belt.all(belt)[i].name = name then return Servers.all(servers)[Origins.all(origins)[i].server].name; end;
    end;
    return "";
end;

(* The tool name for a tool of the server called server: SERVER_TOOL,
   each byte a provider would not take (it takes letters, digits, _ and
   -) made _, and cut at MaxName bytes; put into b. *)
proc toolName(server, tool: []const U8; var b: Buf.Buf);
var i: INT; c: U8;
begin
    Buf.reset(b);
    Buf.str(b, server);
    Buf.add(b, '_');
    Buf.str(b, tool);
    if b.len > MaxName then b.len := MaxName; end;
    for i := 0 to b.len - 1 do
        c := Buf.bytes(b)[i];
        if not (((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or ((c >= '0') and (c <= '9')) or
                (c = '_') or (c = '-')) then
            Buf.bytes(b)[i] := '_';
        end;
    end;
end;

(* s's tools, from the result of tools/list, a JSON text, put on the belt as the server index
   at says; how many were put. A tool whose name the belt has is left out. *)
proc offer(const s: Server; at: INT; res: []const U8): INT;
var d: Json.Doc; list, t, schema: Json.Value; i, added: INT; text, b, params: Buf.Buf; name: []const U8;
begin
    if not Json.init(SYSTEM.ADR(d), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    Buf.init(text, Heap.heap);
    defer Buf.done(text);
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.init(params, Heap.heap);
    defer Buf.done(params);
    Buf.str(text, res);
    added := 0;
    list := Json.member(SYSTEM.ADR(d), Json.parse(SYSTEM.ADR(d), Buf.bytes(text)), "tools");
    for i := 0 to Json.len(SYSTEM.ADR(d), list) - 1 do
        t := Json.item(SYSTEM.ADR(d), list, i);
        name := Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), t, "name"));
        if LEN(name) = 0 then continue; end;
        toolName(s.name, name, b);
        if owns(Buf.bytes(b)) then continue; end;
        schema := Json.member(SYSTEM.ADR(d), t, "inputSchema");
        Buf.reset(params);
        if schema = Json.None then
            Buf.str(params, "{\"type\":\"object\"}");
        else
            Amsg.compact(SYSTEM.ADR(d), schema, params);
        end;
        Belt.push(belt, {name: Amsg.keep(Buf.bytes(b)), params: Amsg.keep(Buf.bytes(params)), description:
            Amsg.keep(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), t, "description")))});
        Origins.push(origins, {server: at, name: Amsg.keep(name)});
        INC(added);
    end;
    return added;
end;

var startWait*: INT;   (* milliseconds a starting server is given to answer; a test shortens it *)
var startBy: I64;   (* the time, on Sys.clock, by which a server starting must answer *)
var late: BOOL;     (* whether it didn't *)

(* Whether the start's time is up; a request's stopped while a server starts. *)
proc startedLate: BOOL;
begin
    late := Sys.clock() > startBy;
    return late;
end;

(* s, started or named, shaken hands with and asked its tools, which
   are put on the belt, given startWait ms to answer; why is what went
   wrong, after its name. A server not attached is kept in dropped,
   with why. *)
proc admit(var s: Server; var why: Buf.Buf): BOOL;
var res: Buf.Buf; ok: BOOL;
begin
    Buf.init(res, Heap.heap);
    defer Buf.done(res);
    late := false;
    startBy := Sys.clock() + I64(startWait) * 1000000;
    s.due := startBy;
    ok := handshake(s, startedLate, res) and request(s, "tools/list", "{}", startedLate, res);
    s.due := 0;
    if not ok then
        if late then Buf.reset(res); Buf.str(res, "no answer in time"); end;
        Buf.str(why, Buf.bytes(res));
    elsif offer(s, servers.len, Buf.bytes(res)) = 0 then
        Buf.str(why, "offers no tool that is new");
        ok := false;
    end;
    if not ok then
        finish(s, Grace);
        s.why := Amsg.keep(Buf.bytes(why));
        Servers.push(dropped, s);
        return false;
    end;
    Servers.push(servers, s);
    return true;
end;

(* A server started by argv, called name, and its tools put on the belt.
   "" if it is attached; else what went wrong, which names the server. *)
proc attach*(name: []const U8; argv: [][]const U8): []const U8;
var s: Server; why: Buf.Buf;
begin
    Buf.init(why, Heap.heap);
    defer Buf.done(why);
    Fmt.write(why, "{}: ", [Fmt.str(name)]);
    s := {name: Amsg.keep(name)};
    Buf.init(s.pending, Heap.heap);
    if not start(argv, s) then
        Buf.done(s.pending);
        Buf.str(why, "cannot start");
        return Amsg.keep(Buf.bytes(why));
    end;
    if admit(s, why) then return ""; end;
    return Amsg.keep(Buf.bytes(why));
end;

(* The server at url, called name, sent token as a bearer's if it is
   not "", and its tools put on the belt, as attach puts a child's. A
   token that runs out at expires (0, never) is renewed by renew. A
   server of that name already attached just takes the token. *)
proc attachUrl*(name, url, token: []const U8; expires: I64): []const U8;
var s: Server; why: Buf.Buf; i: INT;
begin
    for i := 0 to servers.len - 1 do
        if Servers.all(servers)[i].name = name then
            Servers.all(servers)[i].token := Amsg.keep(token);
            Servers.all(servers)[i].expires := expires;
            return "";
        end;
    end;
    Buf.init(why, Heap.heap);
    defer Buf.done(why);
    Fmt.write(why, "{}: ", [Fmt.str(name)]);
    s := {name: Amsg.keep(name), url: Amsg.keep(url), token: Amsg.keep(token), expires: expires, rd: -1, wr: -1};
    Buf.init(s.pending, Heap.heap);
    if admit(s, why) then return ""; end;
    return Amsg.keep(Buf.bytes(why));
end;

(* The last server called name that was not attached, or nil. *)
proc droppedAs(name: []const U8): ^Server;
var i: INT; s: ^Server;
begin
    s := nil;
    for i := 0 to dropped.len - 1 do
        if Servers.all(dropped)[i].name = name then s := SYSTEM.ADR(Servers.all(dropped)[i]); end;
    end;
    return s;
end;

(* How the server called name, refused with a 401, wants a login: its
   WWW-Authenticate, where a login starts; "" if it was not refused. *)
proc challenge*(name: []const U8): []const U8;
var s: ^Server;
begin
    s := droppedAs(name);
    if s = nil then return ""; end;
    return s^.challenge;
end;

(* What became of the server called name, a line into b: how many
   tools it offers, or why it was not attached. *)
proc status*(name: []const U8; var b: Buf.Buf);
var i, n: INT; s: ^Server;
begin
    n := 0;
    for i := 0 to origins.len - 1 do
        if Servers.all(servers)[Origins.all(origins)[i].server].name = name then INC(n); end;
    end;
    s := droppedAs(name);
    if n > 0 then
        Fmt.write(b, "{}: {} tools\n", [Fmt.str(name), Fmt.int(n)]);
    elsif s # nil then
        Fmt.write(b, "{}\n", [Fmt.str(s^.why)]);
    else
        Fmt.write(b, "{}: not attached\n", [Fmt.str(name)]);
    end;
end;

(* The tools the attached servers offer. *)
proc tools*: []Awire.Tool;
begin
    return Belt.all(belt);
end;

(* The tool name run with the arguments v of d, an object: its result
   added to out. stopped, which may be nil, says whether the human
   said to stop. Whether the human agrees to the call is asked
   before. *)
proc call*(name: []const U8; d: ^Json.Doc; v: Json.Value; stopped: proc: BOOL; var out: Buf.Buf);
var i, k: INT; q, res: Buf.Buf; r, c, t: Json.Value; kind: []const U8; failed: BOOL; o: Origin;
    rd: Json.Doc; text: Buf.Buf;
begin
    for i := 0 to belt.len - 1 do
        if Belt.all(belt)[i].name = name then o := Origins.all(origins)[i]; end;
    end;
    Buf.init(q, Heap.heap);
    defer Buf.done(q);
    Buf.init(res, Heap.heap);
    defer Buf.done(res);
    Buf.str(q, "{\"name\":");
    Amsg.quote(q, o.name);
    Buf.str(q, ",\"arguments\":");
    Amsg.compact(d, v, q);
    Buf.add(q, '}');
    if not request(Servers.all(servers)[o.server], "tools/call", Buf.bytes(q), stopped, res) then
        Buf.str(out, "error: ");
        Buf.str(out, Buf.bytes(res));
        return;
    end;
    if not Json.init(SYSTEM.ADR(rd), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(rd));
    Buf.init(text, Heap.heap);
    defer Buf.done(text);
    r := Json.parse(SYSTEM.ADR(rd), Buf.bytes(res));
    c := Json.member(SYSTEM.ADR(rd), r, "content");
    for k := 0 to Json.len(SYSTEM.ADR(rd), c) - 1 do
        t := Json.item(SYSTEM.ADR(rd), c, k);
        kind := Json.text(SYSTEM.ADR(rd), Json.member(SYSTEM.ADR(rd), t, "type"));
        if kind = "text" then
            Buf.str(text, Json.text(SYSTEM.ADR(rd), Json.member(SYSTEM.ADR(rd), t, "text")));
        else
            Fmt.write(text, "[{}]", [Fmt.str(kind)]);
        end;
        Buf.add(text, '\n');
    end;
    failed := Json.member(SYSTEM.ADR(rd), r, "isError") = Json.True;
    if failed then Buf.str(out, "error: "); end;
    if text.len = 0 then Buf.str(text, "(no output)"); end;
    Buf.str(out, Buf.bytes(text));
end;

(* The module's test, which starts build/mcpstub (test/Amcpstub.raz). *)

var failed: BOOL;   (* whether any check of the test failed *)
var digits: [IdLen]U8;   (* num's digits *)

(* n in decimal, good until the next call. *)
proc num(n: INT): []const U8;
var k: INT;
begin
    digits, k := Str.fromInt(n);
    return digits[0..k];
end;

(* A failure noted, and said, if got is not want. *)
proc expect(what, got, want: []const U8);
begin
    if got = want then return; end;
    Out.str("Amcp: ");
    Out.str(what);
    Out.str(": got \"");
    Out.str(got);
    Out.str("\", wanted \"");
    Out.str(want);
    Out.str("\"\n");
    failed := true;
end;

var calls: INT;   (* how many times soon has been asked *)

(* Says to stop from its third look on, as a human would. *)
proc soon: BOOL;
begin
    INC(calls);
    return calls > 2;
end;

(* The tool name run with the arguments text, its result. *)
proc run(name, text: []const U8; stopped: proc: BOOL): []const U8;
var d: Json.Doc; b: Buf.Buf; own: []U8;
begin
    if not Json.init(SYSTEM.ADR(d), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    own := Amsg.keep(text);
    Buf.init(b, Heap.heap);
    call(name, SYSTEM.ADR(d), Json.parse(SYSTEM.ADR(d), own), stopped, b);
    return Buf.bytes(b);
end;

var web: Server;   (* build/mcpstub http, a child that serves HTTP *)
var at: Buf.Buf;   (* a URL of it *)

(* The URL of path on web's port, the line it wrote, good until the
   next call. *)
proc url(port, path: []const U8): []const U8;
begin
    Buf.reset(at);
    Fmt.write(at, "http://127.0.0.1:{}{}", [Fmt.str(port), Fmt.str(path)]);
    return Buf.bytes(at);
end;

(* A token renewed, as a login's would be: the one /login takes. *)
proc fresh(_name, _url: []const U8; var expires: I64): []const U8;
begin
    expires := Sys.clock() + 3600000000000;
    return "secret";
end;

(* The checks over HTTP, against web, which they start and leave
   running: a session, an event stream, a session forgotten, a login
   wanted and a token. *)
proc overHttp;
var port: Buf.Buf; err: []const U8;
begin
    Buf.init(port, Heap.heap);
    Buf.init(at, Heap.heap);
    web := {};
    Buf.init(web.pending, Heap.heap);
    if not start(["build/mcpstub", "http"], web) or (LEN(readLine(web, nil, port)) > 0) then
        expect("the HTTP server", "not started", "started");
        return;
    end;
    err := attachUrl("web", url(Buf.bytes(port), "/mcp"), "", 0);
    expect("attach over HTTP", err, "");
    expect("tools over HTTP", num(LEN(tools())), "16");
    expect("an event stream", run("web_echo", "{\"text\":\"streamed\"}", nil), "streamed\n");
    expect("a session forgotten", run("web_die", "{}", nil), "(no output)");
    expect("a new session", run("web_echo", "{\"text\":\"again\"}", nil), "again\n");
    err := attachUrl("lin", url(Buf.bytes(port), "/login"), "", 0);
    expect("a login wanted", err, "lin: the server needs a login (401); /mcp login lin, or set mcp_token.lin");
    expect("how", challenge("lin"), "Bearer realm=\"stub\"");
    err := attachUrl("key", url(Buf.bytes(port), "/login"), "secret", 0);
    expect("a token", err, "");
    renew := fresh;
    err := attachUrl("old", url(Buf.bytes(port), "/login"), "stale", Sys.clock() + 3600000000000);
    expect("a token renewed on a 401", err, "");
    Buf.reset(at);
    status("old", at);
    status("lin", at);
    expect("status", Buf.bytes(at), "old: 8 tools\nlin: the server needs a login (401); /mcp login lin, or set mcp_token.lin\n");
    expect("no server down", run("web_echo", "{\"text\":\"still\"}", nil), "still\n");
end;

(* Runs the checks; 0 if all hold. *)
proc main*: INT;
var t: []Awire.Tool; err: []const U8;
begin
    err := attach("none", ["no-such-server-of-arno"]);
    expect("no such program", err, "none: cannot start");
    startWait := 300;
    err := attach("mute", ["build/mcpstub", "mute"]);
    expect("a server that never answers", err, "mute: no answer in time");
    startWait := 10000;
    err := attach("quit", ["build/mcpstub", "quit"]);
    expect("a server that quits", err, "quit: server gone");
    err := attach("odd", ["build/mcpstub", "odd"]);
    expect("a server that errs", err, "odd: no tools here");
    expect("nothing offered yet", num(LEN(tools())), "0");
    err := attach("stub", ["build/mcpstub"]);
    expect("attach", err, "");
    t := tools();
    expect("tools", num(LEN(t)), "8");
    expect("a name", t[0].name, "stub_echo");
    expect("a description", t[0].description, "Say the text back.");
    expect("a schema", t[0].params, "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}}}");
    expect("no schema", t[1].params, "{\"type\":\"object\"}");
    expect("a name cut", num(LEN(t[6].name)), "64");
    expect("a name made fit", t[7].name, "stub_odd_name_");
    expect("owns", num(INT(owns("stub_echo"))), "1");
    expect("owns not", num(INT(owns("echo"))), "0");
    expect("serverOf", serverOf("stub_echo"), "stub");
    expect("serverOf not", serverOf("echo"), "");
    err := attach("stub", ["build/mcpstub"]);
    expect("the same again", err, "stub: offers no tool that is new");
    expect("no duplicates", num(LEN(tools())), "8");
    expect("echo", run("stub_echo", "{\"text\":\"hi \\\"there\\\"\"}", nil), "hi \"there\"\n");
    expect("an error", run("stub_fail", "{}", nil), "error: boom\n");
    expect("a picture", run("stub_picture", "{}", nil), "[image]\nseen\n");
    expect("a server's error", run("stub_nope", "{}", nil), "error: no such tool");
    expect("empty", run("stub_empty", "{}", nil), "(no output)");
    expect("stopped", run("stub_hang", "{}", soon), "error: interrupted");
    expect("after being stopped", run("stub_echo", "{\"text\":\"again\"}", nil), "again\n");
    expect("gone", run("stub_die", "{}", nil), "error: server gone");
    expect("gone for good", run("stub_echo", "{}", nil), "error: server gone");
    overHttp();
    stop();
    expect("stopped all", num(LEN(tools())), "0");
    finish(web, 0);
    if failed then return 1; end;
    return 0;
end;

begin
    Servers.init(servers, Heap.heap);
    Belt.init(belt, Heap.heap);
    Origins.init(origins, Heap.heap);
    Servers.init(dropped, Heap.heap);
    startWait := 10000;
    _ := Rt.atExit(stop);   (* the servers end with the program, whichever way it ends *)
end Amcp.
