(* Aconf: arno's configuration, $XDG_CONFIG_HOME/arno/config, or
   ~/.config/arno/config.

   The file is the Pascal arno's: a setting to a line, key = value,
   blanks around either taken off; a line that is empty, begins with #
   or has no = is passed by. A key given twice is the last one's, except for mcp, which
   may be given for each server, and which nth reads.

   The keys that say which provider and how to ask it are read into a
   provider, an Awire.Prov:

       provider       one of Awire.Presets, its url, model and key's
                      variable; the params before it are dropped
       model, url     the provider's own, in place of the preset's
       key            the environment variable of its key
       dialect        anthropic, or else OpenAI's
       timeout        seconds a request may take in all; 0, none
       max_retries    times a request whose connection failed is made
                      again; 0
       retry_backoff  seconds before the first; 2, doubled each time
       effort         MODEL:LEVEL ..., the reasoning effort for each
                      model, as the param reasoning_effort@MODEL

   The keys the rest of arno reads (run, max_steps, mcp and the
   others, Known below, and those PREFIX.NAME for a prefix of Prefixed,
   as check.unit and lsp.ts, or of Owned, as mcp_token.linear) are kept
   for it to ask by get. Any other is a
   param of the provider, key=value, which a request carries if it
   knows it (temperature, top_p, max_tokens, anthropic_version ...),
   so that a provider's field needs no new key here.

   A line [DIR] begins a section: the settings after it, up to the
   next, are for the project whose root is DIR or below it, so that a
   tree of projects has settings of its own. DIR is absolute, or ~ or
   ~/... for the home. Once apply is told the project's root, get gives
   a key as the deepest section holding the root sets it, else as the
   settings before the first section, the global ones, set it: a whole
   value, never a list merged. Only the keys of one project (Sectioned,
   and Prefixed's) may be set in a section; the provider's, mcp and
   mcp_token's are for every directory.

       provider = ollama-cloud     the global settings
       run = tiza man fd
       [~/r]                       ~/r and every project under it
       run = raz robbie make
       [~/r/arno]                  deeper, so over ~/r's
       test_cmd = make check

   What is wrong with the file, an unknown provider, a number that
   isn't one, a section that names no directory or sets a global key,
   is said in warnings, a line each, and the rest is read as if the
   line weren't there; a bad section's settings with it.

   Depends on Awire, for Prov, and Afence, which resolves a section's
   directory as it does the root. Leaves out what each key of the rest
   of arno means, and any file of the project's own: a section is the
   human's word, and a repository cloned grants itself nothing. *)
module Aconf;
import Awire, Amsg, Afence, Buf, Str, Sys, Files, Heap, Mem, Out, Strs := Vec([]const U8), Ints := Vec(INT),
    Sections := Vec(Section);
import SYSTEM;

type
    (* The global settings, or a [DIR] section's. *)
    Section = record
        dir: []const U8;   (* as its header names it, ~ not yet the home; "" for the global settings *)
        rank: INT;         (* how deep it holds the project's root, its resolved path's length; 0 for the global settings, -1 if it doesn't *)
    end;

    Conf* = record
        prov*: Awire.Prov;      (* its strings are the file's, or the preset's *)
        warnings*: Buf.Buf;     (* what is wrong with the file, a line each *)
        text: Buf.Buf;          (* the file, which the settings are slices of *)
        keys, values: Strs.Vec; (* every setting, in the file's order *)
        sect: Ints.Vec;         (* each setting's section, 0 for the global ones *)
        sections: Sections.Vec; (* the global settings first, then each section, in the file's order *)
        params: Strs.Vec;       (* the provider's params, each its own block *)
    end;

const
    (* the keys the rest of arno reads, which are no provider's param *)
    Known: []const []const U8 = ["worker", "workers", "max_steps", "prune", "turn_budget", "build_steps", "build_budget", "mode", "searxng", "test_cmd", "safety",
        "keys", "cache_tools", "cache_ttl", "find_cmd", "grep_cmd", "run", "shell", "run_ro", "run_env",
        "trust", "grant", "context_files", "project_map", "prefetch", "mcp", "jail_net", "jail_rw"];

    (* the keys a section may set, which are one project's *)
    Sectioned: []const []const U8 = ["run", "run_ro", "run_env", "trust", "test_cmd", "safety", "context_files",
        "project_map", "prefetch", "shell", "jail_net", "jail_rw", "mode", "worker", "workers", "build_steps", "build_budget",
        "max_steps", "turn_budget"];

    (* the prefixes of keys PREFIX.NAME, each name its own setting, that
       a section may set too: check.unit, check.fmt, lsp.ts *)
    Prefixed: []const []const U8 = ["check", "lsp"];

    (* the prefixes of keys PREFIX.NAME that only the global settings
       may set, as they run commands as the human: mcp_token.linear *)
    Owned: []const []const U8 = ["mcp_token"];

(* c made a configuration of nothing: the ollama preset. *)
proc init*(var c: Conf);
begin
    c := {};
    Buf.init(c.warnings, Heap.heap);
    Buf.init(c.text, Heap.heap);
    Strs.init(c.keys, Heap.heap);
    Strs.init(c.values, Heap.heap);
    Strs.init(c.params, Heap.heap);
    Ints.init(c.sect, Heap.heap);
    Sections.init(c.sections, Heap.heap);
    Sections.push(c.sections, {dir: "", rank: 0});
    _ := Awire.preset("ollama", c.prov);
end;

proc dropParams(var c: Conf);
var i: INT; p: [][]const U8;
begin
    p := Strs.all(c.params);
    (* kept as the []const U8 the provider reads; each is Str.copy's, so freed as it is *)
    for i := 0 to LEN(p) - 1 do
        if LEN(p[i]) > 0 then Mem.free(Heap.heap, SYSTEM.PTR(p[i])); end;
    end;
    Strs.reset(c.params);
end;

proc done*(var c: Conf);
begin
    dropParams(c);
    Strs.done(c.params);
    Sections.done(c.sections);
    Ints.done(c.sect);
    Strs.done(c.keys);
    Strs.done(c.values);
    Buf.done(c.text);
    Buf.done(c.warnings);
    c := {};
end;

(* Whether key is PREFIX.NAME for a prefix of prefixes and a NAME of
   letters, digits, - and _. *)
proc prefixed(key: []const U8; prefixes: []const []const U8): BOOL;
var i, j: INT; name: []const U8;
begin
    for i := 0 to LEN(prefixes) - 1 do
        if not Str.hasPrefix(key, prefixes[i]) or (LEN(key) <= LEN(prefixes[i]) + 1) or (key[LEN(prefixes[i])] # '.') then
            continue;
        end;
        name := key[LEN(prefixes[i]) + 1..LEN(key)];
        for j := 0 to LEN(name) - 1 do
            if not Str.isLetter(name[j]) and not Str.isDigit(name[j]) and (name[j] # '-') and (name[j] # '_') then return false; end;
        end;
        return true;
    end;
    return false;
end;

(* The value of key, as the deepest section applied sets it, else the
   global settings; within one, as its last line does; "" if none
   sets it. *)
proc get*(const c: Conf; key: []const U8): []const U8;
var i, best, rank, r: INT; keys: [][]const U8; sect: []INT; s: []Section;
begin
    keys := Strs.all(c.keys);
    sect := Ints.all(c.sect);
    s := Sections.all(c.sections);
    best := -1;
    rank := -1;
    for i := 0 to LEN(keys) - 1 do
        r := s[sect[i]].rank;
        if (keys[i] = key) and (r >= 0) and (r >= rank) then
            best := i;
            rank := r;
        end;
    end;
    if best < 0 then return ""; end;
    return Strs.all(c.values)[best];
end;

(* The sections whose directory holds root, the project's, resolved,
   applied, a deeper one over a shallower; the others not. Before,
   only the global settings are. *)
proc apply*(var c: Conf; root: []const U8);
var s: []Section; i: INT; dir, at: Buf.Buf;
begin
    Buf.init(dir, Heap.heap);
    defer Buf.done(dir);
    Buf.init(at, Heap.heap);
    defer Buf.done(at);
    s := Sections.all(c.sections);
    for i := 1 to LEN(s) - 1 do
        Buf.reset(dir);
        if s[i].dir[0] = '~' then
            Buf.str(dir, Sys.env("HOME"));
            Buf.str(dir, s[i].dir[1..LEN(s[i].dir)]);
        else
            Buf.str(dir, s[i].dir);
        end;
        Afence.resolve(Buf.bytes(dir), at);
        s[i].rank := -1;
        if Afence.within(root, Buf.bytes(at)) then s[i].rank := at.len; end;
    end;
end;

(* The nth value, from 0, of key, as the file gave it each time, for a
   key that may be given again, such as mcp; false past the last. *)
proc nth*(const c: Conf; key: []const U8; n: INT): ([]const U8, BOOL);
var i: INT; keys: [][]const U8;
begin
    keys := Strs.all(c.keys);
    for i := 0 to LEN(keys) - 1 do
        if keys[i] = key then
            if n = 0 then return Strs.all(c.values)[i], true; end;
            DEC(n);
        end;
    end;
    return "", false;
end;

(* Whether key, valid or not, is PREFIX.something for a prefix of
   prefixes. *)
proc under(key: []const U8; prefixes: []const []const U8): BOOL;
var i: INT;
begin
    for i := 0 to LEN(prefixes) - 1 do
        if Str.hasPrefix(key, prefixes[i]) and (LEN(key) > LEN(prefixes[i])) and (key[LEN(prefixes[i])] = '.') then
            return true;
        end;
    end;
    return false;
end;

(* Whether key, valid or not, is PREFIX.something for a prefix of
   Prefixed or Owned: arno's, and never a provider's parameter. *)
proc ours(key: []const U8): BOOL;
begin
    return under(key, Prefixed) or under(key, Owned);
end;

(* The nth, from 0, of the names NAME of the keys prefix.NAME that
   apply, in the order the file first gives them, with its value as get
   gives it; false past the last. *)
proc named*(const c: Conf; prefix: []const U8; n: INT): ([]const U8, []const U8, BOOL);
var i, j: INT; keys: [][]const U8; sect: []INT; s: []Section; seen: BOOL;
begin
    keys := Strs.all(c.keys);
    sect := Ints.all(c.sect);
    s := Sections.all(c.sections);
    for i := 0 to LEN(keys) - 1 do
        if (s[sect[i]].rank < 0) or not prefixed(keys[i], Prefixed) or not Str.hasPrefix(keys[i], prefix) then continue; end;
        seen := false;
        for j := 0 to i - 1 do
            if (keys[j] = keys[i]) and (s[sect[j]].rank >= 0) then seen := true; end;
        end;
        if seen then continue; end;
        if n = 0 then return keys[i][LEN(prefix) + 1..LEN(keys[i])], get(c, keys[i]), true; end;
        DEC(n);
    end;
    return "", "", false;
end;

proc warn(var c: Conf; a, b: []const U8);
begin
    Buf.str(c.warnings, "config: ");
    Buf.str(c.warnings, a);
    Buf.str(c.warnings, b);
    Buf.add(c.warnings, '\n');
end;

(* A param of the provider, its key and value joined by =. *)
proc param(var c: Conf; key, value: []const U8);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.str(b, key);
    Buf.add(b, '=');
    Buf.str(b, value);
    Strs.push(c.params, Amsg.keep(Buf.bytes(b)));
end;

(* model's effort, as the param reasoning_effort@MODEL=level. *)
proc effort(var c: Conf; model, level: []const U8);
var key: Buf.Buf;
begin
    Buf.init(key, Heap.heap);
    defer Buf.done(key);
    Buf.str(key, "reasoning_effort@");
    Buf.str(key, model);
    param(c, Buf.bytes(key), level);
end;

(* value, a whole number of 0 or more, into n; or a warning, and n as
   it was. *)
proc number(var c: Conf; key, value: []const U8; var n: INT);
var v: I64; ok: BOOL;
begin
    v, ok := Str.toInt(value);
    if not ok or (v < 0) or (v > 1000000) then
        warn(c, key, " wants a number");
        return;
    end;
    n := INT(v);
end;

proc known(key: []const U8): BOOL;
var i: INT;
begin
    for i := 0 to LEN(Known) - 1 do
        if key = Known[i] then return true; end;
    end;
    return prefixed(key, Prefixed) or prefixed(key, Owned);
end;

(* Whether a section may set key. *)
proc sectioned(key: []const U8): BOOL;
var i: INT;
begin
    for i := 0 to LEN(Sectioned) - 1 do
        if key = Sectioned[i] then return true; end;
    end;
    return prefixed(key, Prefixed);
end;

(* The header line, [DIR], made the section the settings after it go
   to: its number; or -1 if it names no directory, which is warned of,
   and then its settings are passed by. *)
proc header(var c: Conf; line: []const U8): INT;
var dir: []const U8;
begin
    dir := "";
    if line[LEN(line) - 1] = ']' then dir := Str.trim(line[1..LEN(line) - 1]); end;
    if (dir # "~") and not Str.hasPrefix(dir, "~/") and not Str.hasPrefix(dir, "/") then
        warn(c, line, " names no directory, as [/dir] or [~/dir]; its settings are passed by");
        return -1;
    end;
    Sections.push(c.sections, {dir: dir, rank: -1});
    return LEN(Sections.all(c.sections)) - 1;
end;

(* One setting, key = value, read into c. *)
proc setting(var c: Conf; key, value: []const U8);
var word, rest: []const U8; at: INT;
begin
    match key of
    | "provider":
        if Awire.preset(value, c.prov) then
            dropParams(c);
        else
            warn(c, "unknown provider ", value);
        end;
    | "model": c.prov.model := value;
    | "url": c.prov.url := value;
    | "key": c.prov.keyEnv := value;
    | "dialect":
        c.prov.dialect := Awire.Dialect.openai;
        if value = "anthropic" then c.prov.dialect := Awire.Dialect.anthropic; end;
    | "timeout": number(c, key, value, c.prov.limit);
    | "max_retries": number(c, key, value, c.prov.retries);
    | "retry_backoff": number(c, key, value, c.prov.backoff);
    | "effort":
        (* MODEL:LEVEL ..., a model's name having colons of its own,
           as deepseek-v4.1-flash:cloud *)
        word, rest := Str.field(value);
        while LEN(word) > 0 do
            at := Str.findLast(word, ":");
            if at > 0 then effort(c, word[0..at], word[at + 1..LEN(word)]); end;
            word, rest := Str.field(rest);
        end;
    | else:
        if known(key) then
        elsif ours(key) then   (* a PREFIX.NAME gone wrong, check.bad name: no provider's *)
            warn(c, key, " is no key: a name of letters, digits, - and _ goes after the dot");
        else
            param(c, key, value);
        end;
    end;
end;

(* text, a configuration file, read into c, made with init: c keeps
   a copy of it, which its settings are slices of. *)
proc read*(var c: Conf; text: []const U8);
var line, rest, key, value: []const U8; at: INT; more, eq: BOOL;
begin
    Buf.str(c.text, text);
    rest := Buf.bytes(c.text);
    more := LEN(rest) > 0;
    at := 0;   (* the section the settings go to, 0 the global ones; -1 after a bad header *)
    while more do
        line, rest, more := Str.cut(rest, "\n");
        line := Str.trim(line);
        if (LEN(line) = 0) or (line[0] = '#') then continue; end;
        if line[0] = '[' then at := header(c, line); continue; end;
        key, value, eq := Str.cut(line, "=");
        if not eq or (at < 0) then continue; end;
        key := Str.trim(key);
        value := Str.trim(value);
        if (at > 0) and not sectioned(key) then
            warn(c, key, " is for every directory, set before the first [section]");
            continue;
        end;
        Strs.push(c.keys, key);
        Strs.push(c.values, value);
        Ints.push(c.sect, at);
        if at = 0 then setting(c, key, value); end;
    end;
    c.prov.params := Strs.all(c.params);
end;

(* c made the configuration in arno's file, or the ollama preset if
   there is none. *)
proc load*(var c: Conf);
var path, text: Buf.Buf; base: []const U8;
begin
    init(c);
    Buf.init(path, Heap.heap);
    Buf.init(text, Heap.heap);
    defer Buf.done(path);
    defer Buf.done(text);
    base := Sys.env("XDG_CONFIG_HOME");
    if LEN(base) > 0 then
        Buf.str(path, base);
    else
        Buf.str(path, Sys.env("HOME"));
        Buf.str(path, "/.config");
    end;
    Buf.str(path, "/arno/config");
    if Files.load(Buf.bytes(path), text) = 0 then read(c, Buf.bytes(text)); end;
end;

(* The test: a file of every kind of line, and one of sections. *)

var failed: BOOL;

proc expect(what, got, want: []const U8);
begin
    if got = want then return; end;
    Out.str("Aconf: ");
    Out.str(what);
    Out.str("\n  got:  ");
    Out.str(got);
    Out.str("\n  want: ");
    Out.str(want);
    Out.ln;
    failed := true;
end;

(* Sections applied for one project's root and then others', the home
   a made-up one. *)
proc sections;
var c: Conf;
begin
    _ := Sys.setEnv("HOME", "/nowhere/home");
    init(c);
    read(c, `
        run = tiza man fd
        test_cmd = make test
        [~/r]
        run = raz robbie
        trust = make
        provider = claude
        temperature = 0.5
        mcp_token.web = pass web
        [~/r/arno]
        run = raz
        workers = fast cheap:cloud
        lsp.raz = raz-lsp
        [ /nowhere/home/r ]
        trust = robbie
        [w]
        safety = safe
        [~/w/webapp
        safety = safe
        `);
    expect("before apply, the global run", get(c, "run"), "tiza man fd");
    expect("the provider, not set in a section", c.prov.name, "ollama");
    expect("the section warnings", Buf.bytes(c.warnings),
        "config: provider is for every directory, set before the first [section]\n" +
        "config: temperature is for every directory, set before the first [section]\n" +
        "config: mcp_token.web is for every directory, set before the first [section]\n" +
        "config: [w] names no directory, as [/dir] or [~/dir]; its settings are passed by\n" +
        "config: [~/w/webapp names no directory, as [/dir] or [~/dir]; its settings are passed by\n");
    apply(c, "/nowhere/home/r/arno");
    expect("the deepest section's run", get(c, "run"), "raz");
    expect("workers in a section", get(c, "workers"), "fast cheap:cloud");
    expect("the same directory twice, the later", get(c, "trust"), "robbie");
    expect("a global key no section sets", get(c, "test_cmd"), "make test");
    expect("a bad section's key", get(c, "safety"), "");
    expect("a prefixed key in a section", get(c, "lsp.raz"), "raz-lsp");
    apply(c, "/nowhere/home/r");
    expect("the section of the root itself", get(c, "run"), "raz robbie");
    apply(c, "/nowhere/home/r2");
    expect("a sibling with a longer name", get(c, "run"), "tiza man fd");
    done(c);
end;

(* check.NAME keys: global and in a section, the deeper one over, a bad name refused. *)
proc checks;
var c: Conf; n, v: []const U8; ok: BOOL;
begin
    init(c);
    read(c, `
        check.unit = make unit
        check.fmt = make fmt
        check.bad name = x
        check. = x
        [/nowhere/p]
        check.unit = make unit2
        check.e2e_1 = make e2e
        `);
    apply(c, "/nowhere/q");
    n, v, ok := named(c, "check", 1);
    expect("a named check", n, "fmt");
    expect("a named check, its command", v, "make fmt");
    _, _, ok := named(c, "check", 2);
    if ok then expect("a section not applied", "a third", "two"); end;
    apply(c, "/nowhere/p");
    n, v, ok := named(c, "check", 0);
    expect("the deeper section over", n, "unit");
    expect("the deeper section over, its command", v, "make unit2");
    n, v, ok := named(c, "check", 2);
    expect("a section's own check", n, "e2e_1");
    expect("a section's own check, its command", v, "make e2e");
    expect("the warnings of check keys", Buf.bytes(c.warnings),
        "config: check.bad name is no key: a name of letters, digits, - and _ goes after the dot\n" +
        "config: check. is no key: a name of letters, digits, - and _ goes after the dot\n");
    done(c);
end;

proc main*: INT;
var c: Conf; b: Buf.Buf; v: []const U8; ok: BOOL;
begin
    init(c);
    read(c, `
        # arno's configuration
        temperature = 0.9
        provider = claude
          model=claude-opus-5-5
        not a setting
        max_steps = 60
        run = tiza man fd
        mcp = files npx files-server /tmp
        mcp = web https://mcp.example.com/mcp
        mcp_token.web = pass web/mcp
        effort = kimi-k3:high deepseek-v4.1-flash:cloud:low
        anthropic_version = 2023-06-01
        timeout = 600
        max_retries = many
        provider = nowhere
        `);
    expect("the provider", c.prov.name, "claude");
    expect("its model", c.prov.model, "claude-opus-5-5");
    expect("its url", c.prov.url, "https://api.anthropic.com/v1");
    expect("its key", c.prov.keyEnv, "ANTHROPIC_API_KEY");
    if c.prov.dialect # Awire.Dialect.anthropic then expect("its dialect", "openai", "anthropic"); end;
    if c.prov.limit # 600 then expect("its timeout", "not 600", "600"); end;
    if c.prov.retries # 0 then expect("its retries, never set", "set", "0"); end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Str.join(b, c.prov.params, " ");
    expect("its params, temperature dropped by the provider after it", Buf.bytes(b),
        "reasoning_effort@kimi-k3=high reasoning_effort@deepseek-v4.1-flash:cloud=low anthropic_version=2023-06-01");
    expect("a key kept for the rest of arno", get(c, "run"), "tiza man fd");
    expect("a key not set", get(c, "worker"), "");
    v, ok := nth(c, "mcp", 1);
    expect("the second mcp", v, "web https://mcp.example.com/mcp");
    expect("an mcp server's token command", get(c, "mcp_token.web"), "pass web/mcp");
    _, ok := nth(c, "mcp", 2);
    if ok then expect("a third mcp", "there is one", "none"); end;
    expect("the warnings", Buf.bytes(c.warnings),
        "config: max_retries wants a number\nconfig: unknown provider nowhere\n");
    expect("the effort for a model", Awire.param(c.prov, "reasoning_effort@kimi-k3"), "high");
    done(c);
    sections();
    checks();
    if failed then return 1; end;
    return 0;
end;

end Aconf.
