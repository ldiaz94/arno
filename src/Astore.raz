(* Astore: conversations kept on disk, and the lock on arno's shared
   files.

   A conversation is a file of its own, ID.json, in arno's directory,
   $XDG_DATA_HOME/arno or ~/.local/share/arno; its id is when it began,
   in local time, yyyymmdd-hhmmss, so that ids sort as their times do.
   The file is the Pascal arno's, key for key:

       {"title":"...","named":false,"model":"...","system":"...",
        "messages":[...],"stamps":[...],"turns":[...]}

   title is the one the human gave it, and named says it was given; an
   untitled conversation is saved with a title taken from its first
   message, for lists to show, and named false, so that the title is
   taken again as the conversation grows. system, the conversation's
   own system prompt, and turns, a record of each turn, are written
   only when there are some, as the Pascal arno wrote them. save writes
   a file byte for byte as that arno did, so either reads the other's.

   stamps, arno's own, says of each message when it was said and in
   which model's turn, {"at":SECONDS,"model":"..."}, or {} if that is
   not known; it is written only when a message has a stamp, so a file
   without one, older than stamps, is still the Pascal arno's, and is
   read with no stamps.

   A file is written whole to a temporary beside it and renamed over
   it, so a crash leaves the old file, and another session reads the
   old or the new, never half of one. Two sessions at once are usual,
   two terminals or a terminal and a host's --serve: each change made
   by reading a shared file, changing it and writing it back is made
   holding lock, one flock on one file for all of them, which are
   small and held for milliseconds.

   Two things are done otherwise than the Pascal arno did. A title
   taken from the first message is cut at 60 bytes, as that arno cut
   it, but back to where a character starts, so that it is UTF-8,
   which rjson must read; and the list holds only conversations, the
   files save writes, not arno's other files beside them (notes.json,
   stage.json, tests.json, context.json), which that arno listed untitled.

   Beside the conversations, it keeps a text for each project in a file
   of them (keyed): tests.json, the project's test command, and
   stage.json, whether its stage is on, and context.json, whether
   its context files are read. It says where the stage's copy
   lives, a directory a process (stageDir), and sweeps the copies of
   processes that are gone.

   It keeps the usage log, a line for each request of a model, what it
   used and cost, for a host to sum over days (logUse, uses).

   Depends on Amsg, rjson's Json, and rzone's Zone, for the local
   time. Leaves out the other
   files the agent keeps beside the conversations (memory, notes, the
   tool cache), and the stage's own work, which is Astage's. *)
module Astore;
import Amsg, Json, Zone, Buf, Str, Sys, Files, Fmt, Heap, Rt, Out, Msgs := Vec(Amsg.Msg), Strs := Vec([]U8), Args := Vec([]const U8),
    Items := Vec(Item), Order := Sort(Item, before);
import SYSTEM;

type
    Conv* = record
        id*: []U8;
        title*: []U8;     (* the one the human gave it; "" if none *)
        model*: []U8;
        system*: []U8;    (* its own system prompt; "" if arno's stands *)
        msgs*: Msgs.Vec;
        turns*: Strs.Vec; (* one record a turn, each compact JSON text *)
    end;

    (* A conversation, as a list shows it. *)
    Item* = record
        id*: []U8;
        title*: []U8;
        updated*: I64;    (* when its file last changed, in nanoseconds since 1970 *)
    end;

const
    BadId*: ERROR = "no conversation has that id";
    NotSaved*: ERROR = "the conversation can't be written";
    Unreadable*: ERROR = "the conversation's file isn't one arno reads";
    DayNs = 86400000000000;   (* a day, in nanoseconds *)

var
    where: Buf.Buf;   (* arno's directory, with a slash after it *)
    cached: Buf.Buf;  (* the cache's, the same *)
    lockFd, lockDepth: INT;

(* arno's directory, with a slash after it: $XDG_DATA_HOME/arno, or
   ~/.local/share/arno, made if it isn't there. *)
proc dir*: []const U8;
var base: []const U8;
begin
    if where.len > 0 then return Buf.bytes(where); end;
    Buf.init(where, Heap.heap);
    base := Sys.env("XDG_DATA_HOME");
    if LEN(base) > 0 then
        Buf.str(where, base);
    else
        Buf.str(where, Sys.env("HOME"));
        Buf.str(where, "/.local/share");
    end;
    _ := Sys.makeDir(Buf.bytes(where));
    Buf.str(where, "/arno/");
    _ := Sys.makeDir(Buf.bytes(where));
    return Buf.bytes(where);
end;

(* path made arno's directory in place of the usual one, as a test
   wants; it must end in a slash, and be there. *)
proc use*(path: []const U8);
begin
    if where.len = 0 then Buf.init(where, Heap.heap); end;
    Buf.reset(where);
    Buf.str(where, path);
end;

(* arno's cache directory, with a slash after it: $XDG_CACHE_HOME/arno,
   or ~/.cache/arno, made if it isn't there. *)
proc cache*: []const U8;
var base: []const U8;
begin
    if cached.len > 0 then return Buf.bytes(cached); end;
    Buf.init(cached, Heap.heap);
    base := Sys.env("XDG_CACHE_HOME");
    if LEN(base) > 0 then
        Buf.str(cached, base);
    else
        Buf.str(cached, Sys.env("HOME"));
        Buf.str(cached, "/.cache");
    end;
    _ := Sys.makeDir(Buf.bytes(cached));
    Buf.str(cached, "/arno/");
    _ := Sys.makeDir(Buf.bytes(cached));
    return Buf.bytes(cached);
end;

(* The path of name in arno's directory, into b. *)
proc pathOf(name: []const U8; var b: Buf.Buf): []const U8;
begin
    Buf.reset(b);
    Buf.str(b, dir());
    Buf.str(b, name);
    return Buf.bytes(b);
end;

(* the lock *)

(* arno's lock on its shared files, held until as many unlock; a call
   inside one that holds it already holds it on. The second session
   that asks waits. The lock's file can't be kept open by a program a
   tool runs meanwhile; if it can't be opened, the work goes on
   without it, as the Pascal arno did. *)
proc lock*;
var b: Buf.Buf;
begin
    INC(lockDepth);
    if lockDepth > 1 then return; end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    lockFd := Sys.openMode(pathOf("lock", b), {Sys.reading, Sys.writing, Sys.creating}, 180H);
    if lockFd < 0 then return; end;
    _ := Sys.keepOnExec(lockFd, false);
    _ := Sys.lock(lockFd, true);
end;

proc unlock*;
begin
    if lockDepth = 0 then return; end;
    DEC(lockDepth);
    if (lockDepth > 0) or (lockFd < 0) then return; end;
    Sys.close(lockFd);   (* which lets the lock go *)
    lockFd := -1;
end;

(* files *)

(* path made to hold data: written whole to path.PID.tmp, then renamed
   over it. The pid keeps two sessions saving one file at once out of
   each other's temporary. *)
proc replace*(path, data: []const U8): ERROR;
var tmp: Buf.Buf; digits: [20]U8; n: INT;
begin
    Buf.init(tmp, Heap.heap);
    defer Buf.done(tmp);
    Buf.str(tmp, path);
    Buf.add(tmp, '.');
    digits, n := Str.fromInt(Sys.pid());
    Buf.str(tmp, digits[0..n]);
    Buf.str(tmp, ".tmp");
    if not Files.write(Buf.bytes(tmp), data) or (Sys.rename(Buf.bytes(tmp), path) # 0) then
        _ := Sys.remove(Buf.bytes(tmp));
        return NotSaved;
    end;
    return nil;
end;

(* What a file of name in arno's directory keeps for each project, a
   text by its root: tests.json, a project's test command, and
   stage.json, whether its stage is on, and context.json, whether its
   context files are read. Each is an object of roots to
   texts, read and written whole. *)

(* The text name keeps for root, added to b; "" if it keeps none, or
   the file is missing or broken. *)
proc keyed*(name, root: []const U8; var b: Buf.Buf): []const U8;
var path, text: Buf.Buf; d: Json.Doc; v: Json.Value; start: INT;
begin
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    Buf.init(text, Heap.heap);
    defer Buf.done(text);
    start := b.len;
    if Files.load(pathOf(name, path), text) # 0 then return ""; end;
    if not Json.init(SYSTEM.ADR(d), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    v := Json.member(SYSTEM.ADR(d), Json.parse(SYSTEM.ADR(d), Buf.bytes(text)), root);
    if Json.kind(SYSTEM.ADR(d), v) # Json.Kind.string then return ""; end;
    Buf.str(b, Json.text(SYSTEM.ADR(d), v));
    return Buf.bytes(b)[start..b.len];
end;

(* name made to keep value for root, the other roots' as they were; an
   empty value drops root. *)
proc setKeyed*(name, root, value: []const U8): ERROR;
var path, text, out: Buf.Buf; d: Json.Doc; v: Json.Value; i, n: INT;
begin
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    Buf.init(text, Heap.heap);
    defer Buf.done(text);
    Buf.init(out, Heap.heap);
    defer Buf.done(out);
    if not Json.init(SYSTEM.ADR(d), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    lock();
    defer unlock();
    v := Json.None;
    if Files.load(pathOf(name, path), text) = 0 then v := Json.parse(SYSTEM.ADR(d), Buf.bytes(text)); end;
    Buf.add(out, '{');
    n := 0;
    if Json.kind(SYSTEM.ADR(d), v) = Json.Kind.object then
        for i := 0 to Json.len(SYSTEM.ADR(d), v) - 1 do
            if Json.key(SYSTEM.ADR(d), v, i) = root then continue; end;
            if n > 0 then Buf.add(out, ','); end;
            Json.quote(SYSTEM.ADR(out), Json.key(SYSTEM.ADR(d), v, i));
            Buf.add(out, ':');
            Json.write(SYSTEM.ADR(d), SYSTEM.ADR(out), Json.item(SYSTEM.ADR(d), v, i), {});
            INC(n);
        end;
    end;
    if LEN(value) > 0 then
        if n > 0 then Buf.add(out, ','); end;
        Json.quote(SYSTEM.ADR(out), root);
        Buf.add(out, ':');
        Json.quote(SYSTEM.ADR(out), value);
    end;
    Buf.add(out, '}');
    return replace(Buf.bytes(path), Buf.bytes(out));
end;

(* n, from 0 to 99, as two digits. *)
proc two(var b: Buf.Buf; n: INT);
begin
    Buf.add(b, U8('0' + n div 10));
    Buf.add(b, U8('0' + n mod 10));
end;

(* Today's date, in local time, as yyyy-mm-dd, added to b. *)
proc date*(var b: Buf.Buf);
var tm: Zone.Time;
begin
    tm := Zone.local(Sys.now() div 1000000000);
    two(b, tm.year div 100);
    two(b, tm.year mod 100);
    Buf.add(b, '-');
    two(b, tm.month);
    Buf.add(b, '-');
    two(b, tm.day);
end;

(* Whether id may name a conversation: an id comes from outside too, a
   host's, so one that would reach out of arno's directory, by a slash
   or a leading dot, names none. *)
proc fit(id: []const U8): BOOL;
begin
    return (LEN(id) > 0) and (id[0] # '.') and (Str.find(id, "/") < 0);
end;

(* The path of the file of the conversation id, into b, made empty;
   "" if id can't be one. *)
proc file*(id: []const U8; var b: Buf.Buf): []const U8;
begin
    Buf.reset(b);
    if not fit(id) then return ""; end;
    Buf.str(b, dir());
    Buf.str(b, id);
    Buf.str(b, ".json");
    return Buf.bytes(b);
end;

(* the scratch *)

(* The names in the directory path, each kept, into names; none if
   it can't be opened. *)
proc namesIn(path: []const U8; var names: Strs.Vec);
var d: Sys.Dir; name: []const U8; more: BOOL;
begin
    if Sys.openDir(d, path) < 0 then return; end;
    name, more := Sys.nextEntry(d);
    while more do
        Strs.push(names, Amsg.keep(name));
        name, more := Sys.nextEntry(d);
    end;
    Sys.closeDir(d);
end;

(* Removes path and all below it. A link is removed as a link, never
   followed, so that one the model left pointing out of the scratch
   costs nothing outside it. *)
proc wipe*(path: []const U8);
var info: Sys.Info; names: Strs.Vec; all: [][]U8; i: INT; e: INT; b: Buf.Buf;
begin
    info, e := Sys.linkInfo(path);
    if e # 0 then return; end;
    if not info.dir then
        _ := Sys.remove(path);
        return;
    end;
    Strs.init(names, Heap.heap);
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    namesIn(path, names);
    all := Strs.all(names);
    for i := 0 to LEN(all) - 1 do
        Buf.reset(b);
        Buf.str(b, path);
        Buf.add(b, '/');
        Buf.str(b, all[i]);
        wipe(Buf.bytes(b));
        Str.free(Heap.heap, all[i]);
    end;
    Strs.done(names);
    _ := Sys.removeDir(path);
end;

(* The path of the scratch directory of the conversation id, into b,
   not made. *)
proc scratchPath(id: []const U8; var b: Buf.Buf): []const U8;
begin
    Buf.reset(b);
    Buf.str(b, cache());
    Buf.str(b, "scratch/");
    Buf.str(b, id);
    return Buf.bytes(b);
end;

(* The scratch directory of the conversation id, into b, made if it
   isn't there, so that the path the prompt names exists from the
   start; the directory of them all first. *)
proc scratch*(id: []const U8; var b: Buf.Buf): []const U8;
begin
    _ := Sys.makeDir(scratchPath("", b));
    _ := Sys.makeDir(scratchPath(id, b));
    return Buf.bytes(b);
end;

(* The scratch directory of id emptied. *)
proc clearScratch*(id: []const U8);
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    wipe(scratch(id, b));
    _ := scratch(id, b);
end;

(* The scratch directory of old now the one of new, with what is in
   it, as the work goes on under the new id. *)
proc moveScratch*(old, new: []const U8);
var a, b: Buf.Buf;
begin
    Buf.init(a, Heap.heap);
    defer Buf.done(a);
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    _ := Sys.rename(scratch(old, a), scratchPath(new, b));
end;

(* At start-up, removes the scratch directories left by conversations
   that are gone: those not touched in the last day, since another
   session may be in its first turn, writing there before its
   conversation is saved, and that no conversation's file has the id of. *)
proc sweep*;
var names: Strs.Vec; all: [][]U8; i, e: INT; info: Sys.Info; b, f: Buf.Buf;
begin
    Strs.init(names, Heap.heap);
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.init(f, Heap.heap);
    defer Buf.done(f);
    Buf.str(b, cache());
    Buf.str(b, "scratch/");
    namesIn(Buf.bytes(b), names);
    all := Strs.all(names);
    for i := 0 to LEN(all) - 1 do
        info, e := Sys.linkInfo(scratchPath(all[i], b));
        if (e = 0) and (Sys.now() - info.mtime > DayNs) and (LEN(file(all[i], f)) > 0)
                and (Sys.access(Buf.bytes(f), {}) # 0) then
            wipe(Buf.bytes(b));
        end;
        Str.free(Heap.heap, all[i]);
    end;
    Strs.done(names);
end;

(* Whether name, an entry of the stage's directory, is of an arno that
   is no longer running: the pid it starts with, which no process has. *)
proc gone(name: []const U8): BOOL;
var dot: INT; pid: I64; ok: BOOL;
begin
    dot := Str.find(name, ".");
    if dot < 0 then dot := LEN(name); end;
    pid, ok := Str.toInt(name[0..dot]);
    return ok and (pid > 0) and (Sys.kill(INT(pid), 0) = Sys.errNoProcess);
end;

(* Where this arno keeps the stage's copy of the project (Astage), with
   no slash after it: one per arno process rather than per
   conversation, since /new, /clear and /compact change the
   conversation and not the work in progress. Its parent is made here;
   the copy itself is git's to make. A copy whose arno is gone, killed
   by a signal or a crash, is removed here as the next one is made, with
   its index; the repository's note of that worktree stays until git's
   own prune, which the next stage on that repository runs. *)
proc stageDir*(var b: Buf.Buf): []const U8;
var names: Strs.Vec; all: [][]U8; i: INT; digits: [20]U8; n: INT; parent: Buf.Buf;
begin
    Strs.init(names, Heap.heap);
    Buf.init(parent, Heap.heap);
    defer Buf.done(parent);
    Buf.str(parent, cache());
    Buf.str(parent, "stage/");
    _ := Sys.makeDir(Buf.bytes(parent));
    namesIn(Buf.bytes(parent), names);
    all := Strs.all(names);
    for i := 0 to LEN(all) - 1 do
        if gone(all[i]) then
            Buf.reset(b);
            Buf.str(b, Buf.bytes(parent));
            Buf.str(b, all[i]);
            wipe(Buf.bytes(b));
        end;
        Str.free(Heap.heap, all[i]);
    end;
    Strs.done(names);
    Buf.reset(b);
    Buf.str(b, Buf.bytes(parent));
    digits, n := Str.fromInt(Sys.pid());
    Buf.str(b, digits[0..n]);
    return Buf.bytes(b);
end;

(* A new conversation's id, now in local time, into b: yyyymmdd-hhmmss,
   and -2, -3 and so on after it while a conversation saved has it, as
   one begun in the same second may. *)
proc newId*(var b: Buf.Buf);
var tm: Zone.Time; path: Buf.Buf; n, at: INT;
begin
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    tm := Zone.local(Sys.now() div 1000000000);
    two(b, tm.year div 100);
    two(b, tm.year mod 100);
    two(b, tm.month);
    two(b, tm.day);
    Buf.add(b, '-');
    two(b, tm.hour);
    two(b, tm.minute);
    two(b, tm.second);
    at := b.len;
    n := 1;
    while Sys.access(file(Buf.bytes(b), path), {}) = 0 do
        INC(n);
        b.len := at;
        Fmt.write(b, "-{}", [Fmt.int(n)]);
    end;
end;

(* conversations *)

(* c made an empty conversation, with id. *)
proc init*(var c: Conv; id: []const U8);
begin
    c := {};
    c.id := Amsg.keep(id);
    Msgs.init(c.msgs, Heap.heap);
    Strs.init(c.turns, Heap.heap);
end;

(* What c holds given back. *)
proc done*(var c: Conv);
var i: INT; msgs: []Amsg.Msg; turns: [][]U8;
begin
    Str.free(Heap.heap, c.id);
    Str.free(Heap.heap, c.title);
    Str.free(Heap.heap, c.model);
    Str.free(Heap.heap, c.system);
    msgs := Msgs.all(c.msgs);
    for i := 0 to LEN(msgs) - 1 do Amsg.free(msgs[i]); end;
    Msgs.done(c.msgs);
    turns := Strs.all(c.turns);
    for i := 0 to LEN(turns) - 1 do Str.free(Heap.heap, turns[i]); end;
    Strs.done(c.turns);
    c := {};
end;

(* f, one of c's strings, made a copy of s. *)
proc put(var f: []U8; s: []const U8);
begin
    Str.free(Heap.heap, f);
    f := Amsg.keep(s);
end;

proc setTitle*(var c: Conv; title: []const U8);
begin
    put(c.title, title);
end;

proc setModel*(var c: Conv; model: []const U8);
begin
    put(c.model, model);
end;

proc setSystem*(var c: Conv; system: []const U8);
begin
    put(c.system, system);
end;

(* The title an untitled conversation is listed by, into b: its first
   user message as typed, without the attachments its @references
   brought, which follow it after a blank line as <file path="...">
   blocks; on one line; 60 bytes of it at most, cut where a character
   starts. *)
proc autoTitle*(const c: Conv; var b: Buf.Buf);
var msgs: []Amsg.Msg; i, n: INT; s: []const U8;
begin
    msgs := Msgs.all(c.msgs);
    for i := 0 to LEN(msgs) - 1 do
        if msgs[i].role = Amsg.Role.user then
            s := msgs[i].text;
            n := Str.find(s, "\n\n<file path=\"");
            if n >= 0 then s := s[0..n]; end;
            if LEN(s) > 60 then
                n := 60;
                while (n > 0) and (s[n] & 0C0H = 80H) do DEC(n); end;   (* inside a character *)
                s := s[0..n];
            end;
            Str.replace(b, s, "\n", " ");
            return;
        end;
    end;
end;

(* Whether any of msgs has a stamp, which the file then keeps. *)
proc stamped(msgs: []Amsg.Msg): BOOL;
var i: INT;
begin
    for i := 0 to LEN(msgs) - 1 do
        if msgs[i].at > 0 then return true; end;
    end;
    return false;
end;

(* m's stamp, as stamps holds it, added to b. *)
proc stamp(const m: Amsg.Msg; var b: Buf.Buf);
begin
    if m.at = 0 then Buf.str(b, "{}"); return; end;
    Fmt.write(b, `{{"at":{},"model":`, [Fmt.int(INT(m.at))]);
    Amsg.quote(b, m.model);
    Buf.add(b, '}');
end;

(* c as the module's comment shows it, JSON, added to b. *)
proc render*(const c: Conv; var b: Buf.Buf);
var path: Buf.Buf; i: INT; msgs: []Amsg.Msg; turns: [][]U8;
begin
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    Buf.str(b, `{"title":`);
    Buf.str(path, c.title);
    if path.len = 0 then autoTitle(c, path); end;
    Amsg.quote(b, Buf.bytes(path));
    if LEN(c.title) > 0 then
        Buf.str(b, `,"named":true,"model":`);
    else
        Buf.str(b, `,"named":false,"model":`);
    end;
    Amsg.quote(b, c.model);
    if LEN(c.system) > 0 then
        Buf.str(b, `,"system":`);
        Amsg.quote(b, c.system);
    end;
    Buf.str(b, `,"messages":[`);
    msgs := Msgs.all(c.msgs);
    for i := 0 to LEN(msgs) - 1 do
        if i > 0 then Buf.add(b, ','); end;
        Amsg.write(msgs[i], b);
    end;
    Buf.add(b, ']');
    if stamped(msgs) then
        Buf.str(b, `,"stamps":[`);
        for i := 0 to LEN(msgs) - 1 do
            if i > 0 then Buf.add(b, ','); end;
            stamp(msgs[i], b);
        end;
        Buf.add(b, ']');
    end;
    turns := Strs.all(c.turns);
    if LEN(turns) > 0 then
        Buf.str(b, `,"turns":[`);
        for i := 0 to LEN(turns) - 1 do
            if i > 0 then Buf.add(b, ','); end;
            Buf.str(b, turns[i]);
        end;
        Buf.add(b, ']');
    end;
    Buf.add(b, '}');
end;

(* c written to its file. *)
proc save*(const c: Conv): ERROR;
var b, path: Buf.Buf;
begin
    if not fit(c.id) then return BadId; end;
    Buf.init(b, Heap.heap);
    Buf.init(path, Heap.heap);
    defer Buf.done(b);
    defer Buf.done(path);
    render(c, b);
    Buf.str(path, dir());
    Buf.str(path, c.id);
    Buf.str(path, ".json");
    return replace(Buf.bytes(path), Buf.bytes(b));
end;

(* c made the conversation saved as id: BadId if there is none,
   Unreadable if its file isn't one. Its title is the one it was given,
   "" if it was untitled. *)
proc load*(var c: Conv; id: []const U8): ERROR;
var path, text: Buf.Buf; d: Json.Doc; v, msgs, stamps, s, turns: Json.Value; i: INT; t: Buf.Buf; m: ^Amsg.Msg;
begin
    init(c, id);
    if not fit(id) then return BadId; end;
    Buf.init(path, Heap.heap);
    Buf.init(text, Heap.heap);
    Buf.init(t, Heap.heap);
    defer Buf.done(path);
    defer Buf.done(text);
    defer Buf.done(t);
    Buf.str(path, dir());
    Buf.str(path, id);
    Buf.str(path, ".json");
    if Files.load(Buf.bytes(path), text) # 0 then return BadId; end;
    if not Json.init(SYSTEM.ADR(d), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    v := Json.parse(SYSTEM.ADR(d), Buf.bytes(text));
    msgs := Json.member(SYSTEM.ADR(d), v, "messages");
    if Json.kind(SYSTEM.ADR(d), msgs) # Json.Kind.array then return Unreadable; end;
    for i := 0 to Json.len(SYSTEM.ADR(d), msgs) - 1 do
        try Amsg.read(SYSTEM.ADR(d), Json.item(SYSTEM.ADR(d), msgs, i), Msgs.add(c.msgs)^);
    end;
    stamps := Json.member(SYSTEM.ADR(d), v, "stamps");
    for i := 0 to Json.len(SYSTEM.ADR(d), stamps) - 1 do
        if i >= c.msgs.len then break; end;   (* a stamp too many *)
        s := Json.item(SYSTEM.ADR(d), stamps, i);
        m := SYSTEM.ADR(Msgs.all(c.msgs)[i]);
        m^.at, _ := Json.toInt(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), s, "at"));
        m^.model := Amsg.keep(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), s, "model")));
    end;
    turns := Json.member(SYSTEM.ADR(d), v, "turns");
    for i := 0 to Json.len(SYSTEM.ADR(d), turns) - 1 do
        Buf.reset(t);
        Amsg.compact(SYSTEM.ADR(d), Json.item(SYSTEM.ADR(d), turns, i), t);
        Strs.push(c.turns, Amsg.keep(Buf.bytes(t)));
    end;
    if Json.member(SYSTEM.ADR(d), v, "named") = Json.True then
        c.title := Amsg.keep(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), v, "title")));
    end;
    c.model := Amsg.keep(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), v, "model")));
    c.system := Amsg.keep(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), v, "system")));
    return nil;
end;

(* The conversation saved as id given the title title, "" to take one
   from its first message again, all else as it was. *)
proc retitle*(id, title: []const U8): ERROR;
var c: Conv; err: ERROR;
begin
    err := load(c, id);
    defer done(c);
    if err # nil then return err; end;
    setTitle(c, title);
    return save(c);
end;

(* The conversation saved as id given its own system prompt, "" for
   arno's, all else as it was. *)
proc resystem*(id, system: []const U8): ERROR;
var c: Conv; err: ERROR;
begin
    err := load(c, id);
    defer done(c);
    if err # nil then return err; end;
    setSystem(c, system);
    return save(c);
end;

(* The conversation saved as id forgotten: its file removed, and the
   scratch directory that lasts as long as it does. false if none is
   saved as id. *)
proc forget*(id: []const U8): BOOL;
var path, b: Buf.Buf; gone: BOOL;
begin
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    lock();
    defer unlock();
    if (LEN(file(id, path)) = 0) or (Sys.access(Buf.bytes(path), {}) # 0) then return false; end;
    gone := Sys.remove(Buf.bytes(path)) = 0;
    if gone then wipe(scratchPath(id, b)); end;
    return gone;
end;

(* the list *)

(* a lists before b: changed later, or, changed at once, begun later *)
proc before(a, b: Item): BOOL;
begin
    return (a.updated > b.updated) or (a.updated = b.updated) and (Str.cmp(a.id, b.id) > 0);
end;

(* The title of the conversation whose file is text, which save wrote
   if it begins {"title":, into b; false if it isn't one. The title
   comes first, so only it is read, not a file that may be long. *)
proc titleOf(text: []U8; var b: Buf.Buf): BOOL;
var d: Json.Doc; v: Json.Value; end_: INT;
begin
    if not Str.hasPrefix(text, `{"title":`) then return false; end;
    end_ := Str.find(text, `,"named":`);
    if end_ < 0 then return false; end;
    if not Json.init(SYSTEM.ADR(d), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    v := Json.parse(SYSTEM.ADR(d), text[9..end_]);
    if Json.kind(SYSTEM.ADR(d), v) # Json.Kind.string then return false; end;
    Buf.str(b, Json.text(SYSTEM.ADR(d), v));
    return true;
end;

(* s holds t, whatever the case of their ASCII letters. *)
proc holds(s, t: []const U8): BOOL;
var a, b: Buf.Buf;
begin
    Buf.init(a, Heap.heap);
    Buf.init(b, Heap.heap);
    defer Buf.done(a);
    defer Buf.done(b);
    Buf.str(a, s);
    Buf.str(b, t);
    Str.lower(Buf.bytes(a));
    Str.lower(Buf.bytes(b));
    return Str.find(Buf.bytes(a), Buf.bytes(b)) >= 0;
end;

(* The conversations saved, into list, made empty: the one changed last
   first, at most max of them, and only those whose title or id holds
   filter, if it isn't "". /load N and --resume count in this order, so
   1 is the conversation last worked on, not the one last begun. Each
   item's strings are the list's, given back by drop. *)
proc recent*(max: INT; filter: []const U8; var list: Items.Vec);
var d: Sys.Dir; name: []const U8; more: BOOL; all: Items.Vec; items: []Item; info: Sys.Info; e, i: INT;
    path, text, title, both: Buf.Buf;
begin
    Items.init(list, Heap.heap);
    Items.init(all, Heap.heap);
    defer Items.done(all);
    Buf.init(path, Heap.heap);
    Buf.init(text, Heap.heap);
    Buf.init(title, Heap.heap);
    Buf.init(both, Heap.heap);
    defer Buf.done(path);
    defer Buf.done(text);
    defer Buf.done(title);
    defer Buf.done(both);
    if Sys.openDir(d, dir()) < 0 then return; end;
    name, more := Sys.nextEntry(d);
    while more do
        if Str.hasSuffix(name, ".json") then
            info, e := Sys.info(pathOf(name, path));
            if e = 0 then Items.push(all, {id: Amsg.keep(name[0..LEN(name) - 5]), updated: info.mtime}); end;
        end;
        name, more := Sys.nextEntry(d);
    end;
    Sys.closeDir(d);
    items := Items.all(all);
    Order.sort(items);
    for i := 0 to LEN(items) - 1 do
        Buf.reset(text);
        Buf.reset(title);
        Buf.reset(both);
        Buf.str(both, items[i].id);
        Buf.str(both, ".json");
        if (list.len < max) and (Files.load(pathOf(Buf.bytes(both), path), text) = 0)
                and titleOf(Buf.bytes(text), title) then
            Buf.reset(both);
            Buf.str(both, Buf.bytes(title));
            Buf.add(both, ' ');
            Buf.str(both, items[i].id);
            if (LEN(filter) = 0) or holds(Buf.bytes(both), filter) then
                items[i].title := Amsg.keep(Buf.bytes(title));
                Items.push(list, items[i]);
                continue;
            end;
        end;
        Str.free(Heap.heap, items[i].id);
    end;
end;

(* What a list recent made holds given back. *)
proc drop*(var list: Items.Vec);
var i: INT; items: []Item;
begin
    items := Items.all(list);
    for i := 0 to LEN(items) - 1 do
        Str.free(Heap.heap, items[i].id);
        Str.free(Heap.heap, items[i].title);
    end;
    Items.done(list);
end;

(* The usage log, usage.log in arno's directory: a line for each
   request of a model, every session's, the lead's and its workers', as
   a compact JSON object that starts with its time, {"at":SECONDS,...
   (Agent writes it). A line is written with one write to the file
   opened to append, so two sessions' lines never mix, and no lock is
   needed. It holds no text of a conversation. *)

(* line added to the usage log, a newline after it; lost if the file
   can't be written, which costs the human nothing but a row. *)
proc logUse*(line: []const U8);
var path, b: Buf.Buf; fd: INT;
begin
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.str(b, line);
    Buf.add(b, '\n');
    fd := Sys.openMode(pathOf("usage.log", path), {Sys.writing, Sys.creating, Sys.appending}, 180H);
    if fd < 0 then return; end;
    _ := Sys.write(fd, Buf.bytes(b));
    Sys.close(fd);
end;

(* The lines of the usage log made at from or after, and before till
   (0 for no end), as a JSON array, oldest first, into out. A line that
   doesn't start with its time, a write cut short, is passed over. *)
proc uses*(from, till: I64; var out: Buf.Buf);
var path, text: Buf.Buf; rest, line, n: []const U8; more, ok, first: BOOL; at: I64;
begin
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    Buf.init(text, Heap.heap);
    defer Buf.done(text);
    _ := Files.load(pathOf("usage.log", path), text);
    Buf.add(out, '[');
    first := true;
    rest := Buf.bytes(text);
    more := LEN(rest) > 0;
    while more do
        line, rest, more := Str.cut(rest, "\n");
        if not Str.hasPrefix(line, `{"at":`) or not Str.hasSuffix(line, "}") then continue; end;
        n, _, _ := Str.cut(line[6..LEN(line)], ",");
        at, ok := Str.toInt(n);
        if not ok or (at < from) or ((till > 0) and (at >= till)) then continue; end;
        if not first then Buf.add(out, ','); end;
        first := false;
        Buf.str(out, line);
    end;
    Buf.add(out, ']');
end;

(* The test, in build/store, made empty: conversations saved, read
   back, renamed and listed; and, given files, each conversation the
   Pascal arno saved, read and saved again, byte for byte. *)

const Test = "build/store/";

var failed: BOOL;

proc fail(what: []const U8);
begin
    Out.str("Astore: ");
    Out.str(what);
    Out.ln;
    failed := true;
end;

proc expect(what, got, want: []const U8);
begin
    if got = want then return; end;
    fail(what);
    Out.str("  got:  ");
    Out.str(got);
    Out.str("\n  want: ");
    Out.str(want);
    Out.ln;
end;

(* The text of the file saved as id, into b. *)
proc saved(id: []const U8; var b: Buf.Buf): []const U8;
var path: Buf.Buf;
begin
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    Buf.str(path, dir());
    Buf.str(path, id);
    Buf.str(path, ".json");
    Buf.reset(b);
    if Files.load(Buf.bytes(path), b) # 0 then fail(id); end;
    return Buf.bytes(b);
end;

(* Test made, and emptied of what an earlier run left. *)
proc fresh;
var d: Sys.Dir; name: []const U8; more: BOOL; path: Buf.Buf;
begin
    _ := Sys.makeDir("build");
    _ := Sys.makeDir(Test);
    use(Test);
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    if Sys.openDir(d, Test) < 0 then fail("the test's directory"); return; end;
    name, more := Sys.nextEntry(d);
    while more do
        _ := Sys.remove(pathOf(name, path));
        name, more := Sys.nextEntry(d);
    end;
    Sys.closeDir(d);
end;

(* A conversation of one user message, text, saved as id. *)
proc said(id, text: []const U8);
var c: Conv; m: ^Amsg.Msg;
begin
    init(c, id);
    defer done(c);
    setModel(c, "m");
    m := Msgs.add(c.msgs);
    Amsg.init(m^, Amsg.Role.user);
    Amsg.setText(m^, text);
    if save(c) # nil then fail("save"); end;
end;

(* Whether a file save wrote, now, is was, the one the Pascal arno
   wrote; for an untitled conversation from "named" on, since the
   title is taken again at each save, and that arno, before it cut
   the attachments out, took them in; and from "model" on for the
   first few, from before it wrote named at all. *)
proc same(now, was: []const U8; untitled: BOOL): BOOL;
var n, w: INT; from: []const U8;
begin
    if not untitled then return now = was; end;
    from := `,"named":`;
    if Str.find(was, from) < 0 then from := `,"model":`; end;   (* from before there was a named *)
    n := Str.find(now, from);
    w := Str.find(was, from);
    return (n >= 0) and (w >= 0) and (now[n..LEN(now)] = was[w..LEN(was)]);
end;

(* Each of paths, a conversation the Pascal arno saved, loaded from
   where it is and saved in Test: the same bytes. *)
proc compat(paths: []const []const U8);
var i, slash: INT; c: Conv; err: ERROR; from, id: []const U8; was, now: Buf.Buf;
begin
    Buf.init(was, Heap.heap);
    Buf.init(now, Heap.heap);
    defer Buf.done(was);
    defer Buf.done(now);
    for i := 0 to LEN(paths) - 1 do
        slash := Str.findLast(paths[i], "/");
        from := paths[i][0..slash + 1];
        id := paths[i][slash + 1..LEN(paths[i]) - 5];
        use(from);
        err := load(c, id);
        if err = nil then
            _ := saved(id, was);
            use(Test);
            if save(c) # nil then fail("save"); end;
            if not same(saved(id, now), Buf.bytes(was), LEN(c.title) = 0) then fail(paths[i]); end;
        elsif err # Unreadable then
            fail(paths[i]);
        end;
        done(c);
    end;
    use(Test);
end;

proc main*: INT;
var c, back: Conv; b: Buf.Buf; m: ^Amsg.Msg; list: Items.Vec; items: []Item; args: Args.Vec; i: INT;
    long: Buf.Buf;
begin
    fresh;
    Buf.init(b, Heap.heap);
    Buf.init(long, Heap.heap);
    defer Buf.done(b);
    defer Buf.done(long);

    (* an untitled conversation: its title from its first message, as typed *)
    init(c, "20261016-120000");
    setModel(c, "deepseek-v4.1-flash");
    m := Msgs.add(c.msgs);
    Amsg.init(m^, Amsg.Role.user);
    Amsg.setText(m^, "look at\nthis\n\n<file path=\"a.txt\">...</file>");
    m := Msgs.add(c.msgs);
    Amsg.init(m^, Amsg.Role.assistant);
    Amsg.setText(m^, "I see.");
    Strs.push(c.turns, Amsg.keep(`{"at":"2026-10-16 12:00","steps":1,"cost":0.0012}`));
    if save(c) # nil then fail("save"); end;
    expect("an untitled conversation's file", saved("20261016-120000", b),
        `{"title":"look at this","named":false,"model":"deepseek-v4.1-flash","messages":[` +
        `{"role":"user","content":"look at\nthis\n\n<file path=\"a.txt\">...</file>"},` +
        `{"role":"assistant","content":"I see."}],"turns":[{"at":"2026-10-16 12:00","steps":1,"cost":0.0012}]}`);
    if load(back, "20261016-120000") # nil then fail("load"); end;
    expect("an untitled conversation's title, read back", back.title, "");
    expect("its model", back.model, "deepseek-v4.1-flash");
    if (back.msgs.len # 2) or (back.turns.len # 1) then fail("its messages and turns"); end;
    if Msgs.all(back.msgs)[0].at # 0 then fail("a file without stamps, read with none"); end;
    done(back);

    (* titled, with a system prompt of its own *)
    setTitle(c, "a look");
    setSystem(c, "Be brief.");
    Strs.reset(c.turns);
    if save(c) # nil then fail("save"); end;
    expect("a titled conversation's file", saved("20261016-120000", b),
        `{"title":"a look","named":true,"model":"deepseek-v4.1-flash","system":"Be brief.","messages":[` +
        `{"role":"user","content":"look at\nthis\n\n<file path=\"a.txt\">...</file>"},` +
        `{"role":"assistant","content":"I see."}]}`);
    if load(back, "20261016-120000") # nil then fail("load"); end;
    expect("its title, read back", back.title, "a look");
    expect("its system prompt, read back", back.system, "Be brief.");
    done(back);
    done(c);

    if retitle("20261016-120000", "") # nil then fail("retitle"); end;
    if resystem("20261016-120000", "") # nil then fail("resystem"); end;
    expect("retitled and its system prompt dropped", saved("20261016-120000", b),
        `{"title":"look at this","named":false,"model":"deepseek-v4.1-flash","messages":[` +
        `{"role":"user","content":"look at\nthis\n\n<file path=\"a.txt\">...</file>"},` +
        `{"role":"assistant","content":"I see."}]}`);
    said("20261016-120009", "forget me");
    if not forget("20261016-120009") or forget("20261016-120009") then fail("forget"); end;

    (* stamps: kept beside the messages, {} for a message without one,
       and read back *)
    init(c, "20261016-120008");
    m := Msgs.add(c.msgs);
    Amsg.init(m^, Amsg.Role.user);
    Amsg.setText(m^, "hi");
    m^.at := 1794236874;
    m^.model := Amsg.keep("m1");
    m := Msgs.add(c.msgs);
    Amsg.init(m^, Amsg.Role.assistant);
    Amsg.setText(m^, "hello");
    if save(c) # nil then fail("save"); end;
    done(c);
    expect("a stamped conversation's file", saved("20261016-120008", b),
        `{"title":"hi","named":false,"model":"","messages":[{"role":"user","content":"hi"},` +
        `{"role":"assistant","content":"hello"}],"stamps":[{"at":1794236874,"model":"m1"},{}]}`);
    if load(back, "20261016-120008") # nil then fail("load"); end;
    expect("a stamp's model, read back", Msgs.all(back.msgs)[0].model, "m1");
    if (Msgs.all(back.msgs)[0].at # 1794236874) or (Msgs.all(back.msgs)[1].at # 0) then fail("the stamps' times, read back"); end;
    done(back);
    _ := forget("20261016-120008");

    (* a title cut at 60 bytes, back to where a character starts *)
    for i := 1 to 59 do Buf.add(long, 'a'); end;
    Buf.str(long, "é and more");
    said("20261016-120001", Buf.bytes(long));   (* saved within a tick of 120002, below *)
    if not Str.hasPrefix(saved("20261016-120001", b), `{"title":"` + "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" + `","named":false`) then
        fail("a title cut inside a character");
        Out.str(Buf.bytes(b));
        Out.ln;
    end;

    (* the list: changed last first; a filter; only conversations *)
    said("20261016-120002", "find the bug");
    Sys.sleep(20);   (* past the file system's tick, so that the times differ *)
    if retitle("20261016-120000", "") # nil then fail("retitle"); end;
    _ := Files.write(Test + "notes.json", `{"/home/luis/r":["a note"]}`);
    recent(10, "", list);
    items := Items.all(list);
    if LEN(items) # 3 then fail("the list's length"); end;
    if LEN(items) = 3 then
        expect("the list's first, the one changed last", items[0].id, "20261016-120000");
        expect("its title", items[0].title, "look at this");
        expect("the list's second, changed at once with the third but begun later", items[1].id,
            "20261016-120002");
    end;
    drop(list);
    recent(10, "BUG", list);
    if list.len # 1 then fail("a filter"); end;
    drop(list);
    recent(1, "", list);
    if list.len # 1 then fail("max"); end;
    drop(list);

    if load(back, "../escape") # BadId then fail("an id out of the directory"); end;
    done(back);
    if load(back, "notes") # Unreadable then fail("a file that isn't a conversation"); end;
    done(back);

    (* the lock, taken twice, given twice *)
    lock;
    lock;
    unlock;
    if lockFd < 0 then fail("the lock, given back too soon"); end;
    unlock;
    if lockFd >= 0 then fail("the lock, kept"); end;

    Buf.reset(b);
    newId(b);
    if (b.len # 15) or (Buf.bytes(b)[8] # '-') or not Str.hasPrefix(Buf.bytes(b), "20") then
        fail("a new id");
    end;

    Args.init(args, Heap.heap);
    for i := 1 to ARGC() - 1 do Args.push(args, Files.arg(i)); end;
    compat(Args.all(args));
    (* the usage log: a line a request, read back by its time *)
    logUse(`{"at":100,"model":"a"}`);
    logUse(`{"at":200,"model":"b"}`);
    Buf.reset(b);
    uses(150, 0, b);
    expect("the usage log from a time", Buf.bytes(b), `[{"at":200,"model":"b"}]`);
    Buf.reset(b);
    uses(0, 200, b);
    expect("the usage log till a time", Buf.bytes(b), `[{"at":100,"model":"a"}]`);
    (* a text kept for each project, the others' left as they were *)
    Buf.reset(b);
    if (setKeyed("tests.json", "/a", "make check") # nil) or (setKeyed("tests.json", "/b", "x") # nil) or
        (setKeyed("tests.json", "/a", "make test") # nil) or (keyed("tests.json", "/a", b) # "make test") then
        fail("a keyed text set again");
    end;
    Buf.reset(b);
    if (setKeyed("tests.json", "/b", "") # nil) or (keyed("tests.json", "/b", b) # "") or
        (keyed("tests.json", "/a", b) # "make test") or (keyed("nothing.json", "/a", b) # "") then
        fail("a keyed text dropped");
    end;
    if failed then return 1; end;
    return 0;
end;

end Astore.
