(* Agent: a turn of a conversation: the model asked, the tools it
   calls run, and the model asked again with their results, until it
   answers with no call.

   The agent knows nothing of how a turn is shown. It tells its front
   end what happens, the model's text as it comes, each call and its
   result, and asks it what the human says, through a Front: plain mode
   is one, a line at a time; the screen is another, which runs a turn on
   a thread of its own and passes on what it is told to the loop that
   draws.

   The mode, which the human picks, ends the system prompt with its
   instructions, and says whether the tools that change files are
   offered. What each request costs is counted, at its model's list
   price, for /usage and for the turn's budget.

   A turn ends early, the model asked to say where it got to without
   calling more tools, when it has used its steps (maxSteps, config's
   max_steps), when it has spent what config's turn_budget allows, in
   dollars at list price, or when four steps in a row had every call
   fail: a model that keeps failing does better saying what it was
   trying, and being told what to do, than trying again. A read-only call made a second
   time in a turn, with the same arguments, is refused: its result is
   above, and nothing has changed it; any other call might have, and
   clears what was seen.

   Before the first request, the definitions of the names the human's
   message mentions are attached to it (Aahead.prefetch), unless config's
   prefetch is no. Before each request, once the history passes config's
   prune (200,000 bytes unless it says), and each time it has grown by
   half again, the long results of old calls are cut (prune).

   With config's worker naming a model, the model may delegate a step
   to a worker: a turn of the same loop, on the worker's model, over a
   conversation of its own that holds only the brief, with the tools
   less delegate. Only the worker's last answer comes back, as the
   call's result, so that the leading session's history stays as small
   as the reports. What earlier workers of the turn reported goes with
   each brief. A worker is an Agent of its own (Worker), with its own
   provider, arena, connection, budget and seen calls, and a front that
   tells the lead's, saying who speaks around each thing it tells
   (Front.speaker), one worker at a time; what its requests cost is
   added to the lead's sums as well as its own.

   Staged, each worker works in a copy of its own (Astage.fork), made
   from the stage's copy as it stands, numbered, and for its turn the
   zone: its edits go unasked, its shell and check jailed there. When
   it ends, what it changed comes back as one diff, kept in the scratch
   directory as worker-N.diff, its conversation beside it as
   worker-N.json (a saved conversation's format), and summed up in
   the call's result, even when it stopped at its cap; its copy is
   removed. The lead reads the diff and merges it into its own copy
   or drops it (merge). Safe, with no copy to make one from, a worker
   works in the lead's zone, each change asked, as the lead's own.

   Staged, the delegations that begin a step's calls, up to MaxFan of
   them, run side by side (fan), each worker on a thread of its own:
   made ready one after another on the lead's thread, each brief
   without the others' reports, as they start together; each paid at
   most an even share of what the lead's turn has left, so that
   together they can't spend more; handed in, and their results given,
   in the calls' order. The zone and the working directory are the
   process's, and Atools, Alsp and Arun keep state of their own, so a
   worker holds the lead's place (Agent.place), its copy made the
   zone, for all it does but wait for the model: their requests go on
   side by side, and their calls one at a time. A stop stops them all,
   as each asks the front. Safe, workers run one after another, as
   each change is the human's to answer.

   In build mode the session's model leads: before it may change a
   file or delegate, it puts a plan to the human with the plan tool,
   which writes plan.md in the scratch directory and asks them. The
   approval is the conversation's, not the agent's: the last result
   of plan in it says whether its plan was approved, so /new drops it,
   /load brings it back, and a worker, over a conversation of its own,
   is not asked for one: it was delegated to after one. A turn in
   build mode is bounded by build_steps and build_budget in place of
   max_steps and turn_budget, as it carries out a whole plan. A
   worker's turn is bounded by the budget delegate gives it, out of
   what the lead's turn has left, with build_steps only a backstop:
   a cheap model takes many steps for little.

   Each call's work is done in an arena, reset after the call: its
   result is copied into the conversation, which keeps its own memory
   from Heap.

   Each turn begins by asking Apeer whether an editor is reachable, which
   decides whether its tools are offered, and ends by stopping the
   language servers its edits started (Alsp).

   Depends on Aprompt (the system prompt), Aahead, Aprice, Atools, Alsp, Apeer,
   Afence, Astage (a worker's copy), Awire, Amsg, Astore and Thread.
   Leaves out forking calls that only read, to run them side by side,
   and workers' calls side by side, which would need a zone and a
   working directory for each. *)
module Agent;
import Aprompt, Aahead, Aprice, Atools, Alsp, Apeer, Afence, Astage, Awire, Amsg, Astore, Http, Json, Buf, Str, Sys, Files, Heap, Arena, Rt, Fmt, Out,
    Thread, Msgs := Vec(Amsg.Msg), Calls := Vec(Amsg.Call), Strs := Vec([]U8), Tools := Vec(Awire.Tool);
import SYSTEM;

type
    (* What the agent tells its front end, and asks of it. Any
       procedure may be nil, and each gets arg. *)
    Front* = record
        text*: proc(s: []const U8; arg: ^U8);            (* a piece of the model's text, as it comes *)
        call*: proc(name, args: []const U8; arg: ^U8);   (* a tool call, about to run *)
        result*: proc(name, res: []const U8; arg: ^U8);  (* its result *)
        note*: proc(s: []const U8; arg: ^U8);            (* what arno says of the turn, a line *)
        ask*: Atools.Ask;                          (* the human asked; nil if nobody is there *)
        why*: Atools.Why;                          (* after a no, why; nil not to ask *)
        stopped*: proc: BOOL;                      (* whether the human said to stop *)
        counted*: proc(arg: ^U8);                  (* a request ended, what it cost counted *)
        edit*: proc(text: []const U8): ([]const U8, BOOL);   (* text, as the human edited it; nil if they can't *)
        speaker*: proc(n: INT; model: []const U8; arg: ^U8);   (* who speaks from now on: 0 the lead, N worker N, said around each thing a worker tells, with its model once as it starts and "" after; nil if it is not asked *)
        arg*: ^U8;
    end;

    Agent* = record
        prov*: ^Awire.Prov;
        front*: Front;
        maxSteps*: INT;
        prune*: INT;          (* bytes of history before old results are cut; 0 never *)
        budget*: F64;         (* dollars a turn may spend, at list price; 0 for no limit *)
        buildSteps*: INT;     (* a turn's steps in build mode, in place of maxSteps *)
        buildBudget*: F64;    (* a turn's dollars in build mode, in place of budget; 0 for no limit *)
        prefetch*: BOOL;      (* definitions attached to the human's message *)
        worker*: []const U8;        (* the model a worker runs on when none is named; "" for no workers *)
        mode*: Aprompt.Mode;
        working: BOOL;        (* this is a worker's *)
        lead: ^Agent;         (* a worker's lead, whose sums its requests add to and whose place it holds; nil for the lead *)
        who: INT;             (* a worker's number, as the front is told it *)
        copy: ^Astage.Work;   (* a staged worker's copy, made the zone each time it takes the place; nil for none *)
        place: Thread.Mutex;  (* the lead's: held by the worker that does anything but wait for the model *)
        talk: Thread.Mutex;   (* the lead's: held by the worker telling its front *)
        stopAt: F64;          (* spent at which the lead's turn has used its budget; 0 for no limit *)
        allowance: F64;       (* dollars a worker may spend; 0 for no limit *)
        reports: Strs.Vec;    (* what the turn's workers reported, each its task and its report, from Heap *)
        forks: INT;           (* the number of the last worker given a copy of its own *)
        kept: INT;            (* the number of the last report kept in the scratch *)
        prompt*: Aprompt.Prompt;
        used*: Awire.Usage;   (* what the requests so far cost, summed *)
        requests*: INT;       (* how many there were *)
        spent*: F64;          (* dollars, at list price, of those priced *)
        unpriced*: INT;       (* those whose model has no known price *)
        held*: I64;           (* tokens the conversation's last request held, in and out; 0 if unknown *)
        human: Atools.Human;  (* the front's ask and why *)
        client: Http.Client;
        mem: Arena.Arena;     (* a call's work *)
        seen: Buf.Buf;        (* the read-only calls of this turn, "\0" then each "name\1args\0" *)
    end;

    (* A delegation: the worker, made ready by prepare, and what the
       lead needs of it once it has worked. *)
    Worker = record
        agent: Agent;         (* the worker's own; its prompt the lead's, only read *)
        prov: Awire.Prov;     (* the lead's, on the worker's model *)
        conv: Astore.Conv;    (* the brief, then the worker's turn *)
        copy: Astage.Work;    (* its copy, while staged *)
        n: INT;               (* the copy's number; 0 for a worker in the lead's zone *)
        doc: Json.Doc;        (* delegate's arguments, parsed in the lead's arena *)
        model: []const U8;    (* the worker's model *)
        task: []const U8;     (* its task, as delegate gave it *)
        why: Buf.Buf;         (* why its last request failed *)
        err: ERROR;           (* how its turn ended *)
        thread: ^Thread.Thread;   (* the thread it works on; nil for the lead's *)
    end;

const
    MaxSteps* = 30;     (* a turn's steps, unless config's max_steps says *)
    BuildSteps* = 200;   (* a build turn's steps, unless config's build_steps says *)
    BuildBudget* = 3.00;   (* a build turn's dollars, unless config's build_budget says *)
    Prune* = 200000;    (* bytes of history before old results are cut, unless config's prune says *)
    KeepSteps = 4;      (* the last steps whose results prune leaves whole *)
    KeepHead = 30;      (* lines of a cut result kept, *)
    KeepBytes = 1500;   (* and about as many bytes at most *)
    CutMark = "\n[... ";   (* what starts the note a cut result ends with *)
    FailSteps = 4;      (* steps in a row whose every call failed, before a turn hands back *)
    CallMemory = 256 * 1024 * 1024;   (* the arena's size: pages are only taken as used *)

    (* what a turn that ran out of steps asks for *)
    StepsAsk = "You have used every tool step this turn allows. Do not call any tools. In a few " +
        "lines, say what is done, what you found, and what you will do next. Ask me a " +
        "question only if you cannot go on without the answer; never ask leave to continue.";
    (* what a turn whose last steps all failed asks for *)
    StuckAsk = "Your last calls have all failed. Do not call any tools. In a few lines, say what you " +
        "were trying, what the errors say, and what you will do differently. Ask me a " +
        "question only if you cannot go on without the answer.";
    (* what a turn over its budget asks for *)
    BudgetAsk = "This turn has spent what the human allows a turn. Do not call any tools. In a few " +
        "lines, say what is done, what is not, and what you would do next.";
    (* what /compact asks for, and what stands for the reply to the summary *)
    CompactAsk* = "Summarize our conversation so far so that it can replace the full history: I will continue " +
        "working with you from your summary alone. Include the goal, decisions made and why, files touched and " +
        "their current state, what is done, what is left, and any facts or preferences I stated. Leave out tool " +
        "output, dead ends and pleasantries. Use plain prose and short lists, no preamble. Do not call any tools.";
    CompactAck* = "Understood. I have the summary and will continue from it.";
    (* the end of a worker's system prompt, in place of the mode's *)
    WorkerText = "# Worker\nYou are a worker: the session that leads gave you one task, the message below, " +
        "and sees only your final report. Do that task completely: read what you need, make the changes, " +
        "build, and run check. Earlier workers' reports, when the brief has them, are what is known: use the " +
        "units and findings they name rather than finding or writing them again. Do not ask questions; if " +
        "something blocks you, stop and say what. End with a short report: what you did, what you read and " +
        "found that the next worker should know, what is left, the files you changed, and check's verdict. " +
        "Write it in the brief's language, whatever language you think in.";
    (* added to it while staged *)
    WorkerCopy = " Your copy was made for this task alone: when you end, the session that leads sees what you " +
        "changed as one diff, and merges it or not.";
    (* Workers run side by side at most: each holds a copy of the project
       and a connection to the provider, whose rate limit they share. *)
    MaxFan = 4;
    MaxReports = 4;     (* earlier reports a brief carries, the newest *)
    MaxReport = 4000;   (* bytes of each *)
    Repeated = "not run: this exact call was already made in this turn and its result " +
        "is above. Use that result, or try something different.";
    Interrupted = "not run: interrupted by the human";
    Approved = "approved:";   (* what the result of a plan the human approved starts with *)
    (* what a change or a delegation is told before a plan is approved *)
    Unplanned = "not run: in build mode nothing is changed or delegated before the human approves a plan. " +
        "Settle the goal with them, then call plan with it.";

(* a made ready to run turns against prov, telling front; the fence
   set from the working directory. *)
proc init*(var a: Agent; prov: ^Awire.Prov; front: Front);
begin
    a := {prov: prov, front: front, maxSteps: MaxSteps, prune: Prune, prefetch: true, buildSteps: BuildSteps,
        buildBudget: BuildBudget,
        human: {ask: front.ask, why: front.why, stopped: front.stopped, arg: front.arg}};
    Strs.init(a.reports, Heap.heap);
    Awire.initClient(a.client);
    if not Arena.init(a.mem, CallMemory) then Rt.stop("arno: out of memory"); end;
    Buf.init(a.seen, Heap.heap);
    Afence.init;
end;

proc note(const a: Agent; s: []const U8);
begin
    if a.front.note # nil then a.front.note(s, a.front.arg); end;
end;

proc stopped(const a: Agent): BOOL;
begin
    return (a.front.stopped # nil) and a.front.stopped();
end;

(* What lasts the session found: the context files, as config's
   context_files says (mode), and the project's map, unless map is
   false. *)
proc prepare*(var a: Agent; mode: []const U8; map: BOOL);
begin
    Aprompt.load(a.prompt, mode, map, a.human, a.front.note);
end;

(* The system prompt of c's next request, made again in sys: it ends
   with the mode's instructions, or a worker's. *)
proc system(var a: Agent; const c: Astore.Conv; var sys: Buf.Buf);
begin
    Buf.reset(sys);
    Aprompt.write(a.prompt, c, a.prov^, a.mode, SYSTEM.ADR(a.mem.base), a.front.note, a.front.arg, sys);
    Buf.str(sys, "\n\n");
    if a.working then
        Buf.str(sys, WorkerText);
        if LEN(Afence.stage) > 0 then Buf.str(sys, WorkerCopy); end;
    else
        Buf.str(sys, "# Mode\n");
        Buf.str(sys, Aprompt.Modes[INT(a.mode)].text);
    end;
    Arena.reset(a.mem);
end;

(* A lookup prefetch made, shown as the def call it stands in for. *)
proc prefetched(name, args, res: []const U8; arg: ^U8);
var a: ^Agent;
begin
    a := ^Agent(arg);
    if a^.front.call # nil then a^.front.call(name, args, a^.front.arg); end;
    if a^.front.result # nil then a^.front.result(name, res, a^.front.arg); end;
end;

(* The definitions of the names in the text of c's last message, the
   human's, attached to it. *)
proc attach(var a: Agent; var c: Astore.Conv);
var m: ^Amsg.Msg; b: Buf.Buf; n: INT;
begin
    m := SYSTEM.ADR(Msgs.all(c.msgs)[c.msgs.len - 1]);
    Buf.init(b, SYSTEM.ADR(a.mem.base));
    Buf.str(b, m^.text);
    n := b.len;
    Aahead.prefetch(m^.text, SYSTEM.ADR(a.mem.base), prefetched, ^U8(SYSTEM.ADR(a)), b);
    if b.len > n then Amsg.setText(m^, Buf.bytes(b)); end;
    Arena.reset(a.mem);
end;

(* The bytes of c's messages' text, the measure prune goes by. *)
proc size(const c: Astore.Conv): INT;
var m: []Amsg.Msg; i, n: INT;
begin
    m := Msgs.all(c.msgs);
    n := 0;
    for i := 0 to LEN(m) - 1 do INC(n, LEN(m[i].text)); end;
    return n;
end;

(* The long results of the calls older than the last KeepSteps steps
   cut to their first lines and a note, in c itself, and so in the
   saved conversation too. Each step resends the whole history, and
   most of what a long turn resends is stale: listings, files read edits
   ago, test runs since passed. Cutting it all at once, rarely, rather
   than a little every step, is for the provider's prompt cache, which
   matches only a prefix that hasn't changed, and bills what it matches
   at a fraction of the price: between cuts the prefix stays put. A
   result already cut is left as it is, and so is a worker's report,
   which is no listing gone stale but what the work found: a lead that
   lost them wrote its answer from their first lines. *)
proc prune(var a: Agent; var c: Astore.Conv);
var m: []Amsg.Msg; b: Buf.Buf; t, line, rest: []const U8; i, k, steps, n: INT;
begin
    m := Msgs.all(c.msgs);
    steps := 0;
    i := LEN(m) - 1;
    while (i >= 0) and (steps < KeepSteps) do
        if (m[i].role = Amsg.Role.assistant) and (m[i].calls.len > 0) then INC(steps); end;
        DEC(i);
    end;
    Buf.init(b, SYSTEM.ADR(a.mem.base));
    for k := 0 to i do
        t := m[k].text;
        if (m[k].role # Amsg.Role.tool) or (LEN(t) < 2000) or (Str.find(t, CutMark) >= 0) or (m[k].tool = "delegate") then
            continue;
        end;
        Buf.reset(b);
        rest := t;
        n := 0;
        while (LEN(rest) > 0) and (n < KeepHead) and (b.len < KeepBytes) do
            line, rest, _ := Str.cut(rest, "\n");
            Buf.str(b, line);
            if LEN(rest) > 0 then Buf.add(b, '\n'); end;
            INC(n);
        end;
        if LEN(rest) = 0 then continue; end;
        Fmt.write(b, "{}{} more bytes, cut from the history as old; make the call again to see them]",
            [Fmt.str(CutMark), Fmt.int(LEN(rest))]);
        Amsg.setText(m[k], Buf.bytes(b));
    end;
    Arena.reset(a.mem);
end;

(* The lead's place taken by worker a, and its copy, if it has one,
   made the zone and the working directory. *)
proc take(var a: Agent);
begin
    Thread.lock(a.lead^.place);
    if a.copy # nil then Astage.visit(a.copy^); end;
end;

(* s copied into a's arena. *)
proc copied(var a: Agent; s: []const U8): []const U8;
var c: []U8; ok: BOOL;
begin
    c, ok := Str.copy(SYSTEM.ADR(a.mem.base), s);
    if not ok then Rt.stop("arno: out of memory"); end;
    return c;
end;

(* tools copied into a's arena: Atools makes its list again for each
   request, and a worker's request goes on while others make theirs. *)
proc owned(var a: Agent; tools: []const Awire.Tool): []const Awire.Tool;
var t: Tools.Vec; i: INT;
begin
    Tools.init(t, SYSTEM.ADR(a.mem.base));
    for i := 0 to LEN(tools) - 1 do
        Tools.push(t, {name: copied(a, tools[i].name), description: copied(a, tools[i].description),
            params: copied(a, tools[i].params)});
    end;
    return Tools.all(t);
end;

(* What a request used, u, and cost, in dollars if priced, added to a's sums. *)
proc count(var a: Agent; const u: Awire.Usage; cost: F64; priced: BOOL);
begin
    INC(a.used.inp, u.inp);
    INC(a.used.cached, u.cached);
    INC(a.used.written, u.written);
    INC(a.used.out, u.out);
    INC(a.requests);
    if priced then a.spent := a.spent + cost; else INC(a.unpriced); end;
end;

(* The model asked, once, with c's messages; its reply added to them,
   unless the request failed with nothing said. What it cost is
   counted, at the price of the model asked, a worker's or the lead's,
   and a worker's in the lead's sums too. A worker lets the lead's
   place go while it waits for the model. *)
proc ask(var a: Agent; var c: Astore.Conv; sys: []const U8; var why: Buf.Buf): ERROR;
var r: Awire.Request; reply: Amsg.Msg; u: Awire.Usage; price: Aprice.Price; priced: BOOL; cost: F64; err: ERROR;
begin
    r := {prov: a.prov, client: SYSTEM.ADR(a.client), system: sys, msgs: Msgs.all(c.msgs),
        tools: Atools.offered(not a.working and (LEN(a.worker) > 0), a.mode in {Aprompt.chat, Aprompt.pair, Aprompt.build},
            not a.working and (a.mode = Aprompt.build)),
        emit: a.front.text, arg: a.front.arg, stopped: a.front.stopped};
    if a.working then
        r.tools := owned(a, r.tools);
        Thread.unlock(a.lead^.place);
    end;
    err := Awire.chat(r, reply, u, why);
    if a.working then
        take(a);
        Arena.reset(a.mem);
    end;
    price, priced := Aprice.price(a.prov^);
    cost := 0.0;
    if priced then cost := Aprice.cost(price, u); end;
    count(a, u, cost, priced);
    if a.working then count(a.lead^, u, cost, priced); end;
    (* a worker's context is not the conversation's *)
    if not a.working and (u.inp + u.out > 0) then a.held := u.inp + u.out; end;
    if a.front.counted # nil then a.front.counted(a.front.arg); end;
    if (err = nil) or (LEN(reply.text) > 0) then
        Msgs.push(c.msgs, reply);
    else
        Amsg.free(reply);
    end;
    return err;
end;

(* Every call seen forgotten: seen holds only the NUL each key
   starts with, so that a key is never found inside another. *)
proc forget(var a: Agent);
begin
    Buf.reset(a.seen);
    Buf.add(a.seen, 0);
end;

(* Whether the call was made already this turn, by a tool that only
   reads; noted if not. A call to any other tool forgets the rest. *)
proc again(var a: Agent; name, args: []const U8): BOOL;
var key: Buf.Buf; seen: BOOL;
begin
    if not Atools.readOnly(name) then
        forget(a);
        return false;
    end;
    Buf.init(key, Heap.heap);
    defer Buf.done(key);
    Buf.add(key, 0);
    Buf.str(key, name);
    Buf.add(key, 1);
    Buf.str(key, args);
    Buf.add(key, 0);
    seen := Str.find(Buf.bytes(a.seen), Buf.bytes(key)) >= 0;
    if not seen then Buf.str(a.seen, Buf.bytes(key)[1..key.len]); end;
    return seen;
end;

(* Whether a result says its call failed: an error, or not run. A
   call the human declined didn't fail; the model was told no. *)
proc failed(res: []const U8): BOOL;
begin
    return Str.hasPrefix(res, "error") or Str.hasPrefix(res, "not run");
end;

proc min(a, b: INT): INT;
begin
    if a < b then return a; end;
    return b;
end;

proc turn*(var a: Agent; var c: Astore.Conv; var why: Buf.Buf): ERROR; forward;

(* The brief of a worker, from delegate's arguments p, added to b: the
   task, the files, when it is done, its role's instructions (role, ""
   for none), and what earlier workers of the turn reported. *)
proc brief(const a: Agent; const p: Atools.Args; task, role: []const U8; var b: Buf.Buf);
var files: [][]const U8; reports: [][]U8; i: INT;
begin
    Fmt.write(b, "Task: {}", [Fmt.str(task)]);
    files := Atools.list(p, "files");
    if LEN(files) > 0 then Buf.str(b, "\n\nFiles:"); end;
    for i := 0 to LEN(files) - 1 do Fmt.write(b, "\n- {}", [Fmt.str(files[i])]); end;
    if LEN(Str.trim(Atools.str(p, "done_when"))) > 0 then
        Fmt.write(b, "\n\nDone when: {}", [Fmt.str(Str.trim(Atools.str(p, "done_when")))]);
    end;
    if LEN(role) > 0 then Fmt.write(b, "\n\nYour role, standing instructions for this kind of work:\n{}", [Fmt.str(role)]); end;
    (* what earlier workers of this turn found goes along, so that the
       next one needn't find it again: a worker blind to a survey's
       findings wrote its own rule for what a unit already did *)
    reports := Strs.all(a.reports);
    if LEN(reports) > 0 then Buf.str(b, "\n\nWhat earlier workers on this task reported:"); end;
    for i := LEN(reports) - MaxReports to LEN(reports) - 1 do
        if i >= 0 then
            Buf.str(b, "\n\n---\n");
            Buf.str(b, reports[i][0..min(LEN(reports[i]), MaxReport)]);
        end;
    end;
end;

(* A worker's front *)

(* The lead's front, to be told by the worker whose Agent is at arg:
   its talk taken, so that workers tell it one at a time, and the
   worker said to speak. *)
proc speak(arg: ^U8): ^Agent;
var w, l: ^Agent;
begin
    w := ^Agent(arg);
    l := w^.lead;
    Thread.lock(l^.talk);
    if l^.front.speaker # nil then l^.front.speaker(w^.who, "", l^.front.arg); end;
    return l;
end;

(* The lead's front l told, by speak, the lead said to speak again, and
   its talk let go. *)
proc spoken(l: ^Agent);
begin
    if l^.front.speaker # nil then l^.front.speaker(0, "", l^.front.arg); end;
    Thread.unlock(l^.talk);
end;

(* The worker's front, each the lead's told between speak and spoken:
   a piece of its text, *)
proc workerText(s: []const U8; arg: ^U8);
var l: ^Agent;
begin
    l := speak(arg);
    if l^.front.text # nil then l^.front.text(s, l^.front.arg); end;
    spoken(l);
end;

(* a call it makes, *)
proc workerCall(name, args: []const U8; arg: ^U8);
var l: ^Agent;
begin
    l := speak(arg);
    if l^.front.call # nil then l^.front.call(name, args, l^.front.arg); end;
    spoken(l);
end;

(* its result, *)
proc workerResult(name, res: []const U8; arg: ^U8);
var l: ^Agent;
begin
    l := speak(arg);
    if l^.front.result # nil then l^.front.result(name, res, l^.front.arg); end;
    spoken(l);
end;

(* what arno says of its turn, *)
proc workerNote(s: []const U8; arg: ^U8);
var l: ^Agent;
begin
    l := speak(arg);
    if l^.front.note # nil then l^.front.note(s, l^.front.arg); end;
    spoken(l);
end;

(* and a request of its counted. *)
proc workerCounted(arg: ^U8);
var l: ^Agent;
begin
    l := speak(arg);
    if l^.front.counted # nil then l^.front.counted(l^.front.arg); end;
    spoken(l);
end;

(* A worker *)

(* w given what it needs to work for a: its own agent, on a copy of the
   lead's provider, with an arena, a connection and a front of its own,
   its conversation and the memory its arguments are parsed in. *)
proc open(var a: Agent; var w: Worker);
var f: Front;
begin
    w.prov := a.prov^;
    f := {text: workerText, call: workerCall, result: workerResult, note: workerNote, ask: a.front.ask,
        why: a.front.why, stopped: a.front.stopped, counted: workerCounted, arg: ^U8(SYSTEM.ADR(w.agent))};
    w.agent := {prov: SYSTEM.ADR(w.prov), front: f, prune: a.prune, buildSteps: a.buildSteps, worker: a.worker,
        mode: a.mode, working: true, lead: SYSTEM.ADR(a), prompt: a.prompt, human: a.human};
    Awire.initClient(w.agent.client);
    if not Arena.init(w.agent.mem, CallMemory) then Rt.stop("arno: out of memory"); end;
    Buf.init(w.agent.seen, Heap.heap);
    Astore.init(w.conv, "worker");
    if not Json.init(SYSTEM.ADR(w.doc), SYSTEM.ADR(a.mem.base)) then Rt.stop("arno: out of memory"); end;
    Buf.init(w.why, Heap.heap);
end;

(* What open gave w let go. *)
proc close(var w: Worker);
begin
    Http.doneClient(w.agent.client);
    Arena.done(w.agent.mem);
    Buf.done(w.agent.seen);
    Astore.done(w.conv);
    Json.done(SYSTEM.ADR(w.doc));
    Buf.done(w.why);
end;

(* Worker w's turn over its conversation, whose one message is its
   brief: the same loop, on its model, which prices it and sets its
   effort as the provider's params say of it. It runs on a thread of
   its own, or on the lead's, holding the lead's place but while it
   waits for the model (ask). *)
proc labour(arg: ^U8);
var w: ^Worker; l: ^Agent;
begin
    w := ^Worker(arg);
    (* the front told the worker's model once, for its label *)
    l := speak(^U8(SYSTEM.ADR(w^.agent)));
    if l^.front.speaker # nil then l^.front.speaker(w^.agent.who, w^.model, l^.front.arg); end;
    spoken(l);
    take(w^.agent);
    w^.err := turn(w^.agent, w^.conv, w^.why);
    Thread.unlock(w^.agent.lead^.place);
end;

(* How many steps the worker took over w: its requests answered. *)
proc steps(const w: Astore.Conv): INT;
var msgs: []Amsg.Msg; i, n: INT;
begin
    msgs := Msgs.all(w.msgs);
    n := 0;
    for i := 0 to LEN(msgs) - 1 do
        if msgs[i].role = Amsg.Role.assistant then INC(n); end;
    end;
    return n;
end;

(* report kept in the scratch directory as report-K.md, the first K
   free, its path into path, for the human to read: a worker's report
   can't be had again by calling again. false if there is no scratch or
   it can't be written. *)
proc keepReport(var a: Agent; report: []const U8; var path: Buf.Buf): BOOL;
var e: INT;
begin
    if LEN(Afence.scratch) = 0 then return false; end;
    repeat
        INC(a.kept);
        Buf.reset(path);
        Fmt.write(path, "{}/report-{}.md", [Fmt.str(Afence.scratch), Fmt.int(a.kept)]);
        _, e := Sys.info(Buf.bytes(path));
    until e # 0;
    return Files.write(Buf.bytes(path), report);
end;

(* Worker n's conversation w kept in the scratch directory as
   worker-n.json, so that what it read can be checked once it has
   reported; its path into path. false if it can't be written. *)
proc keepWorker(n: INT; const w: Astore.Conv; var path: Buf.Buf): BOOL;
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Astore.render(w, b);
    Buf.reset(path);
    Fmt.write(path, "{}/worker-{}.json", [Fmt.str(Afence.scratch), Fmt.int(n)]);
    return Files.write(Buf.bytes(path), Buf.bytes(b));
end;

(* What worker w, numbered n, 0 for one in the lead's zone, reported,
   added to out, and kept with its task for the next workers' briefs.
   One that stopped at its cap, its steps used, is said to have. false
   if there was no report. The report line names the worker's model. *)
proc told(var a: Agent; const w: Worker; var out: Buf.Buf): BOOL;
var msgs: []Amsg.Msg; report: []const U8; b, path: Buf.Buf; cost, allowance: F64;
begin
    msgs := Msgs.all(w.conv.msgs);
    report := "";
    if msgs[LEN(msgs) - 1].role = Amsg.Role.assistant then report := Str.trim(msgs[LEN(msgs) - 1].text); end;
    if LEN(report) = 0 then return false; end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Fmt.write(b, "{}\n\n{}", [Fmt.str(w.task), Fmt.str(report)]);
    Strs.push(a.reports, Amsg.keep(Buf.bytes(b)));
    cost := w.agent.spent;
    allowance := w.agent.allowance;
    (* a turn at its cap hands back once more, a step past it *)
    if steps(w.conv) > a.buildSteps then
        Fmt.write(out, "The worker stopped at its cap of {} steps; its report says where it got to: brief the " +
            "next worker to go on from there.\n", [Fmt.int(a.buildSteps)]);
    elsif (allowance > 0.0) and (cost > allowance) then
        Fmt.write(out, "The worker stopped at its budget of ${}; its report says where it got to: brief the " +
            "next worker to go on from there.\n", [Fmt.real(allowance, 2)]);
    end;
    Buf.str(out, "worker ");
    if w.n > 0 then Fmt.write(out, "{} ", [Fmt.int(w.n)]); end;
    Fmt.write(out, "({}) report ({} steps, ${})", [Fmt.str(w.model), Fmt.int(steps(w.conv)), Fmt.real(cost, 2)]);
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    if keepReport(a, report, path) then Fmt.write(out, ", kept in {}", [Fmt.str(Buf.bytes(path))]); end;
    (* a worker with no number, in the lead's zone, keeps no conversation *)
    if (w.n > 0) and keepWorker(w.n, w.conv, path) then Fmt.write(out, ", conversation in {}", [Fmt.str(Buf.bytes(path))]); end;
    Fmt.write(out, ":\n{}", [Fmt.str(report)]);
    return true;
end;

(* The path of worker n's diff, in the scratch directory, into b. *)
proc diffPath(n: INT; var b: Buf.Buf): []const U8;
begin
    Buf.reset(b);
    Fmt.write(b, "{}/worker-{}.diff", [Fmt.str(Afence.scratch), Fmt.int(n)]);
    return Buf.bytes(b);
end;

(* The number of the next worker given a copy: one past the last, and
   past any whose diff the scratch directory still holds, left by an
   earlier arno on this conversation. *)
proc nextWorker(var a: Agent): INT;
var b: Buf.Buf;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    INC(a.forks);
    while Sys.access(diffPath(a.forks, b), {}) = 0 do INC(a.forks); end;
    return a.forks;
end;

(* Worker n's work gathered from its copy, w, which goes: its diff kept
   in the scratch directory as worker-n.diff, and what it changed, a
   line a file, added to out, with how to merge it. *)
proc handIn(n: INT; var w: Astage.Work; var out: Buf.Buf);
var diff, stat, why, path: Buf.Buf; files: INT;
begin
    Buf.init(diff, Heap.heap);
    defer Buf.done(diff);
    Buf.init(stat, Heap.heap);
    defer Buf.done(stat);
    Buf.init(why, Heap.heap);
    defer Buf.done(why);
    Buf.init(path, Heap.heap);
    defer Buf.done(path);
    files := Astage.gather(w, diff, stat, why);
    if files < 0 then
        Fmt.write(out, "\n\nWorker {}'s changes cannot be told: {}", [Fmt.int(n), Fmt.str(Buf.bytes(why))]);
    elsif files = 0 then
        Fmt.write(out, "\n\nWorker {} changed no file.", [Fmt.int(n)]);
    elsif not Files.write(diffPath(n, path), Buf.bytes(diff)) then
        Fmt.write(out, "\n\nWorker {}'s changes are lost: cannot write {}", [Fmt.int(n), Fmt.str(Buf.bytes(path))]);
    else
        Fmt.write(out, "\n\nWorker {} changed {} file(s), in a copy of its own:\n{}The diff is {}. Read it, then " +
            "call merge with worker {} and apply true to bring it into your copy, or apply false to drop it.",
            [Fmt.int(n), Fmt.int(files), Fmt.str(Buf.bytes(stat)), Fmt.str(Buf.bytes(path)), Fmt.int(n)]);
    end;
end;

(* Worker w, opened, made ready for delegate's arguments args, one of
   k that start together: its brief, its model, its budget, and its
   copy while staged, left for the lead's until it works. false if it
   can't be, why added to out. *)
proc ready(var a: Agent; args: []const U8; k: INT; var w: Worker; var out: Buf.Buf): BOOL;
var p: Atools.Args; m: ^Amsg.Msg; b, role: Buf.Buf; named: []const U8; n: INT; budget: F64;
begin
    if a.working then
        Buf.str(out, "error: a worker cannot delegate");
        return false;
    end;
    if LEN(a.worker) = 0 then
        Buf.str(out, "error: there is no worker model; the human sets them with workers = MODEL ... in the config");
        return false;
    end;
    if not Atools.parse(SYSTEM.ADR(w.doc), SYSTEM.ADR(a.mem.base), args, p) then
        Buf.str(out, "error: the arguments must be one JSON object, as the tool's schema says");
        return false;
    end;
    w.task := Str.trim(Atools.str(p, "task"));
    if LEN(w.task) = 0 then
        Buf.str(out, "error: task is required: what the worker is to do, in full");
        return false;
    end;
    w.model := Str.trim(Atools.str(p, "model"));
    if LEN(w.model) = 0 then w.model := a.worker; end;
    if not Atools.isWorker(w.model) then
        Fmt.write(out, "error: {} is not a worker model; the models are: {}", [Fmt.str(w.model), Fmt.str(Atools.workerModels())]);
        return false;
    end;
    w.prov.model := w.model;
    (* a worker is paid out of the lead's turn: what it asks for, at most
       its share of what the turn has left, and all of that share when it
       asks for nothing; so workers that start together can't overspend *)
    budget := Atools.real(p, "budget", 0.0);
    if a.stopAt > 0.0 then
        if a.spent >= a.stopAt then
            Buf.str(out, "error: your turn's budget is spent, so no worker can be paid for: say where you got to");
            return false;
        end;
        if (budget <= 0.0) or (budget > (a.stopAt - a.spent) / F64(k)) then budget := (a.stopAt - a.spent) / F64(k); end;
    end;
    w.agent.allowance := budget;
    Buf.init(role, Heap.heap);
    defer Buf.done(role);
    named := Str.trim(Atools.str(p, "role"));
    if (LEN(named) > 0) and not Atools.roleText(named, role) then
        Fmt.write(out, "error: {} is not a role; the roles are: {}", [Fmt.str(named), Fmt.str(Atools.roleNames())]);
        return false;
    end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    m := Msgs.add(w.conv.msgs);
    Amsg.init(m^, Amsg.Role.user);
    brief(a, p, w.task, Buf.bytes(role), b);
    Amsg.setText(m^, Buf.bytes(b));

    (* staged, the worker gets a copy of its own; safe, there is none to
       make it from, and it works in the lead's zone *)
    if (LEN(Afence.stage) > 0) and (LEN(Afence.scratch) > 0) then
        n := nextWorker(a);
        if not Astage.fork(n, w.copy, w.why) then
            Fmt.write(out, "error: cannot make the worker's copy: {}", [Fmt.str(Buf.bytes(w.why))]);
            return false;
        end;
        Astage.leave(w.copy);   (* the next is forked from the lead's copy; labour comes back *)
        w.n := n;
        w.agent.copy := SYSTEM.ADR(w.copy);
        w.agent.who := n;
    else
        INC(a.forks);   (* in the lead's zone it is still a worker, and has a number *)
        w.agent.who := a.forks;
    end;
    Buf.reset(b);
    Fmt.write(b, "worker {}: {}", [Fmt.str(w.model), Fmt.str(w.task[0..min(LEN(w.task), 120)])]);
    note(a, Buf.bytes(b));
    return true;
end;

(* Worker w's work over: its report, or why there is none, added to
   out, and what it changed in its copy handed in. *)
proc finish(var a: Agent; var w: Worker; var out: Buf.Buf);
begin
    if not told(a, w, out) then
        Fmt.write(out, "error: the worker ended without a report, after {} steps", [Fmt.int(steps(w.conv))]);
        if w.err = Awire.Failed then Fmt.write(out, ": {}", [Fmt.str(Buf.bytes(w.why))]); end;
    end;
    if w.n > 0 then handIn(w.n, w.copy, out); end;
end;

(* delegate, the calls, each result added to results: each worker made
   ready in turn (ready), so that none sees another's report; run, side
   by side on threads of their own when there are several, else on the
   lead's (labour); then each finished, in the calls' order. *)
proc fan(var a: Agent; calls: []Amsg.Call; results: []Buf.Buf);
var ws: [MaxFan]Worker; made: [MaxFan]BOOL; i: INT;
begin
    for i := 0 to LEN(calls) - 1 do
        open(a, ws[i]);
        made[i] := ready(a, calls[i].args, LEN(calls), ws[i], results[i]);
    end;
    for i := 0 to LEN(calls) - 1 do
        if made[i] and (LEN(calls) > 1) then ws[i].thread, _ := Thread.spawn(labour, ^U8(SYSTEM.ADR(ws[i]))); end;
        (* alone, or with no thread to be had, it works on the lead's *)
        if made[i] and (ws[i].thread = nil) then labour(^U8(SYSTEM.ADR(ws[i]))); end;
    end;
    for i := 0 to LEN(calls) - 1 do
        if ws[i].thread # nil then Thread.join(ws[i].thread); end;
    end;
    for i := 0 to LEN(calls) - 1 do
        if made[i] then finish(a, ws[i], results[i]); end;
        close(ws[i]);
    end;
end;

(* merge, with the arguments args: worker n's diff, from the scratch
   directory, brought into the stage's copy (Astage.carry) or dropped,
   as apply says, and then removed; but kept when it does not apply, so
   that it may be dropped, or done again. Its work is done in the
   call's arena. *)
proc merge(var a: Agent; args: []const U8; var out: Buf.Buf);
var d: Json.Doc; p: Atools.Args; path, diff, why: Buf.Buf; n: INT;
begin
    if a.working then
        Buf.str(out, "error: a worker cannot merge");
        return;
    end;
    if not Json.init(SYSTEM.ADR(d), SYSTEM.ADR(a.mem.base)) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    if not Atools.parse(SYSTEM.ADR(d), SYSTEM.ADR(a.mem.base), args, p) then
        Buf.str(out, "error: the arguments must be one JSON object, as the tool's schema says");
        return;
    end;
    Buf.init(path, SYSTEM.ADR(a.mem.base));
    Buf.init(diff, SYSTEM.ADR(a.mem.base));
    Buf.init(why, SYSTEM.ADR(a.mem.base));
    n := Atools.int(p, "worker", 0);
    if (n <= 0) or (LEN(Afence.stage) = 0) or (Files.load(diffPath(n, path), diff) # 0) then
        Fmt.write(out, "error: no diff of worker {} waits to be merged", [Fmt.str(Atools.str(p, "worker"))]);
        return;
    end;
    if Json.member(p.d, p.v, "apply") = Json.None then   (* a worker's work is not dropped by a slip *)
        Fmt.write(out, "error: say apply true to merge worker {}'s changes, or apply false to drop them", [Fmt.int(n)]);
    elsif not Atools.flag(p, "apply") then
        _ := Sys.remove(Buf.bytes(path));
        Fmt.write(out, "dropped: worker {}'s changes, which your copy never had", [Fmt.int(n)]);
    elsif Astage.carry(Buf.bytes(diff), why) then
        _ := Sys.remove(Buf.bytes(path));
        Fmt.write(out, "merged: worker {}'s changes are in your copy; run check.", [Fmt.int(n)]);
    else
        Fmt.write(out, "error: worker {}'s diff no longer fits your copy, which changed after it began, so nothing " +
            "was applied: {}. Drop it, or brief a worker to do it again on your copy as it is.",
            [Fmt.int(n), Fmt.str(Buf.bytes(why))]);
    end;
end;

(* Whether c's plan is approved: the last result of plan in c says so. *)
proc approved*(const c: Astore.Conv): BOOL;
var m: []Amsg.Msg; i: INT;
begin
    m := Msgs.all(c.msgs);
    i := LEN(m) - 1;
    while (i >= 0) and ((m[i].role # Amsg.Role.tool) or (m[i].tool # "plan")) do DEC(i); end;
    return (i >= 0) and Str.hasPrefix(m[i].text, Approved);
end;

(* Whether a call of name waits, in build mode, for an approved plan:
   it changes files, or hands work on. shell doesn't wait: a plan is
   written from what was found, and shell writes only the stage's
   copy, whose diff the human sees. *)
proc waits(name: []const U8): BOOL;
begin
    match name of
    | "edit", "move", "remove", "delegate", "merge": return true;
    | else: return false;
    end;
end;

(* text, a plan, put to the human: their answer added to out, and the
   plan as it ends. A human with an editor may change it first, the
   front's edit; it is asked again as they left it, and an edited plan
   goes back to the model whole, as theirs replaces the model's. *)
proc approve(var a: Agent; text: []const U8; var out: Buf.Buf): []const U8;
var keys, mine: []const U8; answer: U8; edited, ok: BOOL; revised: Buf.Buf;
begin
    keys := "yn";
    if a.front.edit # nil then keys := "yne"; end;
    edited := false;
    answer := a.human.ask("carry out this plan?", text, keys);
    while answer = 'e' do
        mine, ok := a.front.edit(text);
        if ok and (LEN(Str.trim(mine)) > 0) and (Str.trim(mine) # text) then
            Buf.init(revised, SYSTEM.ADR(a.mem.base));
            Buf.str(revised, Str.trim(mine));
            text := Buf.bytes(revised);
            edited := true;
        end;
        answer := a.human.ask("carry out this plan?", text, keys);
    end;
    if (answer = 'y') and edited then
        Fmt.write(out, "{} the human edited the plan, then approved it; carry out their version, not yours:\n\n{}",
            [Fmt.str(Approved), Fmt.str(text)]);
    elsif answer = 'y' then
        Fmt.write(out, "{} the human approved the plan; carry it out.", [Fmt.str(Approved)]);
    else
        Atools.declined(a.human, "Revise the plan as they say and call plan again; nothing may be changed or " +
            "delegated until a plan is approved.", out);
    end;
    return text;
end;

(* plan, with the arguments args: the plan put to the human (approve),
   whose yes or no, and why, is added to out, then written to plan.md
   in the scratch directory as it ended, and where it is kept added
   too. With nobody to ask, the answer is no. Its work is done in the
   call's arena. *)
proc plan(var a: Agent; args: []const U8; var out: Buf.Buf);
var d: Json.Doc; p: Atools.Args; path: Buf.Buf; text: []const U8;
begin
    if not Json.init(SYSTEM.ADR(d), SYSTEM.ADR(a.mem.base)) then Rt.stop("arno: out of memory"); end;
    defer Json.done(SYSTEM.ADR(d));
    if not Atools.parse(SYSTEM.ADR(d), SYSTEM.ADR(a.mem.base), args, p) then
        Buf.str(out, "error: the arguments must be one JSON object, as the tool's schema says");
        return;
    end;
    text := Str.trim(Atools.str(p, "plan"));
    if LEN(text) = 0 then
        Buf.str(out, "error: plan is required: the plan, in full");
        return;
    end;
    if a.human.ask = nil then
        Buf.str(out, "not approved: there is nobody here to approve a plan, so nothing may be changed or " +
            "delegated. Give the plan in your answer, and stop.");
    else
        text := approve(a, text, out);
    end;
    if LEN(Afence.scratch) = 0 then return; end;
    Buf.init(path, SYSTEM.ADR(a.mem.base));
    Fmt.write(path, "{}/plan.md", [Fmt.str(Afence.scratch)]);
    if Files.write(Buf.bytes(path), text) then
        Fmt.write(out, "\n\nThe plan is kept in {}.", [Fmt.str(Buf.bytes(path))]);
    end;
end;

(* How many of calls, from the first, run together: the delegations
   that begin them, up to MaxFan, when the lead's workers would each
   have a copy of their own and nothing holds them back; else 1. *)
proc together(const a: Agent; const c: Astore.Conv; calls: []Amsg.Call): INT;
var n: INT;
begin
    if a.working or (LEN(Afence.stage) = 0) or (LEN(Afence.scratch) = 0) or stopped(a) then return 1; end;
    if (a.mode = Aprompt.build) and not approved(c) then return 1; end;
    n := 0;
    while (n < LEN(calls)) and (n < MaxFan) and (calls[n].name = "delegate") do INC(n); end;
    if n < 2 then return 1; end;
    return n;
end;

(* calls, which together gave, answered, each result into results:
   several are all delegations, and run side by side (fan). *)
proc answer(var a: Agent; const c: Astore.Conv; calls: []Amsg.Call; results: []Buf.Buf);
var name, args: []const U8;
begin
    name := calls[0].name;
    args := calls[0].args;
    if stopped(a) then
        Buf.str(results[0], Interrupted);
    elsif again(a, name, args) then
        Buf.str(results[0], Repeated);
    elsif (a.mode = Aprompt.build) and not a.working and waits(name) and not approved(c) then
        Buf.str(results[0], Unplanned);
    elsif (name = "plan") and (a.mode = Aprompt.build) and not a.working then
        plan(a, args, results[0]);
    elsif name = "delegate" then
        fan(a, calls, results);
    elsif name = "merge" then
        merge(a, args, results[0]);
    else
        Atools.call(name, args, a.human, SYSTEM.ADR(a.mem.base), results[0]);
    end;
    Arena.reset(a.mem);
end;

(* The calls of c's last message run, each result added to c as a
   tool's message: how many of them failed. Once the human says to
   stop, the calls left aren't run, but answered all the same, as a
   request must answer every call. Delegations that run together are
   all told before any runs, and their results after. *)
proc run(var a: Agent; var c: Astore.Conv): INT;
var calls: []Amsg.Call; res: [MaxFan]Buf.Buf; m: ^Amsg.Msg; i, j, k, bad: INT;
begin
    for k := 0 to MaxFan - 1 do Buf.init(res[k], Heap.heap); end;
    (* the calls stay where they are as messages are added: a message
       keeps its calls in memory of their own *)
    calls := Calls.all(Msgs.all(c.msgs)[c.msgs.len - 1].calls);
    bad := 0;
    i := 0;
    while i < LEN(calls) do
        j := i + together(a, c, calls[i..LEN(calls)]);
        for k := i to j - 1 do
            Buf.reset(res[k - i]);
            if a.front.call # nil then a.front.call(calls[k].name, calls[k].args, a.front.arg); end;
        end;
        answer(a, c, calls[i..j], res[0..j - i]);
        for k := i to j - 1 do
            if a.front.result # nil then a.front.result(calls[k].name, Buf.bytes(res[k - i]), a.front.arg); end;
            if failed(Buf.bytes(res[k - i])) then INC(bad); end;
            m := Msgs.add(c.msgs);
            Amsg.init(m^, Amsg.Role.tool);
            m^.callId := Amsg.keep(calls[k].id);
            m^.tool := Amsg.keep(calls[k].name);
            Amsg.setText(m^, Buf.bytes(res[k - i]));
        end;
        i := j;
    end;
    for k := 0 to MaxFan - 1 do Buf.done(res[k]); end;
    return bad;
end;

(* The model asked once more, with c's system prompt, by request, a
   message of the human's that c doesn't keep: what it said, without
   its calls, into reply. The tools are still offered, so that the
   cache holds. *)
proc once*(var a: Agent; var c: Astore.Conv; request: []const U8; var reply: Buf.Buf; var why: Buf.Buf): ERROR;
var sys: Buf.Buf; m: ^Amsg.Msg; n: INT; err: ERROR;
begin
    Buf.init(sys, Heap.heap);
    defer Buf.done(sys);
    system(a, c, sys);
    m := Msgs.add(c.msgs);
    Amsg.init(m^, Amsg.Role.user);
    Amsg.setText(m^, request);
    n := c.msgs.len;
    err := ask(a, c, Buf.bytes(sys), why);
    (* the request taken out, and with it the reply *)
    if c.msgs.len > n then
        m := SYSTEM.ADR(Msgs.all(c.msgs)[n]);
        Buf.str(reply, m^.text);
        Amsg.free(m^);
    end;
    Amsg.free(Msgs.all(c.msgs)[n - 1]);
    Msgs.resize(c.msgs, n - 1);
    return err;
end;

(* The model asked, by a message of the human's that the conversation
   doesn't keep, to say where it got to, for the reason why: its reply
   kept without calls. The request is the turn's last one and one more
   step. *)
proc handBack(var a: Agent; var c: Astore.Conv; reason, request: []const U8; var why: Buf.Buf): ERROR;
var b: Buf.Buf; m: ^Amsg.Msg; err: ERROR;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Buf.str(b, reason);
    Buf.str(b, "; asking the model to hand back");
    note(a, Buf.bytes(b));
    Buf.reset(b);
    err := once(a, c, request, b, why);
    if b.len > 0 then
        m := Msgs.add(c.msgs);
        Amsg.init(m^, Amsg.Role.assistant);
        Amsg.setText(m^, Buf.bytes(b));
    end;
    return err;
end;

(* A turn of c, whose last message is the human's: run until the model
   answers, hands back, or the human stops it. nil then, or Awire's
   Stopped; Failed for a request that failed, why saying why. What the
   model said is in c either way, what it said for this turn alone
   dropped (Amsg.settle). *)
proc turn*(var a: Agent; var c: Astore.Conv; var why: Buf.Buf): ERROR;
var sys, b: Buf.Buf; first, step, failing, calls, i, floor, most: INT; m: []Amsg.Msg; start, allowed: F64; err: ERROR;
begin
    first := c.msgs.len;
    forget(a);
    (* the editor has the human's files open, not the stage's copy *)
    Apeer.refresh(LEN(Afence.stage) = 0);
    Buf.init(sys, Heap.heap);
    defer Buf.done(sys);
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    if not a.working then
        if a.prefetch then attach(a, c); end;
        for i := 0 to a.reports.len - 1 do Str.free(Heap.heap, Strs.all(a.reports)[i]); end;
        Strs.reset(a.reports);
    end;
    (* build mode's lead carries out a whole plan in a turn; a worker is
       bounded by the budget delegate gave it, its steps only a backstop,
       as a cheap model takes many *)
    most := a.maxSteps;
    allowed := a.budget;
    if a.working then
        most := a.buildSteps;
        allowed := a.allowance;
    elsif a.mode = Aprompt.build then
        most := a.buildSteps;
        allowed := a.buildBudget;
    end;
    start := a.spent;
    if not a.working then
        a.stopAt := 0.0;
        if allowed > 0.0 then a.stopAt := start + allowed; end;
    end;
    failing := 0;
    floor := 0;
    err := nil;
    for step := 1 to most do
        (* once the history is long, and then each time it has grown by
           half again: rare cuts keep the cached prefix whole between them *)
        if (a.prune > 0) and (size(c) > a.prune) and (size(c) > floor + floor div 2) then
            prune(a, c);
            floor := size(c);
        end;
        system(a, c, sys);
        err := ask(a, c, Buf.bytes(sys), why);
        if err # nil then break; end;
        calls := Msgs.all(c.msgs)[c.msgs.len - 1].calls.len;
        if calls = 0 then break; end;
        if run(a, c) = calls then INC(failing); else failing := 0; end;
        if stopped(a) then err := Awire.Stopped; break; end;
        if step = most then
            Fmt.write(b, "{} steps used", [Fmt.int(most)]);
            err := handBack(a, c, Buf.bytes(b), StepsAsk, why);
        elsif failing = FailSteps then
            Fmt.write(b, "{} steps of failed calls in a row", [Fmt.int(FailSteps)]);
            err := handBack(a, c, Buf.bytes(b), StuckAsk, why);
            break;
        elsif (allowed > 0.0) and (a.spent - start > allowed) then
            Fmt.write(b, "turn budget of ${} spent", [Fmt.real(allowed, 2)]);
            err := handBack(a, c, Buf.bytes(b), BudgetAsk, why);
            break;
        end;
    end;
    m := Msgs.all(c.msgs);
    for i := first to LEN(m) - 1 do Amsg.settle(m[i]); end;
    (* a worker's ends with its copy, and a jailed server with the turn's thread *)
    Alsp.stop;
    return err;
end;

(* The module's test: prune, and build mode's plan. *)

(* The human's answers to plan, in the test: yes, and no. *)
proc yes(_question, _detail, _keys: []const U8): U8;
begin
    return 'y';
end;

proc no(_question, _detail, _keys: []const U8): U8;
begin
    return 'n';
end;

(* The result of a call of name with args made in c, as run gives it. *)
proc called(var a: Agent; var c: Astore.Conv; name, args: []const U8): []const U8;
var m: ^Amsg.Msg;
begin
    m := Msgs.add(c.msgs);
    Amsg.init(m^, Amsg.Role.assistant);
    Amsg.addCall(m^, "c", name, args, "");
    _ := run(a, c);
    return Msgs.all(c.msgs)[c.msgs.len - 1].text;
end;

(* Build mode: nothing changed before a plan is approved, nobody there
   to approve one says no, and the last answer counts. *)
proc testPlan(): BOOL;
const Plan = `{"plan":"1. do it"}`;
var a: Agent; p: Awire.Prov; c: Astore.Conv;
begin
    init(a, SYSTEM.ADR(p), {});
    a.mode := Aprompt.build;
    Astore.init(c, "test");
    if called(a, c, "edit", "{}") # Unplanned then Out.str("Agent: an edit before a plan\n"); return false; end;
    if not Str.hasPrefix(called(a, c, "plan", Plan), "not approved: there is nobody here") then
        Out.str("Agent: a plan with nobody to ask\n");
        return false;
    end;
    a.human.ask := yes;
    if not Str.hasPrefix(called(a, c, "plan", Plan), Approved) or not approved(c) then
        Out.str("Agent: a plan approved\n");
        return false;
    end;
    a.human.ask := no;
    if not Str.hasPrefix(called(a, c, "plan", Plan), "declined by user. Revise") or approved(c) then
        Out.str("Agent: a plan declined\n");
        return false;
    end;
    return true;
end;

(* delegate names its model: one of the workers, else refused with the list. *)
proc testModel(): BOOL;
var a: Agent; p: Awire.Prov; c: Astore.Conv; said: []const U8;
begin
    init(a, SYSTEM.ADR(p), {});
    a.worker := "cheap";
    Atools.workers("cheap strong", "cheap", p);
    Astore.init(c, "test");
    said := called(a, c, "delegate", `{"task":"t","done_when":"d","model":"other"}`);
    Atools.workers("", "", p);
    if said # "error: other is not a worker model; the models are: cheap strong" then
        Out.str("Agent: a model not a worker\n");
        return false;
    end;
    return true;
end;

proc main*: INT;
var a: Agent; p: Awire.Prov; c: Astore.Conv; m: ^Amsg.Msg; long: Buf.Buf; i: INT; t: []const U8;
begin
    init(a, SYSTEM.ADR(p), {});
    Astore.init(c, "test");
    Buf.init(long, Heap.heap);
    for i := 1 to 100 do Buf.str(long, "a line of a long result, 38 bytes....\n"); end;
    for i := 0 to 5 do
        m := Msgs.add(c.msgs);
        Amsg.init(m^, Amsg.Role.assistant);
        Amsg.addCall(m^, "c", "read", "{}", "");
        m := Msgs.add(c.msgs);
        Amsg.init(m^, Amsg.Role.tool);
        Amsg.setText(m^, Buf.bytes(long));
    end;
    prune(a, c);
    for i := 0 to 5 do
        t := Msgs.all(c.msgs)[2 * i + 1].text;
        if (i < 2) # Str.hasSuffix(t, "\n[... 2660 more bytes, cut from the history as old; make the call again to see them]") then
            Out.str("Agent: prune\n");
            return 1;
        end;
    end;
    if not Str.hasPrefix(Msgs.all(c.msgs)[1].text, Buf.bytes(long)[0..1140]) then
        Out.str("Agent: prune keeps the head\n");
        return 1;
    end;
    (* a worker's report is never cut *)
    Astore.init(c, "test");
    for i := 0 to 5 do
        m := Msgs.add(c.msgs);
        Amsg.init(m^, Amsg.Role.assistant);
        Amsg.addCall(m^, "c", "delegate", "{}", "");
        m := Msgs.add(c.msgs);
        Amsg.init(m^, Amsg.Role.tool);
        m^.tool := Amsg.keep("delegate");
        Amsg.setText(m^, Buf.bytes(long));
    end;
    prune(a, c);
    if Msgs.all(c.msgs)[1].text # Buf.bytes(long) then
        Out.str("Agent: prune, a report\n");
        return 1;
    end;
    if not testPlan() or not testModel() then return 1; end;
    return 0;
end;

end Agent.
