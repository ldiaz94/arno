(* Agent: a turn of a conversation: the model asked, the tools it
   calls run, and the model asked again with their results, until it
   answers with no call.

   The agent knows nothing of how a turn is shown. It tells its front
   end what happens, the model's text as it comes, each call and its
   result, and asks it what the human says, through a Front: plain mode
   is one, a line at a time; the screen is another, which runs a turn on
   a thread of its own and passes on what it is told to the loop that
   draws.

   The mode, which the human picks, ends the system prompt with its
   instructions, and says whether the tools that change files are
   offered. What each request costs is counted, at its model's list
   price, for /usage and for the turn's budget.

   A turn ends early, the model asked to say where it got to without
   calling more tools, when it has used its steps (maxSteps, config's
   max_steps), when it has spent what config's turn_budget allows, in
   dollars at list price, or when four steps in a row had every call
   fail: a model that keeps failing does better saying what it was
   trying, and being told what to do, than trying again. A read-only call made a second
   time in a turn, with the same arguments, is refused: its result is
   above, and nothing has changed it; any other call might have, and
   clears what was seen.

   Before the first request, the definitions of the names the human's
   message mentions are attached to it (Aahead.prefetch), unless config's
   prefetch is no. Before each request, once the history passes config's
   prune (200,000 bytes unless it says), and each time it has grown by
   half again, the long results of old calls are cut (prune).

   With config's worker naming a model, the model may delegate a step
   to a worker: a turn of the same loop, on the worker's model, over a
   conversation of its own that holds only the brief, with the tools
   less delegate. Only the worker's last answer comes back, as the
   call's result, so that the leading session's history stays as small
   as the reports. What earlier workers of the turn reported goes with
   each brief.

   Each call's work is done in an arena, reset after the call: its
   result is copied into the conversation, which keeps its own memory
   from Heap.

   Depends on Aprompt (the system prompt), Aahead, Aprice, Atools,
   Afence, Awire, Amsg and Astore. Leaves out forking calls that only
   read, to run them side by side. *)
module Agent;
import Aprompt, Aahead, Aprice, Atools, Afence, Awire, Amsg, Astore, Http, Json, Buf, Str, Heap, Arena, Rt, Fmt, Out,
    Msgs := Vec(Amsg.Msg), Calls := Vec(Amsg.Call), Strs := Vec([]U8);

type
    (* What the agent tells its front end, and asks of it. Any
       procedure may be nil, and each gets arg. *)
    Front* = record
        text*: proc(s: []U8; arg: ^U8);            (* a piece of the model's text, as it comes *)
        call*: proc(name, args: []U8; arg: ^U8);   (* a tool call, about to run *)
        result*: proc(name, res: []U8; arg: ^U8);  (* its result *)
        note*: proc(s: []U8; arg: ^U8);            (* what arno says of the turn, a line *)
        ask*: Atools.Ask;                          (* the human asked; nil if nobody is there *)
        why*: Atools.Why;                          (* after a no, why; nil not to ask *)
        stopped*: proc: BOOL;                      (* whether the human said to stop *)
        arg*: ^U8;
    end;

    Agent* = record
        prov*: ^Awire.Prov;
        front*: Front;
        maxSteps*: INT;
        prune*: INT;          (* bytes of history before old results are cut; 0 never *)
        budget*: F64;         (* dollars a turn may spend, at list price; 0 for no limit *)
        prefetch*: BOOL;      (* definitions attached to the human's message *)
        worker*: []U8;        (* the model a worker runs on; "" for no workers *)
        mode*: Aprompt.Mode;
        working: BOOL;        (* the turn under way is a worker's *)
        reports: Strs.Vec;    (* what the turn's workers reported, each its task and its report, from Heap *)
        prompt*: Aprompt.Prompt;
        used*: Awire.Usage;   (* what the requests so far cost, summed *)
        requests*: INT;       (* how many there were *)
        spent*: F64;          (* dollars, at list price, of those priced *)
        unpriced*: INT;       (* those whose model has no known price *)
        human: Atools.Human;  (* the front's ask and why *)
        client: Http.Client;
        mem: Arena.Arena;     (* a call's work *)
        seen: Buf.Buf;        (* the read-only calls of this turn, "\0" then each "name\1args\0" *)
    end;

const
    MaxSteps* = 30;     (* a turn's steps, unless config's max_steps says *)
    Prune* = 200000;    (* bytes of history before old results are cut, unless config's prune says *)
    KeepSteps = 4;      (* the last steps whose results prune leaves whole *)
    KeepHead = 30;      (* lines of a cut result kept, *)
    KeepBytes = 1500;   (* and about as many bytes at most *)
    CutMark = "\n[... ";   (* what starts the note a cut result ends with *)
    FailSteps = 4;      (* steps in a row whose every call failed, before a turn hands back *)
    CallMemory = 256 * 1024 * 1024;   (* the arena's size: pages are only taken as used *)

    (* what a turn that ran out of steps asks for *)
    StepsAsk = "You have used every tool step this turn allows. Do not call any tools. In a few " +
        "lines, say what is done, what you found, and what you will do next. Ask me a " +
        "question only if you cannot go on without the answer; never ask leave to continue.";
    (* what a turn whose last steps all failed asks for *)
    StuckAsk = "Your last calls have all failed. Do not call any tools. In a few lines, say what you " +
        "were trying, what the errors say, and what you will do differently. Ask me a " +
        "question only if you cannot go on without the answer.";
    (* what a turn over its budget asks for *)
    BudgetAsk = "This turn has spent what the human allows a turn. Do not call any tools. In a few " +
        "lines, say what is done, what is not, and what you would do next.";
    (* what /compact asks for, and what stands for the reply to the summary *)
    CompactAsk* = "Summarize our conversation so far so that it can replace the full history: I will continue " +
        "working with you from your summary alone. Include the goal, decisions made and why, files touched and " +
        "their current state, what is done, what is left, and any facts or preferences I stated. Leave out tool " +
        "output, dead ends and pleasantries. Use plain prose and short lists, no preamble. Do not call any tools.";
    CompactAck* = "Understood. I have the summary and will continue from it.";
    (* the end of a worker's system prompt, in place of the mode's *)
    WorkerText = "# Worker\nYou are a worker: the session that leads gave you one task, the message below, " +
        "and sees only your final report. Do that task completely: read what you need, make the changes, " +
        "build, and run check. Earlier workers' reports, when the brief has them, are what is known: use the " +
        "units and findings they name rather than finding or writing them again. Do not ask questions; if " +
        "something blocks you, stop and say what. End with a short report: what you did, what you found that " +
        "the next worker should know, the files you changed, and check's verdict.";
    MaxReports = 4;     (* earlier reports a brief carries, the newest *)
    MaxReport = 4000;   (* bytes of each *)
    Repeated = "not run: this exact call was already made in this turn and its result " +
        "is above. Use that result, or try something different.";
    Interrupted = "not run: interrupted by the human";

(* a made ready to run turns against prov, telling front; the fence
   set from the working directory. *)
proc init*(a: ^Agent; prov: ^Awire.Prov; front: Front);
begin
    a^ := {prov: prov, front: front, maxSteps: MaxSteps, prune: Prune, prefetch: true,
        human: {ask: front.ask, why: front.why, arg: front.arg}};
    Strs.init(ADR(a^.reports), Heap.heap);
    Awire.initClient(ADR(a^.client));
    if not Arena.init(ADR(a^.mem), CallMemory) then Rt.stop("arno: out of memory"); end;
    Buf.init(ADR(a^.seen), Heap.heap);
    Afence.init;
end;

proc note(a: ^Agent; s: []U8);
begin
    if a^.front.note # nil then a^.front.note(s, a^.front.arg); end;
end;

proc stopped(a: ^Agent): BOOL;
begin
    return (a^.front.stopped # nil) and a^.front.stopped();
end;

(* What lasts the session found: the context files, as config's
   context_files says (mode), and the project's map, unless map is
   false. *)
proc prepare*(a: ^Agent; mode: []U8; map: BOOL);
begin
    Aprompt.load(ADR(a^.prompt), mode, map, ADR(a^.human), a^.front.note);
end;

(* The system prompt of c's next request, made again in sys: it ends
   with the mode's instructions, or a worker's. *)
proc system(a: ^Agent; c: ^Astore.Conv; sys: ^Buf.Buf);
begin
    Buf.reset(sys);
    Aprompt.write(ADR(a^.prompt), c, a^.prov, a^.mode, ADR(a^.mem.base), a^.front.note, a^.front.arg, sys);
    Buf.str(sys, "\n\n");
    if a^.working then
        Buf.str(sys, WorkerText);
    else
        Buf.str(sys, "# Mode\n");
        Buf.str(sys, Aprompt.Modes[INT(a^.mode)].text);
    end;
    Arena.reset(ADR(a^.mem));
end;

(* A lookup prefetch made, shown as the def call it stands in for. *)
proc prefetched(name, args, res: []U8; arg: ^U8);
var a: ^Agent;
begin
    a := ^Agent(arg);
    if a^.front.call # nil then a^.front.call(name, args, a^.front.arg); end;
    if a^.front.result # nil then a^.front.result(name, res, a^.front.arg); end;
end;

(* The definitions of the names in the text of c's last message, the
   human's, attached to it. *)
proc attach(a: ^Agent; c: ^Astore.Conv);
var m: ^Amsg.Msg; b: Buf.Buf; n: INT;
begin
    m := ADR(Msgs.all(ADR(c^.msgs))[c^.msgs.len - 1]);
    Buf.init(ADR(b), ADR(a^.mem.base));
    Buf.str(ADR(b), m^.text);
    n := b.len;
    Aahead.prefetch(m^.text, ADR(a^.mem.base), prefetched, ^U8(a), ADR(b));
    if b.len > n then Amsg.setText(m, Buf.bytes(ADR(b))); end;
    Arena.reset(ADR(a^.mem));
end;

(* The bytes of c's messages' text, the measure prune goes by. *)
proc size(c: ^Astore.Conv): INT;
var m: []Amsg.Msg; i, n: INT;
begin
    m := Msgs.all(ADR(c^.msgs));
    n := 0;
    for i := 0 to LEN(m) - 1 do INC(n, LEN(m[i].text)); end;
    return n;
end;

(* The long results of the calls older than the last KeepSteps steps
   cut to their first lines and a note, in c itself, and so in the
   saved conversation too. Each step resends the whole history, and
   most of what a long turn resends is stale: listings, files read edits
   ago, test runs since passed. Cutting it all at once, rarely, rather
   than a little every step, is for the provider's prompt cache, which
   matches only a prefix that hasn't changed, and bills what it matches
   at a fraction of the price: between cuts the prefix stays put. A
   result already cut is left as it is. *)
proc prune(a: ^Agent; c: ^Astore.Conv);
var m: []Amsg.Msg; b: Buf.Buf; t, line, rest: []U8; i, k, steps, n: INT;
begin
    m := Msgs.all(ADR(c^.msgs));
    steps := 0;
    i := LEN(m) - 1;
    while (i >= 0) and (steps < KeepSteps) do
        if (m[i].role = Amsg.Role.assistant) and (m[i].calls.len > 0) then INC(steps); end;
        DEC(i);
    end;
    Buf.init(ADR(b), ADR(a^.mem.base));
    for k := 0 to i do
        t := m[k].text;
        if (m[k].role # Amsg.Role.tool) or (LEN(t) < 2000) or (Str.find(t, CutMark) >= 0) then continue; end;
        Buf.reset(ADR(b));
        rest := t;
        n := 0;
        while (LEN(rest) > 0) and (n < KeepHead) and (b.len < KeepBytes) do
            line, rest, _ := Str.cut(rest, "\n");
            Buf.str(ADR(b), line);
            if LEN(rest) > 0 then Buf.add(ADR(b), '\n'); end;
            INC(n);
        end;
        if LEN(rest) = 0 then continue; end;
        Fmt.write(ADR(b), "{}{} more bytes, cut from the history as old; make the call again to see them]",
            [Fmt.str(CutMark), Fmt.int(LEN(rest))]);
        Amsg.setText(ADR(m[k]), Buf.bytes(ADR(b)));
    end;
    Arena.reset(ADR(a^.mem));
end;

(* The model asked, once, with c's messages; its reply added to them,
   unless the request failed with nothing said. What it cost is
   counted, at the price of the model asked, a worker's or the lead's. *)
proc ask(a: ^Agent; c: ^Astore.Conv; sys: []U8; why: ^Buf.Buf): ERROR;
var r: Awire.Request; reply: Amsg.Msg; u: Awire.Usage; price: Aprice.Price; priced: BOOL; err: ERROR;
begin
    r := {prov: a^.prov, client: ADR(a^.client), system: sys, msgs: Msgs.all(ADR(c^.msgs)),
        tools: Atools.offered(not a^.working and (LEN(a^.worker) > 0), a^.mode in {Aprompt.chat, Aprompt.pair}),
        emit: a^.front.text, arg: a^.front.arg, stopped: a^.front.stopped};
    err := Awire.chat(ADR(r), ADR(reply), ADR(u), why);
    INC(a^.used.inp, u.inp);
    INC(a^.used.cached, u.cached);
    INC(a^.used.written, u.written);
    INC(a^.used.out, u.out);
    INC(a^.requests);
    price, priced := Aprice.price(a^.prov);
    if priced then a^.spent := a^.spent + Aprice.cost(price, u); else INC(a^.unpriced); end;
    if (err = nil) or (LEN(reply.text) > 0) then
        Msgs.push(ADR(c^.msgs), reply);
    else
        Amsg.free(ADR(reply));
    end;
    return err;
end;

(* Every call seen forgotten: seen holds only the NUL each key
   starts with, so that a key is never found inside another. *)
proc forget(a: ^Agent);
begin
    Buf.reset(ADR(a^.seen));
    Buf.add(ADR(a^.seen), 0);
end;

(* Whether the call was made already this turn, by a tool that only
   reads; noted if not. A call to any other tool forgets the rest. *)
proc again(a: ^Agent; name, args: []U8): BOOL;
var key: Buf.Buf; seen: BOOL;
begin
    if not Atools.readOnly(name) then
        forget(a);
        return false;
    end;
    Buf.init(ADR(key), Heap.heap);
    defer Buf.done(ADR(key));
    Buf.add(ADR(key), 0);
    Buf.str(ADR(key), name);
    Buf.add(ADR(key), 1);
    Buf.str(ADR(key), args);
    Buf.add(ADR(key), 0);
    seen := Str.find(Buf.bytes(ADR(a^.seen)), Buf.bytes(ADR(key))) >= 0;
    if not seen then Buf.str(ADR(a^.seen), Buf.bytes(ADR(key))[1..key.len]); end;
    return seen;
end;

(* Whether a result says its call failed: an error, or not run. A
   call the human declined didn't fail; the model was told no. *)
proc failed(res: []U8): BOOL;
begin
    return Str.hasPrefix(res, "error") or Str.hasPrefix(res, "not run");
end;

proc min(a, b: INT): INT;
begin
    if a < b then return a; end;
    return b;
end;

proc turn*(a: ^Agent; c: ^Astore.Conv; why: ^Buf.Buf): ERROR; forward;

(* delegate, with the arguments args: the brief made from them, and a
   worker's turn run on it; its report, or why there is none, added to
   out. *)
proc delegate(a: ^Agent; args: []U8; out: ^Buf.Buf);
var d: Json.Doc; p: Atools.Args; w: Astore.Conv; prov: Awire.Prov; lead: ^Awire.Prov; m: ^Amsg.Msg;
    brief, why: Buf.Buf; files, reports: [][]U8; msgs: []Amsg.Msg; task, report: []U8; i, steps: INT;
    err: ERROR;
begin
    if a^.working then
        Buf.str(out, "error: a worker cannot delegate");
        return;
    end;
    if LEN(a^.worker) = 0 then
        Buf.str(out, "error: there is no worker model; the human sets one with worker = MODEL in the config");
        return;
    end;
    if not Json.init(ADR(d), Heap.heap) then Rt.stop("arno: out of memory"); end;
    defer Json.done(ADR(d));
    Buf.init(ADR(brief), Heap.heap);
    defer Buf.done(ADR(brief));
    Buf.init(ADR(why), Heap.heap);
    defer Buf.done(ADR(why));
    if not Atools.parse(ADR(d), Heap.heap, args, ADR(p)) then
        Buf.str(out, "error: the arguments must be one JSON object, as the tool's schema says");
        return;
    end;
    task := Str.trim(Atools.str(ADR(p), "task"));
    if LEN(task) = 0 then
        Buf.str(out, "error: task is required: what the worker is to do, in full");
        return;
    end;
    Fmt.write(ADR(brief), "Task: {}", [Fmt.str(task)]);
    files := Atools.list(ADR(p), "files");
    if LEN(files) > 0 then Buf.str(ADR(brief), "\n\nFiles:"); end;
    for i := 0 to LEN(files) - 1 do Fmt.write(ADR(brief), "\n- {}", [Fmt.str(files[i])]); end;
    if LEN(Str.trim(Atools.str(ADR(p), "done_when"))) > 0 then
        Fmt.write(ADR(brief), "\n\nDone when: {}", [Fmt.str(Str.trim(Atools.str(ADR(p), "done_when")))]);
    end;
    (* what earlier workers of this turn found goes along, so that the
       next one needn't find it again: a worker blind to a survey's
       findings wrote its own rule for what a unit already did *)
    reports := Strs.all(ADR(a^.reports));
    if LEN(reports) > 0 then Buf.str(ADR(brief), "\n\nWhat earlier workers on this task reported:"); end;
    for i := LEN(reports) - MaxReports to LEN(reports) - 1 do
        if i >= 0 then
            Buf.str(ADR(brief), "\n\n---\n");
            Buf.str(ADR(brief), reports[i][0..min(LEN(reports[i]), MaxReport)]);
        end;
    end;
    Buf.reset(ADR(why));
    Fmt.write(ADR(why), "worker {}: {}", [Fmt.str(a^.worker), Fmt.str(task[0..min(LEN(task), 120)])]);
    note(a, Buf.bytes(ADR(why)));

    Astore.init(ADR(w), "worker");
    defer Astore.done(ADR(w));
    m := Msgs.add(ADR(w.msgs));
    Amsg.init(m, Amsg.Role.user);
    Amsg.setText(m, Buf.bytes(ADR(brief)));
    prov := a^.prov^;
    prov.model := a^.worker;
    lead := a^.prov;
    a^.prov := ADR(prov);
    a^.working := true;
    Buf.reset(ADR(why));
    err := turn(a, ADR(w), ADR(why));
    a^.working := false;
    a^.prov := lead;
    forget(a);   (* what the worker saw is no call of the lead's *)

    msgs := Msgs.all(ADR(w.msgs));
    steps := 0;
    for i := 0 to LEN(msgs) - 1 do
        if msgs[i].role = Amsg.Role.assistant then INC(steps); end;
    end;
    report := "";
    if msgs[LEN(msgs) - 1].role = Amsg.Role.assistant then report := Str.trim(msgs[LEN(msgs) - 1].text); end;
    if LEN(report) = 0 then
        Fmt.write(out, "error: the worker ended without a report, after {} steps", [Fmt.int(steps)]);
        if err = Awire.Failed then Fmt.write(out, ": {}", [Fmt.str(Buf.bytes(ADR(why)))]); end;
        return;
    end;
    Buf.reset(ADR(why));
    Fmt.write(ADR(why), "{}\n\n{}", [Fmt.str(task), Fmt.str(report)]);
    Strs.push(ADR(a^.reports), Amsg.keep(Buf.bytes(ADR(why))));
    Fmt.write(out, "worker report ({} steps):\n{}", [Fmt.int(steps), Fmt.str(report)]);
end;


(* The calls of c's last message run, each result added to c as a
   tool's message: how many of them failed. Once the human says to
   stop, the calls left aren't run, but answered all the same, as a
   request must answer every call. *)
proc run(a: ^Agent; c: ^Astore.Conv): INT;
var calls: []Amsg.Call; res: Buf.Buf; m: ^Amsg.Msg; i, bad: INT;
begin
    Buf.init(ADR(res), Heap.heap);
    defer Buf.done(ADR(res));
    (* the calls stay where they are as messages are added: a message
       keeps its calls in memory of their own *)
    calls := Calls.all(ADR(Msgs.all(ADR(c^.msgs))[c^.msgs.len - 1].calls));
    bad := 0;
    for i := 0 to LEN(calls) - 1 do
        Buf.reset(ADR(res));
        if a^.front.call # nil then a^.front.call(calls[i].name, calls[i].args, a^.front.arg); end;
        if stopped(a) then
            Buf.str(ADR(res), Interrupted);
        elsif again(a, calls[i].name, calls[i].args) then
            Buf.str(ADR(res), Repeated);
        elsif calls[i].name = "delegate" then
            delegate(a, calls[i].args, ADR(res));
        else
            Atools.call(calls[i].name, calls[i].args, ADR(a^.human), ADR(a^.mem.base), ADR(res));
            Arena.reset(ADR(a^.mem));
        end;
        if a^.front.result # nil then a^.front.result(calls[i].name, Buf.bytes(ADR(res)), a^.front.arg); end;
        if failed(Buf.bytes(ADR(res))) then INC(bad); end;
        m := Msgs.add(ADR(c^.msgs));
        Amsg.init(m, Amsg.Role.tool);
        m^.callId := Amsg.keep(calls[i].id);
        m^.tool := Amsg.keep(calls[i].name);
        Amsg.setText(m, Buf.bytes(ADR(res)));
    end;
    return bad;
end;

(* The model asked once more, with c's system prompt, by request, a
   message of the human's that c doesn't keep: what it said, without
   its calls, into reply. The tools are still offered, so that the
   cache holds. *)
proc once*(a: ^Agent; c: ^Astore.Conv; request: []U8; reply, why: ^Buf.Buf): ERROR;
var sys: Buf.Buf; m: ^Amsg.Msg; n: INT; err: ERROR;
begin
    Buf.init(ADR(sys), Heap.heap);
    defer Buf.done(ADR(sys));
    system(a, c, ADR(sys));
    m := Msgs.add(ADR(c^.msgs));
    Amsg.init(m, Amsg.Role.user);
    Amsg.setText(m, request);
    n := c^.msgs.len;
    err := ask(a, c, Buf.bytes(ADR(sys)), why);
    (* the request taken out, and with it the reply *)
    if c^.msgs.len > n then
        m := ADR(Msgs.all(ADR(c^.msgs))[n]);
        Buf.str(reply, m^.text);
        Amsg.free(m);
    end;
    Amsg.free(ADR(Msgs.all(ADR(c^.msgs))[n - 1]));
    Msgs.resize(ADR(c^.msgs), n - 1);
    return err;
end;

(* The model asked, by a message of the human's that the conversation
   doesn't keep, to say where it got to, for the reason why: its reply
   kept without calls. The request is the turn's last one and one more
   step. *)
proc handBack(a: ^Agent; c: ^Astore.Conv; reason, request: []U8; why: ^Buf.Buf): ERROR;
var b: Buf.Buf; m: ^Amsg.Msg; err: ERROR;
begin
    Buf.init(ADR(b), Heap.heap);
    defer Buf.done(ADR(b));
    Buf.str(ADR(b), reason);
    Buf.str(ADR(b), "; asking the model to hand back");
    note(a, Buf.bytes(ADR(b)));
    Buf.reset(ADR(b));
    err := once(a, c, request, ADR(b), why);
    if b.len > 0 then
        m := Msgs.add(ADR(c^.msgs));
        Amsg.init(m, Amsg.Role.assistant);
        Amsg.setText(m, Buf.bytes(ADR(b)));
    end;
    return err;
end;

(* A turn of c, whose last message is the human's: run until the model
   answers, hands back, or the human stops it. nil then, or Awire's
   Stopped; Failed for a request that failed, why saying why. What the
   model said is in c either way, what it said for this turn alone
   dropped (Amsg.settle). *)
proc turn*(a: ^Agent; c: ^Astore.Conv; why: ^Buf.Buf): ERROR;
var sys, b: Buf.Buf; first, step, failing, calls, i, floor: INT; m: []Amsg.Msg; start: F64; err: ERROR;
begin
    first := c^.msgs.len;
    forget(a);
    Buf.init(ADR(sys), Heap.heap);
    defer Buf.done(ADR(sys));
    Buf.init(ADR(b), Heap.heap);
    defer Buf.done(ADR(b));
    if not a^.working then
        if a^.prefetch then attach(a, c); end;
        for i := 0 to a^.reports.len - 1 do Str.free(Heap.heap, Strs.all(ADR(a^.reports))[i]); end;
        Strs.reset(ADR(a^.reports));
    end;
    start := a^.spent;
    failing := 0;
    floor := 0;
    err := nil;
    for step := 1 to a^.maxSteps do
        (* once the history is long, and then each time it has grown by
           half again: rare cuts keep the cached prefix whole between them *)
        if (a^.prune > 0) and (size(c) > a^.prune) and (size(c) > floor + floor div 2) then
            prune(a, c);
            floor := size(c);
        end;
        system(a, c, ADR(sys));
        err := ask(a, c, Buf.bytes(ADR(sys)), why);
        if err # nil then break; end;
        calls := Msgs.all(ADR(c^.msgs))[c^.msgs.len - 1].calls.len;
        if calls = 0 then break; end;
        if run(a, c) = calls then INC(failing); else failing := 0; end;
        if stopped(a) then err := Awire.Stopped; break; end;
        if step = a^.maxSteps then
            Fmt.write(ADR(b), "{} steps used", [Fmt.int(a^.maxSteps)]);
            err := handBack(a, c, Buf.bytes(ADR(b)), StepsAsk, why);
        elsif failing = FailSteps then
            Fmt.write(ADR(b), "{} steps of failed calls in a row", [Fmt.int(FailSteps)]);
            err := handBack(a, c, Buf.bytes(ADR(b)), StuckAsk, why);
            break;
        elsif (a^.budget > 0.0) and (a^.spent - start > a^.budget) then
            Fmt.write(ADR(b), "turn budget of ${} spent", [Fmt.real(a^.budget, 2)]);
            err := handBack(a, c, Buf.bytes(ADR(b)), BudgetAsk, why);
            break;
        end;
    end;
    m := Msgs.all(ADR(c^.msgs));
    for i := first to LEN(m) - 1 do Amsg.settle(ADR(m[i])); end;
    return err;
end;

(* The module's test: prune. *)

proc main*: INT;
var a: Agent; p: Awire.Prov; c: Astore.Conv; m: ^Amsg.Msg; long: Buf.Buf; i: INT; t: []U8;
begin
    init(ADR(a), ADR(p), {});
    Astore.init(ADR(c), "test");
    Buf.init(ADR(long), Heap.heap);
    for i := 1 to 100 do Buf.str(ADR(long), "a line of a long result, 38 bytes....\n"); end;
    for i := 0 to 5 do
        m := Msgs.add(ADR(c.msgs));
        Amsg.init(m, Amsg.Role.assistant);
        Amsg.addCall(m, "c", "read", "{}", "");
        m := Msgs.add(ADR(c.msgs));
        Amsg.init(m, Amsg.Role.tool);
        Amsg.setText(m, Buf.bytes(ADR(long)));
    end;
    prune(ADR(a), ADR(c));
    for i := 0 to 5 do
        t := Msgs.all(ADR(c.msgs))[2 * i + 1].text;
        if (i < 2) # Str.hasSuffix(t, "\n[... 2660 more bytes, cut from the history as old; make the call again to see them]") then
            Out.str("Agent: prune\n");
            return 1;
        end;
    end;
    if not Str.hasPrefix(Msgs.all(ADR(c.msgs))[1].text, Buf.bytes(ADR(long))[0..1140]) then
        Out.str("Agent: prune keeps the head\n");
        return 1;
    end;
    return 0;
end;

end Agent.
