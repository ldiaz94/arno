(* Aprompt: the system prompt, what the model is told before the
   conversation.

   It is made of sections, in this order: arno's own instructions, or
   the conversation's own system prompt in their place; the workspace,
   where the model is and when; the human's context files; the
   project's map; the conversation's scratch directory; its artifacts
   directory, where what the human asks for is made; the project's
   notes; the facts the human asked arno to remember; and what arno is,
   with the commands and modes the human has. The mode's instructions,
   or a worker's, end it; Agent adds them.

   What describes the human or the project rather than the conversation,
   the context files, the map and the remembered facts, is found once,
   when the session starts (load), and kept: it outlives the
   conversation, and a system prompt that stays the same is one the
   provider can cache. The notes are read for every request, so that a
   note the model keeps counts from its next step; and so is the scratch
   directory, which is the conversation's and changes with it.

   Context files are AGENTS.md and CLAUDE.md, in the home directory, in
   ~/.claude, and in each directory from just below home down to the
   working one, so that a ~/lib/CLAUDE.md shared by the projects under
   it counts too; outside home, in the project's root and the working
   directory; last, arno's own for the project, projects/ROOT in its
   directory, where what other tools learned of the project is kept
   outside its repository (arno-claude writes it). Each brings the
   files it names with @path, to five levels.
   They go general first, so that the more particular one comes later,
   where it reads as the last word. config's context_files decides
   whether they are read: ask (the default) says what was found and
   asks, once for the project, the answer kept in context.json; yes
   reads them; no never looks. Asking is the default
   because a context file comes with the repository, not from the
   human, and what it names, which may be anywhere on the disk, goes to
   the provider with every request: the list shows what that would be
   before anything is sent.

   The commands and the modes are written down once, here, in Commands
   and Modes: /help shows the same tables the model reads, so that
   neither drifts from what arno does.

   Depends on Aahead (the map and the notes), Amemory (the facts),
   Afence, Astore (the date), Atools (how the human is asked), Apeer (the
   editor's section, while one is reachable) and Awire (the provider). *)
module Aprompt;
import Aahead, Amemory, Afence, Astore, Atools, Apeer, Awire, Buf, Str, Sys, Files, Fmt, Heap, Mem, Arena, Out, Rt,
    Strs := Vec([]const U8);
import SYSTEM;

type
    (* How the model is to work, which the human picks. review and
       improve only look: they aren't offered the tools that change
       files, so that a review can't turn into changes nobody asked for.
       build leads workers, and changes nothing before the human
       approves its plan (Agent). *)
    Mode* = (chat, review, improve, pair, build);

    ModeInfo* = record
        name*: []const U8;
        hint*: []const U8;   (* what it is for, as /help shows it *)
        text*: []const U8;   (* what the model is told *)
    end;

    Command* = record
        name*: []const U8;
        args*: []const U8;   (* its argument, [in brackets] if it may be left out; "" for none *)
        desc*: []const U8;
    end;

const
    ContextKept = "context.json";   (* where the answer about the context files is kept, by project *)
    Modes*: [5]ModeInfo = [
        {name: "chat", hint: "questions, explanations, small edits",
            text: "Mode: chat. Answer what is asked: explain, compare, discuss. Do not propose patches, " +
            "sketches or lists of what could be changed unless the human asks for a change; then keep it small."},
        {name: "review", hint: "review changes or named code for bugs; no edits",
            text: "Mode: code review. Review what the human names, or else the uncommitted changes (git status " +
            "and git diff). Report concrete problems, most severe first: bugs, then risks, then clarity. Cite " +
            "path:line and say why each matters. If nothing is wrong, say so."},
        {name: "improve", hint: "propose simplifications and clean-ups; no edits",
            text: "Mode: suggest improvements. Study the code the human points at and propose a few specific " +
            "improvements (simpler, faster, clearer), each with a short reason and a small sketch. Prefer " +
            "removing code to adding it."},
        {name: "pair", hint: "build a feature together, step by step",
            text: "Mode: pairing on a feature. Make sure you understand the goal; ask when it is ambiguous. Read " +
            "the relevant code, propose a short plan, then carry it out in small edits, one step at a time, and " +
            "stop after each step so the human can check it."},
        {name: "build", hint: "plan with the human, then lead workers through it",
            text: "Mode: build. You lead: you plan, hand the steps to workers, and review what they did.\n" +
            "1. Plan first. Settle the goal with the human, asking what is unclear, and read enough of the code " +
            "to plan well. Then call plan with the plan: the goal, the steps in order, each with the files it " +
            "touches and how it is checked, and what is left out. Nothing is edited or delegated until the human " +
            "approves a plan; when they decline, revise it as they say and call plan again. A new goal needs a " +
            "new plan.\n" +
            "2. Carry it out. When delegate is offered, hand each step to a worker; when it is not, do the steps " +
            "yourself. A worker starts blank and sees only your brief, so brief it richly: the paths, the exact " +
            "excerpts and signatures it needs, quoted rather than left to find, the project's rules that matter, " +
            "and done_when. Pass on what earlier workers found and read, so that nobody reads it again. Prefer a " +
            "few larger steps to many small ones. Steps that don't wait on each other's reports can go out " +
            "together, several delegate calls in one reply: staged, their workers run side by side. Tell each worker to batch its probes, several commands to a " +
            "call. A worker that ran out of steps reports where it got to: the next one's brief starts there. " +
            "When delegate lists several models, choose one per step: a stronger one for a hard or delicate step, " +
            "a cheaper one for mechanical work, and say which, and why, in a line of your reasoning.\n" +
            "3. Review each worker's report and its changes, and run check. Staged, a worker works in a copy of " +
            "its own and hands back a diff: read it, then merge it into your copy or drop it. A worker's " +
            "\"nothing found\" is a claim like any other: check it against the code before you pass it on, the " +
            "riskiest first.\n" +
            "4. Fix only small things yourself, a few lines; anything more goes back to a worker with what is " +
            "wrong and where.\n" +
            "A read-only job, a survey or an audit, runs the same way: the steps are areas, there is nothing " +
            "to merge, and you end with a report whose every finding and every all-clear you have checked.\n" +
            "End with what was built, check's verdict, and what is left."}];

    Commands*: []Command = [
        {name: "/help", args: "", desc: "keys and commands"},
        {name: "/new", args: "", desc: "start a new conversation"},
        {name: "/clear", args: "", desc: "trim history to the first exchange"},
        {name: "/compact", args: "[FOCUS]", desc: "replace history with a summary of it"},
        {name: "/list", args: "[WORD]", desc: "recent conversations, filtered by title"},
        {name: "/load", args: "N|ID|WORD", desc: "resume a conversation"},
        {name: "/export", args: "[N|ID]", desc: "print a conversation as JSON"},
        {name: "/open", args: "[FILE]", desc: "open an artifact, the newest if none is named"},
        {name: "/rename", args: "TITLE", desc: "name this conversation"},
        {name: "/system", args: "[TEXT|-]", desc: "show or set this conversation's own system prompt, - for arno's"},
        {name: "/mode", args: "[NAME]", desc: "show or set the mode"},
        {name: "/budget", args: "[DOLLARS]", desc: "show or set what a turn may spend, workers included"},
        {name: "/model", args: "[NAME]", desc: "show or set the model"},
        {name: "/models", args: "", desc: "list the provider's models"},
        {name: "/provider", args: "[NAME]", desc: "show or set the provider"},
        {name: "/tools", args: "", desc: "list tools"},
        {name: "/view", args: "[lead|all|N]", desc: "show the lead's entries, every one, or worker N's; on the screen"},
        {name: "/mcp", args: "[login NAME]", desc: "what became of each MCP server; log in to one"},
        {name: "/usage", args: "", desc: "tokens and cost of this session"},
        {name: "/remember", args: "[#tag,...] FACT", desc: "remember a fact, for every future conversation"},
        {name: "/forget", args: "TAG|WORD", desc: "forget memories matching a tag or word"},
        {name: "/my-memory", args: "[TAG]", desc: "list remembered facts"},
        {name: "/notes", args: "[forget N|WORD]", desc: "list the model's notes on this project, or forget some"},
        {name: "/test", args: "[COMMAND]", desc: "run the project's test command, or set it; ask about failures"},
        {name: "/safety", args: "[auto|safe]", desc: "auto: work on a copy, one diff a turn; safe: each change asked"},
        {name: "/stage", args: "[drop]", desc: "the copy's changes offered, or dropped"},
        {name: "/quit", args: "", desc: "leave (also ^D)"}];

    MaxDepth = 5;   (* files a context file brings, and they bring, and so on *)
    Names: [][]const U8 = ["AGENTS.md", "CLAUDE.md"];

    (* arno's own instructions, which a conversation's own system prompt
       replaces *)
    Own* = "You are Arno, a terse coding assistant working beside a programmer in their " +
        "terminal.\n\n" +
        "# How to work\n" +
        "- Look before you answer: search and read the code rather than guess. Never make up " +
        "file contents, paths or tool results.\n" +
        "- Find before you read, read before you edit: find or grep to locate code, then read " +
        "it to see its exact current text, always right before an edit.\n" +
        "- When you need a tool, call it in this same reply. Do not say you are about to call " +
        "one and then stop, and do not ask permission to read or search.\n" +
        "- Calls that do not depend on each other, such as reading three files, go together " +
        "in one reply.\n" +
        "- If a call fails or finds nothing, change your approach; never repeat the same call.\n" +
        "- The human is your best source. When a few searches have come up empty, or the " +
        "answer turns on what they intend (which feature, which of two places, whether a " +
        "change is wanted), stop and ask them one clear question instead of searching on.\n" +
        "- Edit only when asked, in small exact replacements. The human approves each edit; " +
        "never repeat a declined one. When they say why, the reason follows \"declined by user:\" " +
        "and tells you what to do instead; when they do not, ask what they want.\n" +
        "- After changing code, run check if it is on offer, and fix what it reports. Run the " +
        "narrowest check that covers a change first, and the whole one before you finish. Build and " +
        "check after each piece of a larger change, not only at the end, and before saying " +
        "something works, run what you built on that very case.\n" +
        "- Find out how something behaves once, in one batch of tries, then use what you " +
        "learned; do not probe the same thing again.\n" +
        "- Answer briefly, in light markdown. Refer to code as path:line.\n\n" +
        "# Exploring code\n" +
        "Every step resends the whole conversation, so make each one count.\n" +
        "- Orient once: the project map below, when there is one, gives the layout; outline " +
        "a directory for the rest.\n" +
        "- Definitions of names in the human's message may already be attached to it: use " +
        "those before searching.\n" +
        "- Found something only by searching, that the next session would search for too " +
        "(where a feature lives, an unexpected layout)? Keep it with note.";

type
    (* What lasts the session, each a section of the prompt or "". *)
    Prompt* = record
        context: Buf.Buf;
        map: Buf.Buf;
        memory: Buf.Buf;
    end;

    (* The context files found, and the paths they were found by. *)
    Found = record
        mem: ^Mem.Allocator;
        home: []const U8;
        seen: Strs.Vec;     (* the files taken, resolved *)
        names: Buf.Buf;     (* their paths, ~ for home, ", " between *)
        text: Buf.Buf;      (* their blocks *)
    end;

(* Context files *)

(* The @paths in a context file's text, pushed on l as written: an @ at
   the start of a line or after a blank or a (, up to the next blank,
   less the punctuation that ends a sentence; not in a code span or a
   fenced block. *)
proc imports(s: []const U8; var l: Strs.Vec);
var ref: []const U8; i, j: INT; fenced, ticked, bol: BOOL;
begin
    fenced := false;
    ticked := false;
    bol := true;
    i := 0;
    while i < LEN(s) do
        if bol and Str.hasPrefix(s[i..LEN(s)], "```") then fenced := not fenced; end;
        bol := s[i] = '\n';
        if bol then
            ticked := false;
        elsif s[i] = '`' then
            ticked := not ticked;
        elsif (s[i] = '@') and not fenced and not ticked and
            ((i = 0) or (s[i - 1] = ' ') or (s[i - 1] = '\t') or (s[i - 1] = '(')) then
            j := i + 1;
            while (j < LEN(s)) and (s[j] # ' ') and (s[j] # '\t') and (s[j] # '\n') and (s[j] # '`') do INC(j); end;
            ref := s[i + 1..j];
            while (LEN(ref) > 0) and (Str.find(",.;:)?!", ref[LEN(ref) - 1..LEN(ref)]) >= 0) do
                ref := ref[0..LEN(ref) - 1];
            end;
            if LEN(ref) > 0 then Strs.push(l, ref); end;
            i := j;
            continue;
        end;
        INC(i);
    end;
end;

(* The context file at path taken, if it is one not taken yet, and the
   files it names after it, depth the levels above it. *)
proc take(var f: Found; path: []const U8; depth: INT);
var r, text, p: Buf.Buf; refs: Strs.Vec; s, nice: []const U8; seen, l: [][]const U8; i: Sys.Info; e, k: INT;
begin
    Buf.init(r, f.mem);
    Afence.resolve(path, r);
    seen := Strs.all(f.seen);
    for k := 0 to LEN(seen) - 1 do
        if seen[k] = Buf.bytes(r) then return; end;
    end;
    i, e := Sys.info(Buf.bytes(r));
    if (e # 0) or not i.file then return; end;
    Buf.init(text, f.mem);
    if Files.load(Buf.bytes(r), text) # 0 then return; end;
    s := Buf.bytes(text);
    k := LEN(s);
    if k > 8192 then k := 8192; end;
    if Str.find(s[0..k], "\x00") >= 0 then return; end;
    Strs.push(f.seen, Buf.bytes(r));
    nice := Buf.bytes(r);
    if Str.hasPrefix(nice, f.home) and (LEN(nice) > LEN(f.home)) and (nice[LEN(f.home)] = '/') then
        Buf.init(p, f.mem);
        Buf.add(p, '~');
        Buf.str(p, nice[LEN(f.home)..LEN(nice)]);
        nice := Buf.bytes(p);
    end;
    Aahead.block(f.text, nice, "", s);
    Buf.add(f.text, '\n');
    if f.names.len > 0 then Buf.str(f.names, ", "); end;
    Buf.str(f.names, nice);
    if depth >= MaxDepth then return; end;
    Strs.init(refs, f.mem);
    imports(s, refs);
    l := Strs.all(refs);
    for k := 0 to LEN(l) - 1 do
        Buf.init(p, f.mem);
        if Str.hasPrefix(l[k], "~/") then
            Buf.str(p, f.home);
            Buf.str(p, l[k][1..LEN(l[k])]);
        elsif Str.hasPrefix(l[k], "/") then
            Buf.str(p, l[k]);
        else
            Buf.str(p, Buf.bytes(r)[0..Str.findLast(Buf.bytes(r), "/") + 1]);
            Buf.str(p, l[k]);
        end;
        take(f, Buf.bytes(p), depth + 1);
    end;
end;

(* Every context file of the directories dirs, general first, into f. *)
proc context(var f: Found; dirs: [][]const U8);
var p: Buf.Buf; i, k: INT;
begin
    Buf.init(p, f.mem);
    for i := 0 to LEN(dirs) - 1 do
        for k := 0 to LEN(Names) - 1 do
            Buf.reset(p);
            Buf.str(p, dirs[i]);
            Buf.add(p, '/');
            Buf.str(p, Names[k]);
            take(f, Buf.bytes(p), 0);
        end;
    end;
end;

(* The directories whose context files count, general first, pushed on
   l: home, ~/.claude, and each from just below home down to the
   working directory; outside home, the project's root and the working
   directory instead; then arno's own for the project. *)
proc places(const f: Found; var l: Strs.Vec);
var b, wd: Buf.Buf; down: Strs.Vec; d: []const U8; all: [][]const U8; i: INT;
begin
    Buf.init(b, f.mem);
    Buf.init(wd, f.mem);
    Strs.init(down, f.mem);
    Strs.push(l, f.home);
    Buf.str(b, f.home);
    Buf.str(b, "/.claude");
    Strs.push(l, Buf.bytes(b));
    Afence.resolve(".", wd);
    d := Buf.bytes(wd);
    if Afence.within(d, f.home) and (d # f.home) then
        while d # f.home do
            Strs.push(down, d);
            d := d[0..Str.findLast(d, "/")];
        end;
        all := Strs.all(down);
        for i := LEN(all) - 1 to 0 by -1 do Strs.push(l, all[i]); end;
    elsif d # f.home then
        Strs.push(l, Afence.zone);
        Strs.push(l, d);
    end;
    if Afence.rooted then
        Buf.init(b, f.mem);
        Fmt.write(b, "{}projects{}", [Fmt.str(Astore.dir()), Fmt.str(Afence.root)]);
        Strs.push(l, Buf.bytes(b));
    end;
end;

(* The prompt *)

(* Whether the context files found are to be read, as mode says: yes
   does, no doesn't, ask goes by the human's answer kept for this
   project, else asks through h and keeps it. With no answer kept and
   nobody to ask, they are left out, said through say. A no, kept, is
   said too, so that the human knows what to change. *)
proc wanted(mode: []const U8; const h: Atools.Human; say: Aahead.Said): BOOL;
var b: Buf.Buf; kept: []const U8; key: U8;
begin
    if mode = "yes" then return true; end;
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    kept := Astore.keyed(ContextKept, Afence.root, b);
    if kept = "yes" then return true; end;
    if kept = "" then
        key := 0;
        if h.ask # nil then key := h.ask(h.who, "read them into every request?", "", "yn"); end;
        if key = 'y' then _ := Astore.setKeyed(ContextKept, Afence.root, "yes"); return true; end;
        if key # 0 then
            _ := Astore.setKeyed(ContextKept, Afence.root, "no");
        elsif say # nil then
            say("context files left out: nobody to ask; ask once in a terminal, or set context_files in config", h.arg);
            return false;
        end;
    end;
    if say # nil then say("context files left out; context_files = yes in config reads them", h.arg); end;
    return false;
end;

(* The context files of home, the home directory, made p's section, as
   mode says; the human asked through h if it says ask. *)
proc readContext(var p: Prompt; home, mode: []const U8; const h: Atools.Human; say: Aahead.Said; mem: ^Mem.Allocator);
var f: Found; dirs: Strs.Vec; b: Buf.Buf;
begin
    Buf.reset(p.context);
    if mode = "no" then return; end;
    Buf.init(b, mem);
    Afence.resolve(home, b);
    f := {mem: mem, home: Buf.bytes(b)};
    Strs.init(f.seen, mem);
    Buf.init(f.names, mem);
    Buf.init(f.text, mem);
    Strs.init(dirs, mem);
    places(f, dirs);
    context(f, Strs.all(dirs));
    if f.text.len = 0 then return; end;
    Buf.init(b, mem);
    Fmt.write(b, "context files: {}", [Fmt.str(Buf.bytes(f.names))]);
    if say # nil then say(Buf.bytes(b), h.arg); end;
    if not wanted(mode, h, say) then return; end;
    Buf.str(p.context, "# Context files\nStanding instructions from the human's context files. Follow " +
        "them. Where two disagree, the later one is more specific and wins.\n\n");
    Buf.str(p.context, Str.trimRight(Buf.bytes(f.text)));
end;

(* p made for the session: the context files, as config's context_files
   (mode) says, the human asked through h if it says ask; the map, if
   map; the remembered facts. What arno does is said through say. *)
proc load*(var p: Prompt; mode: []const U8; map: BOOL; const h: Atools.Human; say: Aahead.Said);
var ar: Arena.Arena;
begin
    Buf.init(p.context, Heap.heap);
    Buf.init(p.map, Heap.heap);
    Buf.init(p.memory, Heap.heap);
    if not Arena.init(ar, 1 shl 26) then return; end;
    defer Arena.done(ar);
    readContext(p, Sys.env("HOME"), mode, h, say, SYSTEM.ADR(ar.base));
    if map then Aahead.map(SYSTEM.ADR(ar.base), p.map); end;
    Amemory.section(SYSTEM.ADR(ar.base), p.memory);
end;

var host: []U8;   (* the "# Host" section, from the program that drives arno; "" for none *)

(* The program that drives this session is name, and tells the model
   more of itself in text, if any: a section of every prompt from now
   on. *)
proc setHost*(name, text: []const U8);
var b: Buf.Buf; ok: BOOL;
begin
    Buf.init(b, Heap.heap);
    defer Buf.done(b);
    Fmt.write(b, "# Host\nYou are running inside {}, a program the human is using, which drives this " +
        "session: it shows the conversation, asks the human your questions, and runs the tools it added.",
        [Fmt.str(name)]);
    if LEN(Str.trim(text)) > 0 then
        Buf.add(b, '\n');
        Buf.str(b, Str.trim(text));
    end;
    Str.free(Heap.heap, host);
    host, ok := Str.copy(Heap.heap, Buf.bytes(b));
    if not ok then Rt.stop("arno: out of memory"); end;
end;

(* p's remembered facts read again, after the human changed them. *)
proc remembered*(var p: Prompt);
var ar: Arena.Arena;
begin
    if not Arena.init(ar, 1 shl 24) then return; end;
    defer Arena.done(ar);
    Buf.reset(p.memory);
    Amemory.section(SYSTEM.ADR(ar.base), p.memory);
end;

(* Command c as /help shows it, its argument after its name, added to b. *)
proc usage*(c: Command; var b: Buf.Buf);
begin
    Buf.str(b, c.name);
    if LEN(c.args) > 0 then
        Buf.add(b, ' ');
        Buf.str(b, c.args);
    end;
end;

(* The stage section of the system prompt, while the stage is up: the
   "How to work" rule that the human approves each edit does not hold,
   and a model not told so asks leave, or leaves the work as a plan. *)
proc stageText(var out: Buf.Buf);
begin
    Fmt.write(out, "\n\n# Stage\nYou work on a copy of the human's project, at {}; their own tree at {} is not " +
        "touched until they say so. Edit, move and remove in the copy are not asked about one by one: when " +
        "your turn ends, the human sees all you changed as one diff and applies it or not. So carry the work " +
        "through to a checked result in this turn, and work only in the copy, never in {}. The " +
        "project's dependencies (node_modules, .venv) are the human's and read-only here, with no " +
        "network: to add or change one, change the manifest and ask the human to install it.",
        [Fmt.str(Afence.stage), Fmt.str(Afence.root), Fmt.str(Afence.root)]);
    if Atools.shellOn() then
        Buf.str(out, " Where shell is on offer, build and run freely in the copy: it is sandboxed, and nothing it " +
            "does leaves the copy but the diff.");
    end;
end;

(* The artifacts section of the system prompt: a document, a page, a
   drawing or a sheet the human asks for is made as a file in dir and
   its path told. The text kinds are written with edit; the others are
   made from text by a program the machine has, through run or shell,
   in the jail, whose home is read-only: hence soffice's own profile. *)
proc artifacts(var out: Buf.Buf; dir: []const U8);
begin
    Fmt.write(out, "\n\n# Artifacts\nWhen the human asks for a document, a page, a drawing or a sheet, rather " +
        "than code in the project, make it as a file in {}, which outlasts the conversation, and end by " +
        "saying its full path. Work files that are not the artifact go in the scratch. Markdown, HTML, " +
        "SVG and tiza drawings (.tiza, described in man 5 tiza) are text: write them with edit. The human sees " +
        "markdown as a styled web page, its YAML front matter's title and subtitle at its head. An HTML page " +
        "stands alone, its styles and scripts inline. The rest are made from text, with run or shell where " +
        "they are offered:\n" +
        "- docx: pandoc in.md -o out.docx\n" +
        "- xlsx: soffice --headless -env:UserInstallation=file://$ARNO_SCRATCH/lo --convert-to xlsx " +
        "--outdir {} in.csv\n" +
        "- png or svg of a drawing: tiza -o out.png in.tiza\n" +
        "- png of an svg: rsvg-convert -o out.png in.svg\n" +
        "Where neither is offered, write the source, say so, and give the command for the human to run.",
        [Fmt.str(dir), Fmt.str(dir)]);
end;

(* The system prompt of c's next request, in mode, added to out: c's
   own system prompt, or Own, then the sections. mem is for the work,
   say for a note dropped as stale. *)
proc write*(const p: Prompt; const c: Astore.Conv; const prov: Awire.Prov; mode: Mode; mem: ^Mem.Allocator; say: Aahead.Said;
    arg: ^U8; var out: Buf.Buf);
var dir: []const U8; e, at, i: INT;
begin
    if LEN(c.system) > 0 then Buf.str(out, c.system); else Buf.str(out, Own); end;
    Buf.str(out, "\n\n# Workspace\nWorking directory: ");
    dir, e := Sys.workDir();
    if e = 0 then Buf.str(out, dir); end;
    Fmt.write(out, ". Project root: {}. Date: ", [Fmt.str(Afence.zone)]);
    Astore.date(out);
    Buf.add(out, '.');
    if p.context.len > 0 then
        Buf.str(out, "\n\n");
        Buf.str(out, Buf.bytes(p.context));
    end;
    if p.map.len > 0 then
        Buf.str(out, "\n\n");
        Buf.str(out, Buf.bytes(p.map));
    end;
    if LEN(Afence.scratch) > 0 then
        Fmt.write(out, "\n\n# Scratch\n{} is yours to write, for this conversation: fixture trees, throwaway " +
            "files, output to compare. Nothing of the human's is there, so edit, move and remove in it are not " +
            "asked about, and check and run see its path as $ARNO_SCRATCH. What should last belongs in the " +
            "project, or, if the human asked for it, among the artifacts.", [Fmt.str(Afence.scratch)]);
    end;
    if LEN(Afence.artifacts) > 0 then artifacts(out, Afence.artifacts); end;
    if LEN(Afence.stage) > 0 then stageText(out); end;
    if Apeer.reachable() then
        Buf.str(out, "\n\n");
        Buf.str(out, Apeer.SystemText);
    end;
    if LEN(host) > 0 then
        Buf.str(out, "\n\n");
        Buf.str(out, host);
    end;
    at := out.len;
    Buf.str(out, "\n\n");
    Aahead.notes(mem, say, arg, out);
    if out.len = at + 2 then out.len := at; end;
    if p.memory.len > 0 then
        Buf.str(out, "\n\n");
        Buf.str(out, Buf.bytes(p.memory));
    end;
    Buf.str(out, "\n\n# About Arno\nYou run inside Arno, a small terminal harness. The human types messages, or " +
        "commands that you cannot run yourself:");
    for i := 0 to LEN(Commands) - 1 do
        Buf.str(out, "\n  ");
        usage(Commands[i], out);
        Fmt.write(out, " - {}", [Fmt.str(Commands[i].desc)]);
    end;
    Fmt.write(out, "\nModes (current: {}):", [Fmt.str(Modes[INT(mode)].name)]);
    for i := 0 to LEN(Modes) - 1 do Fmt.write(out, "\n  {} - {}", [Fmt.str(Modes[i].name), Fmt.str(Modes[i].hint)]); end;
    Fmt.write(out, "\nProvider {}, model {}. The " +
        "config file is ~/.config/arno/config; arno(1) documents its keys. Your file tools reach {} and below " +
        "without asking; for any other path the human is asked first, and a refusal is final: do not look for " +
        "a way around it. When asked how Arno works, answer from this.",
        [Fmt.str(prov.name), Fmt.str(prov.model), Fmt.str(Afence.zone)]);
end;

(* The module's test, in build/prompt, which it makes. *)

var failed: BOOL;

proc expect(what, got, want: []const U8);
begin
    if got = want then return; end;
    Out.str("Aprompt: ");
    Out.str(what);
    Out.str(":\n");
    Out.str(got);
    Out.str("\nnot\n");
    Out.str(want);
    Out.ln;
    failed := true;
end;

(* "read" if p's context files were read, else "". *)
proc read(const p: Prompt): []const U8;
begin
    if p.context.len > 0 then return "read"; end;
    return "";
end;

(* The human who answers yes. *)
proc yes(_who: INT; _question, _detail, _keys: []const U8): U8;
begin
    return 'y';
end;

proc no(_who: INT; _question, _detail, _keys: []const U8): U8;
begin
    return 'n';
end;

proc main*: INT;
var p: Prompt; h: Atools.Human; l: Strs.Vec; b, own: Buf.Buf; dir: []const U8; i: INT;
begin
    Strs.init(l, Heap.heap);
    imports("see @a.md, and (@~/b.md).\n```\n@not\n```\n`@nor` @/c/d.md\nx@y", l);
    Buf.init(b, Heap.heap);
    Str.join(b, Strs.all(l), " ");
    expect("imports", Buf.bytes(b), "a.md ~/b.md /c/d.md");

    _ := Sys.makeDir("build");
    _ := Sys.makeDir("build/prompt");
    _ := Sys.makeDir("build/prompt/home");
    _ := Sys.makeDir("build/prompt/home/proj");
    _ := Sys.makeDir("build/prompt/home/proj/.git");
    _ := Sys.makeDir("build/prompt/data");
    _ := Files.write("build/prompt/home/CLAUDE.md", "general, and @more.md\n");
    _ := Files.write("build/prompt/home/more.md", "more\n");
    _ := Files.write("build/prompt/home/proj/AGENTS.md", "particular, and @../more.md again\n");
    _ := Files.write("build/prompt/data/memory.json", `[{"fact":"likes tea","tags":["me","x"],"created":"t"}]`);
    dir, _ := Sys.workDir();
    dir, _ := Str.copy(Heap.heap, dir);
    Buf.reset(b);
    Buf.str(b, dir);
    Buf.str(b, "/build/prompt/data/");
    Astore.use(Buf.bytes(b));
    Buf.init(b, Heap.heap);
    Buf.str(b, dir);
    Buf.str(b, "/build/prompt/home");
    if Sys.setWorkDir("build/prompt/home/proj") # 0 then Out.str("Aprompt: no build/prompt\n"); return 1; end;
    Afence.init;
    h := {ask: no};
    load(p, "no", false, h, nil);
    readContext(p, Buf.bytes(b), "yes", h, nil, Heap.heap);
    expect("context", Buf.bytes(p.context), "# Context files\nStanding instructions from the human's " +
        "context files. Follow them. Where two disagree, the later one is more specific and wins.\n\n" +
        "<file path=\"~/CLAUDE.md\">\ngeneral, and @more.md\n</file>\n<file path=\"~/more.md\">\nmore\n</file>\n" +
        "<file path=\"~/proj/AGENTS.md\">\nparticular, and @../more.md again\n</file>");
    expect("memory", Buf.bytes(p.memory), "# Remembered facts\nAbout the human and this project:\n" +
        "  - likes tea [me,x]");
    readContext(p, Buf.bytes(b), "ask", h, nil, Heap.heap);
    expect("context, declined", Buf.bytes(p.context), "");
    h := {ask: yes};
    readContext(p, Buf.bytes(b), "ask", h, nil, Heap.heap);
    expect("context, declined stays", read(p), "");
    _ := Astore.setKeyed(ContextKept, Afence.root, "");
    readContext(p, Buf.bytes(b), "ask", h, nil, Heap.heap);
    expect("context, accepted", read(p), "read");
    h := {ask: nil};
    readContext(p, Buf.bytes(b), "ask", h, nil, Heap.heap);
    expect("context, accepted is kept", read(p), "read");
    _ := Astore.setKeyed(ContextKept, Afence.root, "");
    readContext(p, Buf.bytes(b), "ask", h, nil, Heap.heap);
    expect("context, nobody to ask", read(p), "");
    (* arno's own for the project, last *)
    Buf.init(own, Heap.heap);
    Fmt.write(own, "{}projects{}/", [Fmt.str(Astore.dir()), Fmt.str(Afence.root)]);
    for i := 1 to own.len - 1 do
        if Buf.bytes(own)[i] = '/' then _ := Sys.makeDir(Buf.bytes(own)[0..i]); end;
    end;
    Buf.str(own, "AGENTS.md");
    _ := Files.write(Buf.bytes(own), "kept by arno\n");
    readContext(p, Buf.bytes(b), "yes", h, nil, Heap.heap);
    if Str.find(Buf.bytes(p.context), "kept by arno") < Str.find(Buf.bytes(p.context), "particular") then
        expect("arno's own, last", Buf.bytes(p.context), "it after the project's");
    end;
    _ := Sys.remove(Buf.bytes(own));
    _ := Sys.setWorkDir(dir);
    if failed then return 1; end;
    return 0;
end;

end Aprompt.
