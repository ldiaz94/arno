(* Amemory: the facts the human asked arno to remember, for every
   conversation to come: /remember, /forget and /my-memory, and the
   section of the system prompt they make.

   They are kept in memory.json, in arno's directory, as the Pascal
   arno kept them: an array of {"fact", "tags", "created"}, the date a
   fact was remembered as yyyy-mm-dd. Another session may change the
   file at any time, so each change reads it again under Astore's lock.

   Depends on Astore (the directory, the lock, the date) and rjson's
   Json. *)
module Amemory;
import Astore, Json, Buf, Str, Sys, Files, Heap, Mem, Arena, Rt, Out;
import SYSTEM;

(* memory.json's path, into b. *)
proc file(var b: Buf.Buf): []const U8;
begin
    Buf.str(b, Astore.dir());
    Buf.str(b, "memory.json");
    return Buf.bytes(b);
end;

(* memory.json read into d: its array, None if there is no file or it
   isn't one. *)
proc read(d: ^Json.Doc; mem: ^Mem.Allocator): Json.Value;
var path, text: Buf.Buf; v: Json.Value;
begin
    Buf.init(path, mem);
    Buf.init(text, mem);
    if Files.load(file(path), text) # 0 then return Json.None; end;
    v := Json.parse(d, Buf.bytes(text));
    if Json.kind(d, v) # Json.Kind.array then return Json.None; end;
    return v;
end;

(* Whether s holds word, in any case. *)
proc holds(s, word: []const U8; mem: ^Mem.Allocator): BOOL;
var a, b: Buf.Buf;
begin
    Buf.init(a, mem);
    Buf.init(b, mem);
    Buf.str(a, s);
    Buf.str(b, word);
    Str.lower(Buf.bytes(a));
    Str.lower(Buf.bytes(b));
    return Str.find(Buf.bytes(a), Buf.bytes(b)) >= 0;
end;

(* Whether fact m has the tag tag, in any case. *)
proc tagged(d: ^Json.Doc; m: Json.Value; tag: []const U8): BOOL;
var tags: Json.Value; k: INT;
begin
    tags := Json.member(d, m, "tags");
    for k := 0 to Json.len(d, tags) - 1 do
        if Str.eqFold(Json.text(d, Json.item(d, tags, k)), tag) then return true; end;
    end;
    return false;
end;

(* Fact m on a line, as " [a,b]" after it shows its tags, added to out. *)
proc line(d: ^Json.Doc; m: Json.Value; var out: Buf.Buf);
var tags: Json.Value; k: INT;
begin
    Buf.str(out, Json.text(d, Json.member(d, m, "fact")));
    tags := Json.member(d, m, "tags");
    for k := 0 to Json.len(d, tags) - 1 do
        if k = 0 then Buf.str(out, " ["); else Buf.add(out, ','); end;
        Buf.str(out, Json.text(d, Json.item(d, tags, k)));
    end;
    if Json.len(d, tags) > 0 then Buf.add(out, ']'); end;
end;

(* text written as memory.json. *)
proc save(text: []const U8; mem: ^Mem.Allocator);
var path: Buf.Buf;
begin
    Buf.init(path, mem);
    _ := Astore.replace(file(path), text);
end;

(* Fact m added to b, an array begun: after a comma if it isn't the
   array's first. *)
proc add(d: ^Json.Doc; m: Json.Value; var b: Buf.Buf);
begin
    if Buf.bytes(b)[b.len - 1] # '[' then Buf.add(b, ','); end;
    Json.write(d, SYSTEM.ADR(b), m, {});
end;

(* The "# Remembered facts" section of the system prompt, added to out;
   nothing if there are none. *)
proc section*(mem: ^Mem.Allocator; var out: Buf.Buf);
var d: Json.Doc; v: Json.Value; i: INT;
begin
    if not Json.init(SYSTEM.ADR(d), mem) then return; end;
    v := read(SYSTEM.ADR(d), mem);
    if Json.len(SYSTEM.ADR(d), v) = 0 then return; end;
    Buf.str(out, "# Remembered facts\nAbout the human and this project:");
    for i := 0 to Json.len(SYSTEM.ADR(d), v) - 1 do
        Buf.str(out, "\n  - ");
        line(SYSTEM.ADR(d), Json.item(SYSTEM.ADR(d), v, i), out);
    end;
end;

(* fact remembered, with the tags in tags, which commas part. *)
proc remember*(fact, tags: []const U8; mem: ^Mem.Allocator);
var d: Json.Doc; b, all: Buf.Buf; v: Json.Value; t, rest: []const U8; i, n: INT; more: BOOL;
begin
    if not Json.init(SYSTEM.ADR(d), mem) then return; end;
    Buf.init(b, mem);
    Buf.init(all, mem);
    Buf.str(b, `{"fact":`);
    Json.quote(SYSTEM.ADR(b), fact);
    Buf.str(b, `,"tags":[`);
    n := 0;
    rest := tags;
    more := LEN(rest) > 0;
    while more do
        t, rest, more := Str.cut(rest, ",");
        if LEN(t) = 0 then continue; end;
        if n > 0 then Buf.add(b, ','); end;
        Json.quote(SYSTEM.ADR(b), t);
        INC(n);
    end;
    Buf.str(b, `],"created":"`);
    Astore.date(b);
    Buf.str(b, `"}`);
    Astore.lock;
    v := read(SYSTEM.ADR(d), mem);
    Buf.str(all, "[");
    for i := 0 to Json.len(SYSTEM.ADR(d), v) - 1 do add(SYSTEM.ADR(d), Json.item(SYSTEM.ADR(d), v, i), all); end;
    if all.len > 1 then Buf.add(all, ','); end;
    Buf.str(all, Buf.bytes(b));
    Buf.add(all, ']');
    save(Buf.bytes(all), mem);
    Astore.unlock;
end;

(* Every fact with the tag word, or that holds it, in any case,
   forgotten: how many. *)
proc forget*(word: []const U8; mem: ^Mem.Allocator): INT;
var d: Json.Doc; b: Buf.Buf; v, m: Json.Value; i, n: INT;
begin
    if not Json.init(SYSTEM.ADR(d), mem) then return 0; end;
    Buf.init(b, mem);
    Astore.lock;
    defer Astore.unlock;
    v := read(SYSTEM.ADR(d), mem);
    Buf.add(b, '[');
    n := 0;
    for i := 0 to Json.len(SYSTEM.ADR(d), v) - 1 do
        m := Json.item(SYSTEM.ADR(d), v, i);
        if tagged(SYSTEM.ADR(d), m, word) or holds(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), m, "fact")), word, mem) then
            INC(n);
        else
            add(SYSTEM.ADR(d), m, b);
        end;
    end;
    Buf.add(b, ']');
    if n > 0 then save(Buf.bytes(b), mem); end;
    return n;
end;

(* The facts, or those with the tag tag unless it is "", a line each
   with its tags, added to out; nothing if there are none. *)
proc facts*(tag: []const U8; mem: ^Mem.Allocator; var out: Buf.Buf);
var d: Json.Doc; v, m: Json.Value; i, n: INT;
begin
    if not Json.init(SYSTEM.ADR(d), mem) then return; end;
    v := read(SYSTEM.ADR(d), mem);
    n := 0;
    for i := 0 to Json.len(SYSTEM.ADR(d), v) - 1 do
        m := Json.item(SYSTEM.ADR(d), v, i);
        if (LEN(tag) = 0) or tagged(SYSTEM.ADR(d), m, tag) then
            if n > 0 then Buf.add(out, '\n'); end;
            line(SYSTEM.ADR(d), m, out);
            INC(n);
        end;
    end;
end;

(* The module's test, in build/memory, which it makes. *)

proc expect(what, got, want: []const U8): BOOL;
begin
    if got = want then return true; end;
    Out.str("Amemory: ");
    Out.str(what);
    Out.str(":\n");
    Out.str(got);
    Out.str("\nnot\n");
    Out.str(want);
    Out.ln;
    return false;
end;

proc main*: INT;
var ar: Arena.Arena; mem: ^Mem.Allocator; b: Buf.Buf; ok: BOOL;
begin
    if not Arena.init(ar, 1 shl 24) then Rt.stop("Amemory: out of memory"); end;
    mem := SYSTEM.ADR(ar.base);
    _ := Sys.makeDir("build/memory");
    _ := Sys.remove("build/memory/memory.json");
    Astore.use("build/memory/");
    Buf.init(b, Heap.heap);
    remember("likes tea", "me,drinks", mem);
    remember("the build is make", "", mem);
    remember("Tea at four", ",DRINKS,", mem);
    facts("", mem, b);
    ok := expect("facts", Buf.bytes(b), "likes tea [me,drinks]\nthe build is make\nTea at four [DRINKS]");
    Buf.reset(b);
    facts("drinks", mem, b);
    ok := expect("facts by tag", Buf.bytes(b), "likes tea [me,drinks]\nTea at four [DRINKS]") and ok;
    if forget("TEA", mem) # 2 then
        Out.str("Amemory: forget\n");
        ok := false;
    end;
    Buf.reset(b);
    section(mem, b);
    ok := expect("section", Buf.bytes(b), "# Remembered facts\nAbout the human and this project:\n  - the build is make")
        and ok;
    if ok then return 0; end;
    return 1;
end;

end Amemory.
