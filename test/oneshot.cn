// oneshot.cn stub arno: arno asked one question from the command
// line, as a script would ask it, of stub, test/Astub.raz
// (build/stub), the model's server it stands in for, and then a
// session of them on its standard input. arno must:
//
//   - give its usage for -h, and for an empty prompt, with status 2;
//   - stream the reply to the standard output, and save the
//     conversation, saying on the standard error how to go on;
//   - go on with --resume, the earlier turns sent again;
//   - say why a request failed, with status 1, keeping the prompt in
//     the conversation; and so for a key not set, and a conversation
//     not there;
//   - say what is wrong with its configuration, and go on;
//   - tell the model the project's map and notes, keep a note, and
//     attach the definition of a name the prompt mentions;
//   - fetch a page, search, and delegate a step to a worker;
//   - run the tools the model calls, saying each on the standard
//     error, and send their results back: read, grep, def and git;
//     refuse a call made twice, and hand back after four steps of
//     failed calls, or at the step cap; ask about a path outside the
//     project, and about a change after its diff, a line of the
//     standard input the answer, and the next the reason for a no;
//   - in a session, go on with the conversation from line to line,
//     and run the commands: switch, list, load, rename, clear and
//     compact conversations; set the mode, which the system prompt
//     and the tools follow, and the system prompt; remember and forget
//     facts, and the project's notes; count what the session cost;
//     list the provider's models.
//
// Run from the top of the tree, by make check; what it makes goes
// under build/oneshot, its configuration and conversations among it.

if length(args) <> 2 then begin
  echo 'usage: concha test/oneshot.cn stub arno' >&2
  halt(2)
end
stub := args[0]
arno := args[1]

dir := 'build/oneshot'
rm -rf $dir
mkdir -p "$dir/config/arno" "$dir/data"
export XDG_CONFIG_HOME := "$dir/config"
export XDG_DATA_HOME := "$dir/data"
failures := 0
server := ''

procedure cleanup;
begin
  if server <> '' then kill -9 $server 2> /dev/null
end;
trap cleanup EXIT

procedure fail(what);
begin
  echo "oneshot: $what" >&2
  inc(failures)
end;

// arno run with the arguments in the list a: its status, with what it
// wrote in dir/out and what it said in dir/err
function run(a);
begin
  $arno $a < /dev/null > "$dir/out" 2> "$dir/err"
  result := status
end;

// arno run with the arguments in the list a and the text input on
// its standard input: its status, as run's
function answering(a, input);
begin
  echo $input | $arno $a > "$dir/out" 2> "$dir/err"
  result := status
end;

// the file out, dir/out or dir/err, must hold a line with text
procedure holds(what, out, text);
begin
  grep -qF -- $text "$dir/$out"
  if status <> 0 then fail("$what: no '$text' in its $out: " + `cat "$dir/$out"`)
end;

// a run of a that must end with status want, having written a line
// that holds text in the file out, dir/out or dir/err
procedure expect(a, want, out, text);
var got;
begin
  got := run(a)
  if got <> want then fail("arno $(join(a)): status $got, not $want: " + `cat "$dir/err"`)
  grep -qF -- $text "$dir/$out"
  if status <> 0 then fail("arno $(join(a)): no '$text' in its $out: " + `cat "$dir/$out"`)
end;

// the configuration: the stub's url, no context files, which would
// be asked about first on the standard input, and the lines in the
// list more
procedure configure(more);
var line;
begin
  echo "url = http://127.0.0.1:$(port)/v1" > "$dir/config/arno/config"
  echo 'context_files = no' >> "$dir/config/arno/config"
  for line in more do echo $line >> "$dir/config/arno/config"
end;

started := split(`$stub 60`)
if length(started) <> 2 then begin
  echo "oneshot: $stub did not start" >&2
  halt(1)
end
port := started[0]
server := started[1]
configure([])

expect(['-h'], 0, 'out', 'usage: arno')
expect(['  '], 2, 'err', 'arno: no prompt')
expect([], 0, 'err', '/help for commands')

// a new conversation: the system prompt and the question
expect(['hello', 'there'], 0, 'out', '2 messages')
expect(['hello', 'there'], 0, 'err', 'PROMPT goes on from here')
saved := glob("$dir/data/arno/*.json")
if length(saved) < 1 then begin
  fail('no conversation saved')
  halt(1)
end
id := basename(saved[0], '.json')
grep -qF '"title":"hello there","named":false' $(saved[0])
if status <> 0 then fail('the conversation is not saved as it was: ' + `cat $(saved[0])`)

// on from it: the system prompt, the turn before and the question
expect(['--resume', id, 'and', 'more'], 0, 'out', '4 messages')
expect(['--resume', id, 'fail'], 1, 'err', 'arno: HTTP 500: the stub fails, as asked')
grep -qF '{"role":"user","content":"fail"}]}' $(saved[0])
if status <> 0 then fail('the failed prompt is not kept: ' + `cat $(saved[0])`)
expect(['--resume', 'nosuch', 'x'], 1, 'err', 'arno: no conversation nosuch')

configure(['key = ARNO_TEST_UNSET'])
expect(['hello'], 1, 'err', 'arno: ARNO_TEST_UNSET is not set')

configure(['provider = nowhere', 'max_retries = many'])
expect(['hello'], 0, 'err', 'config: unknown provider nowhere')
expect(['hello'], 0, 'err', 'config: max_retries wants a number')

// the tools: a call, its result sent back
configure([])
expect(['call', 'read', '{"path":"Makefile","limit":1}'], 0, 'out', 'the tool said:     1	# arno is a harness')
holds('a call', 'err', '▸ read {"path":"Makefile","limit":1}')
holds('a call', 'err', '  1 line')
expect(['call', 'write', '{}'], 0, 'out', 'the tool said: error: there is no tool named "write"')
expect(['call', 'grep', '{"pattern":"module Arno;","path":"src/","glob":"*.raz"}'], 0, 'out',
  'the tool said: src/Arno.raz:')
expect(['call', 'def', '{"name":"interrupted","path":"src"}'], 0, 'out', '	proc interrupted: BOOL;')
expect(['call', 'git', '{"args":"log --format=%s -n 1"}'], 0, 'out',
  'the tool said: ' + `git log --format=%s -n 1`)

// the system prompt: the project's map, and a note kept
expect(['call', 'note', '{"text":"the stub is test/Astub.raz"}'], 0, 'out', 'the tool said: ok: noted (1 of 30)')
expect(['system'], 0, 'out', '# Project map')
holds('the system prompt', 'out', '- the stub is test/Astub.raz')
// a name in the prompt, its definition attached, shown as a def
expect(['how', 'does', '`interrupted`', 'work'], 0, 'err', '▸ def {"name":"interrupted"}')
last := split(`ls -t "$dir/data/arno"`)[0]
grep -qF '<file path=\"src/Arno.raz\" lines=' "$dir/data/arno/$last"
if status <> 0 then fail('no definition attached: ' + `cat "$dir/data/arno/$last"`)

// the web: a page fetched, and a search through SearXNG
page := "http://127.0.0.1:$(port)/page"
expect(['call', 'fetch', '{"url":"' + page + '"}'], 0, 'out', 'the tool said: A page')
holds('a page', 'out', 'Its text.')
expect(['call', 'search', '{"query":"a b"}'], 0, 'out', 'there is no tool named "search"')
configure(["searxng = http://127.0.0.1:$(port)"])
expect(['call', 'search', '{"query":"a b"}'], 0, 'out', 'the tool said: Found')
holds('a search', 'out', 'a%20b')

// a step delegated to a worker, which reports
configure([])
expect(['call', 'delegate', '{"task":"look","done_when":"seen"}'], 0, 'out',
  'the tool said: error: there is no worker model')
configure(['worker = small'])
expect(['call', 'delegate', '{"task":"look","done_when":"seen"}'], 0, 'out',
  'the tool said: worker report (1 steps):')
holds('a worker', 'out', '2 messages')
holds('a worker', 'err', 'arno: worker small: look')
configure([])

// a call made again refused, and four steps of them a hand-back,
// whose request the conversation doesn't keep
expect(['always', 'read', '{"path":"LICENSE","limit":1}'], 0, 'err', 'not run: this exact call was already made')
holds('a repeated call', 'err', '4 steps of failed calls in a row; asking the model to hand back')
holds('a repeated call', 'out', '13 messages')
saved := `ls -t "$dir/data/arno"`
id := basename(split(saved)[0], '.json')
grep -qF 'Your last calls' "$dir/data/arno/$id.json"
if status = 0 then fail('the hand-back request is kept in the conversation')
expect(['--resume', id, 'and', 'more'], 0, 'out', '14 messages')

configure(['max_steps = 2'])
expect(['always', 'read', '{"path":"LICENSE","limit":1}'], 0, 'err', '2 steps used; asking the model to hand back')

// outside the project, the human asked
configure([])
outside := `mktemp -d`
echo 'far away' > "$outside/f"
far := '{"path":"' + outside + '/f"}'
answering(['call', 'read', far], 'n')
holds('a no', 'out', 'the tool said: declined by user: ')
holds('a no', 'err', 'outside ' + `pwd -P` + '? (a: always, all of ')
answering(['call', 'read', far], 'y')
holds('a yes', 'out', 'the tool said:     1	far away')
answering(['call', 'read', far], '')
holds('no answer', 'out', 'the tool said: declined by user: ')
rm -rf $outside

// a change to a file, its diff shown, approved or declined with a reason
edit := '{"path":"' + dir + '/made","old":"","new":"hello"}'
answering(['call', 'edit', edit], 'y')
holds('an edit', 'out', 'the tool said: ok: created ' + dir + '/made')
holds('an edit', 'err', '+hello')
holds('an edit', 'err', 'create ' + dir + '/made? [y/N]')
edit := '{"path":"' + dir + '/made","old":"hello","new":"bye"}'
answering(['call', 'edit', edit], 'n' + #10 + 'not now')
holds('a declined edit', 'out', 'the tool said: declined by user: not now. Nothing was changed')

// a session: each line a turn of the same conversation, or a command
configure([])
answering([], 'hello' + #10 + 'again' + #10 + '/usage' + #10 + '/help' + #10 + '/nope')
holds('a session', 'out', '2 messages')
holds('a session', 'out', '4 messages')
holds('/usage', 'out', 'requests  2')
holds('/help', 'out', '/remember [#tag,...] FACT')
holds('/help', 'out', '  review           review changes')
holds('an unknown command', 'err', 'arno: unknown command')

// conversations switched, listed, loaded, renamed and exported
answering([], 'first' + #10 + '/rename named one' + #10 + '/new' + #10 + 'second' + #10 + '/list' + #10 +
  '/load named' + #10 + 'more' + #10 + '/export')
holds('/rename', 'out', 'renamed: named one')
holds('/new', 'out', 'a new conversation')
holds('/list', 'out', '  second')
holds('/list', 'out', '  named one')
holds('/load', 'out', ': named one, 2 messages')
holds('/load', 'out', '4 messages')
holds('/export', 'out', '{"title":"named one","named":true')

// the history cleared to the first exchange, and compacted
answering([], 'a' + #10 + 'b' + #10 + 'c' + #10 + '/clear' + #10 + 'd')
holds('/clear', 'out', 'history cleared to the first exchange')
if `tail -n 1 "$dir/out"` <> '4 messages' then fail('/clear: ' + `cat "$dir/out"`)
answering([], 'a' + #10 + 'b' + #10 + '/compact' + #10 + 'c')
holds('/compact', 'out', 'compacted 4 messages')
last := split(`ls -t "$dir/data/arno"`)[0]
grep -qF 'Summary of our conversation so far:\n\n6 messages' "$dir/data/arno/$last"
if status <> 0 then fail('/compact: ' + `cat "$dir/data/arno/$last"`)
if `tail -n 1 "$dir/out"` <> '4 messages' then fail('/compact, then a turn: ' + `cat "$dir/out"`)

// the mode, in the system prompt and the tools; the system prompt
answering([], '/mode review' + #10 + 'system' + #10 + '/tools' + #10 + '/mode nope')
holds('/mode', 'out', 'mode: review')
holds('/mode', 'out', 'Mode: code review')
holds('/mode', 'out', 'Modes (current: review)')
holds('/mode', 'err', 'arno: modes: chat review improve pair')
holds('/tools', 'out', 'read  ')
grep -q '^edit  ' "$dir/out"
if status = 0 then fail('review mode offers edit')
answering([], '/system Be brief.' + #10 + 'system' + #10 + '/system')
holds('/system', 'out', 'Be brief.' + #10 + #10 + '# Workspace')
holds('/system', 'out', "this conversation's own system prompt")

// facts remembered and forgotten, and the project's notes
answering([], '/remember #me,drinks likes tea' + #10 + '/my-memory' + #10 + 'system' + #10 + '/forget TEA' + #10 +
  '/my-memory')
holds('/remember', 'out', 'remembered: likes tea')
holds('/my-memory', 'out', 'likes tea [me,drinks]')
holds('/remember', 'out', '  - likes tea [me,drinks]')
holds('/forget', 'out', 'forgot 1')
holds('/forget', 'out', 'nothing remembered')
answering([], '/notes' + #10 + '/notes forget Astub' + #10 + '/notes' + #10 + '/notes forget 1')
holds('/notes', 'out', ' 1  the stub is test/Astub.raz')
holds('/notes forget', 'out', 'forgot: the stub is test/Astub.raz')
holds('/notes forget', 'out', 'no notes for ')
holds('/notes forget', 'err', 'arno: no note 1')

// the models the provider's server lists, Gemini's models/ taken off
answering([], '/models')
holds('/models', 'out', 'stub-one' + #10 + 'stub-two')

if failures > 0 then halt(1)
