// test/claude.cn: arno-claude, run by make check from arno's top directory:
//
//     concha test/claude.cn tools/arno-claude.cn
//
// In a home of its own: a repository with a second worktree, a rule, an
// agent and a skill, two skills of the home's, and a Claude Code memory
// directory whose session ran in it. Each worktree gets arno's directory:
// the context file naming the entry and the rule, the entry in full in
// memory/, the agent as a role in roles/, the skills in skills/, the
// project's winning a name; a second run leaves them whole, and nothing is
// written into the repository.
if length(args) <> 1 then begin
  echo 'usage: concha test/claude.cn arno-claude' >&2
  halt(2)
end
script := `pwd` + '/' + args[0]
dir := `pwd` + '/build/claude'
failed := false

procedure fail(what);
begin
  writeln('claude: ', what)
  failed := true
end;

// a line holding text in the file f, or a failure named what
procedure holds(what, f, text);
begin
  grep -qF -- $text $f
  if status <> 0 then fail("$what: no '$text' in $f")
end;

rm -rf $dir
mkdir -p $dir/home/.claude/projects/-repo/memory $dir/repo/.claude/rules $dir/repo/.claude/agents
git init -q $dir/repo
begin
  writeln('---')
  writeln('paths: ["backend/**"]')
  writeln('---')
  writeln('Queries go in data/.')
end > $dir/repo/.claude/rules/backend.md
begin
  writeln('---')
  writeln('name: security')
  writeln('description: Security review of a change.')
  writeln('tools: Read, Grep')
  writeln('---')
  writeln()
  writeln('Follow the data from its entry point.')
end > $dir/repo/.claude/agents/security.md
mkdir -p $dir/home/.claude/skills/tiza $dir/home/.claude/skills/comment $dir/repo/.claude/skills/comment
begin
  writeln('---')
  writeln('name: tiza')
  writeln('description: Draw a diagram.')
  writeln('---')
  writeln('Write the text, then render it.')
end > $dir/home/.claude/skills/tiza/SKILL.md
writeln('---', chr(10), 'description: The home''s.', chr(10), '---', chr(10), 'Not this one.') > $dir/home/.claude/skills/comment/SKILL.md
begin
  writeln('---')
  writeln('disable-model-invocation: true')
  writeln('description: Comment on an issue.')
  writeln('allowed-tools: [Read]')
  writeln('---')
  writeln('Summarise $ARGUMENTS for users.')
end > $dir/repo/.claude/skills/comment/SKILL.md
git -C $dir/repo add -A
git -C $dir/repo -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -q -m first
git -C $dir/repo worktree add -q $dir/other
writeln('{"type":"user","cwd":"', dir, '/repo","message":"hi"}') > $dir/home/.claude/projects/-repo/s.jsonl
begin
  writeln('---')
  writeln('name: stale-infra')
  writeln('description: "the \"infra\" folder is stale"')
  writeln('metadata:')
  writeln('  type: project')
  writeln('---')
  writeln()
  writeln('Ignore infrastructure/.')
end > $dir/home/.claude/projects/-repo/memory/stale-infra.md
writeln('- [Stale](stale-infra.md)') > $dir/home/.claude/projects/-repo/memory/MEMORY.md

for i := 1 to 2 do
  env HOME=$dir/home XDG_DATA_HOME=$dir/data concha $script
for root in [dir + '/repo', dir + '/other'] do begin
  own := dir + '/data/arno/projects' + root
  f := own + '/AGENTS.md'
  holds('the entry named', f, '- stale-infra.md: the "infra" folder is stale')
  holds('where entries are', f, own + '/memory')
  holds('the rule', f, '- backend/**: .claude/rules/backend.md')
  grep -qF -- 'Ignore infrastructure/.' $f
  if status = 0 then fail('an entry in full in ' + f)
  holds('the entry in full', own + '/memory/stale-infra.md', 'Ignore infrastructure/.')
  if exists(own + '/memory/MEMORY.md') then fail('the index kept as an entry')
  if `head -n 1 $(own + '/roles/security.md')` <> 'Security review of a change.' then fail('the role description')
  holds('the role text', own + '/roles/security.md', 'Follow the data from its entry point.')
  grep -qF -- 'tools:' $(own + '/roles/security.md')
  if status = 0 then fail('front matter in the role')
  if `head -n 1 $(own + '/skills/tiza.md')` <> 'Draw a diagram.' then fail('the home''s skill')
  if `head -n 1 $(own + '/skills/comment.md')` <> 'Only when the human asks for it: Comment on an issue.' then
    fail('the project''s skill, asked for')
  holds('the skill text', own + '/skills/comment.md', 'Summarise the human''s request for users.')
  grep -qF -- 'allowed-tools' $(own + '/skills/comment.md')
  if status = 0 then fail('front matter in the skill')
end
if length(lines(`git -C $dir/repo status --porcelain`)) <> 0 then fail('the repository was written to')
if failed then halt(1)
echo 'arno-claude ok'
