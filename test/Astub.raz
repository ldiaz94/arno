(* Astub: a model's server for arno's tests, OpenAI's chat completions
   on 127.0.0.1, answering at once and the same way each time.

       build/stub idle-seconds

   It says "port pid" on standard output and serves in the background
   until no request has come for idle-seconds. Its reply streams the
   number of messages the request had, its system prompt among them,
   as "N messages", so that a test sees a conversation go on; to a
   last message of "fail" it answers a 500 with an error, as a
   provider does.

   To a last message of "system" it answers the request's system
   prompt, for a test of what arno tells the model.

   It also serves fetch and search: /page is a page of HTML, and
   /search?format=json&q=... what SearXNG answers, a result that is the
   query. /v1/models lists two models, the second as Gemini names
   them, models/NAME.

   A test asks for a tool call by the human's last message: to "call
   NAME ARGS" the stub calls the tool NAME with the arguments ARGS, and
   answers its result with "the tool said: " and the result; to
   "always NAME ARGS" it makes the same call again after each result,
   for a test of a turn that doesn't end by itself.

   Depends on rnet's Http and Conn and rjson's Json, with no TLS. *)
module Astub;
import Http, Conn, Json, Buf, Str, Sys, Files, Fmt, Out, Heap;

var reply, text: Buf.Buf;

(* data: lines of a reply, as OpenAI streams them *)
proc event(json: []U8);
begin
    Buf.str(ADR(reply), "data: ");
    Buf.str(ADR(reply), json);
    Buf.add(ADR(reply), '\n');
end;

proc said(text: []U8);
begin
    Buf.str(ADR(reply), `data: {"choices":[{"delta":{"content":`);
    Json.quote(ADR(reply), text);
    Buf.str(ADR(reply), "}}]}\n");
end;

(* A call of the tool name with args, args JSON text. *)
proc call(name, args: []U8);
begin
    Buf.str(ADR(reply), `data: {"choices":[{"delta":{"tool_calls":[{"index":0,"id":"c1","type":"function",`);
    Buf.str(ADR(reply), `"function":{"name":`);
    Json.quote(ADR(reply), name);
    Buf.str(ADR(reply), `,"arguments":`);
    Json.quote(ADR(reply), args);
    Buf.str(ADR(reply), "}}]}}]}\n");
end;

(* The reply to a request whose human's last message was asked, with
   the last message last of the role role, as the module's comment
   says; false if asked asks for no call. *)
proc tool(asked, role, last: []U8): BOOL;
var verb, rest, name, args: []U8; ok: BOOL;
begin
    verb, rest, ok := Str.cut(asked, " ");
    if not ok or (verb # "call") and (verb # "always") then return false; end;
    name, args, _ := Str.cut(rest, " ");
    if (role = "tool") and (verb = "call") then
        Buf.reset(ADR(text));
        Buf.str(ADR(text), "the tool said: ");
        Buf.str(ADR(text), last);
        said(Buf.bytes(ADR(text)));
    else
        call(name, args);
    end;
    return true;
end;

proc answer(req, res: ^Http.Message; _arg: ^U8);
var d: Json.Doc; v, msgs, m: Json.Value; n, k, i: INT; last, role, asked: []U8; digits: [20]U8;
begin
    Buf.reset(ADR(reply));
    if not Json.init(ADR(d), Heap.heap) then res^.status := 500; return; end;
    defer Json.done(ADR(d));
    if req^.target = "/page" then
        _ := Http.add(res, "Content-Type", "text/html; charset=utf-8");
        res^.body := "<html><head><title>A page</title></head><body><p>Its   text.</p></body></html>";
        return;
    end;
    if req^.target = "/v1/models" then
        res^.body := `{"object":"list","data":[{"id":"stub-one"},{"id":"models/stub-two"}]}`;
        return;
    end;
    if Str.hasPrefix(req^.target, "/search?format=json&q=") then
        Buf.str(ADR(reply), `{"results":[{"title":"Found","url":"http://x/","content":"`);
        Buf.str(ADR(reply), req^.target[22..LEN(req^.target)]);
        Buf.str(ADR(reply), `"}]}`);
        res^.body := Buf.bytes(ADR(reply));
        return;
    end;
    v := Json.parse(ADR(d), req^.body);
    msgs := Json.member(ADR(d), v, "messages");
    n := Json.len(ADR(d), msgs);
    if (req^.target # "/v1/chat/completions") or (Json.kind(ADR(d), msgs) # Json.Kind.array) then
        res^.status := 404;
        return;
    end;
    m := Json.item(ADR(d), msgs, n - 1);
    last := Json.text(ADR(d), Json.member(ADR(d), m, "content"));
    role := Json.text(ADR(d), Json.member(ADR(d), m, "role"));
    if last = "fail" then
        res^.status := 500;
        res^.body := `{"error":{"message":"the stub fails, as asked"}}`;
        return;
    end;
    asked := "";
    for i := n - 1 to 0 by -1 do
        m := Json.item(ADR(d), msgs, i);
        if Json.text(ADR(d), Json.member(ADR(d), m, "role")) = "user" then
            asked := Json.text(ADR(d), Json.member(ADR(d), m, "content"));
            break;
        end;
    end;
    if asked = "system" then
        said(Json.text(ADR(d), Json.member(ADR(d), Json.item(ADR(d), msgs, 0), "content")));
    elsif not tool(asked, role, last) then
        digits, k := Str.fromInt(n);
        said(digits[0..k]);
        said(" messages");
    end;
    event(`{"choices":[],"usage":{"prompt_tokens":10,"completion_tokens":2}}`);
    Buf.str(ADR(reply), "data: [DONE]\n");
    _ := Http.add(res, "Content-Type", "text/event-stream");
    res^.body := Buf.bytes(ADR(reply));
end;

proc main*: INT;
var l, port, pid, fd: INT; idle: I64; ok: BOOL; s: Http.Server; c: Conn.Conn;
begin
    if ARGC() = 2 then idle, ok := Str.toInt(Files.arg(1)); end;
    if not ok or (idle <= 0) then
        _ := Sys.write(Sys.stderr, "usage: stub idle-seconds\n");
        return 2;
    end;
    l := Sys.listenTcp("127.0.0.1", 0);
    if l >= 0 then port := Sys.localPort(l); end;
    if (l < 0) or (port <= 0) then
        _ := Sys.write(Sys.stderr, "stub: cannot listen on 127.0.0.1\n");
        return 1;
    end;
    pid := Sys.fork();
    if pid < 0 then
        _ := Sys.write(Sys.stderr, "stub: cannot fork\n");
        return 1;
    end;
    if pid > 0 then
        Fmt.print("{} {}\n", [Fmt.int(port), Fmt.int(pid)]);
        Out.flush;
        return 0;
    end;
    Sys.close(0);
    Sys.close(1);
    Sys.close(2);
    Buf.init(ADR(reply), Heap.heap);
    Buf.init(ADR(text), Heap.heap);
    Http.initServer(ADR(s), answer, nil);
    while Sys.ready(l, INT(idle) * 1000) do
        fd := Sys.accept(l);
        if fd >= 0 then
            Conn.socket(ADR(c), fd);
            Http.serveConn(ADR(s), ADR(c));
        end;
    end;
    Sys.exit(0);
    return 0;
end;

end Astub.
