(* Astub: a model's server for arno's tests, OpenAI's chat completions
   on 127.0.0.1, answering at once and the same way each time.

       build/stub idle-seconds

   It says "port pid" on standard output and serves in the background
   until no request has come for idle-seconds. Its reply streams the
   number of messages the request had, its system prompt among them,
   as "N messages", so that a test sees a conversation go on; to a
   last message of "fail" it answers a 500 with an error, as a
   provider does.

   To a last message of "system" it answers the request's system
   prompt, for a test of what arno tells the model.

   It also serves fetch and search: /page is a page of HTML, and
   /search?format=json&q=... what SearXNG answers, a result that is the
   query. /v1/models lists two models, the second as Gemini names
   them, models/NAME.

   A test asks for a tool call by the human's last message: to "call
   NAME ARGS" the stub calls the tool NAME with the arguments ARGS, and
   answers its result with "the tool said: " and the result; to
   "always NAME ARGS" it makes the same call again after each result,
   for a test of a turn that doesn't end by itself; to "fan NAME ARGS",
   ARGS several parted by tabs, it makes as many calls of NAME at once,
   and answers their results with them all, a line each. A worker's brief,
   "Task: " and then the task, asks the same by its task's first line,
   and also "fail", which fails its request, and "empty", which is
   answered with no text at all. To "failing NAME ARGS" it makes the
   call, and a second later fails the request that follows its result.

   Depends on rnet's Http and Conn and rjson's Json, with no TLS. *)
module Astub;
import Http, Conn, Json, Buf, Str, Sys, Files, Fmt, Out, Heap;
import SYSTEM;

var reply, text: Buf.Buf;

(* data: lines of a reply, as OpenAI streams them *)
proc event(json: []const U8);
begin
    Buf.str(reply, "data: ");
    Buf.str(reply, json);
    Buf.add(reply, '\n');
end;

proc said(text: []const U8);
begin
    Buf.str(reply, `data: {"choices":[{"delta":{"content":`);
    Json.quote(SYSTEM.ADR(reply), text);
    Buf.str(reply, "}}]}\n");
end;

(* A call of the tool name with args, args JSON text, the reply's i-th,
   from 0. *)
proc call(i: INT; name, args: []const U8);
begin
    Buf.str(reply, `data: {"choices":[{"delta":{"tool_calls":[{"index":`);
    Fmt.write(reply, "{},\"id\":\"c{}\",", [Fmt.int(i), Fmt.int(i + 1)]);
    Buf.str(reply, `"type":"function","function":{"name":`);
    Json.quote(SYSTEM.ADR(reply), name);
    Buf.str(reply, `,"arguments":`);
    Json.quote(SYSTEM.ADR(reply), args);
    Buf.str(reply, "}}]}}]}\n");
end;

(* The reply to a request whose human's last message was asked, with
   the last message last of the role role, the results of a fan's calls
   all of them, as the module's comment says; false if asked asks for no
   call. *)
proc tool(asked, role, last: []const U8): BOOL;
var verb, rest, name, args, one: []const U8; ok: BOOL; i: INT;
begin
    if Str.hasPrefix(asked, "Task: ") then asked, _, _ := Str.cut(asked[6..LEN(asked)], "\n"); end;
    verb, rest, ok := Str.cut(asked, " ");
    if not ok or (verb # "call") and (verb # "always") and (verb # "fan") and (verb # "failing") then return false; end;
    name, args, _ := Str.cut(rest, " ");
    if (role = "tool") and (verb # "always") then
        Buf.reset(text);
        Buf.str(text, "the tool said: ");
        Buf.str(text, last);
        said(Buf.bytes(text));
    elsif verb = "fan" then
        i := 0;
        repeat
            one, args, ok := Str.cut(args, "\t");
            call(i, name, one);
            INC(i);
        until not ok;
    else
        call(0, name, args);
    end;
    return true;
end;

proc answer(const req: Http.Message; var res: Http.Message; _arg: ^U8);
var text, results: Buf.Buf; d: Json.Doc; v, msgs, m: Json.Value; n, k, i, first: INT; last, role, asked, task: []const U8; digits: [20]U8;
begin
    Buf.reset(reply);
    (* a connection at a time is served, and arno's workers each have
       one of their own: none is kept waiting for another to go quiet *)
    _ := Http.add(res, "Connection", "close");
    if not Json.init(SYSTEM.ADR(d), Heap.heap) then res.status := 500; return; end;
    defer Json.done(SYSTEM.ADR(d));
    Buf.init(text, Heap.heap);   (* parsing changes its text, so the request's body is copied *)
    defer Buf.done(text);
    Buf.init(results, Heap.heap);
    defer Buf.done(results);
    if req.target = "/page" then
        _ := Http.add(res, "Content-Type", "text/html; charset=utf-8");
        res.body := "<html><head><title>A page</title></head><body><p>Its   text.</p></body></html>";
        return;
    end;
    if req.target = "/v1/models" then
        res.body := `{"object":"list","data":[{"id":"stub-one"},{"id":"models/stub-two"}]}`;
        return;
    end;
    if Str.hasPrefix(req.target, "/search?format=json&q=") then
        Buf.str(reply, `{"results":[{"title":"Found","url":"http://x/","content":"`);
        Buf.str(reply, req.target[22..LEN(req.target)]);
        Buf.str(reply, `"}]}`);
        res.body := Buf.bytes(reply);
        return;
    end;
    Buf.str(text, req.body);
    v := Json.parse(SYSTEM.ADR(d), Buf.bytes(text));
    msgs := Json.member(SYSTEM.ADR(d), v, "messages");
    n := Json.len(SYSTEM.ADR(d), msgs);
    if (req.target # "/v1/chat/completions") or (Json.kind(SYSTEM.ADR(d), msgs) # Json.Kind.array) then
        res.status := 404;
        return;
    end;
    m := Json.item(SYSTEM.ADR(d), msgs, n - 1);
    last := Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), m, "content"));
    role := Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), m, "role"));
    (* the results of several calls, in order, a line between *)
    first := n - 1;
    while (first > 0) and (Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), Json.item(SYSTEM.ADR(d), msgs, first - 1), "role")) = "tool") do
        DEC(first);
    end;
    if (role = "tool") and (first < n - 1) then
        for i := first to n - 1 do
            Buf.str(results, Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), Json.item(SYSTEM.ADR(d), msgs, i), "content")));
            if i < n - 1 then Buf.add(results, '\n'); end;
        end;
        last := Buf.bytes(results);
    end;
    if last = "fail" then
        res.status := 500;
        res.body := `{"error":{"message":"the stub fails, as asked"}}`;
        return;
    end;
    asked := "";
    for i := n - 1 to 0 by -1 do
        m := Json.item(SYSTEM.ADR(d), msgs, i);
        if Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), m, "role")) = "user" then
            asked := Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), m, "content"));
            break;
        end;
    end;
    (* a worker's brief is "Task: " and the task, whose first line may ask *)
    if Str.hasPrefix(asked, "Task: ") then task, _, _ := Str.cut(asked[6..LEN(asked)], "\n"); else task := asked; end;
    if Str.hasPrefix(asked, "failing ") and (role = "tool") then
        Sys.sleep(1000);   (* a turn that runs a while, and then ends in an error *)
        res.status := 500;
        res.body := `{"error":{"message":"the stub fails after the call, as asked"}}`;
        return;
    end;
    if task = "fail" then
        res.status := 500;
        res.body := `{"error":{"message":"the stub fails the worker, as asked"}}`;
        return;
    end;
    if task = "empty" then
        (* an empty reply: usage only, no text *)
    elsif asked = "system" then
        said(Json.text(SYSTEM.ADR(d), Json.member(SYSTEM.ADR(d), Json.item(SYSTEM.ADR(d), msgs, 0), "content")));
    elsif not tool(asked, role, last) then
        digits, k := Str.fromInt(n);
        said(digits[0..k]);
        said(" messages");
    end;
    event(`{"choices":[],"usage":{"prompt_tokens":10,"completion_tokens":2}}`);
    Buf.str(reply, "data: [DONE]\n");
    _ := Http.add(res, "Content-Type", "text/event-stream");
    res.body := Buf.bytes(reply);
end;

proc main*: INT;
var l, port, pid, fd: INT; idle: I64; ok: BOOL; s: Http.Server; c: Conn.Conn;
begin
    if ARGC() = 2 then idle, ok := Str.toInt(Files.arg(1)); end;
    if not ok or (idle <= 0) then
        _ := Sys.write(Sys.stderr, "usage: stub idle-seconds\n");
        return 2;
    end;
    l := Sys.listenTcp("127.0.0.1", 0);
    if l >= 0 then port := Sys.localPort(l); end;
    if (l < 0) or (port <= 0) then
        _ := Sys.write(Sys.stderr, "stub: cannot listen on 127.0.0.1\n");
        return 1;
    end;
    pid := Sys.fork();
    if pid < 0 then
        _ := Sys.write(Sys.stderr, "stub: cannot fork\n");
        return 1;
    end;
    if pid > 0 then
        Fmt.print("{} {}\n", [Fmt.int(port), Fmt.int(pid)]);
        Out.flush;
        return 0;
    end;
    Sys.close(0);
    Sys.close(1);
    Sys.close(2);
    Buf.init(reply, Heap.heap);
    Buf.init(text, Heap.heap);
    Http.initServer(s, answer, nil);
    while Sys.ready(l, INT(idle) * 1000) do
        fd := Sys.accept(l);
        if fd >= 0 then
            Conn.socket(c, fd);
            Http.serveConn(s, c);
        end;
    end;
    Sys.exit(0);
    return 0;
end;

end Astub.
